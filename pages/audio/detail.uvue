<template>
  <view class="page">
    <view class="detail-header">
      <view class="header-back" @tap="goBack">
        <image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
      </view>
      <text class="detail-title">详情</text>
    </view>

    <scroll-view class="detail-scroll" scroll-y="true">
      <view class="detail-cover">
        <view class="audio-disc audio-disc-large">
          <view class="audio-disc-center audio-disc-center-large"></view>
        </view>
      </view>

      <view class="detail-tabs">
        <text
          class="detail-tab"
          :class="activeTab == 'intro' ? 'detail-tab-active' : ''"
          @tap="activeTab = 'intro'"
        >
          简介
        </text>
        <text
          class="detail-tab"
          :class="activeTab == 'catalog' ? 'detail-tab-active' : ''"
          @tap="activeTab = 'catalog'"
        >
          目录
        </text>
      </view>

      <view v-if="activeTab == 'intro'" class="intro-panel">
        <text class="content-title">{{ audioTitle }}</text>
        <view class="content-stats">
          <text class="content-stat">浏览 {{ viewCount }}</text>
          <text class="content-stat">收藏 {{ favoriteCount }}</text>
        </view>

        <text class="section-title">音频介绍</text>
        <text class="content-text">{{ audioSummary }}</text>
      </view>

      <view v-else class="catalog-panel">
        <view
          v-for="item in catalogItems"
          :key="item.id"
          class="catalog-item"
          :class="item.id == currentAudioItemId ? 'catalog-item-active' : ''"
          @tap="selectCatalogItem(item.id)"
        >
          <text class="catalog-title" :class="item.id == currentAudioItemId ? 'catalog-title-active' : ''">{{ item.title }}</text>
          <text class="catalog-duration" :class="item.id == currentAudioItemId ? 'catalog-duration-active' : ''">{{ item.duration }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { onMounted, ref } from 'vue'

type ApiResponse<T> = {
  success: boolean
  code?: string
  message?: string
  data?: T | null
}

type AppPodcastAudio = {
  id: number
  podcastId: number
  title: string
  audioUrl: string
  durationSeconds: number
  sortOrder: number
}

type AppPodcast = {
  id: number
  title: string
  summary: string
  coverUrl: string
  publishedAt: string
  progressPercent: number
  studySeconds: number
  audios: AppPodcastAudio[]
}

type CatalogItem = {
  id: string
  title: string
  duration: string
}

const BASE_URL = 'https://api-test.arez.cc.cd'
const ACCESS_TOKEN_KEY = 'app_auth_access_token'
const TOKEN_TYPE_KEY = 'app_auth_token_type'

const audioId = ref('')
const activeTab = ref('intro')
const hasShownDebug = ref(false)
const audioTitle = ref('音频标题占位 1')
const audioSummary = ref(
  '这里是音频简介占位内容。后续可接入真实的音频简介、讲师说明、学习目标、适用人群与补充说明等文本信息。这里保留为较长段落，用于模拟设计图中的正文排版效果，方便后续直接替换成接口返回内容。'
)
const viewCount = ref('1200')
const favoriteCount = ref('860')
const currentAudioItemId = ref('1')
const catalogItems = ref<CatalogItem[]>([
  { id: '1', title: '音频 1：目录标题占位一', duration: "21'44\"" },
  { id: '2', title: '音频 2：目录标题占位二', duration: "18'20\"" },
  { id: '3', title: '音频 3：目录标题占位三', duration: "16'08\"" },
  { id: '4', title: '音频 4：目录标题占位四', duration: "14'35\"" }
])

function showDebugModal(content: string): void {
  return
}

function getAuthorization(): string {
  const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
  const tokenType = uni.getStorageSync(TOKEN_TYPE_KEY)
  if (typeof token === 'string' && token.length > 0) {
    if (typeof tokenType === 'string' && tokenType.length > 0) {
      return tokenType + ' ' + token
    }
    return 'Bearer ' + token
  }
  return ''
}

function safeText(value: string | null): string {
  return value == null || value.length == 0 ? '' : value
}

function formatDuration(seconds: number): string {
  const total = seconds > 0 ? seconds : 0
  const minute = Math.floor(total / 60)
  const second = total % 60
  const secondText = second < 10 ? '0' + String(second) : String(second)
  return String(minute) + "'" + secondText + '"'
}

function selectCatalogItem(id: string): void {
  currentAudioItemId.value = id
}

function tryReadRouteParams(): boolean {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    showDebugModal('未读取到当前页面栈')
    return false
  }

  const currentPage = pages[pages.length - 1]
  if (currentPage == null || currentPage.options == null) {
    showDebugModal('宸茶繘鍏ラ煶棰戣鎯呴〉锛屼絾椤甸潰鍙傛暟灏氭湭灏辩华')
    return false
  }
  const options = currentPage.options as UTSJSONObject
  const idValue = options['id']
  if (typeof idValue === 'string' && idValue.length > 0) {
    audioId.value = idValue
    return true
  }

  showDebugModal('已进入音频详情页，但未读取到音频 id')
  return false
}

function fetchAudioDetail(): void {
  if (audioId.value.length == 0) {
    showDebugModal('无法请求详情：音频 id 为空')
    return
  }

  const headers: UTSJSONObject = {
    'Content-Type': 'application/json'
  }
  const authorization = getAuthorization()
  if (authorization.length > 0) {
    headers['Authorization'] = authorization
  }

  uni.request({
    url: BASE_URL + '/api/v1/app/learning/podcasts/' + audioId.value,
    method: 'GET',
    header: headers,
    success: (res) => {
      const data = res.data as ApiResponse<AppPodcast>
      if (res.statusCode == 200 && data != null && data.success && data.data != null) {
        const podcast = data.data!
        const titleText = safeText(podcast.title).length > 0 ? podcast.title : '空'
        const audioCount = podcast.audios != null ? podcast.audios.length : 0
        showDebugModal('详情接口返回成功：id=' + audioId.value + '，title=' + titleText + '，目录数量=' + String(audioCount))

        if (safeText(podcast.title).length > 0) {
          audioTitle.value = podcast.title
        }
        if (safeText(podcast.summary).length > 0) {
          audioSummary.value = podcast.summary
        }
        viewCount.value = String(podcast.studySeconds != null ? podcast.studySeconds : 0)
        favoriteCount.value = String(podcast.audios != null ? podcast.audios.length : 0)

        if (podcast.audios != null && podcast.audios.length > 0) {
          catalogItems.value = podcast.audios.map((item: AppPodcastAudio, index: number): CatalogItem => {
            const itemTitle =
              safeText(item.title).length > 0 ? item.title : '音频 ' + String(index + 1) + '：目录标题占位'
            return {
              id: String(item.id),
              title: itemTitle,
              duration: formatDuration(item.durationSeconds)
            }
          })
          currentAudioItemId.value = catalogItems.value[0].id
        }
      } else {
        const codeText = data != null && typeof data.code === 'string' ? data.code : '未知错误'
        const messageText = data != null && typeof data.message === 'string' ? data.message : '无返回说明'
        showDebugModal('详情接口返回失败：HTTP ' + String(res.statusCode) + '，' + codeText + '，' + messageText)
      }
    },
    fail: (err) => {
      const errText = typeof err.errMsg === 'string' ? err.errMsg : '请求失败'
      showDebugModal('详情接口请求失败：' + errText)
    }
  })
}

function initAudioDetail(): void {
  if (tryReadRouteParams()) {
    fetchAudioDetail()
    return
  }

  setTimeout(() => {
    if (tryReadRouteParams()) {
      fetchAudioDetail()
    }
  }, 300)
}

function goBack() {
  uni.navigateBack()
}

onMounted(() => {
  initAudioDetail()
})
</script>

<style>
.page {
  flex: 1;
  background-color: #f8f6f0;
}

.detail-header {
  height: 96rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #ece9e1;
  position: relative;
}

.header-back {
  position: absolute;
  left: 20rpx;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.header-back-icon {
  width: 24rpx;
  height: 24rpx;
}

.detail-title {
  font-size: 18px;
  line-height: 28px;
  color: #1f1f1f;
  font-weight: 600;
}

.detail-scroll {
  flex: 1;
}

.detail-cover {
  height: 232px;
  align-items: center;
  justify-content: center;
  background-color: #cabca7;
}

.audio-disc {
  border-radius: 999px;
  background-color: #fffefc;
  align-items: center;
  justify-content: center;
}

.audio-disc-large {
  width: 120px;
  height: 120px;
}

.audio-disc-center {
  border-radius: 999px;
  background-color: #e4c09c;
}

.audio-disc-center-large {
  width: 34px;
  height: 34px;
}

.detail-tabs {
  height: 64px;
  padding: 0 24px;
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
}

.detail-tab {
  position: relative;
  margin-right: 28px;
  font-size: 17px;
  color: #a5a5a5;
}

.detail-tab-active {
  color: #222222;
  font-weight: 700;
}

.detail-tab-active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -10px;
  width: 28px;
  height: 4px;
  margin: auto;
  border-radius: 2px;
  background-color: #c46b76;
}

.intro-panel {
  padding: 28px 22px 32px;
  background-color: #ffffff;
}

.content-title {
  display: block;
  text-align: center;
  font-size: 18px;
  line-height: 28px;
  color: #1f1f1f;
  font-weight: 700;
}

.content-stats {
  margin-top: 18px;
  flex-direction: row;
  justify-content: flex-end;
}

.content-stat {
  margin-left: 18px;
  font-size: 14px;
  color: #a8a8a8;
}

.section-title {
  display: block;
  margin-top: 26px;
  font-size: 16px;
  color: #222222;
}

.content-text {
  display: block;
  margin-top: 18px;
  font-size: 15px;
  line-height: 30px;
  color: #8f8f8f;
}

.catalog-panel {
  padding-bottom: 24px;
  background-color: #ffffff;
}

.catalog-item {
  min-height: 72px;
  padding: 0 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom-width: 1px;
  border-bottom-color: #f0f0f0;
}

.catalog-item-active {
  background-color: #f7f3eb;
}

.catalog-title {
  flex: 1;
  margin-right: 12px;
  font-size: 15px;
  line-height: 24px;
  color: #303030;
}

.catalog-title-active {
  color: #c46b76;
  font-weight: 600;
}

.catalog-duration {
  font-size: 14px;
  color: #a0a0a0;
}

.catalog-duration-active {
  color: #c46b76;
}
</style>
