<template>
	<view class="page">
		<view class="header">
			<view class="back-btn" @tap="goBack">
				<image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">{{ pageTitleText }}</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view v-if="isLoading" class="state-wrap">
				<text class="state-text">{{ loadingText }}</text>
			</view>

			<view v-else-if="errorText.length > 0" class="state-wrap">
				<text class="state-text">{{ errorText }}</text>
				<view class="retry-btn" @tap="loadDetail">
					<text class="retry-btn-text">{{ retryText }}</text>
				</view>
			</view>

			<view v-else class="detail-body">
				<view class="hero-card">
					<image v-if="coverUrl.length > 0" class="hero-cover" :src="coverUrl" mode="aspectFill"></image>
					<view v-else class="hero-cover hero-cover-placeholder">
						<text class="hero-cover-text">{{ pageTitleText }}</text>
					</view>
					<text class="topic-title">{{ title }}</text>
					<text class="topic-summary">{{ summary }}</text>
					<view class="meta-row">
						<text class="meta-text">{{ viewText }} {{ viewCount }}</text>
						<text class="meta-text">{{ favoriteText }} {{ favoriteCount }}</text>
						<text class="meta-text">{{ publishedAt }}</text>
					</view>
					<view class="tag-row">
						<text v-for="tag in tags" :key="tag" class="tag-item">{{ tag }}</text>
					</view>
					<view class="action-row">
						<view class="favorite-btn" @tap="toggleFavorite">
							<text class="favorite-btn-text">{{ isFavorited ? favoritedText : favoriteBtnText }}</text>
						</view>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">{{ requirementTitle }}</text>
					<text class="section-text">{{ learningRequirements }}</text>
				</view>

				<view class="section-card">
					<view class="section-head">
						<text class="section-title">{{ relatedTitle }}</text>
					</view>
					<text class="section-tip">{{ relatedSubtitle }}</text>
				</view>

				<view v-for="section in sections" :key="section.sectionType" class="section-card">
					<view class="section-head">
						<view class="section-title-wrap">
							<view class="section-icon"></view>
							<text class="section-title">{{ getSectionLabel(section) }}</text>
						</view>
						<text v-if="section.hasMore" class="section-more" @tap="goSectionPage(section)">{{ moreText }}</text>
					</view>

					<view v-if="section.previewItems.length == 0" class="empty-section">
						<text class="empty-section-text">{{ emptySectionText }}</text>
					</view>

					<scroll-view v-else class="resource-scroll" scroll-x="true" show-scrollbar="false">
						<view class="resource-row">
							<view
								v-for="item in section.previewItems"
								:key="section.sectionType + '-' + item.resourceId"
								class="resource-card"
								@tap="goResourceDetail(item)"
							>
								<image v-if="item.coverUrl.length > 0" class="resource-cover" :src="item.coverUrl" mode="aspectFill"></image>
								<view v-else class="resource-cover resource-cover-placeholder">
									<text class="resource-cover-text">{{ getResourceTypeLabel(item.resourceType) }}</text>
								</view>
								<text class="resource-title">{{ item.title }}</text>
								<text class="resource-subtitle">{{ item.subtitle.length > 0 ? item.subtitle : item.summary }}</text>
								<view class="resource-meta">
									<text class="resource-meta-text">{{ viewText }} {{ item.browseCount }}</text>
									<text class="resource-meta-text">{{ favoriteText }} {{ item.favoriteCount }}</text>
								</view>
							</view>
						</view>
					</scroll-view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { checkFavoriteStatus, fetchTopicDetailV2, fetchTopicSectionResources, reportBrowseHistory, updateFavoriteStatus, type TopicDetail, type TopicSection, type TopicSectionResource } from '../../utils/auth.uts'

const RESOURCE_TYPE = 'topic'
const KNOWLEDGE_DETAIL_ID_KEY = 'knowledge_detail_id'
const TOPIC_DETAIL_ID_KEY = 'topic_detail_id'

const pageTitleText = '\u4e13\u9898\u8be6\u60c5'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const requirementTitle = '\u5b66\u4e60\u8981\u6c42'
const relatedTitle = '\u76f8\u5173\u5185\u5bb9'
const relatedSubtitle = '\u4e3a\u4f60\u6574\u7406\u4e13\u9898\u5185\u7684\u8bfe\u7a0b\u3001\u89c6\u9891\u3001\u56fe\u4e66\u4e0e\u97f3\u9891\u8d44\u6e90'
const moreText = '\u66f4\u591a'
const emptySectionText = '\u6682\u65e0\u5185\u5bb9'
const favoriteBtnText = '\u6536\u85cf'
const favoritedText = '\u5df2\u6536\u85cf'
const viewText = '\u6d4f\u89c8'
const favoriteText = '\u6536\u85cf'

const topicId = ref('')
const title = ref('')
const summary = ref('')
const learningRequirements = ref('')
const coverUrl = ref('')
const viewCount = ref('0')
const favoriteCount = ref('0')
const publishedAt = ref('')
const tags = ref<string[]>([])
const sections = ref<TopicSection[]>([])
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)
const isLoading = ref(true)
const errorText = ref('')

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const formatDate = (value : string) : string => {
	const text = safeText(value)
	if (text.length == 0) {
		return ''
	}
	return text.replace('T', ' ').substring(0, 16)
}

const normalizeResourceType = (value : string) : string => {
	const type = safeText(value).toLowerCase()
	if (type == 'learning' || type == 'book') {
		return 'book'
	}
	if (type == 'video' || type == 'course') {
		return 'course'
	}
	if (type == 'audio' || type == 'podcast') {
		return 'podcast'
	}
	return type
}

const getSectionLabel = (section : TopicSection) : string => {
	const type = safeText(section.sectionType).toLowerCase()
	if (type == 'book' || type == 'learning') {
		return '\u56fe\u4e66'
	}
	if (type == 'video') {
		return '\u89c6\u9891'
	}
	if (type == 'course') {
		return '\u8bfe\u7a0b'
	}
	if (type == 'podcast' || type == 'audio') {
		return '\u97f3\u9891'
	}
	const label = safeText(section.sectionLabel)
	if (label.length > 0) {
		return label
	}
	return '\u5b66\u4e60'
}

const getResourceTypeLabel = (value : string) : string => {
	const type = normalizeResourceType(value)
	if (type == 'book') {
		return '\u56fe\u4e66'
	}
	if (type == 'course') {
		return '\u8bfe\u7a0b'
	}
	if (type == 'podcast') {
		return '\u97f3\u9891'
	}
	if (type == 'live') {
		return '\u76f4\u64ad'
	}
	return '\u8d44\u6e90'
}

const hydrateSections = () => {
	if (topicId.value.length == 0 || sections.value.length == 0) {
		return
	}

	sections.value.forEach((section : TopicSection, index : number) => {
		if (section.previewItems != null && section.previewItems.length > 0) {
			return
		}
		fetchTopicSectionResources(
			topicId.value,
			section.sectionType,
			1,
			6,
			(pageData) => {
				const records = pageData.records != null ? pageData.records : []
				const current = sections.value.slice()
				if (index >= current.length) {
					return
				}
				current[index] = {
					sectionType: current[index].sectionType,
					sectionLabel: current[index].sectionLabel,
					total: pageData.total > 0 ? pageData.total : records.length,
					hasMore: pageData.total > records.length || current[index].hasMore,
					previewItems: records
				}
				sections.value = current
			},
			() => {
			}
		)
	})
}

const loadParams = () => {
	const pages = getCurrentPages()
	if (pages.length == 0) {
		const cachedId = uni.getStorageSync(TOPIC_DETAIL_ID_KEY)
		if (typeof cachedId == 'string' && cachedId.length > 0) {
			topicId.value = cachedId
		}
		return
	}
	const current = pages[pages.length - 1]
	if (current == null || current.options == null) {
		const cachedId = uni.getStorageSync(TOPIC_DETAIL_ID_KEY)
		if (typeof cachedId == 'string' && cachedId.length > 0) {
			topicId.value = cachedId
		}
		return
	}
	const options = current.options as UTSJSONObject
	const idValue = options['id']
	if (typeof idValue == 'string' && idValue.length > 0) {
		topicId.value = idValue
		uni.setStorageSync(TOPIC_DETAIL_ID_KEY, topicId.value)
		return
	}
	const topicValue = options['topicId']
	if (typeof topicValue == 'string' && topicValue.length > 0) {
		topicId.value = topicValue
		uni.setStorageSync(TOPIC_DETAIL_ID_KEY, topicId.value)
		return
	}
	const cachedId = uni.getStorageSync(TOPIC_DETAIL_ID_KEY)
	if (typeof cachedId == 'string' && cachedId.length > 0) {
		topicId.value = cachedId
	}
}

const applyDetail = (detail : TopicDetail) => {
	title.value = safeText(detail.title)
	summary.value = safeText(detail.summary)
	learningRequirements.value = safeText(detail.learningRequirements)
	coverUrl.value = safeText(detail.coverUrl)
	viewCount.value = String(detail.viewCount)
	favoriteCount.value = String(detail.favoriteCount)
	publishedAt.value = formatDate(detail.publishedAt)
	tags.value = detail.tags != null ? detail.tags : []
	sections.value = detail.sections != null ? detail.sections : []
	hydrateSections()
}

const reportBrowse = () => {
	if (topicId.value.length == 0) {
		return
	}
	reportBrowseHistory(
		{
			resourceType: RESOURCE_TYPE,
			resourceId: Number(topicId.value)
		},
		() => {
		},
		() => {
		}
	)
}

const loadFavoriteStatus = () => {
	if (topicId.value.length == 0) {
		return
	}
	checkFavoriteStatus(
		RESOURCE_TYPE,
		Number(topicId.value),
		(favorited) => {
			isFavorited.value = favorited
		},
		() => {
			isFavorited.value = false
		}
	)
}

const loadDetail = () => {
	if (topicId.value.length == 0) {
		errorText.value = '\u7f3a\u5c11\u4e13\u9898 ID'
		isLoading.value = false
		return
	}
	isLoading.value = true
	errorText.value = ''
	fetchTopicDetailV2(
		topicId.value,
		(detail) => {
			applyDetail(detail)
			isLoading.value = false
			reportBrowse()
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '\u4e13\u9898\u8be6\u60c5\u52a0\u8f7d\u5931\u8d25'
			isLoading.value = false
		}
	)
}

const toggleFavorite = () => {
	if (topicId.value.length == 0 || isFavoriteLoading.value) {
		return
	}
	isFavoriteLoading.value = true
	updateFavoriteStatus(
		{
			resourceType: RESOURCE_TYPE,
			resourceId: Number(topicId.value),
			favorited: !isFavorited.value
		},
		(result) => {
			isFavoriteLoading.value = false
			isFavorited.value = result.favorited
			favoriteCount.value = String(result.favoriteCount)
			uni.showToast({
				title: result.favorited ? '\u6536\u85cf\u6210\u529f' : '\u5df2\u53d6\u6d88\u6536\u85cf',
				icon: 'none'
			})
		},
		(message) => {
			isFavoriteLoading.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

const goSectionPage = (section : TopicSection) => {
	uni.navigateTo({
		url: '/pages/topics/section?topicId=' + topicId.value + '&sectionType=' + encodeURIComponent(section.sectionType) + '&title=' + encodeURIComponent(section.sectionLabel)
	})
}

const goResourceDetail = (item : TopicSectionResource) => {
	const type = normalizeResourceType(item.resourceType)
	if (type == 'book') {
		if (item.resourceId <= 0) {
			uni.showToast({
				title: '\u7f3a\u5c11\u56fe\u4e66\u6761\u76ee ID',
				icon: 'none'
			})
			return
		}
		uni.setStorageSync(KNOWLEDGE_DETAIL_ID_KEY, String(item.resourceId))
		uni.navigateTo({ url: '/pages/knowledge/book-detail?id=' + String(item.resourceId) })
		return
	}
	if (type == 'course') {
		uni.navigateTo({ url: '/pages/course/detail?id=' + String(item.resourceId) })
		return
	}
	if (type == 'podcast') {
		uni.navigateTo({ url: '/pages/audio/detail?id=' + String(item.resourceId) })
		return
	}
	if (type == 'live') {
		uni.navigateTo({ url: '/pages/live/detail?id=' + String(item.resourceId) })
	}
}

const goBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack({ delta: 1 })
		return
	}
	uni.redirectTo({ url: '/pages/topics/list' })
}

loadParams()
loadDetail()

onShow(() => {
	loadFavoriteStatus()
})
</script>

<style>
