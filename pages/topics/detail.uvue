	margin-top: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}

.meta-text {
	margin-right: 16rpx;
	margin-bottom: 8rpx;
	font-size: 12px;
	line-height: 18px;
	color: #9c9c9c;
}

