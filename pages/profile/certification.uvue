<template>
	<view class="page">
		<view class="nav-back" @click="handleBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">学员认证</text>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<view class="status-card">
				<text class="status-label">认证状态</text>
				<text class="status-value" :class="certificationStatusClass">{{ certificationStatusText }}</text>
			</view>

			<view v-if="rejectReason != ''" class="reject-card">
				<text class="reject-title">驳回原因</text>
				<text class="reject-text">{{ rejectReason }}</text>
			</view>

			<view class="form-card">
				<view class="form-row">
					<text class="row-label">真实姓名</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.realName" placeholder="请输入真实姓名" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">手机号</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" type="number" maxlength="11" v-model="form.mobile" placeholder="请输入手机号" @input="handlePhoneInput" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">身份证号</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.idCardNo" placeholder="请输入身份证号" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">省份</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.province" placeholder="请输入省份" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">城市</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.city" placeholder="请输入城市" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">区县</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.district" placeholder="请输入区县" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">工作单位</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.organization" placeholder="请输入工作单位" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">职称/执业类别</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.positionTitle" placeholder="请输入职称或执业类别" />
					</view>
				</view>

				<view class="material-row">
					<text class="row-label">认证材料</text>
					<textarea class="material-textarea" v-model="form.certificationMaterials" placeholder="请填写认证材料说明或材料地址"></textarea>
				</view>
			</view>

			<view class="actions">
				<button class="save-btn" hover-class="save-btn-hover" @click="handleSubmit" :disabled="isSaving">
					{{ isSaving ? '提交中...' : '提交认证' }}
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import {
	fetchCertificationStatus,
	submitCertification
} from '../../utils/auth.uts'

type CertificationForm = {
	realName : string
	mobile : string
	idCardNo : string
	province : string
	city : string
	district : string
	organization : string
	positionTitle : string
	certificationMaterials : string
}

const isSaving = ref(false)
const rejectReason = ref('')
const certificationStatus = ref('0')

const form = ref<CertificationForm>({
	realName: '',
	mobile: '',
	idCardNo: '',
	province: '',
	city: '',
	district: '',
	organization: '',
	positionTitle: '',
	certificationMaterials: ''
})

const certificationStatusText = computed(() : string => {
	if (certificationStatus.value == '2') {
		return '已认证'
	}
	if (certificationStatus.value == '1') {
		return '待审核'
	}
	if (certificationStatus.value == '3') {
		return '已驳回'
	}
	return '未提交'
})

const certificationStatusClass = computed(() : string => {
	if (certificationStatus.value == '2') {
		return 'status-on'
	}
	if (certificationStatus.value == '1') {
		return 'status-pending'
	}
	if (certificationStatus.value == '3') {
		return 'status-reject'
	}
	return 'status-off'
})

const digitsOnly = (value : string) : string => {
	return value.replace(/[^0-9]/g, '')
}

const isValidPhone = (value : string) : boolean => {
	return value == '' || /^1\d{10}$/.test(value)
}

const handlePhoneInput = () => {
	form.value.mobile = digitsOnly(form.value.mobile).slice(0, 11)
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/index'
	})
}

const applyCertificationData = (data : UTSJSONObject) => {
	form.value.realName = (data['realName'] as string) || form.value.realName
	form.value.mobile = (data['mobile'] as string) || form.value.mobile
	form.value.province = (data['province'] as string) || form.value.province
	form.value.city = (data['city'] as string) || form.value.city
	form.value.district = (data['district'] as string) || form.value.district
	form.value.organization = (data['organization'] as string) || form.value.organization
	form.value.positionTitle = (data['positionTitle'] as string) || form.value.positionTitle
	form.value.certificationMaterials = (data['certificationMaterials'] as string) || form.value.certificationMaterials
	certificationStatus.value = (data['certificationStatus'] as string) || certificationStatus.value
	rejectReason.value = (data['rejectReason'] as string) || ''
}

const loadCertification = () => {
	fetchCertificationStatus(
		(data) => {
			applyCertificationData(data as UTSJSONObject)
		},
		() => {}
	)
}

const handleSubmit = () => {
	if (isSaving.value) {
		return
	}

	handlePhoneInput()

	if (form.value.realName == '') {
		uni.showToast({
			title: '请输入真实姓名',
			icon: 'none'
		})
		return
	}

	if (!isValidPhone(form.value.mobile)) {
		uni.showToast({
			title: '手机号格式不正确',
			icon: 'none'
		})
		return
	}

	isSaving.value = true

	submitCertification(
		{
			realName: form.value.realName,
			mobile: form.value.mobile,
			idCardNo: form.value.idCardNo,
			province: form.value.province,
			city: form.value.city,
			district: form.value.district,
			organization: form.value.organization,
			positionTitle: form.value.positionTitle,
			certificationMaterials: form.value.certificationMaterials
		},
		(result) => {
			isSaving.value = false
			applyCertificationData(result as UTSJSONObject)
			uni.showToast({
				title: '提交成功',
				icon: 'success'
			})
		},
		(message) => {
			isSaving.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

loadCertification()
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5fb;
	position: relative;
}

.nav-back {
	position: absolute;
	top: 74rpx;
	left: 12rpx;
	width: 56rpx;
	height: 56rpx;
	align-items: center;
	justify-content: center;
	z-index: 2;
}

.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}

.header {
	padding-top: 78rpx;
	align-items: center;
}

.header-title {
	font-size: 19px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 600;
}

.form-scroll {
	flex: 1;
	padding-top: 30rpx;
}

.status-card,
.reject-card,
.form-card {
	margin-left: 12rpx;
	margin-right: 12rpx;
	background-color: #ffffff;
}

.status-card,
.reject-card {
	margin-bottom: 16rpx;
	padding: 22rpx 24rpx;
	border-radius: 12rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.reject-card {
	flex-direction: column;
	align-items: flex-start;
}

.status-label,
.reject-title {
	font-size: 16px;
	line-height: 24px;
	color: #222222;
	font-weight: 600;
}

.status-value {
	font-size: 14px;
	line-height: 22px;
}

.status-on {
	color: #10b66d;
}

.status-pending {
	color: #f0a330;
}

.status-reject {
	color: #d65f5f;
}

.status-off {
	color: #9a9a9a;
}

.reject-text {
	margin-top: 10rpx;
	font-size: 14px;
	line-height: 22px;
	color: #8b8b8b;
}

.form-row {
	min-height: 98rpx;
	padding-left: 24rpx;
	padding-right: 18rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f5;
}

.material-row {
	padding: 24rpx;
	border-bottom-width: 0;
}

.row-label {
	font-size: 18px;
	line-height: 26px;
	color: #222222;
	font-weight: 600;
}

.row-right {
	flex-direction: row;
	align-items: center;
	max-width: 430rpx;
}

.row-input-wrap {
	flex: 1;
	justify-content: flex-end;
}

.row-input {
	flex: 1;
	height: 52rpx;
	font-size: 16px;
	color: #8f8f8f;
	text-align: right;
	padding-left: 0;
	padding-right: 8rpx;
	background-color: transparent;
}

.material-textarea {
	margin-top: 18rpx;
	width: 100%;
	min-height: 180rpx;
	font-size: 15px;
	line-height: 24px;
	color: #8f8f8f;
	background-color: #f7f7fb;
	border-radius: 12rpx;
	padding: 18rpx;
	box-sizing: border-box;
}

.actions {
	margin-top: 34rpx;
	margin-left: 20rpx;
	margin-right: 20rpx;
	padding-bottom: 100rpx;
}

.save-btn {
	height: 86rpx;
	line-height: 86rpx;
	background-color: #10b66d;
	color: #ffffff;
	font-size: 18px;
	font-weight: 600;
	border-radius: 12rpx;
	border-width: 0;
}

.save-btn[disabled] {
	opacity: 0.76;
}

.save-btn-hover {
	opacity: 0.92;
}
</style>
