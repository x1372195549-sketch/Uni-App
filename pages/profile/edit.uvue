<template>
	<view class="page">
		<view class="nav-back" @click="handleBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">个人资料</text>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<view class="form-card">
				<view class="form-row avatar-row" @click="handleChooseAvatar">
					<text class="row-label">头像</text>
					<view class="row-right">
						<image class="avatar" :src="form.avatarUrl || defaultAvatar" mode="aspectFill"></image>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">昵称</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.nickname" placeholder="请输入昵称" />
					</view>
				</view>

				<view class="form-row" @click="handleChooseGender">
					<text class="row-label">性别</text>
					<view class="row-right">
						<text class="row-value">{{ form.gender || '请选择性别' }}</text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">邮箱</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.email" placeholder="请输入邮箱" />
					</view>
				</view>

				<view class="form-row signature-row">
					<text class="row-label">个性签名</text>
					<view class="row-right row-input-wrap">
						<textarea class="row-textarea" v-model="form.profileSignature" placeholder="请输入个性签名"></textarea>
					</view>
				</view>
			</view>

			<view class="actions">
				<button class="save-btn" hover-class="save-btn-hover" @click="handleSave" :disabled="isSaving">
					{{ isSaving ? '保存中...' : '保存' }}
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import {
	fetchProfile,
	updateProfile,
	normalizeAppUrl,
	requestAvatarUploadUrl,
	uploadAvatarBinaryFile,
	confirmAvatarUpload
} from '../../utils/auth.uts'

type ProfileForm = {
	avatarUrl : string
	nickname : string
	gender : string
	email : string
	profileSignature : string
}

type AvatarMeta = {
	originalName : string
	contentType : string
	fileSize : number
}

const storageKey = 'profile_edit_form'
const genderOptions = ['男', '女']
const defaultAvatar = '/static/mine/avatar.png'
const isSaving = ref(false)
const pendingAvatarPath = ref('')
const pendingAvatarMeta = ref<AvatarMeta | null>(null)

const form = ref<ProfileForm>({
	avatarUrl: defaultAvatar,
	nickname: '',
	gender: '',
	email: '',
	profileSignature: ''
})

const genderMap : UTSJSONObject = {
	'男': '1',
	'女': '2'
}

const genderReverseMap : UTSJSONObject = {
	'1': '男',
	'2': '女'
}

const getFileNameFromPath = (filePath : string) : string => {
	if (filePath == null || filePath == '') {
		return 'avatar.jpg'
	}
	const normalizedPath = filePath.replace(/\\/g, '/')
	const parts = normalizedPath.split('/')
	if (parts.length > 0) {
		const last = parts[parts.length - 1]
		if (last != null && last != '') {
			return last
		}
	}
	return 'avatar.jpg'
}

const getContentTypeFromFileName = (fileName : string) : string => {
	const lower = fileName.toLowerCase()
	if (lower.endsWith('.png')) {
		return 'image/png'
	}
	if (lower.endsWith('.webp')) {
		return 'image/webp'
	}
	return 'image/jpeg'
}

const isSupportedAvatarContentType = (contentType : string) : boolean => {
	return contentType == 'image/jpeg'
		|| contentType == 'image/png'
		|| contentType == 'image/webp'
}

const buildAvatarMeta = (filePath : string, fileSize : number) : AvatarMeta => {
	const originalName = getFileNameFromPath(filePath)
	return {
		originalName,
		contentType: getContentTypeFromFileName(originalName),
		fileSize: fileSize > 0 ? fileSize : 1024
	}
}

const saveProfileLocal = () => {
	uni.setStorageSync(storageKey, form.value)
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/index'
	})
}

const loadProfile = () => {
	const cached = uni.getStorageSync(storageKey)
	if (cached != null && cached != '') {
		form.value = cached as ProfileForm
	}

	fetchProfile(
		(profile) => {
			form.value.nickname = profile.nickname || form.value.nickname
			form.value.avatarUrl = normalizeAppUrl(profile.avatarUrl) || form.value.avatarUrl
			form.value.email = profile.email || form.value.email
			form.value.profileSignature = profile.profileSignature || form.value.profileSignature
			const mappedGender = genderReverseMap[profile.gender] as string
			if (mappedGender != null && mappedGender != '') {
				form.value.gender = mappedGender
			}
			pendingAvatarPath.value = ''
			pendingAvatarMeta.value = null
			saveProfileLocal()
		},
		() => {}
	)
}

const handleChooseAvatar = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res) => {
			if (res.tempFilePaths == null || res.tempFilePaths.length == 0) {
				return
			}

			const filePath = res.tempFilePaths[0]
			const tempFile = res.tempFiles != null && res.tempFiles.length > 0 ? res.tempFiles[0] : null
			const fileSize = tempFile != null ? tempFile.size : 0
			const avatarMeta = buildAvatarMeta(filePath, fileSize)

			if (!isSupportedAvatarContentType(avatarMeta.contentType)) {
				uni.showToast({
					title: '仅支持 JPG、PNG、WEBP',
					icon: 'none'
				})
				return
			}

			if (avatarMeta.fileSize > 5 * 1024 * 1024) {
				uni.showToast({
					title: '头像不能超过 5MB',
					icon: 'none'
				})
				return
			}

			form.value.avatarUrl = filePath
			pendingAvatarPath.value = filePath
			pendingAvatarMeta.value = avatarMeta
		}
	})
}

const handleChooseGender = () => {
	uni.showActionSheet({
		itemList: genderOptions,
		success: (res) => {
			form.value.gender = genderOptions[res.tapIndex]
		}
	})
}

const uploadAvatarIfNeeded = (
	success : (remoteAvatarUrl : string, didUploadAvatar : boolean) => void,
	fail : (message : string) => void
) => {
	if (pendingAvatarPath.value == '') {
		success(form.value.avatarUrl || '', false)
		return
	}

	const meta = pendingAvatarMeta.value
	if (meta == null) {
		fail('头像文件信息缺失')
		return
	}

	requestAvatarUploadUrl(
		{
			originalName: meta.originalName,
			contentType: meta.contentType,
			fileSize: meta.fileSize
		},
		(uploadConfig) => {
			uploadAvatarBinaryFile(
				pendingAvatarPath.value,
				uploadConfig,
				{
					contentType: meta.contentType
				},
				() => {
					confirmAvatarUpload(
						{
							objectKey: uploadConfig.objectKey,
							originalName: meta.originalName
						},
						(result) => {
							const remoteAvatarUrl = normalizeAppUrl(result.avatarUrl || uploadConfig.publicUrl)
							if (remoteAvatarUrl == '') {
								fail('头像上传成功，但未返回地址')
								return
							}
							form.value.avatarUrl = remoteAvatarUrl
							pendingAvatarPath.value = ''
							pendingAvatarMeta.value = null
							success(remoteAvatarUrl, true)
						},
						(message) => {
							fail(message || '头像上传确认失败')
						}
					)
				},
				(message) => {
					fail(message || '头像文件上传失败')
				}
			)
		},
		(message) => {
			fail(message || '获取头像上传地址失败')
		}
	)
}

const handleSave = () => {
	if (isSaving.value) {
		return
	}

	isSaving.value = true

	uploadAvatarIfNeeded(
		(remoteAvatarUrl, didUploadAvatar) => {
			const genderCode = (genderMap[form.value.gender] as string) || ''
			updateProfile(
				{
					nickname: form.value.nickname,
					profileSignature: form.value.profileSignature,
					email: form.value.email,
					gender: genderCode
				},
				() => {
					if (didUploadAvatar && remoteAvatarUrl != '') {
						fetchProfile(
							(profile) => {
								form.value.avatarUrl = normalizeAppUrl(profile.avatarUrl) || remoteAvatarUrl
								saveProfileLocal()
								isSaving.value = false
								if (form.value.avatarUrl == remoteAvatarUrl) {
									uni.showToast({
										title: '头像保存成功',
										icon: 'success'
									})
									return
								}
								uni.showToast({
									title: '头像已上传，但资料未同步',
									icon: 'none'
								})
							},
							() => {
								saveProfileLocal()
								isSaving.value = false
								uni.showToast({
									title: '已保存，头像状态待确认',
									icon: 'none'
								})
							}
						)
						return
					}

					saveProfileLocal()
					isSaving.value = false
					uni.showToast({
						title: '保存成功',
						icon: 'success'
					})
				},
				(message) => {
					isSaving.value = false
					uni.showToast({
						title: message,
						icon: 'none'
					})
				}
			)
		},
		(message) => {
			isSaving.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

loadProfile()
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5fb;
	position: relative;
}

.nav-back {
	position: absolute;
	top: 74rpx;
	left: 12rpx;
	width: 56rpx;
	height: 56rpx;
	align-items: center;
	justify-content: center;
	z-index: 2;
}

.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}

.header {
	padding-top: 78rpx;
	align-items: center;
}

.header-title {
	font-size: 19px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 600;
}

.form-scroll {
	flex: 1;
	padding-top: 30rpx;
}

.form-card {
	margin-left: 12rpx;
	margin-right: 12rpx;
	background-color: #ffffff;
}

.form-row {
	min-height: 98rpx;
	padding-left: 24rpx;
	padding-right: 18rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f5;
}

.form-row:last-child {
	border-bottom-width: 0;
}

.avatar-row {
	min-height: 118rpx;
}

.row-label {
	font-size: 20px;
	line-height: 28px;
	color: #222222;
	font-weight: 600;
}

.row-right {
	flex-direction: row;
	align-items: center;
	max-width: 430rpx;
}

.row-input-wrap {
	flex: 1;
	justify-content: flex-end;
}

.avatar {
	width: 84rpx;
	height: 84rpx;
	border-radius: 42rpx;
	margin-right: 16rpx;
}

.row-value {
	font-size: 18px;
	line-height: 26px;
	color: #a8a8a8;
	text-align: right;
}

.row-input {
	flex: 1;
	height: 52rpx;
	font-size: 18px;
	color: #8f8f8f;
	text-align: right;
	padding-left: 0;
	padding-right: 8rpx;
	background-color: transparent;
}

.signature-row {
	align-items: flex-start;
	padding-top: 24rpx;
	padding-bottom: 24rpx;
}

.row-textarea {
	width: 320rpx;
	min-height: 120rpx;
	font-size: 16px;
	line-height: 24px;
	color: #8f8f8f;
	text-align: left;
	background-color: #f7f7fb;
	border-radius: 12rpx;
	padding: 16rpx;
	box-sizing: border-box;
}

.actions {
	margin-top: 34rpx;
	margin-left: 20rpx;
	margin-right: 20rpx;
	padding-bottom: 180rpx;
}

.save-btn {
	height: 86rpx;
	line-height: 86rpx;
	background-color: #10b66d;
	color: #ffffff;
	font-size: 18px;
	font-weight: 600;
	border-radius: 12rpx;
	border-width: 0;
}

.save-btn[disabled] {
	opacity: 0.76;
}

.save-btn-hover {
	opacity: 0.92;
}
</style>
