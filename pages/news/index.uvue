<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

			<view class="header">
				<text class="header-title">{{ appTitleText }}</text>
			</view>

			<view class="top-tabs">
				<view class="top-tab" @tap="goLearningPage">
					<text class="top-tab-text">{{ homeTabText }}</text>
				</view>
				<view class="top-tab" @tap="goAudioPage">
					<text class="top-tab-text">{{ audioTabText }}</text>
				</view>
				<view class="top-tab" @tap="goCoursePage">
					<text class="top-tab-text">{{ courseTabText }}</text>
				</view>
				<view class="top-tab" @tap="goLivePage">
					<text class="top-tab-text">{{ liveTabText }}</text>
				</view>
				<view class="top-tab" @tap="goBookPage">
					<text class="top-tab-text">{{ bookTabText }}</text>
				</view>
				<view class="top-tab" @tap="goTopicsPage">
					<text class="top-tab-text">{{ topicTabText }}</text>
				</view>
				<view class="top-tab top-tab-active">
					<text class="top-tab-text top-tab-text-active">{{ newsTabText }}</text>
					<view class="top-tab-line"></view>
				</view>
			</view>
		</view>

		<view class="search-bar">
			<input
				v-model="keyword"
				class="search-input"
				:placeholder="searchPlaceholder"
				confirm-type="search"
				@confirm="reloadList"
			/>
			<view class="search-btn" @tap="reloadList">
				<text class="search-btn-text">{{ searchText }}</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" @scrolltolower="loadMore">
			<view class="content-shell">
				<view v-if="isLoading" class="state-wrap">
					<text class="state-text">{{ loadingText }}</text>
				</view>

				<view v-else-if="errorText.length > 0" class="state-wrap">
					<text class="state-text">{{ errorText }}</text>
					<view class="retry-btn" @tap="reloadList">
						<text class="retry-btn-text">{{ retryText }}</text>
					</view>
				</view>

				<view v-else-if="articleItems.length == 0" class="state-wrap">
					<text class="state-text">{{ emptyText }}</text>
				</view>

				<view v-else class="article-list">
					<view
						v-for="item in articleItems"
						:key="item.id"
						class="article-card"
						@tap="goNewsDetail(item.id)"
					>
						<image v-if="item.coverUrl.length > 0" class="article-cover" :src="item.coverUrl" mode="aspectFill"></image>
						<view v-else class="article-cover article-cover-placeholder">
							<text class="article-cover-text">NEWS</text>
						</view>

						<view class="article-main">
							<text class="article-title">{{ item.title }}</text>
							<text class="article-summary">{{ item.summary }}</text>
							<view class="article-tags">
								<text v-for="tag in item.tags" :key="tag" class="article-tag">{{ tag }}</text>
							</view>
							<view class="article-meta">
								<text class="article-meta-text">{{ item.source }}</text>
								<text class="article-meta-text">{{ item.publishedAt }}</text>
								<text class="article-meta-text">{{ viewText }} {{ item.viewCount }}</text>
							</view>
						</view>
					</view>

					<view v-if="isListLoading" class="bottom-state">
						<text class="bottom-state-text">{{ loadingMoreText }}</text>
					</view>
					<view v-else-if="!hasMore" class="bottom-state">
						<text class="bottom-state-text">{{ noMoreText }}</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="tabbar">
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">{{ learningTabText }}</text>
			</view>
			<view class="tab-item" @tap="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ examTabText }}</text>
			</view>
			<view class="tab-item" @tap="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">{{ consultTabText }}</text>
			</view>
			<view class="tab-item" @tap="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ knowledgeTabText }}</text>
			</view>
			<view class="tab-item" @tap="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ mineTabText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { fetchArticles, type Article } from '../../utils/auth.uts'

type ArticleCard = {
	id : number
	title : string
	summary : string
	coverUrl : string
	source : string
	publishedAt : string
	viewCount : number
	tags : string[]
}

const PAGE_SIZE = 10

const appTitleText = '\u6c5f\u82cf\u4e2d\u533b\u5728\u7ebf'
const homeTabText = '\u9996\u9875'
const topicTabText = '\u4e13\u9898'
const bookTabText = '\u56fe\u4e66'
const audioTabText = '\u97f3\u9891'
const liveTabText = '\u76f4\u64ad'
const courseTabText = '\u8bfe\u7a0b'
const newsTabText = '\u8d44\u8baf'
const learningTabText = '\u5b66\u4e60'
const examTabText = '\u8003\u6838'
const consultTabText = '\u54a8\u8be2'
const knowledgeTabText = '\u77e5\u8bc6\u5e93'
const mineTabText = '\u6211\u7684'
const searchPlaceholder = '\u641c\u7d22\u6807\u9898\u3001\u6765\u6e90\u6216\u6458\u8981'
const searchText = '\u641c\u7d22'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const emptyText = '\u6682\u65e0\u8d44\u8baf'
const loadingMoreText = '\u52a0\u8f7d\u66f4\u591a\u4e2d...'
const noMoreText = '\u6ca1\u6709\u66f4\u591a\u4e86'
const loadFailedText = '\u8d44\u8baf\u52a0\u8f7d\u5931\u8d25'
const viewText = '\u6d4f\u89c8'
const fallbackSummaryText = '\u6682\u65e0\u6458\u8981'

const keyword = ref('')
const articleItems = ref<ArticleCard[]>([])
const page = ref(1)
const hasMore = ref(true)
const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const formatDate = (value : string) : string => {
	const text = safeText(value)
	if (text.length == 0) {
		return ''
	}
	return text.replace('T', ' ').substring(0, 16)
}

const mapArticle = (item : Article) : ArticleCard => {
	return {
		id: item.id,
		title: safeText(item.title),
		summary: safeText(item.summary).length > 0 ? safeText(item.summary) : fallbackSummaryText,
		coverUrl: safeText(item.coverUrl),
		source: safeText(item.source),
		publishedAt: formatDate(item.publishedAt),
		viewCount: item.viewCount,
		tags: item.tags != null ? item.tags.slice(0, 2) : []
	}
}

const loadArticles = (loadMoreValue : boolean) => {
	if (!loadMoreValue) {
		page.value = 1
		hasMore.value = true
		errorText.value = ''
		isLoading.value = true
	} else {
		if (!hasMore.value || isListLoading.value) {
			return
		}
		isListLoading.value = true
	}

	fetchArticles(
		page.value,
		PAGE_SIZE,
		keyword.value,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			const mapped = records.map((item : Article) : ArticleCard => {
				return mapArticle(item)
			})

			if (loadMoreValue) {
				articleItems.value = articleItems.value.concat(mapped)
			} else {
				articleItems.value = mapped
			}

			hasMore.value = mapped.length >= PAGE_SIZE
			if (hasMore.value) {
				page.value += 1
			}

			isLoading.value = false
			isListLoading.value = false
		},
		(message) => {
			errorText.value = message.length > 0 ? message : loadFailedText
			isLoading.value = false
			isListLoading.value = false
		}
	)
}

const reloadList = () => {
	loadArticles(false)
}

const loadMore = () => {
	loadArticles(true)
}

const goLearningPage = () => {
	uni.redirectTo({ url: '/pages/index/index' })
}

const goTopicsPage = () => {
	uni.redirectTo({ url: '/pages/topics/list' })
}

const goBookPage = () => {
	uni.redirectTo({ url: '/pages/book/index' })
}

const goAudioPage = () => {
	uni.redirectTo({ url: '/pages/audio/index' })
}

const goLivePage = () => {
	uni.redirectTo({ url: '/pages/live/index' })
}

const goCoursePage = () => {
	uni.redirectTo({ url: '/pages/course/index' })
}

const goMinePage = () => {
	uni.redirectTo({ url: '/pages/mine/index' })
}

const goExamPage = () => {
	uni.redirectTo({ url: '/pages/exam/index' })
}

const goNewsDetail = (id : number) => {
	uni.setStorageSync('article_detail_id', String(id))
	uni.navigateTo({ url: '/pages/news/detail?id=' + String(id) })
}

const goKnowledgePage = () => {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goConsultPage = () => {
	uni.redirectTo({ url: '/pages/consult/index' })
}

loadArticles(false)
</script>

<style>
