	margin-bottom: 18rpx;
	padding: 16rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	flex-direction: row;
	box-shadow: 0 8rpx 24rpx rgba(110, 100, 80, 0.05);
}

.article-cover {
	width: 156rpx;
	height: 156rpx;
	border-radius: 16rpx;
	background-color: #f3e6d6;
}

.article-cover-placeholder {
	align-items: center;
	justify-content: center;
}

.article-cover-text {
	font-size: 18px;
	color: #c88a54;
