	color: #8f8f8f;
	height: 54rpx;
	overflow: hidden;
}

.article-tags {
	margin-top: 10rpx;
	flex-direction: row;
	flex-wrap: wrap;
}

.article-tag {
	margin-right: 10rpx;
	margin-bottom: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
