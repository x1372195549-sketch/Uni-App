<template>
  <view class="page">
    <view class="header">
      <view class="back-btn" @click="goBack">
        <image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
      </view>
      <text class="header-title">详情</text>
    </view>

    <scroll-view class="content" scroll-y="true">
      <view class="hero">
        <view class="hero-mask"></view>
        <view class="paper-outer">
          <view class="paper-line"></view>
          <view class="paper-line"></view>
          <view class="paper-line"></view>
        </view>
      </view>

      <view class="tabs">
        <view class="tab-item" @click="activeTab = 'intro'">
          <text :class="activeTab == 'intro' ? 'tab-text tab-text-active' : 'tab-text'">简介</text>
          <view v-if="activeTab == 'intro'" class="tab-line"></view>
        </view>
        <view class="tab-item" @click="activeTab = 'catalog'">
          <text :class="activeTab == 'catalog' ? 'tab-text tab-text-active' : 'tab-text'">目录</text>
          <view v-if="activeTab == 'catalog'" class="tab-line"></view>
        </view>
        <view class="favorite-tab-btn" @click="toggleFavorite">
          <text class="favorite-text" :class="isFavorited ? 'favorite-text-active' : ''">{{ isFavorited ? '已收藏' : '收藏' }}</text>
        </view>
      </view>

      <view v-if="activeTab == 'intro'" class="intro-panel">
        <text class="media-title">{{ topicTitle }}</text>

        <view class="stats-row">
          <text class="stats-text">浏览 {{ topicViews }}</text>
          <text class="stats-text">收藏 {{ topicFavoriteCount }}</text>
        </view>

        <text class="section-title">资讯介绍</text>
        <text class="intro-text">{{ topicIntro }}</text>
      </view>

      <view v-else class="catalog-panel">
        <view v-for="item in catalogItems" :key="item.id" class="catalog-row catalog-row-active">
          <text class="catalog-title">{{ item.title }}</text>
          <text class="catalog-duration">{{ item.duration }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import {
  checkFavoriteStatus,
  fetchTopicDetail,
  updateFavoriteStatus,
  type Topic,
  type TopicItem
} from '../../utils/auth.uts'

type CatalogItem = {
  id : string
  title : string
  duration : string
}

const RESOURCE_TYPE = 'topic'

const topicId = ref('')
const activeTab = ref('intro')
const topicTitle = ref('资讯详情')
const topicViews = ref('0')
const topicFavoriteCount = ref('0')
const topicIntro = ref('这里展示专题简介、学习要求和补充说明。')
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)
const catalogItems = ref<CatalogItem[]>([])

function safeText(value : string | null) : string {
  return value == null || value.length == 0 ? '' : value
}

function loadFavoriteStatus() : void {
  if (topicId.value.length == 0) {
    return
  }

  checkFavoriteStatus(
    RESOURCE_TYPE,
    Number(topicId.value),
    (favorited) => {
      isFavorited.value = favorited
    },
    () => {
      isFavorited.value = false
    }
  )
}

function toggleFavorite() : void {
  if (topicId.value.length == 0 || isFavoriteLoading.value) {
    return
  }

  isFavoriteLoading.value = true
  updateFavoriteStatus(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(topicId.value),
      favorited: !isFavorited.value
    },
    (result) => {
      isFavorited.value = result.favorited
      topicFavoriteCount.value = String(result.favoriteCount != null ? result.favoriteCount : 0)
      isFavoriteLoading.value = false
      uni.showToast({
        title: result.favorited ? '收藏成功' : '已取消收藏',
        icon: 'success'
      })
    },
    (message) => {
      isFavoriteLoading.value = false
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

function applyTopicDetail(detail : Topic) : void {
  const titleText = safeText(detail.title)
  if (titleText.length > 0) {
    topicTitle.value = titleText
  }

  const introText = safeText(detail.learningRequirements).length > 0
    ? safeText(detail.learningRequirements)
    : safeText(detail.summary)
  if (introText.length > 0) {
    topicIntro.value = introText
  }

  topicViews.value = String(detail.viewCount != null ? detail.viewCount : 0)

  if (detail.items != null && detail.items.length > 0) {
    catalogItems.value = detail.items.map((item : TopicItem, index : number) : CatalogItem => {
      const itemType = safeText(item.itemType)
      return {
        id: String(item.id),
        title: itemType.length > 0 ? itemType + ' ' + String(index + 1) : '条目 ' + String(index + 1),
        duration: ''
      }
    })
  } else {
    catalogItems.value = []
  }
}

function goBack() : void {
  uni.navigateBack()
}

function loadParams() : void {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    return
  }

  const current = pages[pages.length - 1]
  if (current == null || current.options == null) {
    return
  }

  const options = current.options as UTSJSONObject
  const idValue = options['id']
  const tabValue = options['tab']
  if (typeof idValue == 'string' && idValue.length > 0) {
    topicId.value = idValue
  }
  if (typeof tabValue == 'string' && tabValue.length > 0) {
    activeTab.value = tabValue
  }
}

function loadTopicDetail() : void {
  if (topicId.value.length == 0) {
    return
  }

  fetchTopicDetail(
    topicId.value,
    (detail) => {
      applyTopicDetail(detail)
    },
    (message) => {
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

onMounted(() => {
  loadParams()
  loadTopicDetail()
  loadFavoriteStatus()
})

onShow(() => {
  loadFavoriteStatus()
})
</script>

