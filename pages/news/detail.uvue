<template>
	<view class="page">
		<view class="header">
			<view class="back-btn" @tap="goBack">
				<image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">{{ detailTitleText }}</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="detail-body">
				<view class="hero-card">
					<image v-if="coverUrl.length > 0" class="hero-cover" :src="coverUrl" mode="aspectFill"></image>
					<view v-else class="hero-cover hero-cover-placeholder">
						<text class="hero-cover-text">NEWS</text>
					</view>
					<text class="news-title">{{ title }}</text>
					<view class="meta-row">
						<text class="meta-text">{{ source }}</text>
						<text class="meta-text">{{ publishedAt }}</text>
						<text class="meta-text">{{ viewText }} {{ viewCount }}</text>
						<view class="favorite-btn favorite-btn-meta" @tap="toggleFavorite">
							<text class="favorite-btn-text">{{ isFavorited ? favoritedText : favoriteBtnText }}</text>
						</view>
					</view>
					<view class="tag-row">
						<text v-for="tag in tags" :key="tag" class="tag-item">{{ tag }}</text>
					</view>
				</view>

				<view v-if="summary.length > 0" class="section-card">
					<text class="section-title">{{ summaryTitle }}</text>
					<text class="section-text">{{ summary }}</text>
				</view>

				<view class="section-card">
					<text class="section-title">{{ contentTitle }}</text>
					<rich-text v-if="isHtmlContent" class="rich-content" :nodes="content"></rich-text>
					<text v-else class="section-text">{{ content }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onLoad, onShow } from '@dcloudio/uni-app'
import { checkFavoriteStatus, fetchArticleDetail, reportBrowseHistory, updateFavoriteStatus, type Article } from '../../utils/auth.uts'

const PRIMARY_RESOURCE_TYPE = 'article'

const detailTitleText = '\u8d44\u8baf\u8be6\u60c5'
const summaryTitle = '\u6458\u8981'
const contentTitle = '\u6b63\u6587'
const favoriteBtnText = '\u6536\u85cf'
const favoritedText = '\u5df2\u6536\u85cf'
const viewText = '\u6d4f\u89c8'

const articleId = ref('')
const title = ref('')
const summary = ref('')
const content = ref('')
const coverUrl = ref('')
const source = ref('')
const publishedAt = ref('')
const viewCount = ref('0')
const tags = ref<string[]>([])
const isHtmlContent = ref(false)
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const formatDate = (value : string) : string => {
	const text = safeText(value)
	if (text.length == 0) {
		return ''
	}
	return text.replace('T', ' ').substring(0, 16)
}

const detectHtml = (value : string) : boolean => {
	return value.indexOf('<p') >= 0 || value.indexOf('<div') >= 0 || value.indexOf('<br') >= 0
}

const readArticleIdFromStorage = () : string => {
	const cachedId = uni.getStorageSync('article_detail_id')
	return typeof cachedId == 'string' ? cachedId : ''
}

const resolveArticleId = (options : UTSJSONObject | null) => {
	let resolvedId = ''
	if (options != null) {
		const idValue = options['id']
		if (typeof idValue == 'string' && idValue.length > 0) {
			resolvedId = idValue
		}
		if (resolvedId.length == 0) {
			const articleIdValue = options['articleId']
			if (typeof articleIdValue == 'string' && articleIdValue.length > 0) {
				resolvedId = articleIdValue
			}
		}
	}
	if (resolvedId.length == 0) {
		resolvedId = readArticleIdFromStorage()
	}
	if (resolvedId.length > 0) {
		articleId.value = resolvedId
		uni.setStorageSync('article_detail_id', resolvedId)
	}
}

const applyDetail = (detail : Article) => {
	title.value = safeText(detail.title)
	summary.value = safeText(detail.summary)
	content.value = safeText(detail.content)
	coverUrl.value = safeText(detail.coverUrl)
	source.value = safeText(detail.source)
	publishedAt.value = formatDate(detail.publishedAt)
	viewCount.value = String(detail.viewCount)
	tags.value = detail.tags != null ? detail.tags : []
	isHtmlContent.value = detectHtml(content.value)
}

const loadFavoriteStatus = () => {
	if (articleId.value.length == 0) {
		return
	}
	checkFavoriteStatus(
		PRIMARY_RESOURCE_TYPE,
		Number(articleId.value),
		(favorited) => {
			isFavorited.value = favorited
		},
		() => {
			isFavorited.value = false
		}
	)
}

const reportBrowse = () => {
	if (articleId.value.length == 0) {
		return
	}
	reportBrowseHistory(
		{
			resourceType: PRIMARY_RESOURCE_TYPE,
			resourceId: Number(articleId.value)
		},
		() => {
		},
		() => {
		}
	)
}

const loadDetail = () => {
	if (articleId.value.length == 0) {
		return
	}
	fetchArticleDetail(
		articleId.value,
		(detail) => {
			applyDetail(detail)
			reportBrowse()
		},
		(message) => {
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

const submitFavoriteRequest = (
	favorited : boolean,
	success : () => void,
	fail : (message : string) => void
) => {
	updateFavoriteStatus(
		{
			resourceType: PRIMARY_RESOURCE_TYPE,
			resourceId: Number(articleId.value),
			favorited
		},
		(result) => {
			isFavorited.value = result.favorited
			success()
		},
		(message) => {
			fail(message)
		}
	)
}

const toggleFavorite = () => {
	if (articleId.value.length == 0 || isFavoriteLoading.value) {
		return
	}
	isFavoriteLoading.value = true

	const nextFavorited = !isFavorited.value

	submitFavoriteRequest(
		nextFavorited,
		() => {
			isFavoriteLoading.value = false
			uni.showToast({
				title: isFavorited.value ? '\u6536\u85cf\u6210\u529f' : '\u5df2\u53d6\u6d88\u6536\u85cf',
				icon: 'none'
			})
		},
		(message) => {
			isFavoriteLoading.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

const goBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.redirectTo({ url: '/pages/news/index' })
}

onLoad((options) => {
	resolveArticleId(options as UTSJSONObject)
	loadDetail()
})

onShow(() => {
	if (articleId.value.length == 0) {
		resolveArticleId(null)
	}
	if (articleId.value.length > 0 && title.value.length == 0 && content.value.length == 0) {
		loadDetail()
	}
	loadFavoriteStatus()
})
</script>

<style>
.page {
	flex: 1;
	background-color: #f7f7f2;
}

.header {
	height: calc(96rpx + var(--status-bar-height));
	padding-top: var(--status-bar-height);
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
}

.back-btn {
	position: absolute;
	left: 20rpx;
	top: var(--status-bar-height);
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}

.back-icon-image {
	width: 24rpx;
	height: 24rpx;
}

.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}

.content {
	flex: 1;
}

.detail-body {
	padding: 20rpx 18rpx 28rpx;
}

.hero-card,
.section-card {
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	margin-bottom: 18rpx;
}

.hero-cover {
	width: 100%;
	height: 320rpx;
	border-radius: 18rpx;
	background-color: #f3e6d6;
}

.hero-cover-placeholder {
	align-items: center;
	justify-content: center;
}

.hero-cover-text {
	font-size: 24px;
	font-weight: 700;
	color: #cc8e58;
}

.news-title {
	margin-top: 18rpx;
	font-size: 20px;
	line-height: 30px;
	color: #242424;
	font-weight: 700;
}

.meta-row {
	margin-top: 14rpx;
}

.meta-text {
	margin-top: 4rpx;
	font-size: 12px;
	line-height: 18px;
	color: #9c9c9c;
}

.tag-row {
	margin-top: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}

.tag-item {
	margin-right: 10rpx;
	margin-bottom: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #f5efe7;
	font-size: 11px;
	color: #907456;
}

.section-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.section-title {
	font-size: 16px;
	line-height: 24px;
	color: #2b2b2b;
	font-weight: 600;
}

.favorite-btn {
	min-width: 108rpx;
	height: 54rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	border-radius: 27rpx;
	background-color: #f4efe7;
	align-items: center;
	justify-content: center;
}

.favorite-btn-meta {
	margin-top: 12rpx;
	align-self: flex-start;
}

.favorite-btn-text {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
}

.section-text {
	margin-top: 18rpx;
	font-size: 14px;
	line-height: 24px;
	color: #666666;
}

.rich-content {
	margin-top: 18rpx;
}
</style>
