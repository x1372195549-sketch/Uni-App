<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>
			<view class="header">
				<text class="header-title">中医知识考核</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="banner">
				<view class="banner-left">
					<text class="banner-title">中医</text>
					<text class="banner-title">知识考核</text>
				</view>
				<view class="banner-illustration">
					<view class="banner-figure-body"></view>
					<view class="banner-figure-head"></view>
				</view>
			</view>

			<view class="banner-note">
				<view class="banner-note-row">
					<view class="banner-dot"></view>
					<text class="banner-note-text">熟读相关知识点</text>
				</view>
				<view class="banner-note-row">
					<view class="banner-dot"></view>
					<text class="banner-note-text">了解书本知识和考核的关系</text>
				</view>
				<view class="banner-note-row">
					<view class="banner-dot"></view>
					<text class="banner-note-text">第一时间获取相关知识点的运用</text>
				</view>
			</view>

			<view v-if="sourceName.length > 0" class="source-box">
				<text class="source-label">来源：</text>
				<text class="source-text">{{ sourceName }}</text>
			</view>

			<view class="paper-list">
				<view v-for="paper in papers" :key="paper.id" class="paper-card">
					<view class="paper-text-box">
						<text class="paper-title">{{ paper.title }}</text>
						<text class="paper-subtitle">共{{ paper.questionCount }}道题，限时{{ paper.durationMinutes }}分钟</text>
					</view>
					<view class="paper-action" @click="goExamPaper(paper)">
						<text class="paper-action-text">立即答题</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="tabbar">
			<view class="tab-item" @click="goLearningHome">
				<image class="tab-icon" src="/static/tabbar/icon_xuexiweidianji.png" mode="aspectFit"></image>
				<text class="tab-text">学习</text>
			</view>
			<view class="tab-item">
				<image class="tab-icon" src="/static/tabbar/icon_kaohedianji.png" mode="aspectFit"></image>
				<text class="tab-text tab-text-active">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-text">咨询</text>
			</view>
			<view class="tab-item" @click="goKnowledgePage">
				<image class="tab-icon" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-text">知识库</text>
			</view>
			<view class="tab-item" @click="goMinePage">
				<image class="tab-icon" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-text">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
type ExamPaperItem = {
	id : string
	title : string
	questionCount : number
	durationMinutes : number
}

const currentPages = getCurrentPages()
let currentSourceName = ''

if (currentPages.length > 0) {
	const currentPage = currentPages[currentPages.length - 1]
	const options = currentPage.options
	if (options != null && options['sourceName'] != null) {
		currentSourceName = decodeURIComponent(options['sourceName'] as string)
	}
}

const sourceName = ref(currentSourceName)
const papers = ref<ExamPaperItem[]>([
	{ id: 'paper-1', title: '实用中医方药学模拟练习卷', questionCount: 10, durationMinutes: 10 },
	{ id: 'paper-2', title: '中医适宜技术模拟练习卷', questionCount: 10, durationMinutes: 10 },
	{ id: 'paper-3', title: '实用中医理论基础模拟练习卷', questionCount: 10, durationMinutes: 10 },
	{ id: 'paper-4', title: '实用针灸推拿学模拟练习卷', questionCount: 10, durationMinutes: 10 }
])

const goExamPaper = (paper : ExamPaperItem) => {
	uni.navigateTo({
		url: '/pages/exam/paper?id=' + paper.id + '&title=' + encodeURIComponent(paper.title)
	})
}

const goLearningHome = () => {
	uni.redirectTo({
		url: '/pages/index/index'
	})
}

const goConsultPage = () => {
	uni.redirectTo({
		url: '/pages/consult/index'
	})
}

const goKnowledgePage = () => {
	uni.redirectTo({
		url: '/pages/knowledge/index'
	})
}

const goMinePage = () => {
	uni.redirectTo({
		url: '/pages/mine/index'
	})
}
</script>

