<template>
  <view class="page">
    <view class="header">
      <view class="back-btn" @click="goBack">
        <image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
      </view>
      <text class="header-title">课程详情</text>
    </view>

    <scroll-view class="content" scroll-y="true">
      <view class="hero" @tap="playSelectedVideo">
        <video
          v-if="currentVideoUrl.length > 0"
          class="course-video-player"
          :src="currentVideoUrl"
          :title="currentVideoTitle"
          :poster="courseCoverUrl"
          :controls="true"
          :show-center-play-btn="true"
          :enable-progress-gesture="true"
          :show-fullscreen-btn="true"
          object-fit="contain"
          @loadedmetadata="syncCurrentVideoDuration"
          @timeupdate="syncCurrentVideoDuration"
        ></video>
        <image v-if="currentVideoUrl.length == 0 && courseCoverUrl.length > 0" class="hero-cover-image" :src="courseCoverUrl" mode="aspectFill"></image>
        <view v-if="currentVideoUrl.length == 0" class="hero-mask"></view>
        <view v-if="currentVideoUrl.length == 0 && courseCoverUrl.length == 0" class="board-outer">
          <text class="board-label">课程</text>
        </view>
        <view v-if="currentVideoUrl.length == 0 && currentVideoId.length > 0" class="hero-play-button">
          <view class="hero-play-triangle"></view>
        </view>
      </view>

      <view class="tabs">
        <view class="tab-item" @click="activeTab = 'intro'">
          <text :class="activeTab == 'intro' ? 'tab-text tab-text-active' : 'tab-text'">简介</text>
          <view v-if="activeTab == 'intro'" class="tab-line"></view>
        </view>
        <view class="tab-item" @click="activeTab = 'catalog'">
          <text :class="activeTab == 'catalog' ? 'tab-text tab-text-active' : 'tab-text'">目录</text>
          <view v-if="activeTab == 'catalog'" class="tab-line"></view>
        </view>
        <view class="favorite-tab-btn" @click="toggleFavorite">
          <text class="favorite-text" :class="isFavorited ? 'favorite-text-active' : ''">{{ isFavorited ? '已收藏' : '收藏' }}</text>
        </view>
      </view>

      <view v-if="activeTab == 'intro'" class="intro-panel">
        <text class="media-title">{{ courseTitle }}</text>

        <view class="stats-row">
          <text class="stats-text">学时 {{ courseViews }}</text>
          <text class="stats-text">收藏 {{ courseFavorites }}</text>
        </view>

        <text class="section-title">课程介绍</text>
        <text class="intro-text">{{ courseIntro }}</text>
      </view>

      <view v-else class="catalog-panel">
        <view
          v-for="item in catalogItems"
          :key="item.id"
          :class="item.id == currentVideoId ? 'catalog-row catalog-row-active' : 'catalog-row'"
          @tap="selectCatalogItem(item.id)"
        >
          <text class="catalog-title" :class="item.id == currentVideoId ? 'catalog-title-active' : ''">{{ item.title }}</text>
          <text class="catalog-duration" :class="item.id == currentVideoId ? 'catalog-duration-active' : ''">{{ item.duration }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import {
  checkFavoriteStatus,
  fetchCourseDetail,
  normalizeAppUrl,
  reportBrowseHistory,
  updateFavoriteStatus,
  type Course,
  type CourseVideo
} from '../../utils/auth.uts'

type CatalogItem = {
  id : string
  title : string
  duration : string
  videoUrl : string
}

const RESOURCE_TYPE = 'course'

const courseId = ref('')
const activeTab = ref('intro')
const courseTitle = ref('课程详情')
const courseViews = ref('0')
const courseFavorites = ref('0')
const courseIntro = ref('这里展示课程基础信息。')
const courseCoverUrl = ref('')
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)
const catalogItems = ref<CatalogItem[]>([])
const currentVideoId = ref('')
const currentVideoUrl = ref('')
const currentVideoTitle = ref('')

function safeText(value : string | null) : string {
  return value == null || value.length == 0 ? '' : value
}

function formatDuration(seconds : number) : string {
  const total = seconds > 0 ? seconds : 0
  const minute = Math.floor(total / 60)
  const second = total % 60
  const minuteText = minute < 10 ? '0' + String(minute) : String(minute)
  const secondText = second < 10 ? '0' + String(second) : String(second)
  return minuteText + ':' + secondText
}

function formatBackendDuration(seconds : number) : string {
  return seconds > 0 ? formatDuration(seconds) : '--:--'
}

function readDurationFromEvent(event : any) : number {
  if (event == null || event.detail == null) {
    return 0
  }
  const durationValue = event.detail.duration
  if (typeof durationValue == 'number') {
    return Math.floor(durationValue)
  }
  return 0
}

function updateCatalogDuration(id : string, durationText : string) : void {
  catalogItems.value = catalogItems.value.map((item : CatalogItem) : CatalogItem => {
    if (item.id == id) {
      return {
        id: item.id,
        title: item.title,
        duration: durationText,
        videoUrl: item.videoUrl
      }
    }
    return item
  })
}

function syncCurrentVideoDuration(event : any) : void {
  const duration = readDurationFromEvent(event)
  if (duration > 0 && currentVideoId.value.length > 0) {
    updateCatalogDuration(currentVideoId.value, formatDuration(duration))
  }
}

function selectCatalogItem(id : string) : void {
  for (let i = 0; i < catalogItems.value.length; i++) {
    const item = catalogItems.value[i]
    if (item.id == id) {
      currentVideoId.value = item.id
      currentVideoTitle.value = item.title
      currentVideoUrl.value = item.videoUrl
      if (item.videoUrl.length == 0) {
        uni.showToast({
          title: '暂无可播放视频',
          icon: 'none'
        })
      }
      return
    }
  }
}

function playSelectedVideo() : void {
  if (currentVideoUrl.value.length > 0) {
    return
  }
  if (currentVideoId.value.length == 0 && catalogItems.value.length > 0) {
    selectCatalogItem(catalogItems.value[0].id)
    return
  }
  if (currentVideoId.value.length > 0) {
    selectCatalogItem(currentVideoId.value)
  }
}

function loadFavoriteStatus() : void {
  if (courseId.value.length == 0) {
    return
  }

  checkFavoriteStatus(
    RESOURCE_TYPE,
    Number(courseId.value),
    (favorited) => {
      isFavorited.value = favorited
    },
    () => {
      isFavorited.value = false
    }
  )
}

function reportBrowse() : void {
  if (courseId.value.length == 0) {
    return
  }
  reportBrowseHistory(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(courseId.value)
    },
    () => {
    },
    () => {
    }
  )
}

function toggleFavorite() : void {
  if (courseId.value.length == 0 || isFavoriteLoading.value) {
    return
  }

  isFavoriteLoading.value = true
  updateFavoriteStatus(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(courseId.value),
      favorited: !isFavorited.value
    },
    (result) => {
      isFavorited.value = result.favorited
      courseFavorites.value = String(result.favoriteCount != null ? result.favoriteCount : 0)
      isFavoriteLoading.value = false
      uni.showToast({
        title: result.favorited ? '收藏成功' : '已取消收藏',
        icon: 'success'
      })
    },
    (message) => {
      isFavoriteLoading.value = false
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

function applyCourseDetail(detail : Course) : void {
  const titleText = safeText(detail.courseName)
  courseCoverUrl.value = safeText(detail.coverUrl)
  if (titleText.length > 0) {
    courseTitle.value = titleText
  }

  const introText = safeText(detail.introduction)
  if (introText.length > 0) {
    courseIntro.value = introText
  } else {
    const introParts = new Array<string>()
    const subtitleText = safeText(detail.subtitle)
    const lecturerText = safeText(detail.lecturerName)
    const publishedText = safeText(detail.publishedAt)
    if (subtitleText.length > 0) {
      introParts.push('课程副标题：' + subtitleText)
    }
    if (lecturerText.length > 0) {
      introParts.push('讲师：' + lecturerText)
    }
    if (publishedText.length > 0) {
      introParts.push('发布时间：' + publishedText.replace('T', ' '))
    }
    if (introParts.length > 0) {
      courseIntro.value = introParts.join('；')
    }
  }

  courseViews.value = String(detail.studySeconds != null ? detail.studySeconds : 0)

  if (detail.videos != null && detail.videos.length > 0) {
    catalogItems.value = detail.videos.map((item : CourseVideo, index : number) : CatalogItem => {
      return {
        id: String(item.id),
        title: safeText(item.title).length > 0 ? item.title : '课程 ' + String(index + 1),
        duration: formatBackendDuration(item.durationSeconds),
        videoUrl: normalizeAppUrl(safeText(item.videoUrl))
      }
    })
    currentVideoId.value = catalogItems.value[0].id
    currentVideoTitle.value = catalogItems.value[0].title
    currentVideoUrl.value = ''
  } else {
    catalogItems.value = []
    currentVideoId.value = ''
    currentVideoTitle.value = ''
    currentVideoUrl.value = ''
  }
}

function goBack() : void {
  const pages = getCurrentPages()
  if (pages.length > 1) {
    uni.navigateBack()
    return
  }
  uni.redirectTo({ url: '/pages/course/index' })
}

function loadParams() : void {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    return
  }

  const current = pages[pages.length - 1]
  if (current == null || current.options == null) {
    return
  }

  const options = current.options as UTSJSONObject
  const idValue = options['id']
  const tabValue = options['tab']
  if (typeof idValue == 'string' && idValue.length > 0) {
    courseId.value = idValue
  }
  if (typeof tabValue == 'string' && tabValue.length > 0) {
    activeTab.value = tabValue
  }
}

function loadCourseDetail() : void {
  if (courseId.value.length == 0) {
    return
  }

  fetchCourseDetail(
    courseId.value,
    (detail) => {
      applyCourseDetail(detail)
      reportBrowse()
    },
    (message) => {
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

onMounted(() => {
  loadParams()
  loadCourseDetail()
  loadFavoriteStatus()
})

onShow(() => {
  loadFavoriteStatus()
})
</script>

