	margin-top: 10rpx;
}

.stat-row {
	margin-top: 14rpx;
	flex-direction: row;
	justify-content: space-between;
}

.favorite-btn {
	margin-top: 18rpx;
	width: 150rpx;
	height: 58rpx;
	border-radius: 29rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}

.favorite-btn-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}

.section-card {
	margin-top: 18rpx;
}

.section-head {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}

.section-title {
	font-size: 16px;
	line-height: 24px;
	color: #242424;
	font-weight: 700;
}

.section-text {
	margin-top: 16rpx;
	font-size: 14px;
	line-height: 25px;
	color: #686868;
}

.progress-row {
	margin-top: 18rpx;
	flex-direction: row;
	align-items: center;
}

.progress-bg {
	flex: 1;
	height: 12rpx;
	border-radius: 999rpx;
	background-color: #eeeeee;
	overflow: hidden;
}

.progress-fill {
	height: 12rpx;
	border-radius: 999rpx;
	background-color: #18b775;
}

.progress-text {
	margin-left: 14rpx;
