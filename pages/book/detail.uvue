	height: calc(96rpx + var(--status-bar-height));
	padding-top: var(--status-bar-height);
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #eceaf1;
}

