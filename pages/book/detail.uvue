	flex: 1;
}

.book-title {
	font-size: 19px;
	line-height: 28px;
	color: #242424;
	font-weight: 700;
}

.book-meta,
.stat-text,
.section-more,
.chapter-meta {
	font-size: 13px;
	line-height: 20px;
	color: #8f8f8f;
}

