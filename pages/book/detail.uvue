<template>
	<view class="page">
		<view class="header">
			<view class="back-btn" @tap="goBack">
				<image class="back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">图书详情</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view v-if="isLoading" class="state-wrap">
				<text class="state-text">加载中...</text>
			</view>

			<view v-else-if="errorText.length > 0" class="state-wrap">
				<text class="state-text">{{ errorText }}</text>
				<view class="retry-btn" @tap="loadDetail">
					<text class="retry-btn-text">重新加载</text>
				</view>
			</view>

			<view v-else class="detail-body">
				<view class="book-hero">
					<view class="cover-shell">
						<image v-if="coverUrl.length > 0" class="cover-image" :src="coverUrl" mode="aspectFill"></image>
						<view v-else class="cover-fallback">
							<text class="cover-fallback-text">{{ shortTitle }}</text>
						</view>
					</view>
					<view class="hero-main">
						<text class="book-title">{{ bookName }}</text>
						<text class="book-meta">{{ author.length > 0 ? author : '作者未填写' }}</text>
						<text v-if="publisher.length > 0" class="book-meta">{{ publisher }}</text>
						<view class="stat-row">
							<text class="stat-text">阅读 {{ browseCount }}</text>
							<text class="stat-text">收藏 {{ favoriteCount }}</text>
						</view>
						<view class="favorite-btn" @tap="toggleFavorite">
							<text class="favorite-btn-text">{{ favorited ? '已收藏' : '收藏' }}</text>
						</view>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">简介</text>
					<text class="section-text">{{ introduction.length > 0 ? introduction : '暂无简介' }}</text>
				</view>

				<view class="section-card">
					<text class="section-title">学习进度</text>
					<view class="progress-row">
						<view class="progress-bg">
							<view class="progress-fill" :style="'width:' + progressText + '%'"></view>
						</view>
						<text class="progress-text">{{ progressText }}%</text>
					</view>
					<text class="section-text">已学习 {{ studyMinutes }} 分钟，共 {{ totalPagesText }}</text>
				</view>

				<view class="section-card">
					<view class="section-head">
						<text class="section-title">章节目录</text>
						<text class="section-more">{{ String(chapters.length) }} 章</text>
					</view>
					<view v-if="chapters.length == 0" class="chapter-empty">
						<text class="chapter-empty-text">暂无章节</text>
					</view>
					<view
						v-for="item in chapters"
						:key="item.id"
						class="chapter-item"
						@tap="goChapter(item.id)"
					>
						<view class="chapter-main">
							<text class="chapter-title">{{ item.chapterTitle.length > 0 ? item.chapterTitle : ('章节 ' + String(item.id)) }}</text>
							<text class="chapter-meta">起始页 {{ String(item.startPage) }} · 页数 {{ String(item.pageCount) }}</text>
						</view>
						<text class="chapter-arrow">{{ isChapterViewed(item.id) ? '已学习' : '进入' }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onLoad, onShow } from '@dcloudio/uni-app'
import {
	fetchBookDetail,
	reportBrowseHistory,
	updateFavoriteStatus,
	type AppBook,
	type AppBookChapter
} from '../../utils/auth.uts'

const bookId = ref('')
const isLoading = ref(true)
const errorText = ref('')

const bookName = ref('')
const shortTitle = ref('图书')
const author = ref('')
const publisher = ref('')
const coverUrl = ref('')
const introduction = ref('')
const browseCount = ref('0')
const favoriteCount = ref('0')
const favorited = ref(false)
const progressText = ref('0')
const studyMinutes = ref('0')
const totalPagesText = ref('0 页')
const chapters = ref<AppBookChapter[]>([])
const hasLoadedDetail = ref(false)

function safeText(value : string | null) : string {
	return value == null || value.length == 0 ? '' : value
}

function buildShortTitle(value : string) : string {
	const text = safeText(value)
	if (text.length == 0) {
		return '图书'
	}
	return text.length <= 4 ? text : text.substring(0, 4)
}

function sortChapters(items : AppBookChapter[]) : AppBookChapter[] {
	return items.slice().sort((left : AppBookChapter, right : AppBookChapter) : number => {
		if (left.sortOrder != right.sortOrder) {
			return left.sortOrder - right.sortOrder
		}
		return left.id - right.id
	})
}

function buildProgressStorageKey(id : string) : string {
	return 'book_chapter_progress_' + id
}

function buildChapterStudySecondsKey(id : string) : string {
	return 'book_chapter_seconds_' + id
}

function buildBookStudySummaryKey(id : string) : string {
	return 'book_study_summary_' + id
}

function readNumberStorage(key : string) : number {
	const value = uni.getStorageSync(key)
	if (typeof value == 'number') {
		return value
	}
	if (typeof value == 'string' && value.length > 0) {
		const parsed = Number(value)
		return isNaN(parsed) ? 0 : parsed
	}
	return 0
}

function readViewedChapterIds() : string[] {
	if (bookId.value.length == 0) {
		return []
	}
	const stored = uni.getStorageSync(buildProgressStorageKey(bookId.value))
	if (stored instanceof Array) {
		return stored as string[]
	}
	return []
}

function applyLocalStudyProgress() : void {
	const totalChapters = chapters.value.length
	if (bookId.value.length == 0 || totalChapters == 0) {
		progressText.value = '0'
		studyMinutes.value = '0'
		return
	}

	const viewedIds = readViewedChapterIds()
	let viewedCount = 0
	let totalSeconds = 0
	chapters.value.forEach((item : AppBookChapter) => {
		const chapterIdText = String(item.id)
		if (viewedIds.indexOf(chapterIdText) >= 0) {
			viewedCount += 1
		}
		totalSeconds += readNumberStorage(buildChapterStudySecondsKey(bookId.value + '_' + chapterIdText))
	})
	progressText.value = String(Math.floor(viewedCount * 100 / totalChapters))
	studyMinutes.value = String(Math.floor(totalSeconds / 60))
	uni.setStorageSync(buildBookStudySummaryKey(bookId.value), {
		progressPercent: Number(progressText.value),
		studySeconds: totalSeconds
	})
}

function isChapterViewed(chapterId : number) : boolean {
	return readViewedChapterIds().indexOf(String(chapterId)) >= 0
}

function applyDetail(detail : AppBook) : void {
	bookName.value = safeText(detail.bookName)
	shortTitle.value = buildShortTitle(detail.bookName)
	author.value = safeText(detail.author)
	publisher.value = safeText(detail.publisher)
	coverUrl.value = safeText(detail.coverUrl)
	introduction.value = safeText(detail.introduction)
	browseCount.value = String(detail.browseCount)
	favoriteCount.value = String(detail.favoriteCount)
	favorited.value = detail.favorited
	totalPagesText.value = detail.totalPages > 0 ? String(detail.totalPages) + ' 页' : '0 页'
	chapters.value = sortChapters(detail.chapters != null ? detail.chapters : [])
	applyLocalStudyProgress()
}

function reportBrowse() : void {
	if (bookId.value.length == 0) {
		return
	}
	reportBrowseHistory(
		{
			resourceType: 'book',
			resourceId: Number(bookId.value)
		},
		() => {},
		() => {}
	)
}

function loadDetail() : void {
	if (bookId.value.length == 0) {
		errorText.value = '缺少图书 ID'
		isLoading.value = false
		return
	}
	isLoading.value = true
	errorText.value = ''
	fetchBookDetail(
		bookId.value,
		(detail) => {
			applyDetail(detail)
			isLoading.value = false
			hasLoadedDetail.value = true
			reportBrowse()
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '图书详情加载失败'
			isLoading.value = false
		}
	)
}

function toggleFavorite() : void {
	if (bookId.value.length == 0) {
		return
	}
	const nextFavorited = !favorited.value
	updateFavoriteStatus(
		{
			resourceType: 'book',
			resourceId: Number(bookId.value),
			favorited: nextFavorited
		},
		() => {
			favorited.value = nextFavorited
			const nextCount = Number(favoriteCount.value) + (nextFavorited ? 1 : -1)
			favoriteCount.value = String(nextCount < 0 ? 0 : nextCount)
			uni.showToast({ title: nextFavorited ? '已收藏' : '已取消收藏', icon: 'none' })
		},
		(message) => {
			uni.showToast({ title: message.length > 0 ? message : '收藏失败', icon: 'none' })
		}
	)
}

function goChapter(chapterId : number) : void {
	uni.navigateTo({ url: '/pages/book/chapter?bookId=' + bookId.value + '&chapterId=' + String(chapterId) })
}

function goBack() : void {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.redirectTo({ url: '/pages/book/index' })
}

onLoad((options) => {
	const idValue = options['id']
	if (typeof idValue == 'string') {
		bookId.value = idValue
	}
	loadDetail()
})

onShow(() => {
	if (hasLoadedDetail.value) {
		applyLocalStudyProgress()
	}
})
</script>

<style>
