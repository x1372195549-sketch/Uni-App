	{ label: '设置', icon: '/static/mine/icon_about.png' },
	{ label: '使用手册', icon: '/static/mine/icon_manual.png' }
])

const goEditProfile = () => {
	uni.navigateTo({
		url: '/pages/profile/edit'
	})
}

const handleMenuClick = (label : string) => {
	if (label == '个人资料') {
		goEditProfile()
	}
}

const goLearningHome = () => {
	uni.navigateTo({
		url: '/pages/index/index'
	})
}
