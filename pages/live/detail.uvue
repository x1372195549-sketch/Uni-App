<template>
	<view class="page">
		<view class="header">
			<view class="back-btn" @tap="goBack">
				<image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">直播详情</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="hero">
				<image v-if="coverUrl.length > 0" class="hero-cover-image" :src="coverUrl" mode="aspectFill"></image>
				<view v-else class="hero-mask"></view>
				<view class="signal-stack">
					<view class="signal-dot"></view>
					<view class="signal-ring signal-ring-one"></view>
					<view class="signal-ring signal-ring-two"></view>
				</view>
				<view class="status-badge">
					<text class="status-badge-text">{{ statusLabel }}</text>
				</view>
			</view>

			<view class="detail-panel">
				<view class="title-row">
					<text class="media-title">{{ liveTitle }}</text>
					<view class="favorite-title-btn" @tap="toggleFavorite">
						<text class="favorite-text" :class="isFavorited ? 'favorite-text-active' : ''">{{ isFavorited ? '已收藏' : '收藏' }}</text>
					</view>
				</view>

				<view class="stats-row">
					<text class="stats-text">开始 {{ startText }}</text>
					<text class="stats-text">收藏 {{ favoriteCountText }}</text>
				</view>

				<view class="summary-card">
					<text class="summary-line">主播：{{ anchorText }}</text>
					<text class="summary-line">主讲：{{ speakerText }}</text>
					<text class="summary-line">状态：{{ statusLabel }}</text>
					<text class="summary-line">结束时间：{{ endText }}</text>
					<text class="summary-line" v-if="tagText.length > 0">标签：{{ tagText }}</text>
				</view>

				<text class="section-title">直播介绍</text>
				<text class="intro-text">{{ liveIntro }}</text>

				<view v-if="videoItems.length > 0" class="video-section">
					<view class="section-head">
						<text class="section-title">相关视频</text>
					</view>
					<view v-if="selectedVideoUrl.length > 0" class="inline-video-wrap">
						<video
							class="inline-video"
							:src="selectedVideoUrl"
							:title="selectedVideoTitle"
							:poster="coverUrl"
							:controls="true"
							:show-center-play-btn="true"
							:enable-progress-gesture="true"
							:show-fullscreen-btn="true"
							object-fit="contain"
							@loadedmetadata="syncSelectedVideoDuration"
							@timeupdate="syncSelectedVideoDuration"
						></video>
					</view>
					<view
						v-for="item in videoItems"
						:key="item.id"
						:class="item.id == selectedVideoId ? 'video-card video-card-active' : 'video-card'"
						@tap="selectRelatedVideo(item)"
					>
						<text class="video-title">{{ item.title }}</text>
						<text class="video-meta">{{ item.durationText }}</text>
					</view>
				</view>

				<view class="action-wrap">
					<button class="action-btn" hover-class="action-btn-hover" @tap="enterLive">{{ actionButtonText }}</button>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { onLoad, onShow } from '@dcloudio/uni-app'
import {
	checkFavoriteStatus,
	fetchLiveSessionDetail,
	normalizeAppUrl,
	reportBrowseHistory,
	updateFavoriteStatus,
	type LiveSession,
	type LiveSessionVideo
} from '../../utils/auth.uts'

type DetailVideoItem = {
	id : string
	title : string
	videoUrl : string
	durationText : string
}

const RESOURCE_TYPE = 'live'

const liveId = ref('')
const liveTitle = ref('直播详情')
const coverUrl = ref('')
const anchorText = ref('待定')
const speakerText = ref('待定')
const startText = ref('待定')
const endText = ref('待定')
const statusLabel = ref('未开始')
const tagText = ref('')
const favoriteCountText = ref('0')
const liveIntro = ref('暂无直播介绍')
const liveUrl = ref('')
const playbackUrl = ref('')
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)
const videoItems = ref<DetailVideoItem[]>([])
const selectedVideoId = ref('')
const selectedVideoTitle = ref('')
const selectedVideoUrl = ref('')

const actionButtonText = computed(() : string => {
	if (statusLabel.value == '直播中') {
		return '进入直播'
	}
	if (statusLabel.value == '已结束') {
		return playbackUrl.value.length > 0 ? '观看回放' : '直播已结束'
	}
	if (statusLabel.value == '已取消') {
		return '直播已取消'
	}
	return '等待开播'
})

function safeText(value : string | null) : string {
	return value == null || value.length == 0 ? '' : value
}

function formatDateTime(value : string) : string {
	const text = safeText(value)
	if (text.length == 0) {
		return '待定'
	}
	if (text.length >= 16) {
		return text.slice(0, 16).replace('T', ' ')
	}
	return text.replace('T', ' ')
}

function formatDuration(seconds : number) : string {
	if (seconds <= 0) {
		return '--:--'
	}
	const minute = Math.floor(seconds / 60)
	const second = seconds % 60
	const minuteText = minute < 10 ? '0' + String(minute) : String(minute)
	const secondText = second < 10 ? '0' + String(second) : String(second)
	return minuteText + ':' + secondText
}

function readDurationFromEvent(event : any) : number {
	if (event == null || event.detail == null) {
		return 0
	}
	const durationValue = event.detail.duration
	if (typeof durationValue == 'number') {
		return Math.floor(durationValue)
	}
	return 0
}

function updateRelatedVideoDuration(id : string, durationText : string) : void {
	videoItems.value = videoItems.value.map((item : DetailVideoItem) : DetailVideoItem => {
		if (item.id == id) {
			return {
				id: item.id,
				title: item.title,
				videoUrl: item.videoUrl,
				durationText
			}
		}
		return item
	})
}

function syncSelectedVideoDuration(event : any) : void {
	const duration = readDurationFromEvent(event)
	if (duration > 0 && selectedVideoId.value.length > 0) {
		updateRelatedVideoDuration(selectedVideoId.value, formatDuration(duration))
	}
}

function mapLiveStatus(status : string) : string {
	const normalized = safeText(status).toUpperCase()
	if (normalized == 'LIVE' || normalized == '1') {
		return '直播中'
	}
	if (normalized == 'ENDED' || normalized == '2') {
		return '已结束'
	}
	if (normalized == 'CANCELED' || normalized == '3') {
		return '已取消'
	}
	return '未开始'
}

function mapVideoItem(item : LiveSessionVideo, index : number) : DetailVideoItem {
	const titleText = safeText(item.title)
	return {
		id: String(item.id > 0 ? item.id : index + 1),
		title: titleText.length > 0 ? titleText : '视频 ' + String(index + 1),
		videoUrl: normalizeAppUrl(safeText(item.videoUrl)),
		durationText: formatDuration(item.durationSeconds)
	}
}

function goBack() : void {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.redirectTo({ url: '/pages/live/index' })
}

function loadFavoriteStatus() : void {
	if (liveId.value.length == 0) {
		return
	}
	checkFavoriteStatus(
		RESOURCE_TYPE,
		Number(liveId.value),
		(favorited) => {
			isFavorited.value = favorited
		},
		() => {
			isFavorited.value = false
		}
	)
}

function reportBrowse() : void {
	if (liveId.value.length == 0) {
		return
	}
	reportBrowseHistory(
		{
			resourceType: RESOURCE_TYPE,
			resourceId: Number(liveId.value)
		},
		() => {},
		() => {}
	)
}

function toggleFavorite() : void {
	if (liveId.value.length == 0 || isFavoriteLoading.value) {
		return
	}
	isFavoriteLoading.value = true
	updateFavoriteStatus(
		{
			resourceType: RESOURCE_TYPE,
			resourceId: Number(liveId.value),
			favorited: !isFavorited.value
		},
		(result) => {
			isFavorited.value = result.favorited
			favoriteCountText.value = String(result.favoriteCount != null ? result.favoriteCount : 0)
			isFavoriteLoading.value = false
			uni.showToast({
				title: result.favorited ? '收藏成功' : '已取消收藏',
				icon: 'none'
			})
		},
		(message) => {
			isFavoriteLoading.value = false
			uni.showToast({
				title: message.length > 0 ? message : '收藏操作失败',
				icon: 'none'
			})
		}
	)
}

function applyLiveDetail(detail : LiveSession) : void {
	const titleText = safeText(detail.title)
	liveTitle.value = titleText.length > 0 ? titleText : '直播详情'
	coverUrl.value = safeText(detail.coverUrl)
	anchorText.value = safeText(detail.anchorName).length > 0 ? safeText(detail.anchorName) : '待定'
	speakerText.value = safeText(detail.speakerName).length > 0 ? safeText(detail.speakerName) : anchorText.value
	startText.value = formatDateTime(detail.startAt)
	endText.value = formatDateTime(detail.endAt)
	statusLabel.value = mapLiveStatus(detail.liveStatus)
	tagText.value = detail.tags != null ? detail.tags.join(' / ') : ''
	favoriteCountText.value = String(detail.favoriteCount)
	liveUrl.value = normalizeAppUrl(safeText(detail.liveUrl))
	playbackUrl.value = normalizeAppUrl(safeText(detail.playbackUrl))
	isFavorited.value = detail.favorited
	videoItems.value = detail.videos != null
		? detail.videos
			.filter((item : LiveSessionVideo) : boolean => item.videoUrl.length > 0)
			.sort((left : LiveSessionVideo, right : LiveSessionVideo) : number => left.sortOrder - right.sortOrder)
			.map((item : LiveSessionVideo, index : number) : DetailVideoItem => {
				return mapVideoItem(item, index)
			})
		: []
	selectedVideoId.value = ''
	selectedVideoTitle.value = ''
	selectedVideoUrl.value = ''

	const introParts = new Array<string>()
	introParts.push('主播：' + anchorText.value)
	introParts.push('主讲：' + speakerText.value)
	introParts.push('开始时间：' + startText.value)
	introParts.push('结束时间：' + endText.value)
	if (tagText.value.length > 0) {
		introParts.push('标签：' + tagText.value)
	}
	if (statusLabel.value == '直播中' && liveUrl.value.length > 0) {
		introParts.push('当前可进入直播观看。')
	} else if (statusLabel.value == '已结束' && playbackUrl.value.length > 0) {
		introParts.push('当前可观看回放。')
	} else if (statusLabel.value == '已取消') {
		introParts.push('本场直播已取消。')
	} else {
		introParts.push('当前直播尚未开始。')
	}
	liveIntro.value = introParts.join('\n')
}

function loadLiveDetail() : void {
	if (liveId.value.length == 0) {
		return
	}
	fetchLiveSessionDetail(
		liveId.value,
		(detail) => {
			applyLiveDetail(detail)
			reportBrowse()
		},
		(message) => {
			uni.showToast({
				title: message.length > 0 ? message : '直播详情加载失败',
				icon: 'none'
			})
		}
	)
}

function openPlayer(url : string, title : string, playMode : string) : void {
	const targetUrl = normalizeAppUrl(url)
	if (targetUrl.length == 0) {
		uni.showToast({
			title: '暂无可用地址',
			icon: 'none'
		})
		return
	}
	uni.navigateTo({
		url: '/pages/live/player?mode=' + encodeURIComponent(playMode) + '&title=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(targetUrl)
	})
}

function selectRelatedVideo(item : DetailVideoItem) : void {
	const targetUrl = normalizeAppUrl(item.videoUrl)
	if (targetUrl.length == 0) {
		uni.showToast({
			title: '暂无可用地址',
			icon: 'none'
		})
		return
	}
	selectedVideoId.value = item.id
	selectedVideoTitle.value = item.title
	selectedVideoUrl.value = targetUrl
}

function enterLive() : void {
	if (statusLabel.value == '已取消') {
		uni.showToast({
			title: '直播已取消',
			icon: 'none'
		})
		return
	}
	if (statusLabel.value == '直播中') {
		openPlayer(liveUrl.value, liveTitle.value, 'live')
		return
	}
	if (statusLabel.value == '已结束') {
		if (playbackUrl.value.length == 0) {
			uni.showToast({
				title: '暂无回放地址',
				icon: 'none'
			})
			return
		}
		openPlayer(playbackUrl.value, liveTitle.value, 'playback')
		return
	}
	uni.showToast({
		title: '直播尚未开始',
		icon: 'none'
	})
}

onLoad((options) => {
	const routeOptions = options as UTSJSONObject
	const idValue = routeOptions['id']
	if (typeof idValue == 'string' && idValue.length > 0) {
		liveId.value = idValue
	}
	loadLiveDetail()
	loadFavoriteStatus()
})

onShow(() => {
	loadFavoriteStatus()
})
</script>

<style>
