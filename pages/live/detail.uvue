	width: 220rpx;
	height: 220rpx;
	align-items: center;
	justify-content: center;
	z-index: 1;
	position: relative;
}

.signal-dot {
	width: 72rpx;
	height: 72rpx;
	border-radius: 36rpx;
	background-color: rgba(185, 112, 47, 0.42);
	z-index: 3;
}

.signal-ring {
	position: absolute;
	border-width: 10rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.88);
	border-radius: 999rpx;
}

.signal-ring-one {
	width: 134rpx;
	height: 134rpx;
}

.signal-ring-two {
	width: 220rpx;
	height: 220rpx;
}

.status-badge {
	position: absolute;
	left: 28rpx;
	top: 24rpx;
	min-width: 110rpx;
	height: 48rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	border-radius: 24rpx;
	background-color: rgba(184, 93, 105, 0.92);
	align-items: center;
	justify-content: center;
}

.status-badge-text {
	font-size: 12px;
	line-height: 18px;
	color: #ffffff;
	font-weight: 600;
}

.detail-panel {
	margin-top: -24rpx;
	padding: 28rpx 24rpx 40rpx;
	border-top-left-radius: 28rpx;
	border-top-right-radius: 28rpx;
	background-color: #ffffff;
}

.title-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.media-title {
	flex: 1;
	font-size: 20px;
	line-height: 30px;
	color: #2e2e2e;
	font-weight: 700;
}

.favorite-title-btn {
	min-width: 110rpx;
	height: 52rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	border-radius: 28rpx;
	background-color: #f8efe7;
	align-items: center;
	justify-content: center;
}

.favorite-text {
	font-size: 12px;
