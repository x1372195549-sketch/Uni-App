const currentCategoryId = ref('cardio')
const currentDoctors = ref<DoctorItem[]>([])

const refreshDoctors = () => {
	currentDoctors.value = doctors.value.filter((item : DoctorItem) : boolean => item.categoryId == currentCategoryId.value)
}

const selectCategory = (id : string) => {
	currentCategoryId.value = id
	refreshDoctors()
}

const goDoctorDetail = (doctor : DoctorItem) => {
	uni.navigateTo({
		url:
			'/pages/consult/detail?id=' + doctor.id +
			'&name=' + encodeURIComponent(doctor.name) +
			'&title=' + encodeURIComponent(doctor.title) +
			'&organization=' + encodeURIComponent(doctor.organization) +
			'&specialty=' + encodeURIComponent(doctor.specialty) +
			'&tag=' + encodeURIComponent(doctor.tag)
	})
}

const goLearningPage = () => {
	uni.reLaunch({ url: '/pages/index/index' })
}

const goKnowledgePage = () => {
	uni.navigateTo({ url: '/pages/knowledge/index' })
}

const goMinePage = () => {
	uni.navigateTo({ url: '/pages/mine/index' })
}

refreshDoctors()
</script>

