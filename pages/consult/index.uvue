	width: 184rpx;
	background-color: #f1f2f5;
}

.category-item {
	min-height: 112rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}

