<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>
			<view class="header">
				<text class="header-title">{{ pageTitleText }}</text>
			</view>
		</view>

		<view class="search-bar">
			<input
				v-model="searchKeyword"
				class="search-input"
				:placeholder="searchPlaceholder"
				confirm-type="search"
				@confirm="handleSearch"
			/>
			<view class="search-btn" @tap="handleSearch">
				<text class="search-btn-text">{{ searchButtonText }}</text>
			</view>
		</view>

		<view class="content-shell">
			<scroll-view class="category-panel" scroll-y="true">
				<view
					class="category-item"
					:class="{ 'category-item-active': selectedCategoryId == 0 }"
					@tap="selectCategory(0)"
				>
					<view v-if="selectedCategoryId == 0" class="category-line"></view>
					<text class="category-text" :class="{ 'category-text-active': selectedCategoryId == 0 }">{{ allCategoryText }}</text>
				</view>

				<view
					v-for="item in categoryItems"
					:key="item.key"
					class="category-item"
					:class="{ 'category-item-active': selectedCategoryKey == item.key }"
					@tap="selectCategory(item)"
				>
					<view v-if="selectedCategoryKey == item.key" class="category-line"></view>
					<text class="category-text" :class="{ 'category-text-active': selectedCategoryKey == item.key }">{{ item.name }}</text>
				</view>
			</scroll-view>

			<scroll-view class="doctor-panel" scroll-y="true" @scrolltolower="loadMore">
				<view v-if="isLoading" class="state-wrap">
					<text class="state-text">{{ loadingText }}</text>
				</view>

				<view v-else-if="errorText.length > 0" class="state-wrap">
					<text class="state-text">{{ errorText }}</text>
					<view class="retry-btn" @tap="reloadExperts">
						<text class="retry-btn-text">{{ retryText }}</text>
					</view>
				</view>

				<view v-else-if="expertItems.length == 0" class="state-wrap">
					<text class="state-text">{{ emptyExpertText }}</text>
				</view>

				<view v-else class="doctor-grid">
					<view
						v-for="doctor in expertItems"
						:key="doctor.id"
						class="doctor-card"
						@tap="goDoctorDetail(doctor)"
					>
						<view class="doctor-avatar-wrap">
							<image
								v-if="doctor.avatarUrl.length > 0 && !doctor.avatarFailed"
								class="doctor-avatar"
								:src="doctor.avatarUrl"
								mode="aspectFill"
								@error="handleAvatarError(doctor.id)"
							></image>
							<view v-else class="doctor-avatar doctor-avatar-placeholder">
								<text class="doctor-avatar-text">{{ doctor.shortName }}</text>
							</view>
						</view>
						<text class="doctor-name">{{ doctor.name }}</text>
						<text class="doctor-title">{{ doctor.title }}</text>
						<text class="doctor-organization">{{ doctor.organization }}</text>
						<text class="doctor-brief">{{ doctor.specialty }}</text>
					</view>

					<view v-if="isListLoading" class="bottom-state">
						<text class="bottom-state-text">{{ loadingMoreText }}</text>
					</view>
					<view v-else-if="!hasMore" class="bottom-state">
						<text class="bottom-state-text">{{ noMoreText }}</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<view class="floating-action" @tap="goMyQuestions">
			<text class="floating-action-text">{{ myQuestionsText }}</text>
		</view>

		<view class="tabbar">
			<view class="tab-item" @tap="goLearningPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexiweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ learningText }}</text>
			</view>
			<view class="tab-item" @tap="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ examText }}</text>
			</view>
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjiadianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">{{ consultText }}</text>
			</view>
			<view class="tab-item" @tap="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ knowledgeText }}</text>
			</view>
			<view class="tab-item" @tap="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ mineText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { fetchExperts, normalizeAppUrl, type ExpertDetail } from '../../utils/auth.uts'

type CategoryItem = {
	key : string
	categoryId : number
	specialty : string
	name : string
}

type ExpertCard = {
	id : number
	name : string
	shortName : string
	title : string
	organization : string
	specialty : string
	avatarUrl : string
	consultationNotice : string
	avatarFailed : boolean
}

const PAGE_SIZE = 12
const CATEGORY_FETCH_SIZE = 100

const pageTitleText = '\u54a8\u8be2'
const searchPlaceholder = '\u641c\u7d22\u4e13\u5bb6\u59d3\u540d\u3001\u804c\u79f0\u3001\u673a\u6784'
const searchButtonText = '\u641c\u7d22'
const allCategoryText = '\u5168\u90e8'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const emptyExpertText = '\u6682\u65e0\u4e13\u5bb6'
const loadingMoreText = '\u52a0\u8f7d\u66f4\u591a\u4e2d...'
const noMoreText = '\u6ca1\u6709\u66f4\u591a\u4e86'
const loadFailedText = '\u4e13\u5bb6\u52a0\u8f7d\u5931\u8d25'
const myQuestionsText = '\u6211\u7684\u54a8\u8be2'
const learningText = '\u5b66\u4e60'
const examText = '\u8003\u6838'
const consultText = '\u54a8\u8be2'
const knowledgeText = '\u77e5\u8bc6\u5e93'
const mineText = '\u6211\u7684'
const fallbackShortName = '\u533b'
const fallbackExpertName = '\u4e13\u5bb6'
const fallbackCategoryPrefix = '\u4e13\u4e1a\u5206\u7c7b'

const searchKeyword = ref('')
const selectedCategoryKey = ref('all')
const selectedCategoryId = ref(0)
const selectedCategorySpecialty = ref('')
const categoryItems = ref<CategoryItem[]>([])
const expertItems = ref<ExpertCard[]>([])
const page = ref(1)
const hasMore = ref(true)
const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const sanitizeAvatarUrl = (value : string) : string => {
	const avatar = normalizeAppUrl(safeText(value))
	if (avatar.length == 0) {
		return ''
	}
	if (avatar.indexOf('example.com') >= 0) {
		return ''
	}
	return avatar
}

const toShortName = (name : string) : string => {
	const text = safeText(name)
	return text.length > 0 ? text.substring(0, 1) : fallbackShortName
}

const sortCategoryItems = () => {
	categoryItems.value = categoryItems.value.slice().sort((left : CategoryItem, right : CategoryItem) : number => {
		if (left.categoryId > 0 && right.categoryId > 0) {
			return left.categoryId - right.categoryId
		}
		return left.name.localeCompare(right.name)
	})
}

const resolveCategoryName = (detail : ExpertDetail, categoryId : number) : string => {
	const specialty = safeText(detail.specialty)
	if (specialty.length > 0) {
		return specialty
	}

	const title = safeText(detail.title)
	if (title.length > 0) {
		return title
	}

	return fallbackCategoryPrefix + ' ' + String(categoryId)
}

const appendCategoryItems = (detail : ExpertDetail) => {
	const ids = detail.categoryIds != null ? detail.categoryIds : []
	if (ids.length > 0) {
		ids.forEach((categoryId : number) => {
			if (categoryId <= 0) {
				return
			}
			if (categoryItems.value.some((item : CategoryItem) : boolean => item.categoryId == categoryId)) {
				return
			}
			categoryItems.value.push({
				key: 'id:' + String(categoryId),
				categoryId,
				specialty: '',
				name: resolveCategoryName(detail, categoryId)
			})
		})
		return
	}

	const specialty = safeText(detail.specialty)
	if (specialty.length == 0) {
		return
	}
	if (categoryItems.value.some((item : CategoryItem) : boolean => item.specialty == specialty)) {
		return
	}
	categoryItems.value.push({
		key: 'sp:' + specialty,
		categoryId: 0,
		specialty,
		name: specialty
	})
}

const filterExpertsBySelectedCategory = (records : ExpertDetail[]) : ExpertDetail[] => {
	if (selectedCategoryId.value > 0) {
		return records
	}
	if (selectedCategorySpecialty.value.length == 0) {
		return records
	}
	return records.filter((item : ExpertDetail) : boolean => {
		return safeText(item.specialty) == selectedCategorySpecialty.value
	})
}

const resolveRequestPage = (loadMoreValue : boolean) : number => {
	if (selectedCategoryId.value == 0 && selectedCategorySpecialty.value.length > 0) {
		return 1
	}
	return loadMoreValue ? page.value : 1
}

const resolveRequestSize = () : number => {
	if (selectedCategoryId.value == 0 && selectedCategorySpecialty.value.length > 0) {
		return CATEGORY_FETCH_SIZE
	}
	return PAGE_SIZE
}

const resetSelection = () => {
	selectedCategoryKey.value = 'all'
	selectedCategoryId.value = 0
	selectedCategorySpecialty.value = ''
}

const applyCategorySelection = (item : CategoryItem | null) => {
	if (item == null) {
		resetSelection()
		return
	}
	selectedCategoryKey.value = item.key
	selectedCategoryId.value = item.categoryId
	selectedCategorySpecialty.value = item.specialty
}

const rebuildCategories = (records : ExpertDetail[]) => {
	categoryItems.value = []
	records.forEach((detail : ExpertDetail) => {
		appendCategoryItems(detail)
	})
	sortCategoryItems()
}

const mapExpert = (detail : ExpertDetail) : ExpertCard => {
	return {
		id: detail.id,
		name: safeText(detail.realName).length > 0 ? safeText(detail.realName) : fallbackExpertName,
		shortName: toShortName(detail.realName),
		title: safeText(detail.title),
		organization: safeText(detail.organization),
		specialty: safeText(detail.specialty),
		avatarUrl: sanitizeAvatarUrl(detail.avatarUrl),
		consultationNotice: safeText(detail.consultationNotice),
		avatarFailed: false
	}
}

const loadCategories = () => {
	fetchExperts(
		1,
		CATEGORY_FETCH_SIZE,
		'',
		0,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			rebuildCategories(records)
		},
		() => {
		}
	)
}

const loadExperts = (loadMoreValue : boolean) => {
	if (!loadMoreValue) {
		page.value = 1
		hasMore.value = true
		errorText.value = ''
		isLoading.value = true
	} else {
		if (!hasMore.value || isListLoading.value) {
			return
		}
		isListLoading.value = true
	}

	fetchExperts(
		resolveRequestPage(loadMoreValue),
		resolveRequestSize(),
		searchKeyword.value,
		selectedCategoryId.value,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			const filteredRecords = filterExpertsBySelectedCategory(records)
			const mapped = filteredRecords.map((item : ExpertDetail) : ExpertCard => {
				return mapExpert(item)
			})

			if (loadMoreValue) {
				expertItems.value = expertItems.value.concat(mapped)
			} else {
				expertItems.value = mapped
			}

			if (categoryItems.value.length == 0) {
				rebuildCategories(records)
			}

			hasMore.value = selectedCategorySpecialty.value.length == 0 && mapped.length >= PAGE_SIZE
			if (hasMore.value) {
				page.value += 1
			}

			isLoading.value = false
			isListLoading.value = false
		},
		(message) => {
			errorText.value = message.length > 0 ? message : loadFailedText
			isLoading.value = false
			isListLoading.value = false
		}
	)
}

const handleSearch = () => {
	loadExperts(false)
}

const reloadExperts = () => {
	loadExperts(false)
}

const selectCategory = (item : CategoryItem | number) => {
	if (typeof item == 'number' && item == 0) {
		resetSelection()
		loadExperts(false)
		return
	}

	if (typeof item != 'number') {
		applyCategorySelection(item)
	}
	loadExperts(false)
}

const loadMore = () => {
	loadExperts(true)
}

const handleAvatarError = (id : number) => {
	expertItems.value = expertItems.value.map((item : ExpertCard) : ExpertCard => {
		if (item.id != id) {
			return item
		}
		return {
			id: item.id,
			name: item.name,
			shortName: item.shortName,
			title: item.title,
			organization: item.organization,
			specialty: item.specialty,
			avatarUrl: '',
			consultationNotice: item.consultationNotice,
			avatarFailed: true
		}
	})
}

const goDoctorDetail = (doctor : ExpertCard) => {
	uni.navigateTo({
		url:
			'/pages/consult/detail?id=' + String(doctor.id) +
			'&name=' + encodeURIComponent(doctor.name) +
			'&title=' + encodeURIComponent(doctor.title) +
			'&organization=' + encodeURIComponent(doctor.organization) +
			'&specialty=' + encodeURIComponent(doctor.specialty) +
			'&tag=' + encodeURIComponent(doctor.consultationNotice)
	})
}

const goMyQuestions = () => {
	uni.navigateTo({ url: '/pages/consult/questions' })
}

const goLearningPage = () => {
	uni.redirectTo({ url: '/pages/index/index' })
}

const goExamPage = () => {
	uni.redirectTo({ url: '/pages/exam/index' })
}

const goKnowledgePage = () => {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goMinePage = () => {
	uni.redirectTo({ url: '/pages/mine/index' })
}

loadCategories()
loadExperts(false)
</script>

<style>
