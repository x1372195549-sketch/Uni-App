	background-color: #ffffff;
	border-radius: 18rpx;
	flex-direction: row;
	align-items: center;
}

.search-input {
	flex: 1;
	height: 78rpx;
	font-size: 15px;
	color: #303030;
}

.search-btn {
	width: 108rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}

.search-btn-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}

.content-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}

.category-panel {
	width: 196rpx;
	background-color: #f1f2f5;
}

.category-item {
	min-height: 112rpx;
	padding: 18rpx 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}

.category-item-active {
	background-color: #ffffff;
}

.category-line {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 8rpx;
	background-color: #b85d69;
}

.category-text {
	font-size: 15px;
	line-height: 22px;
	color: #8f8f8f;
	text-align: center;
}

.category-text-active {
	color: #b85d69;
	font-weight: 600;
}

.list-panel {
	flex: 1;
	background-color: #ffffff;
}

.state-wrap {
	padding: 120rpx 40rpx;
	align-items: center;
}

.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}

.retry-btn {
	margin-top: 24rpx;
	width: 200rpx;
	height: 68rpx;
	border-radius: 12rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}

.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}

.book-list {
	padding: 16rpx 18rpx 24rpx;
}

.book-card {
	margin-bottom: 18rpx;
	padding: 18rpx;
	border-radius: 16rpx;
	background-color: #fbfaf7;
	flex-direction: row;
	align-items: center;
}

.book-cover-shell {
	width: 132rpx;
	height: 176rpx;
	margin-right: 18rpx;
	border-radius: 10rpx;
	overflow: hidden;
	background-color: #efe3cc;
}

.book-cover {
	width: 132rpx;
	height: 176rpx;
}

.book-main {
	flex: 1;
	min-height: 176rpx;
	justify-content: space-between;
}

.book-title {
	font-size: 16px;
