<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>
			<view class="header">
				<text class="header-title">知识库</text>
			</view>
		</view>

		<view class="search-bar">
			<input
				v-model="searchKeyword"
				class="search-input"
				placeholder="搜索知识条目"
				confirm-type="search"
				@confirm="handleSearch"
			/>
			<view class="search-btn" @click="handleSearch">
				<text class="search-btn-text">搜索</text>
			</view>
		</view>

		<view class="content-shell">
			<scroll-view class="category-panel" scroll-y="true">
				<view
					class="category-item"
					:class="{ 'category-item-active': selectedCategoryId == 0 }"
					@click="selectCategory(0)"
				>
					<view v-if="selectedCategoryId == 0" class="category-line"></view>
					<text
						class="category-text"
						:class="{ 'category-text-active': selectedCategoryId == 0 }"
					>全部</text>
				</view>

				<view
					v-for="item in flatCategories"
					:key="item.id"
					class="category-item"
					:class="{ 'category-item-active': selectedCategoryId == item.id }"
					@click="selectCategory(item.id)"
				>
					<view v-if="selectedCategoryId == item.id" class="category-line"></view>
					<text
						class="category-text"
						:class="{ 'category-text-active': selectedCategoryId == item.id }"
					>{{ item.displayName }}</text>
				</view>
			</scroll-view>

			<scroll-view
				class="list-panel"
				scroll-y="true"
				:refresher-enabled="true"
				:refresher-triggered="isRefreshing"
				@refresherrefresh="handleRefresh"
				@scrolltolower="loadMore"
			>
				<view v-if="isInitialLoading" class="state-wrap">
					<text class="state-text">加载中...</text>
				</view>

				<view v-else-if="errorText.length > 0" class="state-wrap">
					<text class="state-text">{{ errorText }}</text>
					<view class="retry-btn" @click="loadInitialData">
						<text class="retry-btn-text">重新加载</text>
					</view>
				</view>

				<view v-else-if="knowledgeList.length == 0" class="state-wrap">
					<text class="state-text">暂无知识内容</text>
				</view>

				<view v-else class="book-list">
					<view
						v-for="item in knowledgeList"
						:key="item.id"
						class="book-card"
						@click="goKnowledgeDetail(item)"
						>
							<view v-if="item.coverUrl.length > 0" class="book-cover-shell">
								<image
									class="book-cover"
									:src="item.coverUrl"
									mode="aspectFill"
								></image>
							</view>

						<view class="book-main">
							<text class="book-title">{{ item.title }}</text>
							<text v-if="item.summary.length > 0" class="book-summary">{{ item.summary }}</text>
							<text v-if="item.author.length > 0" class="book-meta">作者：{{ item.author }}</text>
							<text v-else-if="item.categoryName.length > 0" class="book-meta">分类：{{ item.categoryName }}</text>
							<view class="book-bottom-row">
								<text class="book-stat">阅读 {{ item.viewCount }}</text>
								<text v-if="item.publishedAt.length > 0" class="book-stat">{{ item.publishedAt }}</text>
							</view>
						</view>
					</view>

					<view v-if="isListLoading" class="bottom-state">
						<text class="bottom-state-text">加载更多中...</text>
					</view>
					<view v-else-if="!hasMore" class="bottom-state">
						<text class="bottom-state-text">没有更多内容了</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<view class="tabbar">
			<view class="tab-item" @click="goLearningPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexiweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">学习</text>
			</view>
			<view class="tab-item" @click="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">咨询</text>
			</view>
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikudianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">知识库</text>
			</view>
			<view class="tab-item" @click="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import {
	fetchKnowledgeCategoryTree,
	fetchKnowledgeEntryDetail,
	fetchKnowledgeEntries,
	type KnowledgeCategory,
	type KnowledgeEntry
} from '../../utils/auth.uts'

const KNOWLEDGE_DETAIL_ID_KEY = 'knowledge_detail_id'

type CategoryDisplayItem = {
	id : number
	displayName : string
}

type KnowledgeDisplayItem = {
	id : number
	title : string
	summary : string
	author : string
	categoryName : string
	coverUrl : string
	viewCount : string
	publishedAt : string
	shortTitle : string
}

const PAGE_SIZE = 10

const searchKeyword = ref('')
const selectedCategoryId = ref(0)
const flatCategories = ref<CategoryDisplayItem[]>([])
const knowledgeList = ref<KnowledgeDisplayItem[]>([])
const page = ref(1)
const hasMore = ref(true)
const isInitialLoading = ref(true)
const isListLoading = ref(false)
const isRefreshing = ref(false)
const errorText = ref('')
const coverLoadingIds = ref<number[]>([])

function safeText(value : string | null) : string {
	return value == null || value.length == 0 ? '' : value
}

function toShortTitle(value : string) : string {
	const title = safeText(value)
	if (title.length == 0) {
		return '知识'
	}
	if (title.length <= 4) {
		return title
	}
	return title.substring(0, 4)
}

function flattenCategories(
	items : KnowledgeCategory[],
	level : number,
	result : CategoryDisplayItem[]
) : void {
	items.forEach((item : KnowledgeCategory) => {
		const indent = level > 0 ? '· '.repeat(level) : ''
		result.push({
			id: item.id,
			displayName: indent + safeText(item.categoryName)
		} as CategoryDisplayItem)

		if (item.children != null && item.children.length > 0) {
			flattenCategories(item.children, level + 1, result)
		}
	})
}

function mapKnowledgeItem(item : KnowledgeEntry) : KnowledgeDisplayItem {
	return {
		id: item.id,
		title: safeText(item.title),
		summary: safeText(item.summary),
		author: safeText(item.author),
		categoryName: safeText(item.categoryName),
		coverUrl: safeText(item.coverUrl),
		viewCount: String(item.viewCount != null ? item.viewCount : 0),
		publishedAt: safeText(item.publishedAt).replace('T', ' '),
		shortTitle: toShortTitle(item.title)
	} as KnowledgeDisplayItem
}

function hasCoverLoading(id : number) : boolean {
	return coverLoadingIds.value.indexOf(id) >= 0
}

function updateKnowledgeCover(id : number, coverUrl : string) : void {
	const normalizedCover = safeText(coverUrl)
	if (normalizedCover.length == 0) {
		return
	}
	knowledgeList.value = knowledgeList.value.map((item : KnowledgeDisplayItem) : KnowledgeDisplayItem => {
		if (item.id == id) {
			return {
				id: item.id,
				title: item.title,
				summary: item.summary,
				author: item.author,
				categoryName: item.categoryName,
				coverUrl: normalizedCover,
				viewCount: item.viewCount,
				publishedAt: item.publishedAt,
				shortTitle: item.shortTitle
			} as KnowledgeDisplayItem
		}
		return item
	})
}

function markCoverLoaded(id : number) : void {
	coverLoadingIds.value = coverLoadingIds.value.filter((itemId : number) : boolean => {
		return itemId != id
	})
}

function hydrateMissingCovers(items : KnowledgeDisplayItem[]) : void {
	items.forEach((item : KnowledgeDisplayItem) => {
		if (item.coverUrl.length > 0 || hasCoverLoading(item.id)) {
			return
		}
		coverLoadingIds.value = coverLoadingIds.value.concat([item.id])
		fetchKnowledgeEntryDetail(
			String(item.id),
			(detail) => {
				updateKnowledgeCover(item.id, detail.coverUrl)
				markCoverLoaded(item.id)
			},
			() => {
				markCoverLoaded(item.id)
			}
		)
	})
}

function loadCategories() : void {
	fetchKnowledgeCategoryTree(
		(categories) => {
			const nextItems = new Array<CategoryDisplayItem>()
			flattenCategories(categories, 0, nextItems)
			flatCategories.value = nextItems
			loadKnowledgeList(false)
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '分类加载失败'
			isInitialLoading.value = false
			isRefreshing.value = false
		}
	)
}

function loadKnowledgeList(loadMore : boolean) : void {
	if (!loadMore) {
		page.value = 1
		hasMore.value = true
		if (!isRefreshing.value) {
			isInitialLoading.value = true
		}
		errorText.value = ''
	} else {
		if (!hasMore.value || isListLoading.value) {
			return
		}
		isListLoading.value = true
	}

	fetchKnowledgeEntries(
		page.value,
		PAGE_SIZE,
		searchKeyword.value,
		selectedCategoryId.value,
		(pageData) => {
			const mapped = pageData.records != null ? pageData.records.map((item : KnowledgeEntry) : KnowledgeDisplayItem => {
				return mapKnowledgeItem(item)
			}) : []

			if (loadMore) {
				knowledgeList.value = knowledgeList.value.concat(mapped)
			} else {
				knowledgeList.value = mapped
			}
			hydrateMissingCovers(mapped)

			hasMore.value = mapped.length >= PAGE_SIZE
			if (hasMore.value) {
				page.value += 1
			}

			isInitialLoading.value = false
			isListLoading.value = false
			isRefreshing.value = false
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '内容加载失败'
			isInitialLoading.value = false
			isListLoading.value = false
			isRefreshing.value = false
		}
	)
}

function loadInitialData() : void {
	loadCategories()
}

function selectCategory(id : number) : void {
	if (selectedCategoryId.value == id) {
		return
	}
	selectedCategoryId.value = id
	loadKnowledgeList(false)
}

function handleSearch() : void {
	loadKnowledgeList(false)
}

function handleRefresh() : void {
	if (isRefreshing.value) {
		return
	}
	isRefreshing.value = true
	loadCategories()
}

function loadMore() : void {
	loadKnowledgeList(true)
}

function goKnowledgeDetail(item : KnowledgeDisplayItem) : void {
	uni.setStorageSync(KNOWLEDGE_DETAIL_ID_KEY, String(item.id))
	uni.navigateTo({
		url: '/pages/knowledge/detail?id=' + String(item.id)
	})
}

function goLearningPage() : void {
	uni.redirectTo({ url: '/pages/index/index' })
}

function goExamPage() : void {
	uni.redirectTo({ url: '/pages/exam/index' })
}

function goMinePage() : void {
	uni.redirectTo({ url: '/pages/mine/index' })
}

function goConsultPage() : void {
	uni.redirectTo({ url: '/pages/consult/index' })
}

loadInitialData()
</script>

<style>
