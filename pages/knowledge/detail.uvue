<template>
	<view class="page">
		<image class="page-bg" src="/static/knowledge-detail-bg.png" mode="scaleToFill"></image>
		<view class="header">
			<view class="header-back" @tap="goBack">
				<image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">{{ title.length > 0 ? title : '知识详情' }}</text>
		</view>

		<scroll-view class="detail-scroll" scroll-y="true">
			<view v-if="isLoading" class="state-wrap">
				<text class="state-text">加载中...</text>
			</view>

			<view v-else-if="errorText.length > 0" class="state-wrap">
				<text class="state-text">{{ errorText }}</text>
				<view class="retry-btn" @tap="loadDetail">
					<text class="retry-btn-text">重新加载</text>
				</view>
			</view>

			<view v-else class="reader-layout">
				<view v-if="showCatalog" class="catalog-page">
					<view class="catalog-hero">
						<view class="cover-shell">
							<image
								v-if="coverUrl.length > 0"
								class="cover-image"
								:src="coverUrl"
								mode="aspectFill"
							></image>
							<view v-else class="cover-fallback">
								<text class="cover-fallback-text">{{ shortTitle }}</text>
							</view>
						</view>

						<view class="catalog-info">
							<view class="catalog-tag-row">
								<text class="catalog-tag">{{ categoryName.length > 0 ? categoryName : '知识库' }}</text>
								<text class="catalog-count">{{ String(sections.length) }} 节</text>
							</view>
							<text class="catalog-book-title">{{ title.length > 0 ? title : '知识条目' }}</text>
							<view class="catalog-data-row">
								<text v-if="publishedAt.length > 0" class="catalog-data">{{ publishedAt }}</text>
								<text class="catalog-data">浏览 {{ viewCount }}</text>
							</view>
						</view>
					</view>

					<view class="catalog-heading">
						<view class="catalog-heading-main">
							<text class="catalog-heading-text">目录</text>
							<text class="catalog-heading-sub">按知识结构快速定位</text>
						</view>
						<view class="catalog-heading-line"></view>
					</view>

					<view class="catalog-list">
						<view
							v-for="item in sections"
							:key="item.index"
							:class="item.index == activeSectionIndex ? 'catalog-item catalog-item-active' : 'catalog-item'"
							@tap="selectSection(item.index)"
						>
							<view class="catalog-icon">
								<text class="catalog-icon-text">{{ String(item.index + 1) }}</text>
							</view>
							<view class="catalog-main">
								<view class="catalog-item-title-row">
									<text class="catalog-item-title">{{ item.title }}</text>
									<text class="catalog-page-no">第 {{ item.pageText }} 页</text>
								</view>
								<text v-if="item.preview.length > 0" class="catalog-item-preview">{{ item.preview }}</text>
							</view>
						</view>
					</view>
				</view>

				<view v-else class="reading-page">
					<view class="reader-head">
						<view class="reader-head-main">
							<text class="reader-kicker">{{ categoryName.length > 0 ? categoryName : '知识库阅读' }}</text>
							<text class="reader-section-title">{{ activeTitle }}</text>
						</view>
						<text class="reader-page-chip">{{ activePageText }} / {{ String(sections.length) }}</text>
					</view>
					<view class="reader-title-underline"></view>
					<view class="reader-meta-row">
						<text v-if="publishedAt.length > 0" class="reader-meta">{{ publishedAt }}</text>
						<text class="reader-meta">浏览 {{ viewCount }}</text>
					</view>

					<rich-text v-if="activeIsHtml" class="rich-content" :nodes="activeContent"></rich-text>
					<view v-else class="reader-text-block">
						<text
							v-for="paragraph in activeParagraphs"
							:key="paragraph"
							class="reader-paragraph"
						>{{ paragraph }}</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<view v-if="!isLoading && errorText.length == 0" class="reader-bottom">
			<view
				:class="activeSectionIndex > 0 ? 'bottom-action' : 'bottom-action bottom-action-disabled'"
				@tap="goPreviousSection"
			>
				<text class="bottom-action-text">上一节</text>
			</view>
			<view class="bottom-action bottom-action-primary" @tap="toggleCatalog">
				<text class="bottom-action-primary-text">{{ showCatalog ? '正文' : '目录' }}</text>
			</view>
			<view
				:class="activeSectionIndex < sections.length - 1 ? 'bottom-action' : 'bottom-action bottom-action-disabled'"
				@tap="goNextSection"
			>
				<text class="bottom-action-text">下一节</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import {
	fetchKnowledgeEntryDetail,
	reportBrowseHistory,
	type KnowledgeEntry
} from '../../utils/auth.uts'

type KnowledgeSection = {
	index : number
	title : string
	content : string
	preview : string
	pageText : string
	isHtml : boolean
}

const KNOWLEDGE_DETAIL_ID_KEY = 'knowledge_detail_id'

const detailId = ref('')
const isLoading = ref(true)
const errorText = ref('')

const title = ref('')
const shortTitle = ref('知识')
const coverUrl = ref('')
const summary = ref('')
const content = ref('')
const categoryName = ref('')
const keywords = ref('')
const source = ref('')
const publishedAt = ref('')
const viewCount = ref('0')

const sections = ref<KnowledgeSection[]>([])
const activeSectionIndex = ref(0)
const activeTitle = ref('正文')
const activeContent = ref('')
const activeParagraphs = ref<string[]>([])
const activeIsHtml = ref(false)
const activePageText = ref('1')
const showCatalog = ref(false)

function safeText(value : string | null) : string {
	return value == null || value.length == 0 ? '' : value
}

function buildShortTitle(value : string) : string {
	const text = safeText(value)
	if (text.length == 0) {
		return '知识'
	}
	return text.length <= 4 ? text : text.substring(0, 4)
}

function detectHtml(value : string) : boolean {
	const text = safeText(value).toLowerCase()
	return text.indexOf('<p') >= 0
		|| text.indexOf('<div') >= 0
		|| text.indexOf('<br') >= 0
		|| text.indexOf('<h1') >= 0
		|| text.indexOf('<h2') >= 0
		|| text.indexOf('<section') >= 0
}

function normalizePlainText(value : string) : string {
	return safeText(value).split('\r').join('\n')
}

function buildParagraphs(value : string) : string[] {
	const lines = normalizePlainText(value).split('\n')
	const result : string[] = []
	for (let i = 0; i < lines.length; i++) {
		const line = lines[i].trim()
		if (line.length > 0) {
			result.push(line)
		}
	}
	if (result.length == 0) {
		result.push('暂无内容')
	}
	return result
}

function buildPreview(value : string) : string {
	const paragraphs = buildParagraphs(value)
	const first = paragraphs.length > 0 ? paragraphs[0] : ''
	if (first.length <= 22) {
		return first
	}
	return first.substring(0, 22) + '...'
}

function addSection(items : KnowledgeSection[], sectionTitle : string, sectionContent : string, isHtml : boolean) : void {
	const text = safeText(sectionContent)
	if (text.length == 0) {
		return
	}
	const index = items.length
	items.push({
		index: index,
		title: sectionTitle,
		content: text,
		preview: isHtml ? '' : buildPreview(text),
		pageText: String(index + 1),
		isHtml: isHtml
	} as KnowledgeSection)
}

function buildSupplementText() : string {
	let text = ''
	if (keywords.value.length > 0) {
		text = text + '关键词：' + keywords.value
	}
	if (source.value.length > 0) {
		if (text.length > 0) {
			text = text + '\n'
		}
		text = text + '来源：' + source.value
	}
	return text
}

function rebuildSections() : void {
	const nextSections : KnowledgeSection[] = []
	addSection(nextSections, '前言', summary.value, false)
	addSection(nextSections, '正文', content.value, detectHtml(content.value))
	addSection(nextSections, '补充信息', buildSupplementText(), false)

	if (nextSections.length == 0) {
		addSection(nextSections, '正文', '暂无内容', false)
	}

	sections.value = nextSections
	selectSection(0)
}

function selectSection(index : number) : void {
	if (index < 0 || index >= sections.value.length) {
		return
	}
	const item = sections.value[index]
	activeSectionIndex.value = index
	activeTitle.value = item.title
	activeContent.value = item.content
	activeIsHtml.value = item.isHtml
	activePageText.value = item.pageText
	activeParagraphs.value = item.isHtml ? [] : buildParagraphs(item.content)
	showCatalog.value = false
}

function toggleCatalog() : void {
	showCatalog.value = !showCatalog.value
}

function goPreviousSection() : void {
	if (activeSectionIndex.value <= 0) {
		return
	}
	selectSection(activeSectionIndex.value - 1)
}

function goNextSection() : void {
	if (activeSectionIndex.value >= sections.value.length - 1) {
		return
	}
	selectSection(activeSectionIndex.value + 1)
}

function applyKnowledgeDetail(detail : KnowledgeEntry) : void {
	title.value = safeText(detail.title)
	shortTitle.value = buildShortTitle(detail.title)
	coverUrl.value = safeText(detail.coverUrl)
	summary.value = safeText(detail.summary)
	content.value = safeText(detail.content)
	categoryName.value = safeText(detail.categoryName)
	keywords.value = safeText(detail.keywords)
	source.value = safeText(detail.source)
	publishedAt.value = safeText(detail.publishedAt).replace('T', ' ')
	viewCount.value = String(detail.viewCount != null ? detail.viewCount : 0)
	rebuildSections()
}

function loadParams(options : UTSJSONObject | null) : void {
	if (options != null) {
		const idValue = options['id']
		const entryIdValue = options['entryId']
		const knowledgeIdValue = options['knowledgeId']
		const contentIdValue = options['contentId']
		if (typeof idValue == 'string' && idValue.length > 0) {
			detailId.value = idValue
			uni.setStorageSync(KNOWLEDGE_DETAIL_ID_KEY, detailId.value)
			return
		}
		if (typeof entryIdValue == 'string' && entryIdValue.length > 0) {
			detailId.value = entryIdValue
			uni.setStorageSync(KNOWLEDGE_DETAIL_ID_KEY, detailId.value)
			return
		}
		if (typeof knowledgeIdValue == 'string' && knowledgeIdValue.length > 0) {
			detailId.value = knowledgeIdValue
			uni.setStorageSync(KNOWLEDGE_DETAIL_ID_KEY, detailId.value)
			return
		}
		if (typeof contentIdValue == 'string' && contentIdValue.length > 0) {
			detailId.value = contentIdValue
			uni.setStorageSync(KNOWLEDGE_DETAIL_ID_KEY, detailId.value)
			return
		}
	}

	const cachedId = uni.getStorageSync(KNOWLEDGE_DETAIL_ID_KEY)
	if (typeof cachedId == 'string' && cachedId.length > 0) {
		detailId.value = cachedId
	}
}

function reportBrowse() : void {
	if (detailId.value.length == 0) {
		return
	}
	reportBrowseHistory(
		{
			resourceType: 'knowledge',
			resourceId: Number(detailId.value)
		},
		() => {
		},
		() => {
		}
	)
}

function loadDetail() : void {
	if (detailId.value.length == 0) {
		errorText.value = '缺少知识条目 ID'
		isLoading.value = false
		return
	}

	isLoading.value = true
	errorText.value = ''

	fetchKnowledgeEntryDetail(
		detailId.value,
		(detail) => {
			applyKnowledgeDetail(detail)
			isLoading.value = false
			reportBrowse()
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '详情加载失败'
			isLoading.value = false
		}
	)
}

function goBack() : void {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

onLoad((options) => {
	loadParams(options as UTSJSONObject)
	loadDetail()
})
</script>

