@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.header {
	height: calc(96rpx + var(--status-bar-height));
	padding-top: var(--status-bar-height);
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #eceaf1;
}
.back-btn {
	position: absolute;
	left: 18rpx;
	bottom: 14rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2a2a2a;
	font-weight: 700;
}
.content {
	flex: 1;
}
.chapter-card {
	margin: 20rpx 18rpx 40rpx;
	padding: 28rpx 24rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
}
.chapter-title {
	font-size: 20px;
	line-height: 30px;
	color: #252525;
	font-weight: 700;
}
.chapter-meta-row {
	margin-top: 16rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.chapter-meta {
	margin-right: 18rpx;
	font-size: 12px;
	line-height: 18px;
	color: #999999;
}
.rich-content {
	margin-top: 24rpx;
}
.chapter-text {
	margin-top: 24rpx;
	font-size: 15px;
	line-height: 28px;
	color: #4f4f4f;
}
.state-wrap {
	padding: 180rpx 40rpx 0;
	align-items: center;
}
.state-text {
	font-size: 14px;
	color: #a8a8b2;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 200rpx;
	height: 68rpx;
	border-radius: 12rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
