@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.hero-shell {
	position: relative;
	height: 254rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 254rpx;
}
.header {
	position: relative;
	z-index: 1;
	height: 146rpx;
	padding-top: 62rpx;
	align-items: center;
	justify-content: center;
}
.top-tabs {
	position: relative;
	z-index: 1;
	height: 108rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.top-tab {
	min-width: 78rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}
.top-tab-text {
	font-size: 15px;
	line-height: 22px;
	color: #333333;
}
.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}
.top-tab-line {
	margin-top: 12rpx;
	width: 40rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.search-bar {
	margin: 16rpx 20rpx 12rpx;
	height: 78rpx;
	padding: 0 12rpx 0 24rpx;
	background-color: #ffffff;
	border-radius: 18rpx;
	flex-direction: row;
	align-items: center;
}
.search-input {
	flex: 1;
	height: 78rpx;
	font-size: 15px;
	color: #303030;
}
.search-btn {
	width: 108rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.search-btn-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}
.category-scroll {
	height: 76rpx;
	background-color: #ffffff;
	white-space: nowrap;
}
.category-row {
	flex-direction: row;
	padding: 0 20rpx;
}
.category-item {
	height: 76rpx;
	margin-right: 18rpx;
	padding: 0 24rpx;
	align-items: center;
	justify-content: center;
	border-bottom-width: 4rpx;
	border-bottom-style: solid;
	border-bottom-color: transparent;
}
.category-item-active {
	border-bottom-color: #d56d79;
}
.category-text {
	font-size: 14px;
	color: #4b4b4b;
}
.category-text-active {
	color: #d56d79;
	font-weight: 600;
}
.book-scroll {
	flex: 1;
	padding-bottom: 112rpx;
}
.book-list {
	padding: 18rpx 20rpx 128rpx;
}
.book-card {
	margin-bottom: 18rpx;
	padding: 18rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	flex-direction: row;
	box-shadow: 0 8rpx 24rpx rgba(110, 100, 80, 0.06);
}
.cover-shell {
	width: 150rpx;
	height: 200rpx;
	margin-right: 18rpx;
	border-radius: 14rpx;
	overflow: hidden;
	background-color: #eadcc4;
}
.cover-image {
	width: 150rpx;
	height: 200rpx;
}
.cover-fallback {
	width: 150rpx;
	height: 200rpx;
	align-items: center;
	justify-content: center;
	background-color: #eadcc4;
}
.cover-fallback-text {
	font-size: 18px;
	line-height: 26px;
	color: #806b4d;
	font-weight: 700;
	text-align: center;
}
.book-main {
	flex: 1;
	min-height: 200rpx;
}
.book-title {
	font-size: 17px;
	line-height: 25px;
	color: #252525;
	font-weight: 700;
}
.book-meta {
	margin-top: 8rpx;
	font-size: 13px;
	line-height: 20px;
	color: #8e8e8e;
}
.book-summary {
	margin-top: 8rpx;
	font-size: 13px;
	line-height: 20px;
	color: #777777;
	height: 40rpx;
	overflow: hidden;
}
.progress-wrap {
	margin-top: 14rpx;
	flex-direction: row;
	align-items: center;
}
.progress-bg {
	flex: 1;
	height: 10rpx;
	border-radius: 999rpx;
	background-color: #eeeeee;
	overflow: hidden;
}
.progress-fill {
	height: 10rpx;
	border-radius: 999rpx;
	background-color: #18b775;
}
.progress-text {
	margin-left: 12rpx;
	font-size: 12px;
	color: #9b9b9b;
}
.book-bottom {
	margin-top: 14rpx;
	flex-direction: row;
	justify-content: space-between;
}
.book-stat {
	font-size: 12px;
	color: #ababab;
}
.state-wrap {
	padding: 160rpx 40rpx 0;
	align-items: center;
}
.state-text {
	font-size: 14px;
	color: #9c9c9c;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 200rpx;
	height: 68rpx;
	border-radius: 12rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.bottom-state {
	padding: 14rpx 0 18rpx;
	align-items: center;
}
.bottom-state-text {
	font-size: 12px;
	color: #b1b1b1;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 104rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1rpx;
	border-top-style: solid;
	border-top-color: #eceaf1;
	flex-direction: row;
}
.tab-item {
	flex: 1;
	align-items: center;
	justify-content: center;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
}
.tab-label {
	margin-top: 6rpx;
	font-size: 20rpx;
	color: #a8a8b2;
}
.tab-label-active {
	color: #18b775;
	font-weight: 600;
}
