<view id="{{A}}" change:eS="{{uV.sS}}" eS="{{$eS[A]}}" change:eA="{{uV.sA}}" eA="{{$eA[A]}}" class="{{['page', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="header"><view class="back-btn" bindtap="{{b}}"><image class="back-icon" src="{{a}}" mode="aspectFit"></image></view><text class="header-title">图书详情</text></view><scroll-view class="content" scroll-y="true" enable-flex="true" enhanced="true"><view wx:if="{{c}}" class="state-wrap"><text class="state-text">加载中...</text></view><view wx:elif="{{d}}" class="state-wrap"><text class="state-text">{{e}}</text><view class="retry-btn" bindtap="{{f}}"><text class="retry-btn-text">重新加载</text></view></view><view wx:else class="detail-body"><view class="book-hero"><view class="cover-shell"><image wx:if="{{g}}" class="cover-image" src="{{h}}" mode="aspectFill"></image><view wx:else class="cover-fallback"><text class="cover-fallback-text">{{i}}</text></view></view><view class="hero-main"><text class="book-title">{{j}}</text><text class="book-meta">{{k}}</text><text wx:if="{{l}}" class="book-meta">{{m}}</text><view class="stat-row"><text class="stat-text">阅读 {{n}}</text><text class="stat-text">收藏 {{o}}</text></view><view class="favorite-btn" bindtap="{{q}}"><text class="favorite-btn-text">{{p}}</text></view></view></view><view class="section-card"><text class="section-title">简介</text><text class="section-text">{{r}}</text></view><view class="section-card"><text class="section-title">学习进度</text><view class="progress-row"><view class="progress-bg"><view class="progress-fill" style="{{s}}"></view></view><text class="progress-text">{{t}}%</text></view><text class="section-text">已学习 {{v}} 分钟，共 {{w}}</text></view><view class="section-card"><view class="section-head"><text class="section-title">章节目录</text><text class="section-more">{{x}} 章</text></view><view wx:if="{{y}}" class="chapter-empty"><text class="chapter-empty-text">暂无章节</text></view><view wx:for="{{z}}" wx:for-item="item" wx:key="e" class="chapter-item" bindtap="{{item.f}}"><view class="chapter-main"><text class="chapter-title">{{item.a}}</text><text class="chapter-meta">起始页 {{item.b}} · 页数 {{item.c}}</text></view><text class="chapter-arrow">{{item.d}}</text></view></view></view></scroll-view></view><wxs src="/common/uniView.wxs" module="uV"/>
