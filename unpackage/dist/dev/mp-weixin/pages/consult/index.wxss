@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.hero-shell {
	position: relative;
	height: 146rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 264rpx;
}
.header {
	position: relative;
	z-index: 1;
	height: 146rpx;
	padding-top: 62rpx;
	align-items: center;
	justify-content: center;
	background-color: transparent;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
	width: 100%;
	text-align: center;
}
.search-bar {
	margin-left: 16rpx;
	margin-right: 16rpx;
	margin-top: 14rpx;
	margin-bottom: 14rpx;
	padding-left: 18rpx;
	padding-right: 10rpx;
	height: 78rpx;
	border-radius: 18rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
}
.search-input {
	flex: 1;
	height: 78rpx;
	font-size: 15px;
	color: #303030;
}
.search-btn {
	width: 108rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.search-btn-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}
.content-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}
.category-panel {
	width: 184rpx;
	background-color: #f1f2f5;
}
.category-item {
	min-height: 112rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}
.category-item-active {
	background-color: #ffffff;
}
.category-line {
	position: absolute;
	left: 0;
	top: 18rpx;
	bottom: 18rpx;
	width: 8rpx;
	border-radius: 0 8rpx 8rpx 0;
	background-color: #d26978;
}
.category-text {
	font-size: 15px;
	line-height: 22px;
	color: #7f8590;
	text-align: center;
}
.category-text-active {
	color: #c9636f;
	font-weight: 600;
}
.doctor-panel {
	flex: 1;
	background-color: #ffffff;
}
.state-wrap {
	padding: 120rpx 30rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	color: #9b9b9b;
	line-height: 22px;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.doctor-grid {
	padding: 16rpx 18rpx 28rpx;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-start;
}
.doctor-card {
	width: 154rpx;
	margin-right: 14rpx;
	margin-bottom: 20rpx;
	background-color: #ffffff;
	border-radius: 14rpx;
	padding: 14rpx 12rpx 16rpx;
	box-shadow: 0 8rpx 18rpx rgba(78, 82, 63, 0.08);
	align-items: center;
}
.doctor-card:nth-child(3n) {
	margin-right: 0;
}
.doctor-avatar-wrap {
	width: 110rpx;
	height: 110rpx;
	border-radius: 55rpx;
	overflow: hidden;
	background-color: #eef6ff;
	align-items: center;
	justify-content: center;
	margin-bottom: 12rpx;
}
.doctor-avatar {
	width: 110rpx;
	height: 110rpx;
	border-radius: 55rpx;
}
.doctor-avatar-placeholder {
	background-color: #d9eef8;
}
.doctor-avatar-text {
	font-size: 30px;
	font-weight: 600;
	color: #2e8aa7;
}
.doctor-name {
	margin-top: 4rpx;
	font-size: 17px;
	line-height: 24px;
	color: #2f2f2f;
	font-weight: 600;
	text-align: center;
}
.doctor-title {
	margin-top: 6rpx;
	font-size: 12px;
	line-height: 18px;
	color: #18b775;
}
.doctor-organization {
	margin-top: 6rpx;
	font-size: 11px;
	line-height: 16px;
	color: #999999;
	text-align: center;
}
.doctor-brief {
	margin-top: 8rpx;
	width: 100%;
	height: 48rpx;
	overflow: hidden;
	font-size: 11px;
	line-height: 16px;
	color: #b4b4b4;
	text-align: left;
}
.bottom-state {
	width: 100%;
	padding-top: 20rpx;
	align-items: center;
}
.bottom-state-text {
	font-size: 12px;
	color: #b1b1b1;
}
.floating-action {
	position: absolute;
	right: 20rpx;
	bottom: 124rpx;
	width: 148rpx;
	height: 62rpx;
	border-radius: 31rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
	box-shadow: 0 12rpx 24rpx rgba(24, 183, 117, 0.22);
}
.floating-action-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #ececec;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-icon-image {
	width: 40rpx;
	height: 40rpx;
}
.tab-label {
	margin-top: 6rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b4b4b4;
}
.tab-label-active {
	color: #18b775;
	font-weight: 600;
}
