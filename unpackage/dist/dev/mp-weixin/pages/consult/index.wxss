@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
}
.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 24px;
	line-height: 34px;
	color: #2f2f2f;
	font-weight: 600;
}
.content-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}
.category-panel {
	width: 190rpx;
	background-color: #f1f2f5;
}
.category-item {
	min-height: 96rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-top: 18rpx;
	padding-bottom: 18rpx;
	justify-content: center;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #e6e6e9;
	position: relative;
}
.category-item-active {
	background-color: #ffffff;
}
.category-line {
	position: absolute;
	left: 0;
	top: 18rpx;
	bottom: 18rpx;
	width: 8rpx;
	border-radius: 0 8rpx 8rpx 0;
	background-color: #2fdc96;
}
.category-text {
	font-size: 16px;
	line-height: 24px;
	color: #7f8590;
	text-align: center;
}
.category-text-active {
	color: #2f2f2f;
	font-weight: 600;
}
.doctor-panel {
	flex: 1;
	background-color: #ffffff;
}
.doctor-grid {
	padding: 16rpx 18rpx 28rpx;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}
.doctor-card {
	width: 154rpx;
	margin-bottom: 20rpx;
	background-color: #ffffff;
	border-radius: 14rpx;
	padding: 14rpx 10rpx 16rpx;
	box-shadow: 0 8rpx 18rpx rgba(78, 82, 63, 0.08);
	align-items: center;
}
.doctor-avatar-wrap {
	width: 110rpx;
	height: 110rpx;
	border-radius: 55rpx;
	overflow: hidden;
	background-color: #eef6ff;
	align-items: center;
	justify-content: center;
	margin-bottom: 12rpx;
}
.doctor-avatar {
	width: 110rpx;
	height: 110rpx;
	border-radius: 55rpx;
}
.doctor-avatar-placeholder {
	background-color: #d9eef8;
}
.doctor-avatar-text {
	font-size: 30px;
	font-weight: 600;
	color: #2e8aa7;
}
.doctor-name {
	font-size: 18px;
	line-height: 26px;
	color: #2f2f2f;
	font-weight: 600;
}
.doctor-brief {
	margin-top: 8rpx;
	font-size: 11px;
	line-height: 16px;
	color: #b4b4b4;
	text-align: center;
	height: 48rpx;
}
.doctor-tag {
	margin-top: 10rpx;
	padding: 4rpx 10rpx;
	border-radius: 8rpx;
	border-width: 1px;
	border-style: solid;
	border-color: #36b979;
	font-size: 10px;
	line-height: 16px;
	color: #36b979;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #ececec;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-icon-image {
	width: 40rpx;
	height: 40rpx;
}
.tab-label {
	margin-top: 6rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b4b4b4;
}
.tab-label-active {
	color: #18b775;
	font-weight: 600;
}
