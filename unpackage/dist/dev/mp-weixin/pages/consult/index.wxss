@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.hero-shell {
	position: relative;
	height: 118rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 236rpx;
}
.header {
	position: relative;
	z-index: 1;
	height: 118rpx;
	padding-top: 34rpx;
	align-items: center;
	justify-content: center;
	background-color: transparent;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
	width: 100%;
	text-align: center;
}
.content-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}
.category-panel {
	width: 184rpx;
	background-color: #f1f2f5;
}
.category-group {
	background-color: #f1f2f5;
}
.category-item {
	height: 118rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}
.category-item-active {
	background-color: #ffffff;
}
.subcategory-wrap {
	background-color: #f1f2f5;
}
.subcategory-item {
	height: 110rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}
.subcategory-item-active {
	background-color: #ffffff;
}
.category-line {
	position: absolute;
	left: 0;
	top: 18rpx;
	bottom: 18rpx;
	width: 8rpx;
	border-radius: 0 8rpx 8rpx 0;
	background-color: #d26978;
}
.subcategory-line {
	top: 18rpx;
	bottom: 18rpx;
}
.category-text {
	font-size: 16px;
	line-height: 24px;
	color: #7f8590;
	text-align: center;
}
.category-text-active {
	color: #c9636f;
	font-weight: 600;
}
.subcategory-text {
	font-size: 15px;
	line-height: 22px;
	color: #9ca3ad;
	text-align: center;
}
.subcategory-text-active {
	color: #6b707a;
	font-weight: 500;
}
.doctor-panel {
	flex: 1;
	background-color: #ffffff;
}
.doctor-grid {
	padding: 16rpx 18rpx 28rpx;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-start;
}
.doctor-card {
	width: 154rpx;
	margin-right: 14rpx;
	margin-bottom: 20rpx;
	background-color: #ffffff;
	border-radius: 14rpx;
	padding: 14rpx 12rpx 16rpx;
	box-shadow: 0 8rpx 18rpx rgba(78, 82, 63, 0.08);
	align-items: center;
}
.doctor-card:nth-child(3n) {
	margin-right: 0;
}
.doctor-avatar-wrap {
	width: 110rpx;
	height: 110rpx;
	border-radius: 55rpx;
	overflow: hidden;
	background-color: #eef6ff;
	align-items: center;
	justify-content: center;
	margin-bottom: 12rpx;
}
.doctor-avatar {
	width: 110rpx;
	height: 110rpx;
	border-radius: 55rpx;
}
.doctor-avatar-placeholder {
	background-color: #d9eef8;
}
.doctor-avatar-text {
	font-size: 30px;
	font-weight: 600;
	color: #2e8aa7;
}
.doctor-name {
	margin-top: 4rpx;
	font-size: 18px;
	line-height: 26px;
	color: #2f2f2f;
	font-weight: 600;
}
.doctor-brief {
	margin-top: 8rpx;
	width: 100%;
	height: 90rpx;
	overflow: hidden;
	font-size: 11px;
	line-height: 15px;
	color: #b4b4b4;
	text-align: left;
}
.doctor-tag {
	margin-top: 10rpx;
	padding: 3rpx 10rpx;
	border-radius: 8rpx;
	border-width: 1px;
	border-style: solid;
	border-color: #36b979;
	font-size: 9px;
	line-height: 13px;
	color: #36b979;
	align-self: flex-start;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #ececec;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-icon-image {
	width: 40rpx;
	height: 40rpx;
}
.tab-label {
	margin-top: 6rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b4b4b4;
}
.tab-label-active {
	color: #18b775;
	font-weight: 600;
}
