@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
	position: relative;
}
.page-top-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 750rpx;
	height: 300rpx;
	background-image: url('data:image/png;base64,');
	background-repeat: no-repeat;
	background-position: left top;
	background-size: 750rpx 300rpx;
	z-index: 0;
}
.nav-back {
	position: absolute;
	top: 86rpx;
	left: 12rpx;
	width: 56rpx;
	height: 56rpx;
	align-items: center;
	justify-content: center;
	z-index: 3;
}
.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header {
	padding-top: 96rpx;
	align-items: center;
	position: relative;
	z-index: 2;
	min-height: 56rpx;
}
.header-title {
	position: absolute;
	left: 0;
	right: 0;
	font-size: 19px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 600;
	text-align: center;
}
.scroll {
	flex: 1;
	padding-top: 24rpx;
	position: relative;
	z-index: 1;
}
.hero-spacer {
	height: 180rpx;
}
.hero-card {
	margin-left: 18rpx;
	margin-right: 18rpx;
	border-radius: 22rpx;
	overflow: hidden;
	background-color: #ffffff;
	position: relative;
	margin-top: -24rpx;
}
.hero-overlay {
	position: relative;
	z-index: 1;
	padding: 24rpx 22rpx 26rpx;
	align-items: center;
	background-color: rgba(255, 255, 255, 0.98);
}
.avatar-image,
.avatar-circle {
	width: 160rpx;
	height: 160rpx;
	border-radius: 80rpx;
	border-width: 8rpx;
	border-style: solid;
	border-color: #3dbfe2;
	background-color: #d9eef8;
	margin-top: 0;
}
.avatar-circle {
	align-items: center;
	justify-content: center;
}
.avatar-text {
	font-size: 54px;
	font-weight: 600;
	color: #2b829f;
}
.hero-info {
	width: 100%;
	margin-top: 18rpx;
}
.meta-row {
	margin-top: 10rpx;
	flex-direction: row;
	align-items: flex-start;
}
.meta-label {
	font-size: 15px;
	line-height: 22px;
	color: #8a8f98;
}
.meta-value {
	flex: 1;
	font-size: 15px;
	line-height: 22px;
	color: #8a8f98;
}
.name-row {
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
}
.doctor-name {
	font-size: 24px;
	line-height: 34px;
	color: #2f2f2f;
	font-weight: 600;
}
.doctor-title {
	margin-left: 18rpx;
	font-size: 16px;
	line-height: 24px;
	color: #1db56f;
	font-weight: 600;
}
.section-card {
	margin-top: 18rpx;
	margin-left: 18rpx;
	margin-right: 18rpx;
	padding: 22rpx 24rpx;
	border-radius: 18rpx;
	background-color: #ffffff;
}
.section-head {
	flex-direction: row;
	align-items: center;
}
.section-line {
	width: 8rpx;
	height: 28rpx;
	border-radius: 8rpx;
	background-color: #18b775;
	margin-right: 14rpx;
}
.section-title {
	font-size: 19px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.section-content {
	margin-top: 20rpx;
	font-size: 15px;
	line-height: 28px;
	color: #6e7680;
}
.experience-item {
	padding-top: 18rpx;
	padding-bottom: 18rpx;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ececec;
}
.experience-item:last-child {
	border-bottom-width: 0;
	padding-bottom: 0;
}
.experience-title {
	font-size: 16px;
	line-height: 24px;
	color: #2f2f2f;
	font-weight: 600;
}
.experience-time {
	margin-top: 8rpx;
	font-size: 13px;
	line-height: 18px;
	color: #9aa0a8;
}
.experience-description {
	margin-top: 10rpx;
	font-size: 14px;
	line-height: 22px;
	color: #6e7680;
}
.action-section {
	padding: 20rpx 18rpx 48rpx;
}
.consult-btn {
	height: 88rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	color: #ffffff;
	font-size: 18px;
	line-height: 88rpx;
}
.consult-btn-hover {
	opacity: 0.92;
}
.secondary-btn {
	margin-top: 20rpx;
	height: 88rpx;
	border-radius: 14rpx;
	background-color: #ffffff;
	color: #18b775;
	font-size: 18px;
	line-height: 88rpx;
	border-width: 2rpx;
	border-style: solid;
	border-color: #18b775;
}
.secondary-btn-hover {
	opacity: 0.92;
}
