@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
	position: relative;
}
.top-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 750rpx;
	height: 240rpx;
	opacity: 0.18;
}
.nav-back {
	position: absolute;
	top: 98rpx;
	left: 12rpx;
	width: 56rpx;
	height: 56rpx;
	align-items: center;
	justify-content: center;
	z-index: 5;
}
.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header {
	padding-top: 112rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	align-items: center;
	justify-content: center;
	position: relative;
	z-index: 2;
	min-height: 72rpx;
}
.header-title {
	font-size: 19px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 600;
	text-align: center;
	width: 100%;
}
.content-scroll {
	flex: 1;
	padding-top: 52rpx;
	position: relative;
	z-index: 1;
}
.content {
	padding: 0 20rpx 150rpx;
}
.expert-card,
.form-card {
	background-color: #ffffff;
	border-radius: 18rpx;
	padding: 24rpx;
	margin-bottom: 20rpx;
}
.expert-caption,
.field-label {
	font-size: 14px;
	color: #8a8f98;
}
.expert-value {
	margin-top: 14rpx;
	font-size: 18px;
	color: #2f2f2f;
	font-weight: 600;
}
.field-input {
	margin-top: 12rpx;
	height: 76rpx;
	padding: 0 20rpx;
	background-color: #f7f7f2;
	border-radius: 12rpx;
	font-size: 15px;
	color: #2f2f2f;
}
.field-label-gap {
	margin-top: 24rpx;
}
.field-textarea {
	margin-top: 12rpx;
	width: 100%;
	height: 280rpx;
	padding: 20rpx;
	background-color: #f7f7f2;
	border-radius: 12rpx;
	font-size: 15px;
	color: #2f2f2f;
}
.field-count {
	margin-top: 10rpx;
	font-size: 12px;
	color: #b1b1b1;
	text-align: right;
}
.bottom-bar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 20rpx 24rpx 28rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #ececec;
	z-index: 5;
}
.submit-btn {
	height: 88rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.submit-btn-text {
	font-size: 18px;
	line-height: 26px;
	color: #ffffff;
	font-weight: 600;
}
