@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f4ee;
}
.hero-shell {
	position: relative;
	height: 146rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 264rpx;
}
.header {
	position: relative;
	z-index: 1;
	height: 146rpx;
	padding-top: 62rpx;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
	width: 100%;
	text-align: center;
}
.content {
	flex: 1;
	padding-bottom: 120rpx;
}
.banner {
	position: relative;
	margin-left: 24rpx;
	margin-right: 24rpx;
	margin-top: 18rpx;
	height: 280rpx;
	border-radius: 22rpx;
	overflow: hidden;
}
.banner-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
}
.banner-overlay {
	position: relative;
	width: 100%;
	height: 100%;
	padding-left: 34rpx;
	padding-right: 30rpx;
	padding-top: 34rpx;
	background-color: rgba(0, 0, 0, 0.04);
}
.banner-left {
	justify-content: flex-start;
}
.banner-title {
	font-size: 30px;
	line-height: 40px;
	color: #ffffff;
	font-weight: 700;
}
.banner-note {
	margin-left: 24rpx;
	margin-right: 24rpx;
	padding: 22rpx 22rpx 14rpx;
	border-bottom-left-radius: 22rpx;
	border-bottom-right-radius: 22rpx;
	background-color: #ffffff;
}
.banner-note-row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 12rpx;
}
.banner-dot {
	width: 12rpx;
	height: 12rpx;
	border-radius: 999rpx;
	background-color: #12b368;
	margin-right: 14rpx;
}
.banner-note-text {
	font-size: 14px;
	line-height: 22px;
	color: #4b4b4b;
}
.source-box {
	margin-left: 24rpx;
	margin-right: 24rpx;
	margin-top: 18rpx;
	padding: 18rpx 20rpx;
	border-radius: 16rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
}
.source-label {
	font-size: 14px;
	line-height: 20px;
	color: #8c8c8c;
}
.source-text {
	flex: 1;
	font-size: 14px;
	line-height: 20px;
	color: #2f2f2f;
}
.state-wrap {
	padding: 120rpx 30rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.paper-list {
	padding-left: 24rpx;
	padding-right: 24rpx;
	padding-top: 18rpx;
}
.paper-card {
	background-color: #ffffff;
	border-radius: 18rpx;
	padding: 26rpx 24rpx;
	margin-bottom: 18rpx;
	flex-direction: row;
	align-items: center;
}
.paper-text-box {
	flex: 1;
}
.paper-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.paper-desc {
	margin-top: 10rpx;
	font-size: 13px;
	line-height: 20px;
	color: #777777;
}
.paper-subtitle {
	margin-top: 12rpx;
	font-size: 14px;
	line-height: 20px;
	color: #9b9b9b;
}
.paper-meta {
	margin-top: 8rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b1b1b1;
}
.paper-action {
	margin-left: 18rpx;
	width: 148rpx;
	height: 60rpx;
	border-radius: 999rpx;
	background-color: #12b368;
	align-items: center;
	justify-content: center;
}
.paper-action-text {
	font-size: 14px;
	line-height: 20px;
	color: #ffffff;
	font-weight: 600;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 104rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #ebe7df;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-icon {
	width: 36rpx;
	height: 36rpx;
}
.tab-text {
	margin-top: 8rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b7b7b7;
}
.tab-text-active {
	color: #12b368;
	font-weight: 600;
}
