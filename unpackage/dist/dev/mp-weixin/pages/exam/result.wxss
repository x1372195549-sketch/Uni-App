@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #ffffff;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
}
.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 16px;
	line-height: 24px;
	color: #2f2f2f;
	font-weight: 500;
}
.state-wrap {
	flex: 1;
	padding: 120rpx 30rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.result-scroll {
	flex: 1;
}
.result-body {
	padding: 40rpx 24rpx 48rpx;
	align-items: center;
}
.trophy-box {
	width: 260rpx;
	height: 280rpx;
	position: relative;
	align-items: center;
}
.trophy-left {
	position: absolute;
	left: 18rpx;
	top: 58rpx;
	width: 54rpx;
	height: 86rpx;
	border-top-left-radius: 54rpx;
	border-bottom-left-radius: 54rpx;
	border-width: 16rpx;
	border-style: solid;
	border-right-width: 0;
	border-color: #d89f15;
}
.trophy-right {
	position: absolute;
	right: 18rpx;
	top: 58rpx;
	width: 54rpx;
	height: 86rpx;
	border-top-right-radius: 54rpx;
	border-bottom-right-radius: 54rpx;
	border-width: 16rpx;
	border-style: solid;
	border-left-width: 0;
	border-color: #d89f15;
}
.trophy-cup {
	margin-top: 20rpx;
	width: 170rpx;
	height: 132rpx;
	border-bottom-left-radius: 36rpx;
	border-bottom-right-radius: 36rpx;
	border-top-left-radius: 24rpx;
	border-top-right-radius: 24rpx;
	background-color: #e0ab22;
	align-items: center;
	justify-content: center;
}
.trophy-star {
	width: 52rpx;
	height: 52rpx;
	border-radius: 12rpx;
	background-color: rgba(255, 235, 170, 0.45);
}
.trophy-stem {
	margin-top: 8rpx;
	width: 54rpx;
	height: 64rpx;
	background-color: #d59816;
}
.trophy-base {
	margin-top: 8rpx;
	width: 148rpx;
	height: 30rpx;
	border-radius: 12rpx;
	background-color: #bf7c09;
}
.paper-name {
	margin-top: 12rpx;
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
	text-align: center;
}
.score-text {
	margin-top: 18rpx;
	font-size: 22px;
	line-height: 32px;
	color: #e04f36;
	font-weight: 700;
}
.result-text {
	margin-top: 16rpx;
	font-size: 16px;
	line-height: 24px;
	color: #555555;
}
.answer-list {
	width: 100%;
	margin-top: 28rpx;
}
.answer-card {
	padding: 22rpx;
	margin-bottom: 16rpx;
	border-radius: 20rpx;
	background-color: #f8f6f1;
}
.answer-head {
	flex-direction: row;
	align-items: flex-start;
	justify-content: space-between;
}
.answer-title {
	flex: 1;
	font-size: 15px;
	line-height: 24px;
	color: #2f2f2f;
	font-weight: 600;
}
.answer-status {
	margin-left: 18rpx;
	font-size: 13px;
	line-height: 20px;
	font-weight: 600;
}
.answer-status-correct {
	color: #16a34a;
}
.answer-status-wrong {
	color: #d14d41;
}
.answer-meta {
	margin-top: 10rpx;
	font-size: 13px;
	line-height: 20px;
	color: #666666;
}
.answer-analysis {
	margin-top: 10rpx;
	font-size: 13px;
	line-height: 20px;
	color: #8a6a4c;
}
.action-row {
	width: 100%;
	margin-top: 16rpx;
	flex-direction: row;
}
.action-btn {
	flex: 1;
	height: 76rpx;
	border-radius: 16rpx;
	align-items: center;
	justify-content: center;
}
.action-btn-light {
	margin-right: 12rpx;
	background-color: #eef0f2;
}
.action-btn-primary {
	margin-left: 12rpx;
	background-color: #12b368;
}
.action-btn-light-text {
	font-size: 15px;
	line-height: 22px;
	color: #2f2f2f;
	font-weight: 600;
}
.action-btn-primary-text {
	font-size: 15px;
	line-height: 22px;
	color: #ffffff;
	font-weight: 600;
}
