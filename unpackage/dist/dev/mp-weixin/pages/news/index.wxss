@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.hero-shell {
	position: relative;
	height: 244rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 244rpx;
}
.header {
	position: relative;
	z-index: 1;
	padding-top: 62rpx;
	height: 136rpx;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.top-tabs {
	position: relative;
	z-index: 1;
	height: 108rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}
.top-tab {
	min-width: 78rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}
.top-tab-active {
	position: relative;
}
.top-tab-text {
	font-size: 15px;
	line-height: 22px;
	color: #333333;
}
.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}
.top-tab-line {
	position: absolute;
	bottom: 12rpx;
	width: 42rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.search-bar {
	margin: 0 20rpx 0;
	padding-left: 18rpx;
	padding-right: 10rpx;
	height: 76rpx;
	border-radius: 18rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
}
.search-input {
	flex: 1;
	height: 76rpx;
	font-size: 14px;
	color: #2f2f2f;
}
.search-btn {
	width: 108rpx;
	height: 54rpx;
	border-radius: 27rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.search-btn-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}
.content {
	flex: 1;
	padding-bottom: 110rpx;
}
.content-shell {
	padding: 8rpx 20rpx 36rpx;
}
.state-wrap {
	padding: 120rpx 30rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.article-list {
	padding-top: 2rpx;
}
.article-card {
	margin-bottom: 18rpx;
	padding: 16rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	flex-direction: row;
	box-shadow: 0 8rpx 24rpx rgba(110, 100, 80, 0.05);
}
.article-cover {
	width: 156rpx;
	height: 156rpx;
	border-radius: 16rpx;
	background-color: #f3e6d6;
}
.article-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.article-cover-text {
	font-size: 18px;
	color: #c88a54;
	font-weight: 700;
}
.article-main {
	flex: 1;
	padding-left: 18rpx;
}
.article-title {
	font-size: 16px;
	line-height: 24px;
	color: #252525;
	font-weight: 600;
}
.article-summary {
	margin-top: 10rpx;
	font-size: 12px;
	line-height: 18px;
	color: #8f8f8f;
	height: 54rpx;
	overflow: hidden;
}
.article-tags {
	margin-top: 10rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.article-tag {
	margin-right: 10rpx;
	margin-bottom: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #f5efe7;
	font-size: 11px;
	color: #907456;
}
.article-meta {
	margin-top: 10rpx;
}
.article-meta-text {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
	margin-top: 4rpx;
}
.bottom-state {
	padding-top: 10rpx;
	align-items: center;
}
.bottom-state-text {
	font-size: 12px;
	line-height: 18px;
	color: #b1b1b1;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
}
