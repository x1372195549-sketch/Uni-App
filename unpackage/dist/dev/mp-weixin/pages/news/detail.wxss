@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
}
.back-btn {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.back-icon-image {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.content {
	flex: 1;
}
.detail-body {
	padding: 20rpx 18rpx 28rpx;
}
.hero-card,
.section-card {
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	margin-bottom: 18rpx;
}
.hero-cover {
	width: 100%;
	height: 320rpx;
	border-radius: 18rpx;
	background-color: #f3e6d6;
}
.hero-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.hero-cover-text {
	font-size: 24px;
	font-weight: 700;
	color: #cc8e58;
}
.news-title {
	margin-top: 18rpx;
	font-size: 20px;
	line-height: 30px;
	color: #242424;
	font-weight: 700;
}
.meta-row {
	margin-top: 14rpx;
}
.meta-text {
	margin-top: 4rpx;
	font-size: 12px;
	line-height: 18px;
	color: #9c9c9c;
}
.tag-row {
	margin-top: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.tag-item {
	margin-right: 10rpx;
	margin-bottom: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #f5efe7;
	font-size: 11px;
	color: #907456;
}
.section-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.section-title {
	font-size: 16px;
	line-height: 24px;
	color: #2b2b2b;
	font-weight: 600;
}
.favorite-btn {
	min-width: 108rpx;
	height: 54rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	border-radius: 27rpx;
	background-color: #f4efe7;
	align-items: center;
	justify-content: center;
}
.favorite-btn-text {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
}
.section-text {
	margin-top: 18rpx;
	font-size: 14px;
	line-height: 24px;
	color: #666666;
}
.rich-content {
	margin-top: 18rpx;
}
