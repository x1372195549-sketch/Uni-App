@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	position: relative;
	background-color: #f7f7f2;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 284rpx;
}
.content {
	flex: 1;
	padding-top: 304rpx;
	padding-bottom: 128rpx;
}
.profile-shell {
	margin-left: 12rpx;
	margin-right: 12rpx;
	background-color: rgba(255, 255, 255, 0.97);
	border-radius: 18rpx;
	box-shadow: 0 12rpx 22rpx rgba(90, 90, 60, 0.05);
	overflow: hidden;
}
.profile-head {
	padding-left: 14rpx;
	padding-right: 20rpx;
	padding-top: 18rpx;
	padding-bottom: 12rpx;
	flex-direction: row;
	align-items: center;
}
.avatar {
	width: 76rpx;
	height: 76rpx;
	border-radius: 38rpx;
	margin-right: 14rpx;
}
.profile-main {
	flex: 1;
}
.name-row {
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
	margin-bottom: 8rpx;
}
.nickname {
	font-size: 18px;
	line-height: 26px;
	color: #1f1f1f;
	font-weight: 600;
}
.user-type {
	font-size: 13px;
	line-height: 20px;
	color: #9d9d9d;
	margin-left: 8rpx;
}
.sub-row {
	flex-direction: row;
	align-items: center;
}
.student-no {
	font-size: 13px;
	line-height: 20px;
	color: #9d9d9d;
	margin-right: 10rpx;
}
.cert-tag {
	padding-left: 14rpx;
	padding-right: 14rpx;
	height: 32rpx;
	line-height: 32rpx;
	border-radius: 7rpx;
	font-size: 12px;
	font-weight: 500;
	color: #ffffff;
}
.cert-tag-on {
	background-color: #10b66d;
}
.cert-tag-off {
	background-color: #b9b9b9;
}
.edit-text {
	align-self: flex-start;
	padding-top: 12rpx;
	font-size: 12px;
	line-height: 20px;
	color: #a4a4a4;
}
.menu {
	padding-left: 18rpx;
	padding-right: 18rpx;
	padding-top: 4rpx;
	padding-bottom: 8rpx;
}
.menu-item {
	height: 80rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #f1f1ec;
}
.menu-item:last-child {
	border-bottom-width: 0;
}
.menu-left {
	flex-direction: row;
	align-items: center;
}
.menu-icon {
	width: 28rpx;
	height: 28rpx;
	margin-right: 16rpx;
}
.menu-label {
	font-size: 16px;
	line-height: 24px;
	color: #1b1b1b;
}
.menu-arrow {
	width: 14rpx;
	height: 22rpx;
	opacity: 0.72;
}
.footer {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 98rpx;
	align-items: center;
}
.footer-line {
	font-size: 11px;
	line-height: 16px;
	color: #b8b8b8;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
}
