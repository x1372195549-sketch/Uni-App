@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  flex: 1;
  background-color: #f7f7f2;
}
.hero-shell {
  position: relative;
  height: 226rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 226rpx;
}
.header {
  position: relative;
  z-index: 1;
  padding-top: 34rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
}
.header-title {
  font-size: 20px;
  line-height: 30px;
  color: #2f2f2f;
  font-weight: 600;
}
.top-tabs {
  position: relative;
  z-index: 1;
  height: 108rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  background-color: rgba(251, 250, 246, 0.78);
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: rgba(229, 234, 225, 0.95);
}
.top-tab {
  min-width: 78rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
}
.top-tab-active {
  position: relative;
}
.top-tab-text {
  font-size: 15px;
  line-height: 22px;
  color: #333333;
}
.top-tab-text-active {
  color: #b85d69;
  font-weight: 600;
}
.top-tab-line {
  position: absolute;
  bottom: 10rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background-color: #b85d69;
}
.search-bar {
  margin: 0 20rpx 0;
  padding-left: 18rpx;
  padding-right: 10rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background-color: #ffffff;
  flex-direction: row;
  align-items: center;
}
.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 14px;
  color: #2f2f2f;
}
.search-btn {
  width: 108rpx;
  height: 54rpx;
  border-radius: 27rpx;
  background-color: #18b775;
  align-items: center;
  justify-content: center;
}
.search-btn-text {
  font-size: 13px;
  color: #ffffff;
  font-weight: 600;
}
.content {
  flex: 1;
  padding-bottom: 110rpx;
}
.content-shell {
  padding-left: 20rpx;
  padding-right: 20rpx;
  padding-top: 8rpx;
  padding-bottom: 40rpx;
}
.state-wrap {
  padding: 120rpx 30rpx;
  align-items: center;
}
.state-text {
  font-size: 14px;
  line-height: 22px;
  color: #9b9b9b;
  text-align: center;
}
.retry-btn {
  margin-top: 24rpx;
  width: 220rpx;
  height: 70rpx;
  border-radius: 14rpx;
  background-color: #18b775;
  align-items: center;
  justify-content: center;
}
.retry-btn-text {
  font-size: 14px;
  color: #ffffff;
  font-weight: 600;
}
.audio-card {
  margin-bottom: 22rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(110, 100, 80, 0.05);
}
.bottom-state {
  padding-top: 10rpx;
  align-items: center;
}
.bottom-state-text {
  font-size: 12px;
  line-height: 18px;
  color: #b1b1b1;
}
.audio-cover-shell {
  padding: 0;
  background-color: #f1e3cf;
}
.audio-cover {
  height: 260rpx;
  position: relative;
  padding-left: 44rpx;
  padding-top: 48rpx;
  background-color: #f4e4cf;
}
.cover-title {
  font-size: 28px;
  line-height: 38px;
  color: #b9702f;
  font-weight: 600;
}
.cover-subtitle {
  margin-top: 16rpx;
  font-size: 18px;
  line-height: 26px;
  color: #8d6e4d;
}
.audio-disc {
  position: absolute;
  right: 54rpx;
  top: 52rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.92);
  align-items: center;
  justify-content: center;
}
.audio-disc-center {
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background-color: rgba(185, 112, 47, 0.42);
}
.audio-info {
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}
.audio-title {
  font-size: 18px;
  line-height: 28px;
  color: #252525;
  font-weight: 600;
}
.audio-meta {
  margin-top: 18rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.teacher-name {
  font-size: 15px;
  line-height: 22px;
  color: #a8a8a8;
}
.stats {
  flex-direction: row;
  align-items: center;
}
.stat-text {
  font-size: 13px;
  line-height: 20px;
  color: #a0a0a0;
  margin-left: 18rpx;
}
.tabbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 96rpx;
  padding-bottom: 8rpx;
  background-color: rgba(255, 255, 255, 0.98);
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #e9e9e4;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}
.tab-item {
  align-items: center;
  justify-content: center;
}
.tab-item-active {
  margin-top: -2rpx;
}
.tab-icon-image {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 6rpx;
}
.tab-label {
  font-size: 11px;
  line-height: 16px;
  color: #b1b1b1;
}
.tab-label-active {
  color: #18b775;
}
