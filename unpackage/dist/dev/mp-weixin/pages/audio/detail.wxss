@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  flex: 1;
  background-color: #f8f6f0;
}
.detail-header {
  height: 96rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #ece9e1;
  position: relative;
}
.header-back {
  position: absolute;
  left: 20rpx;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.header-back-icon {
  width: 24rpx;
  height: 24rpx;
}
.detail-title {
  font-size: 18px;
  line-height: 28px;
  color: #1f1f1f;
  font-weight: 600;
}
.detail-scroll {
  flex: 1;
}
.detail-cover {
  height: 232px;
  align-items: center;
  justify-content: center;
  background-color: #cabca7;
}
.audio-disc {
  border-radius: 999px;
  background-color: #fffefc;
  align-items: center;
  justify-content: center;
}
.audio-disc-large {
  width: 120px;
  height: 120px;
}
.audio-disc-center {
  border-radius: 999px;
  background-color: #e4c09c;
}
.audio-disc-center-large {
  width: 34px;
  height: 34px;
}
.detail-tabs {
  height: 64px;
  padding: 0 24px;
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
}
.tab-item {
  margin-right: 32rpx;
  align-items: center;
  justify-content: center;
}
.detail-tab {
  font-size: 17px;
  color: #a5a5a5;
}
.detail-tab-active {
  color: #222222;
  font-weight: 700;
}
.tab-line {
  margin-top: 10rpx;
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #c46b76;
}
.favorite-tab-btn {
  margin-left: auto;
  min-width: 108rpx;
  height: 56rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  border-radius: 28rpx;
  background-color: #f4efe7;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.favorite-text {
  font-size: 24rpx;
  color: #8f8f8f;
}
.favorite-text-active {
  color: #c46b76;
  font-weight: 600;
}
.intro-panel {
  padding: 28px 22px 32px;
  background-color: #ffffff;
}
.content-title {
  display: block;
  text-align: center;
  font-size: 18px;
  line-height: 28px;
  color: #1f1f1f;
  font-weight: 700;
}
.content-stats {
  margin-top: 18px;
  flex-direction: row;
  justify-content: flex-end;
}
.content-stat {
  margin-left: 18px;
  font-size: 14px;
  color: #a8a8a8;
}
.section-title {
  display: block;
  margin-top: 26px;
  font-size: 16px;
  color: #222222;
}
.content-text {
  display: block;
  margin-top: 18px;
  font-size: 15px;
  line-height: 30px;
  color: #8f8f8f;
}
.catalog-panel {
  padding-bottom: 24px;
  background-color: #ffffff;
}
.catalog-item {
  min-height: 72px;
  padding: 0 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #f0f0f0;
}
.catalog-item-active {
  background-color: #f7f3eb;
}
.catalog-title {
  flex: 1;
  margin-right: 12px;
  font-size: 15px;
  line-height: 24px;
  color: #303030;
}
.catalog-title-active {
  color: #c46b76;
  font-weight: 600;
}
.catalog-duration {
  font-size: 14px;
  color: #a0a0a0;
}
.catalog-duration-active {
  color: #c46b76;
}
