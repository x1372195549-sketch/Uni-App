@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.header {
	height: 88rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: #f7f7f2;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
	position: relative;
}
.back-btn {
	position: absolute;
	left: 16rpx;
	top: 0;
	bottom: 0;
	width: 56rpx;
	align-items: center;
	justify-content: center;
}
.back-icon {
	font-size: 30rpx;
	line-height: 30rpx;
	color: #222222;
	font-weight: 600;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.content {
	flex: 1;
}
.hero {
	height: 420rpx;
	position: relative;
	background-color: #d8c9b5;
	align-items: center;
	justify-content: center;
}
.hero-mask {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(60, 54, 44, 0.2);
}
.disc-outer {
	width: 220rpx;
	height: 220rpx;
	border-radius: 110rpx;
	background-color: rgba(255, 255, 255, 0.88);
	align-items: center;
	justify-content: center;
	z-index: 1;
}
.disc-inner {
	width: 72rpx;
	height: 72rpx;
	border-radius: 36rpx;
	background-color: rgba(185, 112, 47, 0.4);
}
.tabs {
	height: 108rpx;
	padding-left: 44rpx;
	padding-right: 44rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
}
.tab-item {
	margin-right: 74rpx;
	align-items: center;
	justify-content: center;
	position: relative;
}
.tab-text {
	font-size: 16px;
	line-height: 24px;
	color: #9f9f9f;
}
.tab-text-active {
	color: #262626;
	font-weight: 600;
}
.tab-line {
	margin-top: 10rpx;
	width: 58rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.intro-panel {
	padding-left: 46rpx;
	padding-right: 46rpx;
	padding-top: 34rpx;
	padding-bottom: 48rpx;
	background-color: #ffffff;
}
.media-title {
	font-size: 18px;
	line-height: 28px;
	color: #242424;
	font-weight: 600;
	text-align: center;
}
.stats-row {
	margin-top: 34rpx;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}
.stats-text {
	font-size: 12px;
	line-height: 18px;
	color: #9e9e9e;
	margin-left: 28rpx;
}
.section-title {
	margin-top: 38rpx;
	font-size: 15px;
	line-height: 22px;
	color: #2b2b2b;
}
.intro-text {
	margin-top: 28rpx;
	font-size: 12px;
	line-height: 24px;
	color: #8f8f8f;
}
.catalog-panel {
	padding-top: 6rpx;
	padding-bottom: 60rpx;
	background-color: #ffffff;
	min-height: 860rpx;
}
.catalog-row {
	min-height: 106rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.catalog-row-active {
	background-color: #f3f3f3;
}
.catalog-title {
	flex: 1;
	font-size: 14px;
	line-height: 22px;
	color: #353535;
	padding-right: 20rpx;
}
.catalog-duration {
	font-size: 12px;
	line-height: 18px;
	color: #a9a9a9;
}
.exam-wrap {
	margin-top: 150rpx;
	align-items: center;
}
.exam-btn {
	width: 300rpx;
	height: 84rpx;
	line-height: 84rpx;
	border-radius: 18rpx;
	background-color: #b66572;
	color: #ffffff;
	font-size: 18px;
	font-weight: 600;
	border-width: 0;
}
.exam-btn-hover {
	opacity: 0.92;
}
