<view id="{{G}}" change:eS="{{uV.sS}}" eS="{{$eS[G]}}" change:eA="{{uV.sA}}" eA="{{$eA[G]}}" class="{{['page', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="header"><view class="header-back" bindtap="{{b}}"><image class="header-back-icon" src="{{a}}" mode="aspectFit"></image></view><text class="header-title">知识详情</text></view><scroll-view class="detail-scroll" scroll-y="true" enable-flex="true" enhanced="true"><view wx:if="{{c}}" class="state-wrap"><text class="state-text">加载中...</text></view><view wx:elif="{{d}}" class="state-wrap"><text class="state-text">{{e}}</text><view class="retry-btn" bindtap="{{f}}"><text class="retry-btn-text">重新加载</text></view></view><view wx:else class="detail-body"><view class="hero-card"><view class="cover-shell"><image wx:if="{{g}}" class="cover-image" src="{{h}}" mode="aspectFill"></image><view wx:else class="cover-fallback"><text class="cover-fallback-text">{{i}}</text></view></view><view class="hero-main"><text class="book-title">{{j}}</text><text wx:if="{{k}}" class="book-meta">作者：{{l}}</text><text wx:if="{{m}}" class="book-meta">出版社：{{n}}</text><text wx:if="{{o}}" class="book-meta">分类：{{p}}</text><view class="stats-row"><text wx:if="{{q}}" class="stat-text">{{r}}</text><text class="stat-text">阅读 {{s}}</text><text wx:if="{{t}}" class="stat-text">{{v}}</text></view></view></view><view wx:if="{{w}}" class="section-card"><text class="section-title">简介</text><text class="section-text">{{x}}</text></view><view class="section-card"><text class="section-title">正文内容</text><rich-text wx:if="{{y}}" class="rich-content" nodes="{{z}}"></rich-text><text wx:else class="section-text">{{A}}</text></view><view wx:if="{{B}}" class="section-card"><text class="section-title">补充信息</text><text wx:if="{{C}}" class="section-text">关键词：{{D}}</text><text wx:if="{{E}}" class="section-text">来源：{{F}}</text></view></view></scroll-view></view><wxs src="/common/uniView.wxs" module="uV"/>
