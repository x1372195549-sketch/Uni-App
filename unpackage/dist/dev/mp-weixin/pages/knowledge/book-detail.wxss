@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
}
.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.tab-strip {
	height: 88rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
	padding: 0 18rpx;
	border-bottom-width: 1rpx;
	border-bottom-style: solid;
	border-bottom-color: #efedf5;
}
.tab-item {
	margin-right: 28rpx;
	height: 88rpx;
	align-items: center;
	justify-content: center;
}
.tab-text {
	font-size: 28rpx;
	color: #666666;
}
.tab-text-active {
	color: #d56d79;
	font-weight: 600;
}
.tab-line {
	width: 36rpx;
	height: 4rpx;
	border-radius: 999rpx;
	background-color: #d56d79;
	margin-top: 10rpx;
}
.overview-shell {
	flex: 1;
	padding-bottom: 104rpx;
}
.detail-scroll {
	flex: 1;
}
.state-wrap {
	padding: 180rpx 40rpx 0;
	align-items: center;
}
.chapter-state-wrap {
	padding-top: 120rpx;
}
.state-text {
	font-size: 28rpx;
	color: #a9a9b6;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 28rpx;
	color: #ffffff;
	font-weight: 600;
}
.detail-body {
	padding: 20rpx 18rpx 28rpx;
}
.hero-card {
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
}
.cover-shell {
	width: 180rpx;
	height: 240rpx;
	margin-right: 20rpx;
	border-radius: 12rpx;
	overflow: hidden;
	background-color: #e8dcc5;
}
.cover-image {
	width: 180rpx;
	height: 240rpx;
}
.cover-fallback {
	width: 180rpx;
	height: 240rpx;
	align-items: center;
	justify-content: center;
	background-color: #f3e2c6;
}
.cover-fallback-text {
	font-size: 22px;
	line-height: 30px;
	color: #6e6049;
	font-weight: 600;
	text-align: center;
}
.hero-main {
	flex: 1;
}
.book-title {
	font-size: 18px;
	line-height: 28px;
	color: #1f1f1f;
	font-weight: 700;
}
.book-meta {
	margin-top: 12rpx;
	font-size: 13px;
	line-height: 20px;
	color: #8c8c8c;
}
.stats-row {
	margin-top: 16rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.stat-text {
	margin-right: 18rpx;
	margin-top: 8rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b1b1b1;
}
.chapter-entry-btn {
	margin-top: 20rpx;
	width: 180rpx;
	height: 60rpx;
	border-radius: 30rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.chapter-entry-btn-text {
	font-size: 24rpx;
	color: #ffffff;
	font-weight: 600;
}
.section-card {
	margin-top: 18rpx;
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
}
.section-title {
	font-size: 16px;
	line-height: 24px;
	color: #242424;
	font-weight: 600;
}
.section-text {
	display: block;
	margin-top: 16rpx;
	font-size: 14px;
	line-height: 26px;
	color: #6f6f6f;
}
.rich-content {
	margin-top: 16rpx;
}
.chapter-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}
.drawer-panel {
	width: 214rpx;
	background-color: #f2f4fa;
	border-right-width: 1rpx;
	border-right-style: solid;
	border-right-color: #e7e7f0;
}
.drawer-scroll {
	flex: 1;
}
.drawer-item {
	min-height: 96rpx;
	padding: 18rpx 16rpx;
	align-items: flex-start;
	justify-content: center;
	border-left-width: 6rpx;
	border-left-style: solid;
	border-left-color: transparent;
}
.drawer-item-active {
	background-color: #ffffff;
	border-left-color: #df6876;
}
.drawer-item-text {
	font-size: 24rpx;
	line-height: 34rpx;
	color: #666a78;
}
.drawer-item-text-active {
	color: #df6876;
	font-weight: 600;
}
.drawer-empty {
	padding: 40rpx 16rpx;
	align-items: center;
}
.drawer-empty-text {
	font-size: 22rpx;
	color: #b4b7c3;
}
.chapter-content-panel {
	flex: 1;
}
.chapter-scroll {
	flex: 1;
}
.chapter-content-card {
	margin: 18rpx;
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
}
.chapter-title {
	font-size: 32rpx;
	line-height: 44rpx;
	color: #2a2a2a;
	font-weight: 700;
}
.chapter-meta-row {
	margin-top: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.chapter-meta {
	margin-right: 18rpx;
	font-size: 22rpx;
	line-height: 32rpx;
	color: #999daa;
}
.chapter-text {
	display: block;
	margin-top: 20rpx;
	font-size: 28rpx;
	line-height: 44rpx;
	color: #545867;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 104rpx;
	background-color: #ffffff;
	border-top-width: 1rpx;
	border-top-style: solid;
	border-top-color: #eceaf1;
	flex-direction: row;
}
.tab-item {
	flex: 1;
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	background-color: #ffffff;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
}
.tab-label {
	margin-top: 6rpx;
	font-size: 20rpx;
	color: #a8a8b2;
}
.tab-label-active {
	color: #df6876;
}
