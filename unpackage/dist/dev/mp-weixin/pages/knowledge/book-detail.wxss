@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #f5f5fb;
}
.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.reader-shell {
	flex: 1;
	position: relative;
	padding-bottom: 100rpx;
}
.reader-content {
	flex: 1;
}
.reader-inner {
	padding-left: 48rpx;
	padding-right: 48rpx;
	padding-top: 40rpx;
	padding-bottom: 80rpx;
	background-color: #ffffff;
	min-height: 100%;
}
.chapter-title {
	font-size: 26px;
	line-height: 38px;
	color: #323232;
	font-weight: 600;
	text-align: center;
	margin-bottom: 36rpx;
}
.content-text {
	font-size: 18px;
	line-height: 34px;
	color: #2f2f2f;
}
.drawer-mask {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.08);
}
.drawer-panel {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 540rpx;
	background-color: #ffffff;
	box-shadow: 12rpx 0 28rpx rgba(60, 60, 60, 0.08);
}
.drawer-book {
	height: 216rpx;
	padding-left: 26rpx;
	padding-right: 26rpx;
	flex-direction: row;
	align-items: center;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #e8e8e8;
}
.drawer-cover {
	width: 128rpx;
	height: 168rpx;
	border-radius: 6rpx;
	background-color: #b8674d;
}
.drawer-book-info {
	margin-left: 24rpx;
	flex: 1;
}
.drawer-book-title {
	font-size: 28px;
	line-height: 38px;
	color: #2f2f2f;
	font-weight: 600;
}
.drawer-book-author {
	margin-top: 16rpx;
	font-size: 16px;
	line-height: 24px;
	color: #b5b5b5;
}
.drawer-tabs {
	height: 112rpx;
	flex-direction: row;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #eeeeee;
}
.drawer-tab {
	flex: 1;
	align-items: center;
	justify-content: center;
	position: relative;
}
.drawer-tab-text {
	font-size: 18px;
	line-height: 26px;
	color: #b2b2b2;
}
.drawer-tab-text-active {
	color: #2f2f2f;
	font-weight: 600;
}
.drawer-tab-line {
	position: absolute;
	bottom: 14rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.drawer-section-title {
	height: 92rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	font-size: 18px;
	line-height: 92rpx;
	color: #3e3e3e;
}
.drawer-list {
	flex: 1;
}
.drawer-row {
	min-height: 96rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	flex-direction: row;
	align-items: center;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #f0f0f0;
}
.drawer-row-bookmark {
	padding-left: 18rpx;
}
.bookmark-flag {
	width: 22rpx;
	height: 34rpx;
	background-color: #be6874;
	margin-right: 20rpx;
}
.drawer-row-title {
	flex: 1;
	font-size: 17px;
	line-height: 26px;
	color: #3d3d3d;
}
.drawer-bookmark-title {
	font-size: 15px;
	color: #585858;
}
.drawer-progress {
	font-size: 15px;
	line-height: 22px;
	color: #be6874;
}
.reader-tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.reader-tab-item {
	align-items: center;
	justify-content: center;
}
.reader-tab-icon-image {
	width: 32rpx;
	height: 32rpx;
}
.reader-tab-text {
	margin-top: 6rpx;
	font-size: 13px;
	line-height: 18px;
	color: #4d4d4d;
}
.reader-tab-text-active {
	color: #18b775;
	font-weight: 600;
}
