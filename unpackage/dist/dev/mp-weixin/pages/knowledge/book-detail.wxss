@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
}
.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.detail-scroll {
	flex: 1;
}
.state-wrap {
	padding: 180rpx 40rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 200rpx;
	height: 68rpx;
	border-radius: 12rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.detail-body {
	padding: 20rpx 18rpx 28rpx;
}
.hero-card {
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
}
.cover-shell {
	width: 180rpx;
	height: 240rpx;
	margin-right: 20rpx;
	border-radius: 12rpx;
	overflow: hidden;
	background-color: #e8dcc5;
}
.cover-image {
	width: 180rpx;
	height: 240rpx;
}
.cover-fallback {
	width: 180rpx;
	height: 240rpx;
	padding: 24rpx 18rpx;
	align-items: center;
	justify-content: center;
}
.cover-fallback-text {
	font-size: 22px;
	line-height: 30px;
	color: #6e6049;
	font-weight: 600;
	text-align: center;
}
.hero-main {
	flex: 1;
}
.book-title {
	font-size: 18px;
	line-height: 28px;
	color: #1f1f1f;
	font-weight: 700;
}
.book-meta {
	margin-top: 12rpx;
	font-size: 13px;
	line-height: 20px;
	color: #8c8c8c;
}
.stats-row {
	margin-top: 16rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.stat-text {
	margin-right: 18rpx;
	margin-top: 8rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b1b1b1;
}
.section-card {
	margin-top: 18rpx;
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
}
.section-title {
	font-size: 16px;
	line-height: 24px;
	color: #242424;
	font-weight: 600;
}
.section-text {
	display: block;
	margin-top: 16rpx;
	font-size: 14px;
	line-height: 26px;
	color: #6f6f6f;
}
.rich-content {
	margin-top: 16rpx;
}
