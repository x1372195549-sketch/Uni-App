@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.hero-shell {
	position: relative;
	height: 146rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 264rpx;
}
.header {
	position: relative;
	z-index: 1;
	height: 146rpx;
	padding-top: 62rpx;
	align-items: center;
	justify-content: center;
	background-color: transparent;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
	width: 100%;
	text-align: center;
}
.search-bar {
	margin: 16rpx 20rpx 18rpx;
	height: 78rpx;
	padding: 0 12rpx 0 24rpx;
	background-color: #ffffff;
	border-radius: 18rpx;
	flex-direction: row;
	align-items: center;
}
.search-input {
	flex: 1;
	height: 78rpx;
	font-size: 15px;
	color: #303030;
}
.search-btn {
	width: 108rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.search-btn-text {
	font-size: 13px;
	color: #ffffff;
	font-weight: 600;
}
.content-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}
.category-panel {
	width: 196rpx;
	background-color: #f1f2f5;
}
.category-item {
	min-height: 112rpx;
	padding: 18rpx 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}
.category-item-active {
	background-color: #ffffff;
}
.category-line {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 8rpx;
	background-color: #b85d69;
}
.category-text {
	font-size: 15px;
	line-height: 22px;
	color: #8f8f8f;
	text-align: center;
}
.category-text-active {
	color: #b85d69;
	font-weight: 600;
}
.list-panel {
	flex: 1;
	background-color: #ffffff;
}
.state-wrap {
	padding: 120rpx 40rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 200rpx;
	height: 68rpx;
	border-radius: 12rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.book-list {
	padding: 16rpx 18rpx 24rpx;
}
.book-card {
	margin-bottom: 18rpx;
	padding: 18rpx;
	border-radius: 16rpx;
	background-color: #fbfaf7;
	flex-direction: row;
	align-items: center;
}
.book-cover-shell {
	width: 132rpx;
	height: 176rpx;
	margin-right: 18rpx;
	border-radius: 10rpx;
	overflow: hidden;
	background-color: #efe3cc;
}
.book-cover {
	width: 132rpx;
	height: 176rpx;
}
.book-cover-fallback {
	width: 132rpx;
	height: 176rpx;
	padding: 20rpx 14rpx;
	align-items: center;
	justify-content: center;
	background-color: #e8dcc5;
}
.book-cover-fallback-text {
	font-size: 18px;
	line-height: 26px;
	color: #6e6049;
	font-weight: 600;
	text-align: center;
}
.book-main {
	flex: 1;
	min-height: 176rpx;
	justify-content: space-between;
}
.book-title {
	font-size: 16px;
	line-height: 24px;
	color: #2b2b2b;
	font-weight: 600;
}
.book-summary {
	margin-top: 10rpx;
	font-size: 13px;
	line-height: 20px;
	color: #8c8c8c;
}
.book-meta {
	margin-top: 12rpx;
	font-size: 12px;
	line-height: 18px;
	color: #b45f73;
}
.book-bottom-row {
	margin-top: 14rpx;
	flex-direction: row;
	justify-content: space-between;
}
.book-stat {
	font-size: 12px;
	line-height: 18px;
	color: #b1b1b1;
}
.bottom-state {
	padding: 12rpx 0 16rpx;
	align-items: center;
}
.bottom-state-text {
	font-size: 12px;
	color: #b1b1b1;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
	font-weight: 600;
}
