@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.hero-shell {
	position: relative;
	height: 118rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 236rpx;
}
.header {
	position: relative;
	z-index: 1;
	height: 118rpx;
	padding-top: 34rpx;
	align-items: center;
	justify-content: center;
	background-color: transparent;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
	width: 100%;
	text-align: center;
}
.content-shell {
	flex: 1;
	flex-direction: row;
	padding-bottom: 104rpx;
}
.category-panel {
	width: 184rpx;
	background-color: #f1f2f5;
}
.category-item {
	height: 118rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	background-color: #eef0f3;
	align-items: center;
	justify-content: center;
	position: relative;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(225, 227, 231, 0.9);
}
.category-item-active {
	background-color: #ffffff;
}
.category-line {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 8rpx;
	background-color: #b85d69;
}
.category-text {
	font-size: 17px;
	line-height: 24px;
	color: #a6a6a6;
	text-align: center;
}
.category-text-active {
	color: #b85d69;
	font-weight: 600;
}
.book-panel {
	flex: 1;
	background-color: #ffffff;
}
.book-grid {
	padding-left: 18rpx;
	padding-right: 18rpx;
	padding-top: 16rpx;
	padding-bottom: 24rpx;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}
.book-card {
	width: 156rpx;
	margin-bottom: 28rpx;
	align-items: center;
}
.book-cover {
	width: 132rpx;
	height: 180rpx;
	border-radius: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	padding-top: 18rpx;
	align-items: center;
	justify-content: flex-start;
	box-shadow: 0 8rpx 18rpx rgba(105, 100, 90, 0.08);
}
.book-cover-title {
	font-size: 18px;
	line-height: 24px;
	color: #4f523f;
	font-weight: 600;
	text-align: center;
}
.book-name {
	margin-top: 12rpx;
	font-size: 12px;
	line-height: 18px;
	color: #4a4a4a;
	text-align: center;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
	font-weight: 600;
}
