@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.nav-back {
	position: absolute;
	left: 22rpx;
	top: 108rpx;
	width: 52rpx;
	height: 52rpx;
	align-items: center;
	justify-content: center;
	z-index: 10;
}
.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header {
	height: 188rpx;
	padding-top: 36rpx;
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 34rpx;
	font-weight: 600;
	color: #1f1f1f;
}
.top-tabs {
	height: 92rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #efefef;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #efefef;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.top-tab {
	flex: 1;
	height: 92rpx;
	align-items: center;
	justify-content: center;
	position: relative;
}
.top-tab-text {
	font-size: 28rpx;
	color: #303030;
}
.top-tab-text-active {
	color: #b45f73;
	font-weight: 600;
}
.top-tab-line {
	position: absolute;
	bottom: 10rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b45f73;
}
.list-scroll {
	flex: 1;
	padding-top: 20rpx;
}
.book-card {
	margin-left: 16rpx;
	margin-right: 16rpx;
	margin-bottom: 20rpx;
	padding: 22rpx 24rpx;
	background-color: #ffffff;
	border-radius: 22rpx;
	flex-direction: row;
	align-items: center;
	box-shadow: 0 10rpx 24rpx rgba(60, 60, 60, 0.05);
}
.book-cover-shell {
	width: 124rpx;
	height: 164rpx;
	margin-right: 26rpx;
	border-radius: 10rpx;
	background-color: #f1f1f1;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.book-cover {
	width: 112rpx;
	height: 152rpx;
}
.book-main {
	flex: 1;
	justify-content: center;
}
.book-meta-row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 34rpx;
}
.book-type-tag {
	padding-left: 14rpx;
	padding-right: 14rpx;
	height: 40rpx;
	border-radius: 20rpx;
	background-color: #f7e6d8;
	color: #c4803f;
	font-size: 22rpx;
	line-height: 40rpx;
	margin-right: 16rpx;
}
.book-title {
	flex: 1;
	font-size: 32rpx;
	font-weight: 600;
	line-height: 42rpx;
	color: #242424;
}
.book-time {
	font-size: 24rpx;
	color: #b1b1b1;
}
.poster-card {
	margin-left: 16rpx;
	margin-right: 16rpx;
	margin-bottom: 22rpx;
	background-color: #ffffff;
	border-radius: 22rpx;
	overflow: hidden;
	box-shadow: 0 10rpx 24rpx rgba(60, 60, 60, 0.05);
}
.poster-cover {
	height: 314rpx;
	position: relative;
}
.poster-type-badge {
	position: absolute;
	left: 20rpx;
	top: 18rpx;
	padding-left: 14rpx;
	padding-right: 14rpx;
	height: 42rpx;
	border-radius: 21rpx;
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
	z-index: 3;
}
.poster-type-badge-text {
	font-size: 20rpx;
	font-weight: 600;
	color: #c27a3a;
}
.poster-main-copy {
	position: absolute;
	left: 42rpx;
	top: 52rpx;
	z-index: 2;
}
.poster-main-title {
	font-size: 64rpx;
	line-height: 78rpx;
	font-weight: 600;
	color: #b6651d;
	white-space: pre-line;
}
.poster-sub-title {
	margin-top: 18rpx;
	font-size: 34rpx;
	line-height: 44rpx;
	color: #8f6136;
}
.poster-side-text {
	position: absolute;
	right: 38rpx;
	top: 50rpx;
	font-size: 48rpx;
	line-height: 62rpx;
	color: rgba(174, 108, 55, 0.9);
}
.poster-figure-shell {
	position: absolute;
	right: 100rpx;
	bottom: 18rpx;
	width: 226rpx;
	height: 242rpx;
	border-radius: 14rpx;
	overflow: hidden;
}
.poster-figure {
	width: 226rpx;
	height: 242rpx;
}
.poster-body {
	padding: 18rpx 24rpx 24rpx;
}
.poster-body-title {
	font-size: 28rpx;
	line-height: 40rpx;
	font-weight: 600;
	color: #222222;
}
.bottom-space {
	height: 36rpx;
}
