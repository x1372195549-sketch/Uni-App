@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.nav-back {
	position: absolute;
	left: 22rpx;
	top: 108rpx;
	width: 52rpx;
	height: 52rpx;
	align-items: center;
	justify-content: center;
	z-index: 10;
}
.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header {
	height: 188rpx;
	padding-top: 36rpx;
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 34rpx;
	font-weight: 600;
	color: #1f1f1f;
}
.top-tabs {
	height: 92rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #efefef;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #efefef;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.top-tab {
	flex: 1;
	height: 92rpx;
	align-items: center;
	justify-content: center;
	position: relative;
}
.top-tab-text {
	font-size: 28rpx;
	color: #303030;
}
.top-tab-text-active {
	color: #b45f73;
	font-weight: 600;
}
.top-tab-line {
	position: absolute;
	bottom: 10rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b45f73;
}
.list-scroll {
	flex: 1;
	padding-top: 20rpx;
}
.state-wrap {
	padding-top: 140rpx;
	padding-left: 40rpx;
	padding-right: 40rpx;
	align-items: center;
}
.state-text {
	font-size: 28rpx;
	line-height: 40rpx;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 28rpx;
	width: 220rpx;
	height: 76rpx;
	line-height: 76rpx;
	background-color: #10b66d;
	color: #ffffff;
	font-size: 28rpx;
	border-radius: 12rpx;
	border-width: 0;
}
.retry-btn-hover {
	opacity: 0.92;
}
.favorite-card {
	margin-left: 16rpx;
	margin-right: 16rpx;
	margin-bottom: 20rpx;
	padding: 22rpx 24rpx;
	background-color: #ffffff;
	border-radius: 22rpx;
	flex-direction: row;
	align-items: center;
	box-shadow: 0 10rpx 24rpx rgba(60, 60, 60, 0.05);
}
.favorite-cover-shell {
	width: 124rpx;
	height: 164rpx;
	margin-right: 26rpx;
	border-radius: 10rpx;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.favorite-cover {
	width: 124rpx;
	height: 164rpx;
}
.favorite-cover-placeholder {
	width: 124rpx;
	height: 164rpx;
	align-items: center;
	justify-content: center;
}
.favorite-cover-placeholder-text {
	font-size: 26rpx;
	line-height: 36rpx;
	color: #8d6e4d;
	font-weight: 600;
}
.favorite-main {
	flex: 1;
	justify-content: center;
}
.favorite-meta-row {
	flex-direction: row;
	align-items: flex-start;
	margin-bottom: 16rpx;
}
.favorite-type-tag {
	padding-left: 14rpx;
	padding-right: 14rpx;
	height: 40rpx;
	border-radius: 20rpx;
	background-color: #f7e6d8;
	color: #c4803f;
	font-size: 22rpx;
	line-height: 40rpx;
	margin-right: 16rpx;
}
.favorite-title {
	flex: 1;
	font-size: 32rpx;
	font-weight: 600;
	line-height: 42rpx;
	color: #242424;
}
.favorite-source {
	font-size: 24rpx;
	line-height: 34rpx;
	color: #8f8f8f;
	margin-bottom: 10rpx;
}
.favorite-time {
	font-size: 24rpx;
	color: #b1b1b1;
}
.bottom-space {
	height: 36rpx;
}
