<view id="{{t}}" change:eS="{{uV.sS}}" eS="{{$eS[t]}}" change:eA="{{uV.sA}}" eA="{{$eA[t]}}" class="{{['page', virtualHostClass]}}" style="{{virtualHostStyle}}" hidden="{{virtualHostHidden || false}}"><view class="nav-back" bindtap="{{b}}"><image class="nav-back-icon" src="{{a}}" mode="aspectFit"></image></view><view class="header"><text class="header-title">个人资料</text></view><scroll-view class="form-scroll" scroll-y="true" enable-flex="true" enhanced="true"><view class="form-card"><view class="form-row avatar-row" bindtap="{{d}}"><text class="row-label">头像</text><view class="row-right"><image class="avatar" src="{{c}}" mode="aspectFill"></image><text class="row-arrow">&gt;</text></view></view><view class="form-row"><text class="row-label">昵称</text><view class="row-right row-input-wrap"><input class="row-input" placeholder="请输入昵称" value="{{e}}" bindinput="{{f}}"/><text class="row-arrow">&gt;</text></view></view><view class="form-row" bindtap="{{h}}"><text class="row-label">性别</text><view class="row-right"><text class="row-value">{{g}}</text><text class="row-arrow">&gt;</text></view></view><view class="form-row"><text class="row-label">年龄</text><view class="row-right row-input-wrap"><input class="row-input" type="number" maxlength="3" placeholder="请输入数字年龄" bindinput="{{i}}" value="{{j}}"/><text class="row-arrow">&gt;</text></view></view><view class="form-row" bindtap="{{l}}"><text class="row-label">文化程度</text><view class="row-right"><text class="row-value">{{k}}</text><text class="row-arrow">&gt;</text></view></view><view class="form-row"><text class="row-label">执业类别</text><view class="row-right row-input-wrap"><input class="row-input" placeholder="请输入执业类别" value="{{m}}" bindinput="{{n}}"/><text class="row-arrow">&gt;</text></view></view><view class="form-row"><text class="row-label">地区</text><view class="row-right row-input-wrap"><input class="row-input" placeholder="请输入地区" value="{{o}}" bindinput="{{p}}"/><text class="row-arrow">&gt;</text></view></view><view class="form-row"><text class="row-label">联系电话</text><view class="row-right row-input-wrap"><input class="row-input" type="number" maxlength="11" placeholder="请输入11位联系电话" bindinput="{{q}}" value="{{r}}"/><text class="row-arrow">&gt;</text></view></view></view><view class="actions"><button class="save-btn" hover-class="save-btn-hover" bindtap="{{s}}">保存</button></view></scroll-view></view><wxs src="/common/uniView.wxs" module="uV"/>
