@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f5f5fb;
}
.nav-back {
	position: absolute;
	left: 22rpx;
	top: 108rpx;
	width: 52rpx;
	height: 52rpx;
	align-items: center;
	justify-content: center;
	z-index: 10;
}
.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header {
	height: 188rpx;
	padding-top: 36rpx;
	background-color: #ffffff;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 34rpx;
	font-weight: 600;
	color: #2f2f2f;
}
.top-tabs {
	height: 92rpx;
	background-color: #ffffff;
	flex-direction: row;
	align-items: center;
	padding: 0 16rpx;
	border-top-width: 1rpx;
	border-top-style: solid;
	border-top-color: #f1f1f5;
}
.top-tab {
	flex: 1;
	height: 92rpx;
	align-items: center;
	justify-content: center;
}
.top-tab-text {
	font-size: 28rpx;
	color: #595959;
}
.top-tab-text-active {
	color: #d86d79;
	font-weight: 600;
}
.top-tab-line {
	width: 38rpx;
	height: 4rpx;
	border-radius: 999rpx;
	background-color: #d86d79;
	margin-top: 10rpx;
}
.list-scroll {
	flex: 1;
}
.history-card {
	margin: 18rpx 20rpx 0;
	padding: 18rpx;
	background-color: #ffffff;
	border-radius: 22rpx;
	flex-direction: row;
}
.book-cover-shell {
	width: 112rpx;
	height: 152rpx;
	border-radius: 14rpx;
	overflow: hidden;
	background-color: #f6e7d2;
}
.book-cover {
	width: 112rpx;
	height: 152rpx;
}
.book-cover-fallback {
	width: 112rpx;
	height: 152rpx;
	align-items: center;
	justify-content: center;
	background-color: #f3e2c6;
}
.book-cover-fallback-text {
	font-size: 26rpx;
	font-weight: 700;
	color: #766042;
}
.book-main {
	flex: 1;
	margin-left: 20rpx;
}
.book-meta-row {
	flex-direction: row;
	align-items: center;
}
.book-type-tag {
	padding: 4rpx 12rpx;
	border-radius: 999rpx;
	background-color: #fbe6d7;
	font-size: 20rpx;
	color: #d69b66;
	margin-right: 10rpx;
}
.book-title {
	flex: 1;
	font-size: 30rpx;
	font-weight: 600;
	color: #2f2f2f;
}
.book-subtitle {
	margin-top: 10rpx;
	font-size: 24rpx;
	line-height: 36rpx;
	color: #6c6c74;
}
.book-time {
	margin-top: 10rpx;
	font-size: 22rpx;
	color: #a1a1ad;
}
.book-bottom-row {
	margin-top: 12rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.book-stat {
	font-size: 22rpx;
	color: #8e8e99;
}
.state-wrap {
	padding: 180rpx 40rpx 0;
	align-items: center;
}
.state-text {
	font-size: 28rpx;
	color: #b0b0ba;
	text-align: center;
}
.retry-btn {
	margin-top: 26rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #21c17a;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 28rpx;
	font-weight: 600;
	color: #ffffff;
}
.bottom-state {
	padding: 30rpx 0 10rpx;
	align-items: center;
}
.bottom-state-text {
	font-size: 24rpx;
	color: #b6b6c1;
}
.bottom-space {
	height: 36rpx;
}
