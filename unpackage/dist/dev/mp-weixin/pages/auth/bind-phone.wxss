@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	position: relative;
	background-color: #f8f6f1;
	overflow: hidden;
}
.bg {
	position: absolute;
	top: 0;
	bottom: 0;
	width: 750rpx;
	opacity: 0.98;
}
.nav-back {
	position: absolute;
	top: 72rpx;
	left: 14rpx;
	width: 52rpx;
	height: 52rpx;
	align-items: center;
	justify-content: center;
	z-index: 2;
}
.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}
.header {
	padding-top: 78rpx;
	align-items: center;
}
.header-title {
	font-size: 17px;
	line-height: 24px;
	color: #1b1b1b;
	font-weight: 500;
}
.form {
	padding-left: 70rpx;
	padding-right: 70rpx;
	padding-top: 114rpx;
}
.field {
	margin-bottom: 52rpx;
}
.label {
	font-size: 18px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 500;
	margin-bottom: 18rpx;
}
.input {
	height: 56rpx;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #dddddd;
	font-size: 17px;
	color: #1c1c1c;
	padding-left: 0;
	padding-right: 0;
	background-color: transparent;
}
.code-row {
	flex-direction: row;
	align-items: flex-end;
}
.code-input {
	flex: 1;
}
.send-code-wrap {
	width: 170rpx;
	height: 56rpx;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #dddddd;
	align-items: flex-end;
	justify-content: center;
}
.send-code {
	font-size: 15px;
	line-height: 22px;
	color: #12ba7b;
	font-weight: 600;
	text-align: right;
}
.submit-btn {
	margin-top: 40rpx;
	width: 320rpx;
	height: 58rpx;
	line-height: 58rpx;
	padding: 0;
	align-self: center;
	background-color: #08b16b;
	color: #ffffff;
	font-size: 18px;
	font-weight: 500;
	border-width: 0;
	border-radius: 8rpx;
}
.submit-btn-hover {
	opacity: 0.92;
}
