@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
}
.back-btn {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}
.back-icon-image {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.content {
	flex: 1;
}
.state-wrap {
	padding: 160rpx 30rpx;
	align-items: center;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: #9b9b9b;
	text-align: center;
}
.retry-btn {
	margin-top: 24rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.retry-btn-text {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
}
.detail-body {
	padding: 20rpx 18rpx 28rpx;
}
.hero-card,
.section-card {
	padding: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	margin-bottom: 18rpx;
}
.hero-cover {
	width: 100%;
	height: 320rpx;
	border-radius: 18rpx;
	background-color: #f3e6d6;
}
.hero-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.hero-cover-text {
	font-size: 18px;
	color: #cc8e58;
	font-weight: 700;
}
.topic-title {
	margin-top: 18rpx;
	font-size: 20px;
	line-height: 30px;
	color: #242424;
	font-weight: 700;
}
.topic-summary {
	margin-top: 14rpx;
	font-size: 14px;
	line-height: 22px;
	color: #7a7a7a;
}
.meta-row {
	margin-top: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.meta-text {
	margin-right: 16rpx;
	margin-bottom: 8rpx;
	font-size: 12px;
	line-height: 18px;
	color: #9c9c9c;
}
.tag-row {
	margin-top: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.tag-item {
	margin-right: 10rpx;
	margin-bottom: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #f5efe7;
	font-size: 11px;
	color: #907456;
}
.action-row {
	margin-top: 16rpx;
}
.favorite-btn {
	width: 120rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #f4efe7;
	align-items: center;
	justify-content: center;
}
.favorite-btn-text {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
}
.section-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.section-title-wrap {
	flex-direction: row;
	align-items: center;
}
.section-icon {
	width: 14rpx;
	height: 28rpx;
	border-radius: 999rpx;
	background-color: #1fbe75;
	margin-right: 12rpx;
}
.section-title {
	font-size: 16px;
	line-height: 24px;
	color: #2b2b2b;
	font-weight: 600;
}
.section-tip {
	margin-top: 10rpx;
	font-size: 13px;
	line-height: 20px;
	color: #8a8a8a;
}
.section-more {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
}
.section-text {
	margin-top: 18rpx;
	font-size: 14px;
	line-height: 24px;
	color: #666666;
}
.empty-section {
	padding-top: 18rpx;
}
.empty-section-text {
	font-size: 12px;
	line-height: 18px;
	color: #b1b1b1;
}
.resource-scroll {
	margin-top: 18rpx;
}
.resource-row {
	flex-direction: row;
	padding-right: 12rpx;
}
.resource-card {
	width: 210rpx;
	margin-right: 18rpx;
	padding: 0 0 12rpx;
	border-radius: 18rpx;
	background-color: #faf8f3;
}
.resource-cover {
	width: 210rpx;
	height: 210rpx;
	border-top-left-radius: 18rpx;
	border-top-right-radius: 18rpx;
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
	background-color: #f3e6d6;
}
.resource-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.resource-cover-text {
	font-size: 12px;
	color: #c88a54;
}
.resource-title {
	margin-top: 12rpx;
	padding-left: 14rpx;
	padding-right: 14rpx;
	font-size: 15px;
	line-height: 22px;
	color: #2b2b2b;
	font-weight: 600;
}
.resource-subtitle {
	margin-top: 10rpx;
	padding-left: 14rpx;
	padding-right: 14rpx;
	font-size: 12px;
	line-height: 18px;
	color: #7f7f7f;
	height: 54rpx;
	overflow: hidden;
}
.resource-meta {
	margin-top: 12rpx;
	padding-left: 14rpx;
	padding-right: 14rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.resource-meta-text {
	margin-right: 16rpx;
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
