@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.hero-shell {
	position: relative;
	height: 236rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 236rpx;
}
.header {
	position: relative;
	z-index: 1;
	padding-top: 34rpx;
	height: 118rpx;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.top-tabs {
	position: relative;
	z-index: 1;
	height: 96rpx;
	margin-top: 18rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}
.top-tab {
	min-width: 88rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}
.top-tab-active {
	position: relative;
}
.top-tab-text {
	font-size: 18px;
	line-height: 26px;
	color: #333333;
}
.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}
.top-tab-line {
	position: absolute;
	bottom: 10rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.content {
	flex: 1;
	padding-bottom: 110rpx;
}
.content-shell {
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-bottom: 40rpx;
}
.search-wrap {
	padding-bottom: 20rpx;
	background-color: #f7f7f2;
}
.search-box {
	height: 72rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	border-radius: 36rpx;
	background-color: rgba(255, 255, 255, 0.94);
	border-width: 1px;
	border-style: solid;
	border-color: rgba(191, 214, 195, 0.9);
	flex-direction: row;
	align-items: center;
}
.search-icon {
	width: 30rpx;
	height: 30rpx;
	margin-right: 18rpx;
	opacity: 0.78;
}
.search-placeholder {
	font-size: 14px;
	line-height: 22px;
	color: #b0b8ad;
}
.home-list {
	padding-top: 4rpx;
}
.home-card {
	margin-bottom: 24rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	overflow: hidden;
	box-shadow: 0 10rpx 24rpx rgba(207, 201, 186, 0.28);
}
.card-head {
	min-height: 220rpx;
	padding: 30rpx;
	background-color: #f8e8ce;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.card-type {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
	font-weight: 600;
	margin-bottom: 10rpx;
}
.card-title {
	width: 380rpx;
	font-size: 22px;
	line-height: 32px;
	color: #d0832e;
	font-weight: 700;
}
.card-subtitle {
	margin-top: 10rpx;
	width: 380rpx;
	font-size: 14px;
	line-height: 22px;
	color: #8d6f45;
}
.card-cover {
	width: 140rpx;
	height: 140rpx;
	border-radius: 24rpx;
	background-color: #ffffff;
}
.card-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.card-cover-text {
	font-size: 22px;
	line-height: 30px;
	color: #dfc2a3;
	font-weight: 600;
}
.card-foot {
	padding: 26rpx 30rpx;
}
.card-desc {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
}
