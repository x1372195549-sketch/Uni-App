@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.hero-shell {
	position: relative;
	height: 244rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 244rpx;
}
.header {
	position: relative;
	z-index: 1;
	padding-top: 62rpx;
	height: 136rpx;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.top-tabs {
	position: relative;
	z-index: 1;
	height: 108rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}
.top-tab {
	min-width: 78rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}
.top-tab-active {
	position: relative;
}
.top-tab-text {
	font-size: 15px;
	line-height: 22px;
	color: #333333;
}
.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}
.top-tab-line {
	position: absolute;
	bottom: 12rpx;
	width: 42rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.content {
	flex: 1;
	padding-bottom: 110rpx;
}
.content-shell {
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-bottom: 20rpx;
}
.hero-card-top {
	margin-top: 0;
}
.hero-swiper {
	height: 292rpx;
}
.hero-card {
	position: relative;
	height: 292rpx;
	box-sizing: border-box;
	padding: 24rpx 24rpx;
	border-radius: 24rpx;
	background: linear-gradient(135deg, #f7e4c8 0%, #f3efe7 100%);
	box-shadow: 0 12rpx 28rpx rgba(152, 118, 72, 0.12);
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	overflow: hidden;
}
.hero-main {
	flex: 1;
	height: 244rpx;
	padding-right: 22rpx;
}
.hero-kicker {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
	font-weight: 600;
}
.hero-title {
	margin-top: 10rpx;
	font-size: 18px;
	line-height: 26px;
	color: #8a5a28;
	font-weight: 700;
	height: 52rpx;
	overflow: hidden;
}
.hero-subtitle {
	margin-top: 12rpx;
	font-size: 13px;
	line-height: 20px;
	color: #7c6e58;
	height: 40rpx;
	overflow: hidden;
}
.hero-action {
	margin-top: 18rpx;
	width: 156rpx;
	height: 56rpx;
	border-radius: 28rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.hero-action-text {
	font-size: 13px;
	line-height: 20px;
	color: #ffffff;
	font-weight: 600;
}
.hero-cover {
	width: 178rpx;
	height: 208rpx;
	border-radius: 18rpx;
}
.hero-cover-placeholder {
	background-color: rgba(255, 255, 255, 0.42);
	align-items: center;
	justify-content: center;
}
.hero-cover-text {
	font-size: 15px;
	line-height: 22px;
	color: #d38c42;
	font-weight: 700;
}
.section-head {
	margin-top: 30rpx;
	margin-bottom: 18rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.section-gap {
	margin-top: 36rpx;
}
.section-title {
	font-size: 18px;
	line-height: 26px;
	color: #2f2f2f;
	font-weight: 600;
}
.section-more {
	font-size: 13px;
	line-height: 20px;
	color: #b85d69;
}
.section-empty {
	height: 72rpx;
	align-items: center;
	justify-content: center;
}
.section-empty-text {
	font-size: 13px;
	line-height: 20px;
	color: #b8b8b8;
}
.recommend-grid {
	flex-direction: row;
	justify-content: space-between;
}
.recommend-card {
	width: 214rpx;
	padding: 12rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	box-shadow: 0 8rpx 24rpx rgba(110, 100, 80, 0.06);
}
.recommend-cover {
	width: 190rpx;
	height: 116rpx;
	border-radius: 14rpx;
	background-color: #f3e6d6;
}
.recommend-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.recommend-cover-text {
	font-size: 15px;
	line-height: 22px;
	color: #c88a54;
	font-weight: 700;
}
.recommend-type {
	margin-top: 10rpx;
	font-size: 11px;
	line-height: 16px;
	color: #b85d69;
	font-weight: 600;
}
.recommend-title {
	margin-top: 4rpx;
	font-size: 14px;
	line-height: 20px;
	color: #2f2f2f;
	font-weight: 600;
	height: 40rpx;
	overflow: hidden;
}
.recommend-summary {
	margin-top: 6rpx;
	font-size: 11px;
	line-height: 16px;
	color: #8e8e8e;
	height: 32rpx;
	overflow: hidden;
}
.topic-scroll {
	white-space: nowrap;
}
.topic-row {
	flex-direction: row;
}
.topic-card {
	width: 280rpx;
	margin-right: 18rpx;
	padding: 18rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	box-shadow: 0 8rpx 24rpx rgba(110, 100, 80, 0.06);
}
.topic-cover {
	width: 244rpx;
	height: 156rpx;
	border-radius: 16rpx;
	background-color: #f4e4cf;
}
.topic-cover-placeholder {
	align-items: center;
	justify-content: center;
}
.topic-cover-text {
	font-size: 16px;
	color: #cbad88;
	font-weight: 600;
}
.topic-title {
	margin-top: 14rpx;
	font-size: 16px;
	line-height: 24px;
	color: #2f2f2f;
	font-weight: 600;
}
.topic-summary {
	margin-top: 10rpx;
	font-size: 12px;
	line-height: 18px;
	color: #8e8e8e;
	height: 54rpx;
	overflow: hidden;
}
.topic-tags {
	margin-top: 12rpx;
	flex-direction: row;
	flex-wrap: wrap;
}
.topic-tag {
	margin-right: 10rpx;
	margin-bottom: 8rpx;
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #f5efe7;
	font-size: 11px;
	color: #907456;
}
.topic-meta {
	margin-top: 12rpx;
	flex-direction: row;
	justify-content: space-between;
}
.topic-meta-text {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
}
