@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.header {
	height: calc(88rpx + var(--status-bar-height));
	padding-top: var(--status-bar-height);
	padding-left: 20rpx;
	padding-right: 20rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: #f7f7f2;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
	position: relative;
}
.back-btn {
	position: absolute;
	left: 16rpx;
	top: var(--status-bar-height);
	bottom: 0;
	width: 56rpx;
	align-items: center;
	justify-content: center;
}
.back-icon-image {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.content {
	flex: 1;
}
.hero {
	height: 420rpx;
	position: relative;
	background-color: #d8c9b5;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}
.hero-cover-image {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 420rpx;
}
.hero-mask {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(60, 54, 44, 0.2);
}
.signal-stack {
	width: 220rpx;
	height: 220rpx;
	align-items: center;
	justify-content: center;
	z-index: 1;
	position: relative;
}
.signal-dot {
	width: 72rpx;
	height: 72rpx;
	border-radius: 36rpx;
	background-color: rgba(185, 112, 47, 0.42);
	z-index: 3;
}
.signal-ring {
	position: absolute;
	border-width: 10rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.88);
	border-radius: 999rpx;
}
.signal-ring-one {
	width: 134rpx;
	height: 134rpx;
}
.signal-ring-two {
	width: 220rpx;
	height: 220rpx;
}
.status-badge {
	position: absolute;
	left: 28rpx;
	top: 24rpx;
	min-width: 110rpx;
	height: 48rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	border-radius: 24rpx;
	background-color: rgba(184, 93, 105, 0.92);
	align-items: center;
	justify-content: center;
}
.status-badge-text {
	font-size: 12px;
	line-height: 18px;
	color: #ffffff;
	font-weight: 600;
}
.detail-panel {
	margin-top: -24rpx;
	padding: 28rpx 24rpx 40rpx;
	border-top-left-radius: 28rpx;
	border-top-right-radius: 28rpx;
	background-color: #ffffff;
}
.title-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.media-title {
	flex: 1;
	font-size: 20px;
	line-height: 30px;
	color: #2e2e2e;
	font-weight: 700;
}
.favorite-title-btn {
	min-width: 110rpx;
	height: 52rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	border-radius: 28rpx;
	background-color: #f8efe7;
	align-items: center;
	justify-content: center;
}
.favorite-text {
	font-size: 12px;
	line-height: 18px;
	color: #c7816e;
}
.favorite-text-active {
	color: #b85d69;
	font-weight: 600;
}
.stats-row {
	margin-top: 22rpx;
	flex-direction: row;
	justify-content: space-between;
}
.stats-text {
	font-size: 12px;
	line-height: 18px;
	color: #9a8d7a;
}
.summary-card {
	margin-top: 22rpx;
	padding: 22rpx 20rpx;
	border-radius: 18rpx;
	background-color: #faf7f2;
}
.summary-line {
	margin-top: 8rpx;
	font-size: 13px;
	line-height: 20px;
	color: #73685a;
}
.summary-line:first-child {
	margin-top: 0;
}
.section-title {
	margin-top: 26rpx;
	font-size: 16px;
	line-height: 24px;
	color: #2c2c2c;
	font-weight: 600;
}
.intro-text {
	margin-top: 16rpx;
	font-size: 14px;
	line-height: 24px;
	color: #666666;
	white-space: pre-line;
}
.video-section {
	margin-top: 28rpx;
}
.section-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.inline-video-wrap {
	margin-top: 16rpx;
	border-radius: 18rpx;
	overflow: hidden;
	background-color: #000000;
}
.inline-video {
	width: 100%;
	height: 360rpx;
	background-color: #000000;
}
.video-card {
	margin-top: 16rpx;
	padding: 22rpx 20rpx;
	border-radius: 18rpx;
	background-color: #faf7f2;
}
.video-card-active {
	background-color: #fff0f3;
	border-width: 1rpx;
	border-style: solid;
	border-color: #c26b7f;
}
.video-title {
	font-size: 15px;
	line-height: 22px;
	color: #2f2f2f;
	font-weight: 600;
}
.video-meta {
	margin-top: 10rpx;
	font-size: 12px;
	line-height: 18px;
	color: #9a8d7a;
}
.action-wrap {
	margin-top: 44rpx;
	align-items: center;
}
.action-btn {
	width: 280rpx;
	height: 74rpx;
	line-height: 74rpx;
	border-radius: 16rpx;
	background-color: #c26b7f;
	color: #ffffff;
	font-size: 16px;
	font-weight: 600;
}
.action-btn-hover {
	opacity: 0.9;
}
