@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #111111;
}
.header {
	height: 88rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: #111111;
	position: relative;
}
.back-btn {
	position: absolute;
	left: 16rpx;
	top: 0;
	bottom: 0;
	width: 56rpx;
	align-items: center;
	justify-content: center;
}
.back-icon-image {
	width: 24rpx;
	height: 24rpx;
}
.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #ffffff;
	font-weight: 600;
}
.player-shell {
	flex: 1;
	padding: 20rpx;
}
.video-player {
	width: 100%;
	height: 420rpx;
	border-radius: 18rpx;
	background-color: #000000;
}
.web-player {
	flex: 1;
}
.state-wrap {
	flex: 1;
	align-items: center;
	justify-content: center;
	padding-left: 40rpx;
	padding-right: 40rpx;
}
.state-text {
	font-size: 14px;
	line-height: 22px;
	color: rgba(255, 255, 255, 0.72);
	text-align: center;
}
.copy-btn {
	margin-top: 28rpx;
	width: 240rpx;
	height: 72rpx;
	border-radius: 16rpx;
	background-color: #18b775;
	align-items: center;
	justify-content: center;
}
.copy-btn-text {
	font-size: 15px;
	line-height: 22px;
	color: #ffffff;
	font-weight: 600;
}
