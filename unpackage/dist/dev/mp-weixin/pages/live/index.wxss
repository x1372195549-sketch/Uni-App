@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
	flex: 1;
	background-color: #f7f7f2;
}
.hero-shell {
	position: relative;
	height: 236rpx;
	overflow: hidden;
}
.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 236rpx;
}
.header {
	position: relative;
	z-index: 1;
	padding-top: 34rpx;
	height: 118rpx;
	align-items: center;
	justify-content: center;
}
.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}
.top-tabs {
	position: relative;
	z-index: 1;
	height: 96rpx;
	margin-top: 18rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}
.top-tab {
	min-width: 88rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}
.top-tab-active {
	position: relative;
}
.top-tab-text {
	font-size: 18px;
	line-height: 26px;
	color: #333333;
}
.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}
.top-tab-line {
	position: absolute;
	bottom: 10rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}
.content {
	flex: 1;
	padding-bottom: 110rpx;
}
.content-shell {
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-top: 24rpx;
	padding-bottom: 40rpx;
}
.live-card {
	margin-bottom: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	overflow: hidden;
	box-shadow: 0 12rpx 24rpx rgba(110, 100, 80, 0.05);
}
.live-cover-shell {
	padding: 0;
	background-color: #f1e3cf;
}
.live-cover {
	height: 260rpx;
	position: relative;
	padding-left: 44rpx;
	padding-top: 48rpx;
	background-color: #f4e4cf;
}
.cover-badge {
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #bf5d68;
	color: #ffffff;
	font-size: 12px;
	font-weight: 600;
	align-self: flex-start;
	text-align: center;
}
.cover-title {
	margin-top: 16rpx;
	font-size: 28px;
	line-height: 38px;
	color: #b9702f;
	font-weight: 600;
}
.cover-subtitle {
	margin-top: 16rpx;
	font-size: 18px;
	line-height: 26px;
	color: #8d6e4d;
}
.live-signal {
	position: absolute;
	right: 54rpx;
	top: 52rpx;
	width: 148rpx;
	height: 148rpx;
	align-items: center;
	justify-content: center;
}
.signal-dot {
	width: 42rpx;
	height: 42rpx;
	border-radius: 21rpx;
	background-color: rgba(185, 112, 47, 0.42);
	z-index: 3;
}
.signal-ring {
	position: absolute;
	border-width: 8rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.84);
	border-radius: 999rpx;
}
.signal-ring-one {
	width: 90rpx;
	height: 90rpx;
}
.signal-ring-two {
	width: 148rpx;
	height: 148rpx;
}
.live-info {
	padding-left: 24rpx;
	padding-right: 24rpx;
	padding-top: 22rpx;
	padding-bottom: 22rpx;
}
.live-title {
	font-size: 18px;
	line-height: 28px;
	color: #252525;
	font-weight: 600;
}
.live-meta {
	margin-top: 18rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.teacher-name {
	font-size: 15px;
	line-height: 22px;
	color: #a8a8a8;
}
.stats {
	flex-direction: row;
	align-items: center;
}
.stat-text {
	font-size: 13px;
	line-height: 20px;
	color: #a0a0a0;
	margin-left: 18rpx;
}
.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}
.tab-item {
	align-items: center;
	justify-content: center;
}
.tab-item-active {
	margin-top: -2rpx;
}
.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}
.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}
.tab-label-active {
	color: #18b775;
}
