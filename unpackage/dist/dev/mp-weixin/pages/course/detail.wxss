@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  flex: 1;
  background-color: #f7f7f2;
}
.header {
  height: calc(88rpx + var(--status-bar-height));
  padding-top: var(--status-bar-height);
  padding-left: 20rpx;
  padding-right: 20rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #f7f7f2;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #ece9e1;
  position: relative;
}
.back-btn {
  position: absolute;
  left: 16rpx;
  top: var(--status-bar-height);
  bottom: 0;
  width: 56rpx;
  align-items: center;
  justify-content: center;
}
.back-icon-image {
  width: 24rpx;
  height: 24rpx;
}
.header-title {
  font-size: 20px;
  line-height: 30px;
  color: #2f2f2f;
  font-weight: 600;
}
.content {
  flex: 1;
}
.hero {
  height: 420rpx;
  position: relative;
  background-color: #d8c9b5;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.course-video-player {
  width: 750rpx;
  height: 420rpx;
  background-color: #000000;
}
.hero-cover-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 420rpx;
}
.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(60, 54, 44, 0.2);
}
.hero-play-button {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background-color: rgba(255, 255, 255, 0.48);
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.hero-play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top-width: 24rpx;
  border-top-style: solid;
  border-top-color: transparent;
  border-bottom-width: 24rpx;
  border-bottom-style: solid;
  border-bottom-color: transparent;
  border-left-width: 34rpx;
  border-left-style: solid;
  border-left-color: rgba(255, 255, 255, 0.96);
}
.board-outer {
  width: 220rpx;
  height: 220rpx;
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.88);
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.board-label {
  font-size: 30px;
  line-height: 40px;
  color: rgba(185, 112, 47, 0.45);
  font-weight: 600;
}
.tabs {
  height: 108rpx;
  padding-left: 44rpx;
  padding-right: 44rpx;
  background-color: #ffffff;
  flex-direction: row;
  align-items: center;
}
.tab-item {
  margin-right: 74rpx;
  align-items: center;
  justify-content: center;
}
.tab-text {
  font-size: 16px;
  line-height: 24px;
  color: #9f9f9f;
}
.tab-text-active {
  color: #262626;
  font-weight: 600;
}
.tab-line {
  margin-top: 10rpx;
  width: 58rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background-color: #b85d69;
}
.favorite-tab-btn {
  margin-left: auto;
  min-width: 108rpx;
  height: 56rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  border-radius: 28rpx;
  background-color: #f4efe7;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.favorite-text {
  font-size: 24rpx;
  color: #8f8f8f;
}
.favorite-text-active {
  color: #c46b76;
  font-weight: 600;
}
.intro-panel {
  padding-left: 46rpx;
  padding-right: 46rpx;
  padding-top: 34rpx;
  padding-bottom: 48rpx;
  background-color: #ffffff;
}
.media-title {
  font-size: 18px;
  line-height: 28px;
  color: #242424;
  font-weight: 600;
  text-align: center;
}
.stats-row {
  margin-top: 34rpx;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}
.stats-text {
  font-size: 12px;
  line-height: 18px;
  color: #9e9e9e;
  margin-left: 28rpx;
}
.section-title {
  margin-top: 38rpx;
  font-size: 15px;
  line-height: 22px;
  color: #2b2b2b;
}
.intro-text {
  margin-top: 28rpx;
  font-size: 12px;
  line-height: 24px;
  color: #8f8f8f;
}
.catalog-panel {
  padding-top: 6rpx;
  padding-bottom: 60rpx;
  background-color: #ffffff;
  min-height: 860rpx;
}
.catalog-row {
  min-height: 106rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.catalog-row-active {
  background-color: #f3f3f3;
}
.catalog-title {
  flex: 1;
  font-size: 14px;
  line-height: 22px;
  color: #353535;
  padding-right: 20rpx;
}
.catalog-duration {
  font-size: 12px;
  line-height: 18px;
  color: #a9a9a9;
}
.catalog-title-active {
  color: #b85d69;
  font-weight: 600;
}
.catalog-duration-active {
  color: #b85d69;
}
