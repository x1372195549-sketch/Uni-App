@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page {
  flex: 1;
  background-color: #f7f7f2;
}
.hero-shell {
  position: relative;
  height: 254rpx;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 254rpx;
}
.header {
  position: relative;
  z-index: 1;
  padding-top: 62rpx;
  height: 146rpx;
  align-items: center;
  justify-content: center;
}
.header-title {
  font-size: 20px;
  line-height: 30px;
  color: #2f2f2f;
  font-weight: 600;
}
.top-tabs {
  position: relative;
  z-index: 1;
  height: 108rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  background-color: rgba(251, 250, 246, 0.78);
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.top-tab {
  min-width: 78rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
}
.top-tab-text {
  font-size: 15px;
  line-height: 22px;
  color: #333333;
}
.top-tab-text-active {
  color: #b85d69;
  font-weight: 600;
}
.top-tab-line {
  margin-top: 12rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background-color: #b85d69;
}
.search-bar {
  margin: 0 20rpx 0;
  padding-left: 18rpx;
  padding-right: 10rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background-color: #ffffff;
  flex-direction: row;
  align-items: center;
}
.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 14px;
  color: #2f2f2f;
}
.search-btn {
  width: 108rpx;
  height: 54rpx;
  border-radius: 27rpx;
  background-color: #18b775;
  align-items: center;
  justify-content: center;
}
.search-btn-text {
  font-size: 13px;
  color: #ffffff;
  font-weight: 600;
}
.content {
  flex: 1;
}
.content-shell {
  padding: 18rpx 20rpx 176rpx;
}
.state-wrap {
  padding: 120rpx 30rpx;
  align-items: center;
}
.state-text {
  font-size: 14px;
  line-height: 22px;
  color: #9b9b9b;
  text-align: center;
}
.retry-btn {
  margin-top: 24rpx;
  width: 220rpx;
  height: 70rpx;
  border-radius: 14rpx;
  background-color: #18b775;
  align-items: center;
  justify-content: center;
}
.retry-btn-text {
  font-size: 14px;
  color: #ffffff;
  font-weight: 600;
}
.list-wrap {
  gap: 18rpx;
}
.course-card {
  overflow: hidden;
  border-radius: 22rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(110, 100, 80, 0.05);
}
.course-cover-shell {
  padding: 0;
}
.course-cover-image {
  width: 100%;
  height: 196rpx;
}
.course-cover {
  position: relative;
  height: 196rpx;
  padding: 28rpx 28rpx 24rpx;
  background-color: #f6e1bc;
}
.cover-badge {
  padding-left: 16rpx;
  padding-right: 16rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 18rpx;
  background-color: #cc6b76;
  font-size: 11px;
  color: #ffffff;
  font-weight: 600;
}
.cover-title {
  margin-top: 18rpx;
  width: 420rpx;
  font-size: 28px;
  line-height: 40px;
  color: #d38c42;
  font-weight: 700;
}
.cover-subtitle {
  margin-top: 10rpx;
  font-size: 18px;
  line-height: 28px;
  color: #8f7a57;
}
.cover-board {
  position: absolute;
  right: 34rpx;
  top: 42rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  border-width: 10rpx;
  border-style: solid;
  border-color: #fff8ee;
  align-items: center;
  justify-content: center;
}
.board-text {
  font-size: 16px;
  color: #e1b98e;
  font-weight: 700;
}
.course-info {
  padding: 20rpx 24rpx 24rpx;
}
.course-title {
  font-size: 22px;
  line-height: 32px;
  font-weight: 600;
  color: #2f2f2f;
}
.course-meta {
  margin-top: 14rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.teacher-name {
  flex: 1;
  font-size: 16px;
  line-height: 24px;
  color: #8f8f8f;
}
.stats {
  flex-direction: row;
}
.stat-text {
  margin-left: 16rpx;
  font-size: 14px;
  line-height: 22px;
  color: #b1b1b1;
}
.bottom-state {
  padding-top: 10rpx;
  align-items: center;
}
.bottom-state-text {
  font-size: 12px;
  line-height: 18px;
  color: #b1b1b1;
}
.tabbar {
  height: 120rpx;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
  background-color: #ffffff;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #ededed;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}
.tab-item {
  flex: 1;
  align-items: center;
  justify-content: center;
}
.tab-item-active {
  opacity: 1;
}
.tab-icon-image {
  width: 42rpx;
  height: 42rpx;
}
.tab-label {
  margin-top: 6rpx;
  font-size: 11px;
  line-height: 16px;
  color: #bcbcbc;
}
.tab-label-active {
  color: #1ab168;
}
