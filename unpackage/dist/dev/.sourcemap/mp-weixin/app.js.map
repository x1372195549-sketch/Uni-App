<script lang="uts">



	export default {
		onLaunch() {
			uni.__f__('log','at App.uvue:7','App Launch')
		},
		onShow() {
			uni.__f__('log','at App.uvue:10','App Show')

			const pages = getCurrentPages()
			const needAuth = pages.length == 0 || pages[pages.length - 1].route == 'pages/login/index'
			if (!needAuth) {
				const token = uni.getStorageSync('app_auth_access_token')
				if (token == null || token == '') {
					uni.reLaunch({
						url: '/pages/login/index'
					})
				}
			}

		},
		onHide() {
			uni.__f__('log','at App.uvue:25','App Hide')
		},


















		onExit() {
			uni.__f__('log','at App.uvue:46','App Exit')
		},
	}
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>