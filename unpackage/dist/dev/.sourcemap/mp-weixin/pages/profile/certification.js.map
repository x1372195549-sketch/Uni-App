<template>
	<view class="page">
		<view class="nav-back" @click="handleBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">学员认证</text>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<view class="status-card">
				<text class="status-label">认证状态</text>
				<text class="status-value" :class="certificationStatusClass">{{ certificationStatusText }}</text>
			</view>

			<view v-if="rejectReason != ''" class="reject-card">
				<text class="reject-title">驳回原因</text>
				<text class="reject-text">{{ rejectReason }}</text>
			</view>

			<view class="form-card">
				<view class="form-row">
					<text class="row-label">真实姓名</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.realName" placeholder="请输入真实姓名" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">手机号</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" type="number" maxlength="11" v-model="form.mobile" placeholder="请输入11位手机号" @input="handlePhoneInput" />
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">身份证号</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" maxlength="18" v-model="form.idCardNo" placeholder="请输入身份证号" @input="handleIdCardInput" />
					</view>
				</view>

				<picker class="picker-row" mode="region" :value="regionValue" @change="handleRegionChange">
					<view class="form-row">
						<text class="row-label">省份</text>
						<view class="row-right">
							<text :class="form.province == '' ? 'row-placeholder' : 'row-value'">{{ form.province == '' ? '请选择省份' : form.province }}</text>
						</view>
					</view>
				</picker>

				<picker class="picker-row" mode="region" :value="regionValue" @change="handleRegionChange">
					<view class="form-row">
						<text class="row-label">城市</text>
						<view class="row-right">
							<text :class="form.city == '' ? 'row-placeholder' : 'row-value'">{{ form.city == '' ? '请选择城市' : form.city }}</text>
						</view>
					</view>
				</picker>

				<picker class="picker-row" mode="region" :value="regionValue" @change="handleRegionChange">
					<view class="form-row">
						<text class="row-label">区县</text>
						<view class="row-right">
							<text :class="form.district == '' ? 'row-placeholder' : 'row-value'">{{ form.district == '' ? '请选择区县' : form.district }}</text>
						</view>
					</view>
				</picker>

				<view class="form-row">
					<text class="row-label">工作单位</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.organization" placeholder="请输入工作单位" />
					</view>
				</view>

				<picker class="picker-row" mode="selector" :range="positionOptions" :value="positionIndex" @change="handlePositionChange">
					<view class="form-row">
						<text class="row-label">职称/执业类别</text>
						<view class="row-right">
							<text :class="form.positionTitle == '' ? 'row-placeholder' : 'row-value'">{{ form.positionTitle == '' ? '请选择职称或执业类别' : form.positionTitle }}</text>
						</view>
					</view>
				</picker>

				<view class="material-row">
					<text class="row-label">认证材料</text>
					<textarea class="material-textarea" v-model="form.certificationMaterials" placeholder="请填写认证材料说明或材料地址"></textarea>
				</view>
			</view>

			<view class="actions">
				<button class="save-btn" hover-class="save-btn-hover" @click="handleSubmit" :disabled="isSaving">
					{{ isSaving ? '提交中...' : '提交认证' }}
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import {
	fetchCertificationStatus,
	submitCertification
} from '../../utils/auth.uts'

type CertificationForm = {
	realName : string
	mobile : string
	idCardNo : string
	province : string
	city : string
	district : string
	organization : string
	positionTitle : string
	certificationMaterials : string
}

const isSaving = ref(false)
const rejectReason = ref('')
const certificationStatus = ref('0')
const positionOptions = ['医师', '护士', '药师', '技师', '中医师', '康复治疗师', '医学生', '其他']

const form = ref<CertificationForm>({
	realName: '',
	mobile: '',
	idCardNo: '',
	province: '',
	city: '',
	district: '',
	organization: '',
	positionTitle: '',
	certificationMaterials: ''
})

const certificationStatusText = computed(() : string => {
	if (certificationStatus.value == '2') {
		return '已认证'
	}
	if (certificationStatus.value == '1') {
		return '待审核'
	}
	if (certificationStatus.value == '3') {
		return '已驳回'
	}
	return '未提交'
})

const certificationStatusClass = computed(() : string => {
	if (certificationStatus.value == '2') {
		return 'status-on'
	}
	if (certificationStatus.value == '1') {
		return 'status-pending'
	}
	if (certificationStatus.value == '3') {
		return 'status-reject'
	}
	return 'status-off'
})

const regionValue = computed(() : string[] => {
	return [form.value.province, form.value.city, form.value.district]
})

const positionIndex = computed(() : number => {
	const index = positionOptions.indexOf(form.value.positionTitle)
	return index >= 0 ? index : 0
})

const trimText = (value : string) : string => {
	return value.trim()
}

const digitsOnly = (value : string) : string => {
	return value.replace(/[^0-9]/g, '')
}

const isValidPhone = (value : string) : boolean => {
	return /^1\d{10}$/.test(value)
}

const normalizeIdCard = (value : string) : string => {
	return value.replace(/[^0-9Xx]/g, '').toUpperCase().slice(0, 18)
}

const isValidIdCard = (value : string) : boolean => {
	return /(^\d{15}$)|(^\d{17}(\d|X)$)/.test(value)
}

const readPickerIndex = (event : any) : number => {
	if (event == null || event.detail == null) {
		return -1
	}
	const rawValue = event.detail.value
	if (typeof rawValue == 'number') {
		return rawValue
	}
	if (typeof rawValue == 'string') {
		const parsed = parseInt(rawValue)
		return isNaN(parsed) ? -1 : parsed
	}
	return -1
}

const handlePhoneInput = () => {
	form.value.mobile = digitsOnly(form.value.mobile).slice(0, 11)
}

const handleIdCardInput = () => {
	form.value.idCardNo = normalizeIdCard(form.value.idCardNo)
}

const handleRegionChange = (event : any) => {
	if (event == null || event.detail == null || event.detail.value == null) {
		return
	}
	const values = event.detail.value as string[]
	if (values.length >= 3) {
		form.value.province = values[0]
		form.value.city = values[1]
		form.value.district = values[2]
	}
}

const handlePositionChange = (event : any) => {
	const index = readPickerIndex(event)
	if (index >= 0 && index < positionOptions.length) {
		form.value.positionTitle = positionOptions[index]
	}
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/index'
	})
}

const applyCertificationData = (data : UTSJSONObject) => {
	form.value.realName = (data['realName'] as string) || form.value.realName
	form.value.mobile = (data['mobile'] as string) || form.value.mobile
	form.value.province = (data['province'] as string) || form.value.province
	form.value.city = (data['city'] as string) || form.value.city
	form.value.district = (data['district'] as string) || form.value.district
	form.value.organization = (data['organization'] as string) || form.value.organization
	form.value.positionTitle = (data['positionTitle'] as string) || form.value.positionTitle
	form.value.certificationMaterials = (data['certificationMaterials'] as string) || form.value.certificationMaterials
	certificationStatus.value = (data['certificationStatus'] as string) || certificationStatus.value
	rejectReason.value = (data['rejectReason'] as string) || ''
	handlePhoneInput()
	handleIdCardInput()
}

const loadCertification = () => {
	fetchCertificationStatus(
		(data) => {
			applyCertificationData(data as UTSJSONObject)
		},
		() => {}
	)
}

const validateForm = () : boolean => {
	form.value.realName = trimText(form.value.realName)
	form.value.organization = trimText(form.value.organization)
	form.value.certificationMaterials = trimText(form.value.certificationMaterials)
	handlePhoneInput()
	handleIdCardInput()

	if (form.value.realName == '') {
		uni.showToast({ title: '请输入真实姓名', icon: 'none' })
		return false
	}
	if (!isValidPhone(form.value.mobile)) {
		uni.showToast({ title: '手机号必须为11位', icon: 'none' })
		return false
	}
	if (!isValidIdCard(form.value.idCardNo)) {
		uni.showToast({ title: '请输入正确的身份证号', icon: 'none' })
		return false
	}
	if (form.value.province == '' || form.value.city == '' || form.value.district == '') {
		uni.showToast({ title: '请选择省市区', icon: 'none' })
		return false
	}
	if (form.value.organization == '') {
		uni.showToast({ title: '请输入工作单位', icon: 'none' })
		return false
	}
	if (form.value.positionTitle == '') {
		uni.showToast({ title: '请选择职称或执业类别', icon: 'none' })
		return false
	}
	if (form.value.certificationMaterials == '') {
		uni.showToast({ title: '请填写认证材料', icon: 'none' })
		return false
	}
	return true
}

const handleSubmit = () => {
	if (isSaving.value || !validateForm()) {
		return
	}

	isSaving.value = true

	submitCertification(
		{
			realName: form.value.realName,
			mobile: form.value.mobile,
			idCardNo: form.value.idCardNo,
			province: form.value.province,
			city: form.value.city,
			district: form.value.district,
			organization: form.value.organization,
			positionTitle: form.value.positionTitle,
			certificationMaterials: form.value.certificationMaterials
		},
		(result) => {
			isSaving.value = false
			applyCertificationData(result as UTSJSONObject)
			uni.showToast({
				title: '提交成功',
				icon: 'success'
			})
		},
		(message) => {
			isSaving.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

loadCertification()
</script>

