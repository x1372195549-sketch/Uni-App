<template>
	<view class="page">
		<view class="nav-back" @click="handleBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">Profile</text>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<view class="form-card">
				<view class="form-row avatar-row" @click="handleChooseAvatar">
					<text class="row-label">Avatar</text>
					<view class="row-right">
						<image class="avatar" :src="form.avatarUrl || defaultAvatar" mode="aspectFill"></image>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">Nickname</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.nickname" placeholder="Enter nickname" />
					</view>
				</view>

				<view class="form-row" @click="handleChooseGender">
					<text class="row-label">Gender</text>
					<view class="row-right">
						<text class="row-value">{{ form.gender || 'Select gender' }}</text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">Email</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.email" placeholder="Enter email" />
					</view>
				</view>

				<view class="form-row signature-row">
					<text class="row-label">Signature</text>
					<view class="row-right row-input-wrap">
						<textarea class="row-textarea" v-model="form.profileSignature" placeholder="Enter signature"></textarea>
					</view>
				</view>
			</view>

			<view class="actions">
				<button class="save-btn" hover-class="save-btn-hover" @click="handleSave" :disabled="isSaving">
					{{ isSaving ? 'Saving...' : 'Save' }}
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import {
	fetchProfile,
	updateProfile,
	requestAvatarUploadUrl,
	uploadAvatarBinaryFile,
	confirmAvatarUpload
} from '../../utils/auth.uts'

type ProfileForm = {
	avatarUrl : string
	nickname : string
	gender : string
	email : string
	profileSignature : string
}

type AvatarMeta = {
	originalName : string
	contentType : string
	fileSize : number
}

const storageKey = 'profile_edit_form'
const genderOptions = ['Male', 'Female']
const defaultAvatar = '/static/mine/avatar.png'
const testAvatarSource = '/static/profile/test-avatar.png'
const isSaving = ref(false)
const selectedAvatarMeta = ref<AvatarMeta | null>(null)

const form = ref<ProfileForm>({
	avatarUrl: defaultAvatar,
	nickname: '',
	gender: '',
	email: '',
	profileSignature: ''
})

const genderMap : UTSJSONObject = {
	'Male': '1',
	'Female': '2'
}

const genderReverseMap : UTSJSONObject = {
	'1': 'Male',
	'2': 'Female'
}

const isRemoteAvatarUrl = (value : string) : boolean => {
	if (value == null || value == '') {
		return false
	}
	return /^https?:\/\//.test(value)
}

const getFileNameFromPath = (filePath : string) : string => {
	if (filePath == null || filePath == '') {
		return 'avatar.jpg'
	}
	const parts = filePath.split('/')
	if (parts.length > 0) {
		const last = parts[parts.length - 1]
		if (last != null && last != '') {
			return last
		}
	}
	return 'avatar.jpg'
}

const getContentTypeFromFileName = (fileName : string) : string => {
	const lower = fileName.toLowerCase()
	if (lower.endsWith('.png')) {
		return 'image/png'
	}
	if (lower.endsWith('.gif')) {
		return 'image/gif'
	}
	if (lower.endsWith('.webp')) {
		return 'image/webp'
	}
	return 'image/jpeg'
}

const buildAvatarMeta = (filePath : string, fileSize : number) : AvatarMeta => {
	const originalName = getFileNameFromPath(filePath)
	return {
		originalName,
		contentType: getContentTypeFromFileName(originalName),
		fileSize: fileSize > 0 ? fileSize : 1024
	}
}

const saveProfileLocal = () => {
	uni.setStorageSync(storageKey, form.value)
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/index'
	})
}

const loadProfile = () => {
	const cached = uni.getStorageSync(storageKey)
	if (cached != null && cached != '') {
		form.value = cached as ProfileForm
	}

	fetchProfile(
		(profile) => {
			form.value.nickname = profile.nickname || form.value.nickname
			form.value.avatarUrl = profile.avatarUrl || form.value.avatarUrl
			form.value.email = profile.email || form.value.email
			form.value.profileSignature = profile.profileSignature || form.value.profileSignature
			const mappedGender = genderReverseMap[profile.gender] as string
			if (mappedGender != null && mappedGender != '') {
				form.value.gender = mappedGender
			}
			saveProfileLocal()
		},
		() => {}
	)
}

const handleChooseAvatar = () => {
	uni.getImageInfo({
		src: testAvatarSource,
		success: (res) => {
			const resolvedPath = res.path != null && res.path != '' ? res.path : testAvatarSource
			form.value.avatarUrl = resolvedPath
			selectedAvatarMeta.value = buildAvatarMeta('test-avatar.png', 1024)
		},
		fail: () => {
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album'],
				success: (res) => {
					if (res.tempFilePaths != null && res.tempFilePaths.length > 0) {
						form.value.avatarUrl = res.tempFilePaths[0]
						if (res.tempFiles != null && res.tempFiles.length > 0) {
							const tempFile = res.tempFiles[0]
							selectedAvatarMeta.value = buildAvatarMeta(res.tempFilePaths[0], tempFile.size)
							return
						}
						selectedAvatarMeta.value = buildAvatarMeta(res.tempFilePaths[0], 1024)
					}
				}
			})
		}
	})
}

const handleChooseGender = () => {
	uni.showActionSheet({
		itemList: genderOptions,
		success: (res) => {
			form.value.gender = genderOptions[res.tapIndex]
		}
	})
}

const uploadAvatarIfNeeded = (
	success : (remoteAvatarUrl : string, didUploadAvatar : boolean) => void,
	fail : (message : string) => void
) => {
	const currentAvatar = form.value.avatarUrl || ''
	if (currentAvatar == '' || currentAvatar == defaultAvatar || isRemoteAvatarUrl(currentAvatar)) {
		success(currentAvatar, false)
		return
	}

	requestAvatarUploadUrl(
		{
			originalName: selectedAvatarMeta.value != null ? selectedAvatarMeta.value!.originalName : getFileNameFromPath(currentAvatar),
			contentType: selectedAvatarMeta.value != null ? selectedAvatarMeta.value!.contentType : getContentTypeFromFileName(getFileNameFromPath(currentAvatar)),
			fileSize: selectedAvatarMeta.value != null ? selectedAvatarMeta.value!.fileSize : 1024
		},
		(uploadConfig) => {
			uploadAvatarBinaryFile(
				currentAvatar,
				uploadConfig,
				{
					contentType: selectedAvatarMeta.value != null ? selectedAvatarMeta.value!.contentType : getContentTypeFromFileName(getFileNameFromPath(currentAvatar))
				},
				() => {
					const originalName = getFileNameFromPath(currentAvatar)
					confirmAvatarUpload(
						{
							objectKey: uploadConfig.objectKey,
							originalName
						},
						(result) => {
							const remoteAvatarUrl = result.avatarUrl || uploadConfig.publicUrl
							if (remoteAvatarUrl == '') {
								fail('Avatar uploaded but no URL returned')
								return
							}
							form.value.avatarUrl = remoteAvatarUrl
							selectedAvatarMeta.value = null
							success(remoteAvatarUrl, true)
						},
						(message) => {
							fail(message || 'Confirm avatar upload failed')
						}
					)
				},
				(message) => {
					fail(message || 'Avatar file upload failed')
				}
			)
		},
		(message) => {
			fail(message || 'Request upload url failed')
		}
	)
}

const handleSave = () => {
	if (isSaving.value) {
		return
	}

	isSaving.value = true

	uploadAvatarIfNeeded(
		(remoteAvatarUrl, didUploadAvatar) => {
			const genderCode = genderMap[form.value.gender] as string
			updateProfile(
				{
					nickname: form.value.nickname,
					profileSignature: form.value.profileSignature,
					email: form.value.email,
					gender: genderCode
				},
				() => {
					if (didUploadAvatar && remoteAvatarUrl != '') {
						fetchProfile(
							(profile) => {
								saveProfileLocal()
								isSaving.value = false
								if (profile.avatarUrl == remoteAvatarUrl) {
									uni.showToast({
										title: 'Avatar saved',
										icon: 'success'
									})
									return
								}
								uni.showToast({
									title: 'Avatar uploaded, profile not updated',
									icon: 'none'
								})
							},
							() => {
								saveProfileLocal()
								isSaving.value = false
								uni.showToast({
									title: 'Saved, avatar status unknown',
									icon: 'none'
								})
							}
						)
						return
					}

					saveProfileLocal()
					isSaving.value = false
					uni.showToast({
						title: 'Saved',
						icon: 'success'
					})
				},
				(message) => {
					isSaving.value = false
					uni.showToast({
						title: message,
						icon: 'none'
					})
				}
			)
		},
		(message) => {
			isSaving.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

loadProfile()
</script>

