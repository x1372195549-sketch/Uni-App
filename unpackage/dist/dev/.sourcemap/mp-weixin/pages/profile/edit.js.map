<template>
	<view class="page">
		<view class="nav-back" @click="handleBack">
			<text class="nav-back-icon"><</text>
		</view>

		<view class="header">
			<text class="header-title">个人资料</text>
		</view>

		<scroll-view class="form-scroll" scroll-y="true">
			<view class="form-card">
				<view class="form-row avatar-row" @click="handleChooseAvatar">
					<text class="row-label">头像</text>
					<view class="row-right">
						<image class="avatar" :src="form.avatarUrl" mode="aspectFill"></image>
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">昵称</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.nickname" placeholder="请输入昵称" />
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row" @click="handleChooseGender">
					<text class="row-label">性别</text>
					<view class="row-right">
						<text class="row-value">{{ form.gender || '请选择' }}</text>
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">年龄</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" type="number" maxlength="3" v-model="form.age" placeholder="请输入数字年龄" @input="handleAgeInput" />
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row" @click="handleChooseEducation">
					<text class="row-label">文化程度</text>
					<view class="row-right">
						<text class="row-value">{{ form.education || '请选择' }}</text>
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">执业类别</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.practiceType" placeholder="请输入执业类别" />
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">地区</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" v-model="form.organization" placeholder="请输入地区" />
						<text class="row-arrow">></text>
					</view>
				</view>

				<view class="form-row">
					<text class="row-label">联系电话</text>
					<view class="row-right row-input-wrap">
						<input class="row-input" type="number" maxlength="11" v-model="form.phone" placeholder="请输入11位联系电话" @input="handlePhoneInput" />
						<text class="row-arrow">></text>
					</view>
				</view>
			</view>

			<view class="actions">
				<button class="save-btn" hover-class="save-btn-hover" @click="handleSave">保存</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { fetchProfile, updateProfile } from '../../utils/auth.uts'

type ProfileForm = {
	avatarUrl : string
	nickname : string
	gender : string
	age : string
	education : string
	practiceType : string
	organization : string
	phone : string
}

const storageKey = 'profile_edit_form'
const educationOptions = ['小学', '初中', '高中', '专科', '本科', '研究生', '博士']
const genderOptions = ['男', '女']
const defaultAvatar = '/static/mine/avatar.png'

const form = ref<ProfileForm>({
	avatarUrl: defaultAvatar,
	nickname: '',
	gender: '',
	age: '',
	education: '',
	practiceType: '',
	organization: '',
	phone: ''
})

const genderMap : UTSJSONObject = {
	'男': '1',
	'女': '2'
}

const genderReverseMap : UTSJSONObject = {
	'1': '男',
	'2': '女'
}

const digitsOnly = (value : string) : string => {
	return value.replace(/[^0-9]/g, '')
}

const isValidPhone = (value : string) : boolean => {
	return /^1\d{10}$/.test(value)
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.navigateTo({
		url: '/pages/mine/index'
	})
}

const loadProfile = () => {
	const cached = uni.getStorageSync(storageKey)
	if (cached != null && cached != '') {
		form.value = cached as ProfileForm
		form.value.age = digitsOnly(form.value.age).slice(0, 3)
		form.value.phone = digitsOnly(form.value.phone).slice(0, 11)
	}

	fetchProfile(
		(profile) => {
			form.value.nickname = profile.nickname || form.value.nickname
			form.value.avatarUrl = profile.avatarUrl || form.value.avatarUrl
			form.value.phone = profile.mobile || form.value.phone
			const g = genderReverseMap[profile.gender] as string
			if (g) {
				form.value.gender = g
			}
		},
		() => {}
	)
}

const handleAgeInput = () => {
	form.value.age = digitsOnly(form.value.age).slice(0, 3)
}

const handlePhoneInput = () => {
	form.value.phone = digitsOnly(form.value.phone).slice(0, 11)
}

const handleChooseAvatar = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album'],
		success: (res) => {
			if (res.tempFilePaths != null && res.tempFilePaths.length > 0) {
				form.value.avatarUrl = res.tempFilePaths[0]
			}
		}
	})
}

const handleChooseGender = () => {
	uni.showActionSheet({
		itemList: genderOptions,
		success: (res) => {
			form.value.gender = genderOptions[res.tapIndex]
		}
	})
}

const handleChooseEducation = () => {
	uni.showActionSheet({
		itemList: educationOptions,
		success: (res) => {
			form.value.education = educationOptions[res.tapIndex]
		}
	})
}

const saveProfileLocal = () => {
	uni.setStorageSync(storageKey, form.value)
}

const handleSave = () => {
	handleAgeInput()
	handlePhoneInput()

	if (form.value.age != '' && digitsOnly(form.value.age) != form.value.age) {
		uni.showToast({
			title: '年龄只能填写数字',
			icon: 'none'
		})
		return
	}

	if (form.value.phone != '' && !isValidPhone(form.value.phone)) {
		uni.showToast({
			title: '联系电话需为11位手机号',
			icon: 'none'
		})
		return
	}

	saveProfileLocal()

	const genderCode = genderMap[form.value.gender] as string
	updateProfile(
		{
			nickname: form.value.nickname,
			avatarUrl: form.value.avatarUrl != defaultAvatar ? form.value.avatarUrl : undefined,
			gender: genderCode
		},
		() => {
			uni.showToast({
				title: '已保存',
				icon: 'success'
			})
		},
		(message) => {
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

loadProfile()
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5fb;
	position: relative;
}

.nav-back {
	position: absolute;
	top: 74rpx;
	left: 12rpx;
	width: 56rpx;
	height: 56rpx;
	align-items: center;
	justify-content: center;
	z-index: 2;
}

.nav-back-icon {
	font-size: 34rpx;
	line-height: 34rpx;
	color: #111111;
	font-weight: 600;
}

.header {
	padding-top: 78rpx;
	align-items: center;
}

.header-title {
	font-size: 19px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 600;
}

.form-scroll {
	flex: 1;
	padding-top: 30rpx;
}

.form-card {
	margin-left: 12rpx;
	margin-right: 12rpx;
	background-color: #ffffff;
}

.form-row {
	min-height: 98rpx;
	padding-left: 24rpx;
	padding-right: 18rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #f0f0f5;
}

.form-row:last-child {
	border-bottom-width: 0;
}

.avatar-row {
	min-height: 118rpx;
}

.row-label {
	font-size: 20px;
	line-height: 28px;
	color: #222222;
	font-weight: 600;
}

.row-right {
	flex-direction: row;
	align-items: center;
	max-width: 430rpx;
}

.row-input-wrap {
	flex: 1;
	justify-content: flex-end;
}

.avatar {
	width: 84rpx;
	height: 84rpx;
	border-radius: 42rpx;
	margin-right: 16rpx;
}

.row-value {
	font-size: 18px;
	line-height: 26px;
	color: #a8a8a8;
	text-align: right;
}

.row-input {
	flex: 1;
	height: 52rpx;
	font-size: 18px;
	color: #8f8f8f;
	text-align: right;
	padding-left: 0;
	padding-right: 8rpx;
	background-color: transparent;
}

.row-arrow {
	font-size: 22rpx;
	line-height: 22rpx;
	color: #c3c3c3;
}

.actions {
	margin-top: 34rpx;
	margin-left: 20rpx;
	margin-right: 20rpx;
	padding-bottom: 180rpx;
}

.save-btn {
	height: 86rpx;
	line-height: 86rpx;
	background-color: #10b66d;
	color: #ffffff;
	font-size: 18px;
	font-weight: 600;
	border-radius: 12rpx;
	border-width: 0;
}

.save-btn-hover {
	opacity: 0.92;
}

.hint {
	margin-top: 16rpx;
	font-size: 13px;
	line-height: 20px;
	color: #a6a6a6;
	text-align: center;
}
</style>
