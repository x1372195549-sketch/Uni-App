<template>
	<view class="page">
		<view class="nav-back" @tap="handleBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">{{ pageTitleText }}</text>
		</view>

		<view class="top-tabs">
			<view
				v-for="tab in tabs"
				:key="tab.key"
				class="top-tab"
				@tap="changeTab(tab.key)"
			>
				<text class="top-tab-text" :class="activeTab == tab.key ? 'top-tab-text-active' : ''">{{ tab.label }}</text>
				<view v-if="activeTab == tab.key" class="top-tab-line"></view>
			</view>
		</view>

		<scroll-view class="list-scroll" scroll-y="true">
			<view v-if="isLoading" class="state-wrap">
				<text class="state-text">{{ loadingText }}</text>
			</view>

			<view v-else-if="errorText.length > 0" class="state-wrap">
				<text class="state-text">{{ errorText }}</text>
				<view class="retry-btn" @tap="loadFavorites">
					<text class="retry-btn-text">{{ retryText }}</text>
				</view>
			</view>

			<view v-else-if="filteredItems.length == 0" class="state-wrap">
				<text class="state-text">{{ emptyText }}</text>
			</view>

			<view
				v-else
				v-for="item in filteredItems"
				:key="item.id"
				class="favorite-card"
				@tap="goToDetail(item)"
			>
				<view class="favorite-cover-shell" :style="{ backgroundColor: item.coverColor }">
					<image
						v-if="item.coverUrl.length > 0"
						class="favorite-cover"
						:src="item.coverUrl"
						mode="aspectFill"
						@error="handleCoverError(item.id)"
					></image>
					<view v-else class="favorite-cover-placeholder">
						<text class="favorite-cover-placeholder-text">{{ item.typeLabel }}</text>
					</view>
				</view>

				<view class="favorite-main">
					<view class="favorite-meta-row">
						<text class="favorite-type-tag">{{ item.typeLabel }}</text>
						<text class="favorite-title">{{ item.title }}</text>
					</view>
					<text v-if="item.source.length > 0" class="favorite-source">{{ item.source }}</text>
					<text class="favorite-time">{{ favoriteTimeText }} {{ item.timeText }}</text>
				</view>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import {
	fetchAudioDetail,
	fetchArticleDetail,
	fetchBookDetail,
	fetchCourseDetail,
	fetchLiveSessionDetail,
	fetchProfileFavorites,
	fetchTopicDetail,
	type Article,
	type AppBook,
	type AppPodcast,
	type AppResourceRecord,
	type Course,
	type LiveSession,
	type Topic
} from '../../utils/auth.uts'

type FavoriteTab = {
	key : string
	label : string
}

type FavoriteDisplayItem = {
	id : string
	resourceType : string
	resourceId : number
	typeLabel : string
	title : string
	source : string
	timeText : string
	coverUrl : string
	coverColor : string
}

const TYPE_ALL = 'ALL'
const TYPE_AUDIO = 'AUDIO'
const TYPE_COURSE = 'COURSE'
const TYPE_LIVE = 'LIVE'
const TYPE_BOOK = 'BOOK'
const TYPE_TOPIC = 'TOPIC'
const TYPE_INFO = 'INFO'

const pageTitleText = '\u6211\u7684\u6536\u85cf'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const emptyText = '\u6682\u65e0\u6536\u85cf\u5185\u5bb9'
const loadFailedText = '\u52a0\u8f7d\u6536\u85cf\u5931\u8d25'
const favoriteTimeText = '\u6536\u85cf\u65f6\u95f4:'
const unsupportedOpenText = '\u6682\u4e0d\u652f\u6301\u6253\u5f00\u8be5\u6536\u85cf'
const unknownText = '\u672a\u77e5'

const tabs : FavoriteTab[] = [
	{ key: TYPE_ALL, label: '\u5168\u90e8' },
	{ key: TYPE_AUDIO, label: '\u97f3\u9891' },
	{ key: TYPE_COURSE, label: '\u8bfe\u7a0b' },
	{ key: TYPE_LIVE, label: '\u76f4\u64ad' },
	{ key: TYPE_BOOK, label: '\u56fe\u4e66' },
	{ key: TYPE_TOPIC, label: '\u4e13\u9898' },
	{ key: TYPE_INFO, label: '\u8d44\u8baf' }
]

const activeTab = ref(TYPE_ALL)
const isLoading = ref(true)
const errorText = ref('')
const allItems = ref<FavoriteDisplayItem[]>([])

const filteredItems = computed(() : FavoriteDisplayItem[] => {
	if (activeTab.value == TYPE_ALL) {
		return allItems.value
	}
	return allItems.value.filter((item : FavoriteDisplayItem) : boolean => item.resourceType == activeTab.value)
})

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const formatOccurredAt = (value : string) : string => {
	const text = safeText(value)
	if (text.length == 0) {
		return unknownText
	}
	return text.replace('T', ' ')
}

const normalizeFavoriteType = (resourceType : string) : string => {
	const normalizedType = safeText(resourceType).toLowerCase()
	if (normalizedType == 'audio' || normalizedType == 'podcast') {
		return TYPE_AUDIO
	}
	if (normalizedType == 'live') {
		return TYPE_LIVE
	}
	if (normalizedType == 'course') {
		return TYPE_COURSE
	}
	if (normalizedType == 'book' || normalizedType == 'books' || normalizedType == 'learning') {
		return TYPE_BOOK
	}
	if (normalizedType == 'topic') {
		return TYPE_TOPIC
	}
	if (normalizedType == 'article' || normalizedType == 'info') {
		return TYPE_INFO
	}
	return safeText(resourceType).toUpperCase()
}

const getTypeLabel = (resourceType : string) : string => {
	const normalizedType = normalizeFavoriteType(resourceType)
	if (normalizedType == TYPE_AUDIO) {
		return '\u97f3\u9891'
	}
	if (normalizedType == TYPE_LIVE) {
		return '\u76f4\u64ad'
	}
	if (normalizedType == TYPE_COURSE) {
		return '\u8bfe\u7a0b'
	}
	if (normalizedType == TYPE_BOOK) {
		return '\u56fe\u4e66'
	}
	if (normalizedType == TYPE_TOPIC) {
		return '\u4e13\u9898'
	}
	if (normalizedType == TYPE_INFO) {
		return '\u8d44\u8baf'
	}
	return '\u6536\u85cf'
}

const getCoverColor = (resourceType : string) : string => {
	const normalizedType = normalizeFavoriteType(resourceType)
	if (normalizedType == TYPE_AUDIO) {
		return '#F6E3D2'
	}
	if (normalizedType == TYPE_LIVE) {
		return '#E1D7C8'
	}
	if (normalizedType == TYPE_COURSE) {
		return '#F3E3D8'
	}
	if (normalizedType == TYPE_BOOK) {
		return '#F2DFCA'
	}
	if (normalizedType == TYPE_TOPIC) {
		return '#EDE3D4'
	}
	if (normalizedType == TYPE_INFO) {
		return '#EFE2D0'
	}
	return '#F1F1F1'
}

const sanitizeCoverUrl = (value : string) : string => {
	const cover = safeText(value)
	if (cover.length == 0) {
		return ''
	}
	if (cover.indexOf('example.com') >= 0) {
		return ''
	}
	return cover
}

const buildFallbackItem = (record : AppResourceRecord) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: getTypeLabel(record.resourceType) + ' #' + String(record.resourceId),
		source: safeText(record.source),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: '',
		coverColor: getCoverColor(record.resourceType)
	}
}

const mapAudioFavorite = (record : AppResourceRecord, detail : AppPodcast) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: safeText(detail.title).length > 0 ? detail.title : '\u97f3\u9891 #' + String(record.resourceId),
		source: safeText(record.source).length > 0 ? safeText(record.source) : safeText(detail.publishedAt),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: sanitizeCoverUrl(detail.coverUrl),
		coverColor: getCoverColor(record.resourceType)
	}
}

const mapLiveFavorite = (record : AppResourceRecord, detail : LiveSession) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: safeText(detail.title).length > 0 ? detail.title : '\u76f4\u64ad #' + String(record.resourceId),
		source: safeText(record.source).length > 0 ? safeText(record.source) : safeText(detail.anchorName),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: sanitizeCoverUrl(detail.coverUrl),
		coverColor: getCoverColor(record.resourceType)
	}
}

const mapCourseFavorite = (record : AppResourceRecord, detail : Course) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: safeText(detail.courseName).length > 0 ? detail.courseName : '\u8bfe\u7a0b #' + String(record.resourceId),
		source: safeText(record.source).length > 0 ? safeText(record.source) : safeText(detail.lecturerName),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: sanitizeCoverUrl(detail.coverUrl),
		coverColor: getCoverColor(record.resourceType)
	}
}

const mapBookFavorite = (record : AppResourceRecord, detail : AppBook) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: safeText(detail.bookName).length > 0 ? detail.bookName : '\u56fe\u4e66 #' + String(record.resourceId),
		source: safeText(record.source).length > 0 ? safeText(record.source) : safeText(detail.author),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: sanitizeCoverUrl(detail.coverUrl),
		coverColor: getCoverColor(record.resourceType)
	}
}

const mapTopicFavorite = (record : AppResourceRecord, detail : Topic) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: safeText(detail.title).length > 0 ? detail.title : '\u4e13\u9898 #' + String(record.resourceId),
		source: safeText(record.source).length > 0 ? safeText(record.source) : safeText(detail.publishedAt),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: sanitizeCoverUrl(detail.coverUrl),
		coverColor: getCoverColor(record.resourceType)
	}
}

const mapArticleFavorite = (record : AppResourceRecord, detail : Article) : FavoriteDisplayItem => {
	return {
		id: String(record.id),
		resourceType: normalizeFavoriteType(record.resourceType),
		resourceId: record.resourceId,
		typeLabel: getTypeLabel(record.resourceType),
		title: safeText(detail.title).length > 0 ? detail.title : '\u8d44\u8baf #' + String(record.resourceId),
		source: safeText(record.source).length > 0 ? safeText(record.source) : safeText(detail.source),
		timeText: formatOccurredAt(safeText(record.occurredAt)),
		coverUrl: sanitizeCoverUrl(detail.coverUrl),
		coverColor: getCoverColor(record.resourceType)
	}
}

const enrichFavoriteItem = (
	record : AppResourceRecord,
	success : (item : FavoriteDisplayItem) => void
) => {
	const normalizedType = normalizeFavoriteType(record.resourceType)
	if (normalizedType == TYPE_AUDIO) {
		fetchAudioDetail(
			String(record.resourceId),
			(detail) => {
				success(mapAudioFavorite(record, detail))
			},
			() => {
				success(buildFallbackItem(record))
			}
		)
		return
	}

	if (normalizedType == TYPE_LIVE) {
		fetchLiveSessionDetail(
			String(record.resourceId),
			(detail) => {
				success(mapLiveFavorite(record, detail))
			},
			() => {
				success(buildFallbackItem(record))
			}
		)
		return
	}

	if (normalizedType == TYPE_COURSE) {
		fetchCourseDetail(
			String(record.resourceId),
			(detail) => {
				success(mapCourseFavorite(record, detail))
			},
			() => {
				success(buildFallbackItem(record))
			}
		)
		return
	}

	if (normalizedType == TYPE_BOOK) {
		fetchBookDetail(
			String(record.resourceId),
			(detail) => {
				success(mapBookFavorite(record, detail))
			},
			() => {
				success(buildFallbackItem(record))
			}
		)
		return
	}

	if (normalizedType == TYPE_TOPIC) {
		fetchTopicDetail(
			String(record.resourceId),
			(detail) => {
				success(mapTopicFavorite(record, detail))
			},
			() => {
				success(buildFallbackItem(record))
			}
		)
		return
	}

	if (normalizedType == TYPE_INFO) {
		fetchArticleDetail(
			String(record.resourceId),
			(detail) => {
				success(mapArticleFavorite(record, detail))
			},
			() => {
				success(buildFallbackItem(record))
			}
		)
		return
	}

	success(buildFallbackItem(record))
}

const loadFavorites = () => {
	isLoading.value = true
	errorText.value = ''

	fetchProfileFavorites(
		1,
		50,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			if (records.length == 0) {
				allItems.value = []
				isLoading.value = false
				return
			}

			const resultItems = new Array<FavoriteDisplayItem>()
			let finishedCount = 0

			records.forEach((record : AppResourceRecord) => {
				enrichFavoriteItem(record, (item : FavoriteDisplayItem) => {
					resultItems.push(item)
					finishedCount += 1
					if (finishedCount == records.length) {
						allItems.value = resultItems.sort((left : FavoriteDisplayItem, right : FavoriteDisplayItem) : number => {
							if (left.timeText == right.timeText) {
								return 0
							}
							return left.timeText > right.timeText ? -1 : 1
						})
						isLoading.value = false
					}
				})
			})
		},
		(message) => {
			errorText.value = message.length > 0 ? message : loadFailedText
			allItems.value = []
			isLoading.value = false
		},
		'occurredAt,desc'
	)
}

const changeTab = (tabKey : string) => {
	activeTab.value = tabKey
}

const handleCoverError = (itemId : string) => {
	allItems.value = allItems.value.map((item : FavoriteDisplayItem) : FavoriteDisplayItem => {
		if (item.id != itemId) {
			return item
		}
		return {
			id: item.id,
			resourceType: item.resourceType,
			resourceId: item.resourceId,
			typeLabel: item.typeLabel,
			title: item.title,
			source: item.source,
			timeText: item.timeText,
			coverUrl: '',
			coverColor: item.coverColor
		}
	})
}

const goToDetail = (item : FavoriteDisplayItem) => {
	let url = ''
	if (item.resourceType == TYPE_AUDIO) {
		url = '/pages/audio/detail?id=' + String(item.resourceId)
	} else if (item.resourceType == TYPE_LIVE) {
		url = '/pages/live/detail?id=' + String(item.resourceId)
	} else if (item.resourceType == TYPE_COURSE) {
		url = '/pages/course/detail?id=' + String(item.resourceId)
	} else if (item.resourceType == TYPE_BOOK) {
		url = '/pages/book/detail?id=' + String(item.resourceId)
	} else if (item.resourceType == TYPE_TOPIC) {
		url = '/pages/topics/detail?id=' + String(item.resourceId)
	} else if (item.resourceType == TYPE_INFO) {
		url = '/pages/news/detail?id=' + String(item.resourceId)
	}

	if (url.length == 0) {
		uni.showToast({
			title: unsupportedOpenText,
			icon: 'none'
		})
		return
	}

	uni.navigateTo({ url })
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.redirectTo({
		url: '/pages/mine/index'
	})
}

loadFavorites()

onShow(() => {
	loadFavorites()
})
</script>

