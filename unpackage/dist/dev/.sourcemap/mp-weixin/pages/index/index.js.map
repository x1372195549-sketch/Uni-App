	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 244rpx;
}

.header {
	position: relative;
	z-index: 1;
	padding-top: 62rpx;
	height: 136rpx;
	align-items: center;
	justify-content: center;
}

.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}

.top-tabs {
	position: relative;
	z-index: 1;
	height: 108rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}

.top-tab {
	min-width: 78rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}

.top-tab-active {
	position: relative;
}

.top-tab-text {
	font-size: 15px;
	line-height: 22px;
	color: #333333;
}

.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}

.top-tab-line {
	position: absolute;
	bottom: 12rpx;
	width: 42rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}

.content {
	flex: 1;
	padding-bottom: 110rpx;
}

.content-shell {
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-bottom: 20rpx;
}

.hero-card-top {
	margin-top: 0;
}

.hero-swiper {
	height: 292rpx;
}

.hero-card {
	position: relative;
	height: 292rpx;
	box-sizing: border-box;
	padding: 24rpx 24rpx;
	border-radius: 24rpx;
	background: linear-gradient(135deg, #f7e4c8 0%, #f3efe7 100%);
	box-shadow: 0 12rpx 28rpx rgba(152, 118, 72, 0.12);
