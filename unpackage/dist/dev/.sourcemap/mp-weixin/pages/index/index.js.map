<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

			<view class="header">
				<text class="header-title">{{ appTitleText }}</text>
			</view>

			<view class="top-tabs">
				<view class="top-tab top-tab-active">
					<text class="top-tab-text top-tab-text-active">{{ homeTabText }}</text>
					<view class="top-tab-line"></view>
				</view>
				<view class="top-tab" @tap="goTopicsPage">
					<text class="top-tab-text">{{ topicTabText }}</text>
				</view>
				<view class="top-tab" @tap="goAudioPage">
					<text class="top-tab-text">{{ audioTabText }}</text>
				</view>
				<view class="top-tab" @tap="goLivePage">
					<text class="top-tab-text">{{ liveTabText }}</text>
				</view>
				<view class="top-tab" @tap="goCoursePage">
					<text class="top-tab-text">{{ courseTabText }}</text>
				</view>
				<view class="top-tab" @tap="goNewsPage">
					<text class="top-tab-text">{{ newsTabText }}</text>
				</view>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="content-shell">
				<swiper
					v-if="heroSlides.length > 0"
					class="hero-swiper hero-card-top"
					indicator-dots="true"
					autoplay="true"
					circular="true"
					interval="4000"
					duration="400"
				>
					<swiper-item v-for="item in heroSlides" :key="item.id">
						<view class="hero-card" @tap="goHeroDetail(item)">
							<view class="hero-main">
								<text class="hero-kicker">{{ item.kicker }}</text>
								<text class="hero-title">{{ item.title }}</text>
								<text class="hero-subtitle">{{ item.subtitle }}</text>
								<view class="hero-action">
									<text class="hero-action-text">{{ item.actionText }}</text>
								</view>
							</view>
							<image v-if="item.coverUrl.length > 0" class="hero-cover" :src="item.coverUrl" mode="aspectFill"></image>
							<view v-else class="hero-cover hero-cover-placeholder">
								<text class="hero-cover-text">{{ item.kicker }}</text>
							</view>
						</view>
					</swiper-item>
				</swiper>
				<view v-else class="hero-card hero-card-top" @tap="goTopicsPage">
					<view class="hero-main">
						<text class="hero-kicker">{{ heroKickerText }}</text>
						<text class="hero-title">{{ heroTitleText }}</text>
						<text class="hero-subtitle">{{ heroSubtitleText }}</text>
						<view class="hero-action">
							<text class="hero-action-text">{{ heroActionText }}</text>
						</view>
					</view>
					<view class="hero-cover hero-cover-placeholder">
						<text class="hero-cover-text">{{ topicTabText }}</text>
					</view>
				</view>

				<view class="section-head">
					<text class="section-title">{{ homeRecommendTitle }}</text>
				</view>

				<view v-if="recommendItems.length > 0" class="recommend-grid">
					<view
						v-for="item in recommendItems"
						:key="item.id"
						class="recommend-card"
						@tap="goRecommendDetail(item)"
					>
						<image v-if="item.coverUrl.length > 0" class="recommend-cover" :src="item.coverUrl" mode="aspectFill"></image>
						<view v-else class="recommend-cover recommend-cover-placeholder">
							<text class="recommend-cover-text">{{ item.typeLabel }}</text>
						</view>
						<text class="recommend-type">{{ item.typeLabel }}</text>
						<text class="recommend-title">{{ item.title }}</text>
						<text class="recommend-summary">{{ item.summary }}</text>
					</view>
				</view>
				<view v-else class="section-empty">
					<text class="section-empty-text">{{ emptyRecommendText }}</text>
				</view>

				<view class="section-head section-gap">
					<text class="section-title">{{ recommendTopicTitle }}</text>
					<text class="section-more" @tap="goTopicsPage">{{ moreText }}</text>
				</view>

				<scroll-view v-if="topicItems.length > 0" class="topic-scroll" scroll-x="true" show-scrollbar="false">
					<view class="topic-row">
						<view
							v-for="item in topicItems"
							:key="item.id"
							class="topic-card"
							@tap="goHomeTopicDetail(item)"
						>
							<image v-if="item.coverUrl.length > 0" class="topic-cover" :src="item.coverUrl" mode="aspectFill"></image>
							<view v-else class="topic-cover topic-cover-placeholder">
								<text class="topic-cover-text">{{ topicTabText }}</text>
							</view>
							<text class="topic-title">{{ item.title }}</text>
							<text class="topic-summary">{{ item.summary }}</text>
							<view class="topic-tags">
								<text v-for="tag in item.tags" :key="tag" class="topic-tag">{{ tag }}</text>
							</view>
							<view class="topic-meta">
								<text class="topic-meta-text">{{ viewText }} {{ item.viewCount }}</text>
								<text class="topic-meta-text">{{ favoriteText }} {{ item.favoriteCount }}</text>
							</view>
						</view>
					</view>
				</scroll-view>
				<view v-else class="section-empty">
					<text class="section-empty-text">{{ emptyTopicText }}</text>
				</view>

			</view>
		</scroll-view>

		<view class="tabbar">
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">{{ learningTabText }}</text>
			</view>
			<view class="tab-item" @tap="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ examTabText }}</text>
			</view>
			<view class="tab-item" @tap="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">{{ consultTabText }}</text>
			</view>
			<view class="tab-item" @tap="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ knowledgeTabText }}</text>
			</view>
			<view class="tab-item" @tap="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">{{ mineTabText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import {
	fetchAppHome,
	type AppHomeItem,
	type AppHomeSection
} from '../../utils/auth.uts'

type HomeTopicCard = {
	id : number
	resourceType : string
	resourceId : number
	title : string
	summary : string
	coverUrl : string
	tags : string[]
	viewCount : number
	favoriteCount : number
}

type HomeRecommendItem = {
	id : string
	resourceType : string
	resourceId : number
	typeLabel : string
	title : string
	summary : string
	coverUrl : string
}

type HomeHeroSlide = {
	id : string
	resourceType : string
	resourceId : number
	kicker : string
	title : string
	subtitle : string
	coverUrl : string
	actionText : string
}

const appTitleText = '\u6c5f\u82cf\u4e2d\u533b\u5728\u7ebf'
const homeTabText = '\u9996\u9875'
const topicTabText = '\u4e13\u9898'
const audioTabText = '\u97f3\u9891'
const liveTabText = '\u76f4\u64ad'
const courseTabText = '\u8bfe\u7a0b'
const newsTabText = '\u8d44\u8baf'
const learningTabText = '\u5b66\u4e60'
const examTabText = '\u8003\u6838'
const consultTabText = '\u54a8\u8be2'
const knowledgeTabText = '\u77e5\u8bc6\u5e93'
const mineTabText = '\u6211\u7684'
const heroKickerText = '\u5b66\u4e60\u4e13\u9898'
const heroTitleText = '\u5206\u573a\u666f\u3001\u5206\u8d44\u6e90\u7684\u4e2d\u533b\u5b66\u4e60\u8bbe\u8ba1'
const heroSubtitleText = '\u7528\u4e13\u9898\u628a\u56fe\u4e66\u3001\u8bfe\u7a0b\u3001\u97f3\u9891\u4e32\u6210\u5b8c\u6574\u5b66\u4e60\u8def\u5f84\u3002'
const heroActionText = '\u8fdb\u5165\u4e13\u9898'
const heroActionAudioText = '\u8fdb\u5165\u97f3\u9891'
const heroActionLiveText = '\u8fdb\u5165\u76f4\u64ad'
const heroActionCourseText = '\u8fdb\u5165\u8bfe\u7a0b'
const heroActionNewsText = '\u67e5\u770b\u8d44\u8baf'
const homeRecommendTitle = '\u9996\u9875\u63a8\u8350'
const recommendTopicTitle = '\u70ed\u95e8\u4e13\u9898'
const emptyRecommendText = '\u6682\u65e0\u9996\u9875\u63a8\u8350'
const emptyTopicText = '\u6682\u65e0\u70ed\u95e8\u4e13\u9898'
const moreText = '\u66f4\u591a'
const viewText = '\u6d4f\u89c8'
const favoriteText = '\u6536\u85cf'
const fallbackTopicSummary = '\u66f4\u9002\u5408\u6309\u4e3b\u9898\u5316\u5b66\u4e60\u7684\u5185\u5bb9\u7ec4\u5408\u3002'
const fallbackAudioSummary = '\u4ece\u97f3\u9891\u89d2\u5ea6\u7ee7\u7eed\u5b66\u4e60\u3002'
const fallbackLiveSummary = '\u67e5\u770b\u6700\u65b0\u76f4\u64ad\u4e0e\u56de\u653e\u5185\u5bb9\u3002'
const fallbackCourseSummary = '\u8fdb\u5165\u7cfb\u7edf\u8bfe\u7a0b\u5b66\u4e60\u3002'
const fallbackNewsSlideSummary = '\u4e86\u89e3\u6700\u65b0\u8d44\u8baf\u5185\u5bb9\u3002'
const TOPIC_DETAIL_ID_KEY = 'topic_detail_id'

const topicItems = ref<HomeTopicCard[]>([])
const recommendItems = ref<HomeRecommendItem[]>([])
const heroSlides = ref<HomeHeroSlide[]>([])

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const safeNumber = (value : number | null) : number => {
	return value == null ? 0 : value
}

const normalizeResourceType = (value : string) : string => {
	const text = safeText(value).toUpperCase()
	if (text == 'PODCAST' || text == 'PODCASTS' || text == 'AUDIO' || text == 'AUDIOS' || text == 'APP_PODCAST' || text == '\u97f3\u9891') {
		return 'AUDIO'
	}
	if (text == 'ARTICLE' || text == 'ARTICLES' || text == 'NEWS' || text == 'INFO' || text == '\u8d44\u8baf') {
		return 'ARTICLE'
	}
	if (text == 'TOPIC' || text == 'TOPICS' || text == 'SPECIAL' || text == 'SPECIAL_TOPIC' || text == 'SUBJECT' || text == '\u4e13\u9898') {
		return 'TOPIC'
	}
	if (text == 'LIVE' || text == 'LIVES' || text == 'LIVESESSION' || text == 'LIVE_SESSION' || text == 'LIVE_STREAM' || text == '\u76f4\u64ad') {
		return 'LIVE'
	}
	if (text == 'COURSE' || text == 'COURSES' || text == 'APP_COURSE' || text == '\u8bfe\u7a0b') {
		return 'COURSE'
	}
	return text
}

const labelByResourceType = (type : string, fallback : string) : string => {
	if (fallback.length > 0) {
		return fallback
	}
	if (type == 'AUDIO') {
		return audioTabText
	}
	if (type == 'LIVE') {
		return liveTabText
	}
	if (type == 'COURSE') {
		return courseTabText
	}
	if (type == 'ARTICLE') {
		return newsTabText
	}
	if (type == 'TOPIC') {
		return topicTabText
	}
	return fallback
}

const fallbackSummaryByResourceType = (type : string) : string => {
	if (type == 'AUDIO') {
		return fallbackAudioSummary
	}
	if (type == 'LIVE') {
		return fallbackLiveSummary
	}
	if (type == 'COURSE') {
		return fallbackCourseSummary
	}
	if (type == 'ARTICLE') {
		return fallbackNewsSlideSummary
	}
	return fallbackTopicSummary
}

const actionTextByResourceType = (type : string) : string => {
	if (type == 'AUDIO') {
		return heroActionAudioText
	}
	if (type == 'LIVE') {
		return heroActionLiveText
	}
	if (type == 'COURSE') {
		return heroActionCourseText
	}
	if (type == 'ARTICLE') {
		return heroActionNewsText
	}
	return heroActionText
}

const mapRecommendItem = (item : AppHomeItem) : HomeRecommendItem => {
	const type = normalizeResourceType(item.contentType)
	const label = labelByResourceType(type, safeText(item.contentTypeLabel))
	const summary = safeText(item.summary).length > 0 ? safeText(item.summary) : safeText(item.subtitle)
	return {
		id: type + '-' + String(item.id),
		resourceType: type,
		resourceId: safeNumber(item.targetId),
		typeLabel: label,
		title: safeText(item.title),
		summary: summary.length > 0 ? summary : fallbackSummaryByResourceType(type),
		coverUrl: safeText(item.coverUrl)
	}
}

const mapTopicItem = (item : AppHomeItem) : HomeTopicCard => {
	const type = normalizeResourceType(item.contentType)
	return {
		id: item.id,
		resourceType: type,
		resourceId: safeNumber(item.targetId),
		title: safeText(item.title),
		summary: safeText(item.summary).length > 0 ? safeText(item.summary) : fallbackTopicSummary,
		coverUrl: safeText(item.coverUrl),
		tags: [],
		viewCount: 0,
		favoriteCount: 0
	}
}

const mapHeroSlide = (item : AppHomeItem) : HomeHeroSlide => {
	const type = normalizeResourceType(item.contentType)
	return {
		id: type + '-' + String(item.id),
		resourceType: type,
		resourceId: safeNumber(item.targetId),
		kicker: labelByResourceType(type, safeText(item.contentTypeLabel)),
		title: safeText(item.title),
		subtitle: safeText(item.summary).length > 0 ? safeText(item.summary) : fallbackSummaryByResourceType(type),
		coverUrl: safeText(item.coverUrl),
		actionText: actionTextByResourceType(type)
	}
}

const findSection = (sections : AppHomeSection[], codeKeywords : string[], nameKeywords : string[]) : AppHomeSection | null => {
	for (let i = 0; i < sections.length; i++) {
		const section = sections[i]
		const code = safeText(section.categoryCode).toLowerCase()
		const name = safeText(section.categoryName)
		for (let j = 0; j < codeKeywords.length; j++) {
			if (code.indexOf(codeKeywords[j]) >= 0) {
				return section
			}
		}
		for (let k = 0; k < nameKeywords.length; k++) {
			if (name.indexOf(nameKeywords[k]) >= 0) {
				return section
			}
		}
	}
	return null
}

const collectSectionItems = (sections : AppHomeSection[]) : AppHomeItem[] => {
	const items : AppHomeItem[] = []
	for (let i = 0; i < sections.length; i++) {
		const sectionItems = sections[i].items != null ? sections[i].items : []
		for (let j = 0; j < sectionItems.length; j++) {
			items.push(sectionItems[j])
		}
	}
	return items
}

const filterItemsByResourceType = (items : AppHomeItem[], resourceType : string) : AppHomeItem[] => {
	const result : AppHomeItem[] = []
	for (let i = 0; i < items.length; i++) {
		if (normalizeResourceType(items[i].contentType) == resourceType) {
			result.push(items[i])
		}
	}
	return result
}

const filterRecommendItems = (items : AppHomeItem[]) : AppHomeItem[] => {
	const result : AppHomeItem[] = []
	for (let i = 0; i < items.length; i++) {
		const type = normalizeResourceType(items[i].contentType)
		if (type == 'AUDIO' || type == 'LIVE' || type == 'COURSE' || type == 'ARTICLE') {
			result.push(items[i])
		}
	}
	return result
}

const loadHomeData = () => {
	fetchAppHome(
		(data) => {
			const sections = data.sections != null ? data.sections : []
			const recommendSection = findSection(sections, ['recommend', 'home_recommend', 'index_recommend'], ['\u9996\u9875\u63a8\u8350', '\u63a8\u8350'])
			const topicSection = findSection(sections, ['topic', 'hot_topic', 'popular_topic'], ['\u70ed\u95e8\u4e13\u9898', '\u4e13\u9898'])
			const allItems = collectSectionItems(sections)
			const matchedRecommendSource = recommendSection != null && recommendSection.items != null ? recommendSection.items : []
			const matchedTopicSource = topicSection != null && topicSection.items != null ? topicSection.items : []
			const fallbackRecommendSource = filterRecommendItems(allItems)
			const fallbackTopicSource = filterItemsByResourceType(allItems, 'TOPIC')
			const recommendSource = matchedRecommendSource.length > 0 ? matchedRecommendSource : fallbackRecommendSource
			const topicSource = matchedTopicSource.length > 0 ? matchedTopicSource : fallbackTopicSource
			const heroSource = recommendSource.length > 0 ? recommendSource : allItems

			recommendItems.value = recommendSource.slice(0, 3).map((item : AppHomeItem) : HomeRecommendItem => {
				return mapRecommendItem(item)
			})
			topicItems.value = topicSource.slice(0, 6).map((item : AppHomeItem) : HomeTopicCard => {
				return mapTopicItem(item)
			})
			heroSlides.value = heroSource.slice(0, 5).map((item : AppHomeItem) : HomeHeroSlide => {
				return mapHeroSlide(item)
			})
		},
		() => {
			recommendItems.value = []
			topicItems.value = []
			heroSlides.value = []
		}
	)
}

const goHeroDetail = (item : HomeHeroSlide) => {
	if (item.resourceType == 'TOPIC') {
		goTopicDetail(item.resourceId)
		return
	}
	if (item.resourceType == 'AUDIO') {
		uni.navigateTo({ url: '/pages/audio/detail?id=' + String(item.resourceId) })
		return
	}
	if (item.resourceType == 'LIVE') {
		uni.navigateTo({ url: '/pages/live/detail?id=' + String(item.resourceId) })
		return
	}
	if (item.resourceType == 'COURSE') {
		uni.navigateTo({ url: '/pages/course/detail?id=' + String(item.resourceId) })
		return
	}
	if (item.resourceType == 'ARTICLE') {
		goArticleDetail(item.resourceId)
		return
	}
	if (item.resourceType == 'TOPIC') {
		goTopicDetail(item.resourceId)
	}
}

const goRecommendDetail = (item : HomeRecommendItem) => {
	if (item.resourceType == 'AUDIO') {
		uni.navigateTo({ url: '/pages/audio/detail?id=' + String(item.resourceId) })
		return
	}
	if (item.resourceType == 'LIVE') {
		uni.navigateTo({ url: '/pages/live/detail?id=' + String(item.resourceId) })
		return
	}
	if (item.resourceType == 'COURSE') {
		uni.navigateTo({ url: '/pages/course/detail?id=' + String(item.resourceId) })
		return
	}
	if (item.resourceType == 'ARTICLE') {
		goArticleDetail(item.resourceId)
		return
	}
	if (item.resourceType == 'TOPIC') {
		goTopicDetail(item.resourceId)
	}
}

const goTopicsPage = () => {
	uni.redirectTo({ url: '/pages/topics/list' })
}

const goTopicDetail = (id : number) => {
	uni.setStorageSync(TOPIC_DETAIL_ID_KEY, String(id))
	uni.navigateTo({ url: '/pages/topics/detail?id=' + String(id) })
}

const goHomeTopicDetail = (item : HomeTopicCard) => {
	const id = item.resourceId > 0 ? item.resourceId : item.id
	goTopicDetail(id)
}

const goArticleDetail = (id : number) => {
	uni.navigateTo({ url: '/pages/news/detail?id=' + String(id) })
}

const goAudioPage = () => {
	uni.redirectTo({ url: '/pages/audio/index' })
}

const goLivePage = () => {
	uni.redirectTo({ url: '/pages/live/index' })
}

const goCoursePage = () => {
	uni.redirectTo({ url: '/pages/course/index' })
}

const goNewsPage = () => {
	uni.redirectTo({ url: '/pages/news/index' })
}

const goMinePage = () => {
	uni.redirectTo({ url: '/pages/mine/index' })
}

const goExamPage = () => {
	uni.redirectTo({ url: '/pages/exam/index' })
}

const goKnowledgePage = () => {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goConsultPage = () => {
	uni.redirectTo({ url: '/pages/consult/index' })
}

loadHomeData()
</script>

<style>
