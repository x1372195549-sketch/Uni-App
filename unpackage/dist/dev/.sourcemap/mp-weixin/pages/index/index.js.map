<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

			<view class="header">
				<text class="header-title">江苏中医在线</text>
			</view>

			<view class="top-tabs">
				<view class="top-tab top-tab-active">
					<text class="top-tab-text top-tab-text-active">首页</text>
					<view class="top-tab-line"></view>
				</view>
				<view class="top-tab" @click="goAudioPage">
					<text class="top-tab-text">音频</text>
				</view>
				<view class="top-tab" @click="goLivePage">
					<text class="top-tab-text">直播</text>
				</view>
				<view class="top-tab" @click="goCoursePage">
					<text class="top-tab-text">课程</text>
				</view>
				<view class="top-tab" @click="goNewsPage">
					<text class="top-tab-text">资讯</text>
				</view>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="content-shell">
				<view class="search-wrap">
					<view class="search-box">
						<image class="search-icon" src="/static/home/icon_search.png" mode="aspectFit"></image>
						<text class="search-placeholder">请输入关键字搜索</text>
					</view>
				</view>

				<view class="home-list">
					<view class="home-card" v-for="item in homeSections" :key="item.sectionKey" @click="goHomeDetail(item)">
						<view class="card-head">
							<view>
								<text class="card-type">{{ item.typeLabel }}</text>
								<text class="card-title">{{ item.title }}</text>
								<text class="card-subtitle">{{ item.subtitle }}</text>
							</view>
							<image v-if="item.coverUrl.length > 0" class="card-cover" :src="item.coverUrl" mode="aspectFill"></image>
							<view v-else class="card-cover card-cover-placeholder">
								<text class="card-cover-text">{{ item.typeShort }}</text>
							</view>
						</view>
						<view class="card-foot">
							<text class="card-desc">{{ item.description }}</text>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="tabbar">
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">学习</text>
			</view>
			<view class="tab-item" @click="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">咨询</text>
			</view>
			<view class="tab-item" @click="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">知识库</text>
			</view>
			<view class="tab-item" @click="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { fetchHomeCategories, fetchHomeContents } from '../../utils/auth.uts'

type HomeCategory = {
	id : number
	parentId : number
	categoryName : string
	categoryCode : string
	iconUrl : string
	description : string
	sortOrder : number
	status : string
}

type HomeContent = {
	id : number
	categoryId : number
	contentType : string
	targetId : number
	title : string
	coverUrl : string
	linkUrl : string
	sortOrder : number
	startAt : string
	endAt : string
	status : string
}

type HomeSection = {
	sectionKey : string
	contentType : string
	typeLabel : string
	typeShort : string
	title : string
	subtitle : string
	description : string
	coverUrl : string
	targetId : string
}

const homeSections = ref<HomeSection[]>([
	{
		sectionKey: 'audio',
		contentType: 'podcast',
		typeLabel: '音频内容',
		typeShort: '音频',
		title: '音频内容占位',
		subtitle: '等待首页内容接口返回',
		description: '点击进入音频详情页',
		coverUrl: '',
		targetId: ''
	},
	{
		sectionKey: 'live',
		contentType: 'live',
		typeLabel: '直播内容',
		typeShort: '直播',
		title: '直播内容占位',
		subtitle: '等待首页内容接口返回',
		description: '点击进入直播详情页',
		coverUrl: '',
		targetId: ''
	},
	{
		sectionKey: 'course',
		contentType: 'course',
		typeLabel: '课程内容',
		typeShort: '课程',
		title: '课程内容占位',
		subtitle: '等待首页内容接口返回',
		description: '点击进入课程详情页',
		coverUrl: '',
		targetId: ''
	},
	{
		sectionKey: 'news',
		contentType: 'topic',
		typeLabel: '资讯内容',
		typeShort: '资讯',
		title: '资讯内容占位',
		subtitle: '等待首页内容接口返回',
		description: '点击进入资讯详情页',
		coverUrl: '',
		targetId: ''
	}
])

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const normalizeContentType = (value : string) : string => {
	const type = value.toLowerCase()
	if (type == 'podcast' || type == 'audio') {
		return 'podcast'
	}
	if (type == 'live' || type == 'live_session') {
		return 'live'
	}
	if (type == 'course') {
		return 'course'
	}
	if (type == 'topic' || type == 'article' || type == 'news') {
		return 'topic'
	}
	return type
}

const buildFallbackSections = () : HomeSection[] => {
	return [...homeSections.value]
}

const mapHomeContentToSection = (item : HomeContent, categories : HomeCategory[]) : HomeSection | null => {
	const normalizedType = normalizeContentType(safeText(item.contentType))
	if (normalizedType != 'podcast' && normalizedType != 'live' && normalizedType != 'course' && normalizedType != 'topic') {
		return null
	}

	const category = categories.find((entry : HomeCategory) : boolean => entry.id == item.categoryId)
	const categoryName = category != null ? safeText(category.categoryName) : ''

	let typeLabel = '首页内容'
	let typeShort = '内容'
	let subtitle = '首页配置内容'
	let description = '点击进入详情页'

	if (normalizedType == 'podcast') {
		typeLabel = '音频内容'
		typeShort = '音频'
		subtitle = categoryName.length > 0 ? categoryName : '音频推荐'
		description = '点击进入音频详情页'
	}
	if (normalizedType == 'live') {
		typeLabel = '直播内容'
		typeShort = '直播'
		subtitle = categoryName.length > 0 ? categoryName : '直播推荐'
		description = '点击进入直播详情页'
	}
	if (normalizedType == 'course') {
		typeLabel = '课程内容'
		typeShort = '课程'
		subtitle = categoryName.length > 0 ? categoryName : '课程推荐'
		description = '点击进入课程详情页'
	}
	if (normalizedType == 'topic') {
		typeLabel = '资讯内容'
		typeShort = '资讯'
		subtitle = categoryName.length > 0 ? categoryName : '资讯推荐'
		description = '点击进入资讯详情页'
	}

	return {
		sectionKey: normalizedType,
		contentType: normalizedType,
		typeLabel,
		typeShort,
		title: safeText(item.title).length > 0 ? item.title : typeLabel,
		subtitle,
		description,
		coverUrl: safeText(item.coverUrl),
		targetId: String(item.targetId)
	}
}

const applyHomeData = (categories : HomeCategory[], contents : HomeContent[]) => {
	const fallbackMap = new Map<string, HomeSection>()
	const fallbacks = buildFallbackSections()
	for (let i = 0; i < fallbacks.length; i++) {
		fallbackMap.set(fallbacks[i].sectionKey, fallbacks[i])
	}

	const sortedContents = [...contents].sort((left : HomeContent, right : HomeContent) : number => {
		return (left.sortOrder || 0) - (right.sortOrder || 0)
	})

	for (let i = 0; i < sortedContents.length; i++) {
		const mapped = mapHomeContentToSection(sortedContents[i], categories)
		if (mapped != null && fallbackMap.has(mapped.sectionKey)) {
			fallbackMap.set(mapped.sectionKey, mapped)
		}
	}

	homeSections.value = [
		fallbackMap.get('podcast') as HomeSection,
		fallbackMap.get('live') as HomeSection,
		fallbackMap.get('course') as HomeSection,
		fallbackMap.get('topic') as HomeSection
	]
}

const loadHomeData = () => {
	fetchHomeCategories(
		(categoryPage) => {
			fetchHomeContents(
				(contentPage) => {
					applyHomeData(categoryPage.records || [], contentPage.records || [])
				},
				() => {}
			)
		},
		() => {}
	)
}

const goHomeDetail = (item : HomeSection) => {
	if (item.targetId.length == 0) {
		return
	}

	if (item.contentType == 'podcast') {
		uni.navigateTo({ url: '/pages/audio/detail?id=' + item.targetId })
		return
	}
	if (item.contentType == 'live') {
		uni.navigateTo({ url: '/pages/live/detail?id=' + item.targetId })
		return
	}
	if (item.contentType == 'course') {
		uni.navigateTo({ url: '/pages/course/detail?id=' + item.targetId })
		return
	}
	if (item.contentType == 'topic') {
		uni.navigateTo({ url: '/pages/news/detail?id=' + item.targetId })
	}
}

const goAudioPage = () => {
	uni.redirectTo({ url: '/pages/audio/index' })
}

const goLivePage = () => {
	uni.redirectTo({ url: '/pages/live/index' })
}

const goCoursePage = () => {
	uni.redirectTo({ url: '/pages/course/index' })
}

const goNewsPage = () => {
	uni.redirectTo({ url: '/pages/news/index' })
}

const goMinePage = () => {
	uni.redirectTo({ url: '/pages/mine/index' })
}

const goExamPage = () => {
	uni.redirectTo({ url: '/pages/exam/index' })
}

const goKnowledgePage = () => {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goConsultPage = () => {
	uni.redirectTo({ url: '/pages/consult/index' })
}

onMounted(() => {
	loadHomeData()
})
</script>

<style>
.page {
	flex: 1;
	background-color: #f7f7f2;
}

.hero-shell {
	position: relative;
	height: 236rpx;
	overflow: hidden;
}

.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 236rpx;
}

.header {
	position: relative;
	z-index: 1;
	padding-top: 34rpx;
	height: 118rpx;
	align-items: center;
	justify-content: center;
}

.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}

.top-tabs {
	position: relative;
	z-index: 1;
	height: 96rpx;
	margin-top: 18rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}

.top-tab {
	min-width: 88rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}

.top-tab-active {
	position: relative;
}

.top-tab-text {
	font-size: 18px;
	line-height: 26px;
	color: #333333;
}

.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}

.top-tab-line {
	position: absolute;
	bottom: 10rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}

.content {
	flex: 1;
	padding-bottom: 110rpx;
}

.content-shell {
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-bottom: 40rpx;
}

.search-wrap {
	padding-bottom: 20rpx;
	background-color: #f7f7f2;
}

.search-box {
	height: 72rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	border-radius: 36rpx;
	background-color: rgba(255, 255, 255, 0.94);
	border-width: 1px;
	border-style: solid;
	border-color: rgba(191, 214, 195, 0.9);
	flex-direction: row;
	align-items: center;
}

.search-icon {
	width: 30rpx;
	height: 30rpx;
	margin-right: 18rpx;
	opacity: 0.78;
}

.search-placeholder {
	font-size: 14px;
	line-height: 22px;
	color: #b0b8ad;
}

.home-list {
	padding-top: 4rpx;
}

.home-card {
	margin-bottom: 24rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	overflow: hidden;
	box-shadow: 0 10rpx 24rpx rgba(207, 201, 186, 0.28);
}

.card-head {
	min-height: 220rpx;
	padding: 30rpx;
	background-color: #f8e8ce;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.card-type {
	font-size: 12px;
	line-height: 18px;
	color: #b85d69;
	font-weight: 600;
	margin-bottom: 10rpx;
}

.card-title {
	width: 380rpx;
	font-size: 22px;
	line-height: 32px;
	color: #d0832e;
	font-weight: 700;
}

.card-subtitle {
	margin-top: 10rpx;
	width: 380rpx;
	font-size: 14px;
	line-height: 22px;
	color: #8d6f45;
}

.card-cover {
	width: 140rpx;
	height: 140rpx;
	border-radius: 24rpx;
	background-color: #ffffff;
}

.card-cover-placeholder {
	align-items: center;
	justify-content: center;
}

.card-cover-text {
	font-size: 22px;
	line-height: 30px;
	color: #dfc2a3;
	font-weight: 600;
}

.card-foot {
	padding: 26rpx 30rpx;
}

.card-desc {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}

.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}

.tab-item {
	align-items: center;
	justify-content: center;
}

.tab-item-active {
	margin-top: -2rpx;
}

.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}

.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}

.tab-label-active {
	color: #18b775;
}
</style>
