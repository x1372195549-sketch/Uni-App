<template>
	<view class="page">
		<view class="header">
			<view class="header-back" @click="goBack">
				<image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">知识详情</text>
		</view>

		<scroll-view class="detail-scroll" scroll-y="true">
			<view v-if="isLoading" class="state-wrap">
				<text class="state-text">加载中...</text>
			</view>

			<view v-else-if="errorText.length > 0" class="state-wrap">
				<text class="state-text">{{ errorText }}</text>
				<view class="retry-btn" @click="loadDetail">
					<text class="retry-btn-text">重新加载</text>
				</view>
			</view>

			<view v-else class="detail-body">
				<view class="hero-card">
					<view class="cover-shell">
						<image
							v-if="coverUrl.length > 0"
							class="cover-image"
							:src="coverUrl"
							mode="aspectFill"
						></image>
						<view v-else class="cover-fallback">
							<text class="cover-fallback-text">{{ shortTitle }}</text>
						</view>
					</view>

					<view class="hero-main">
						<text class="book-title">{{ title }}</text>
						<text v-if="author.length > 0" class="book-meta">作者：{{ author }}</text>
						<text v-if="publisher.length > 0" class="book-meta">出版社：{{ publisher }}</text>
						<text v-if="categoryName.length > 0" class="book-meta">分类：{{ categoryName }}</text>
						<view class="stats-row">
							<text v-if="publishedAt.length > 0" class="stat-text">{{ publishedAt }}</text>
							<text class="stat-text">阅读 {{ viewCount }}</text>
							<text v-if="totalPages.length > 0" class="stat-text">{{ totalPages }}</text>
						</view>
					</view>
				</view>

				<view v-if="summary.length > 0" class="section-card">
					<text class="section-title">简介</text>
					<text class="section-text">{{ summary }}</text>
				</view>

				<view class="section-card">
					<text class="section-title">正文内容</text>
					<rich-text v-if="isHtmlContent" class="rich-content" :nodes="content"></rich-text>
					<text v-else class="section-text">{{ content }}</text>
				</view>

				<view v-if="keywords.length > 0 || source.length > 0" class="section-card">
					<text class="section-title">补充信息</text>
					<text v-if="keywords.length > 0" class="section-text">关键词：{{ keywords }}</text>
					<text v-if="source.length > 0" class="section-text">来源：{{ source }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { fetchKnowledgeEntryDetail, type KnowledgeEntry } from '../../utils/auth.uts'

const detailId = ref('')
const isLoading = ref(true)
const errorText = ref('')

const title = ref('')
const shortTitle = ref('知识')
const coverUrl = ref('')
const summary = ref('')
const content = ref('')
const categoryName = ref('')
const author = ref('')
const publisher = ref('')
const keywords = ref('')
const source = ref('')
const publishedAt = ref('')
const totalPages = ref('')
const viewCount = ref('0')
const isHtmlContent = ref(false)

function safeText(value : string | null) : string {
	return value == null || value.length == 0 ? '' : value
}

function buildShortTitle(value : string) : string {
	const text = safeText(value)
	if (text.length == 0) {
		return '知识'
	}
	if (text.length <= 4) {
		return text
	}
	return text.substring(0, 4)
}

function detectHtml(value : string) : boolean {
	return value.indexOf('<p') >= 0 || value.indexOf('<div') >= 0 || value.indexOf('<br') >= 0
}

function applyDetail(detail : KnowledgeEntry) : void {
	title.value = safeText(detail.title)
	shortTitle.value = buildShortTitle(detail.title)
	coverUrl.value = safeText(detail.coverUrl)
	summary.value = safeText(detail.summary)
	content.value = safeText(detail.content)
	categoryName.value = safeText(detail.categoryName)
	author.value = safeText(detail.author)
	publisher.value = safeText(detail.publisher)
	keywords.value = safeText(detail.keywords)
	source.value = safeText(detail.source)
	publishedAt.value = safeText(detail.publishedAt).replace('T', ' ')
	totalPages.value = detail.totalPages != null && detail.totalPages > 0 ? '共 ' + String(detail.totalPages) + ' 页' : ''
	viewCount.value = String(detail.viewCount != null ? detail.viewCount : 0)
	isHtmlContent.value = detectHtml(content.value)
}

function loadParams() : void {
	const pages = getCurrentPages()
	if (pages.length == 0) {
		return
	}

	const currentPage = pages[pages.length - 1]
	if (currentPage == null || currentPage.options == null) {
		return
	}

	const options = currentPage.options as UTSJSONObject
	const idValue = options['id']
	if (typeof idValue == 'string' && idValue.length > 0) {
		detailId.value = idValue
	}
}

function loadDetail() : void {
	if (detailId.value.length == 0) {
		errorText.value = '缺少知识条目 ID'
		isLoading.value = false
		return
	}

	isLoading.value = true
	errorText.value = ''

	fetchKnowledgeEntryDetail(
		detailId.value,
		(detail) => {
			applyDetail(detail)
			isLoading.value = false
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '详情加载失败'
			isLoading.value = false
		}
	)
}

function goBack() : void {
	uni.navigateBack()
}

loadParams()
loadDetail()
</script>

