<template>
	<view class="page">
		<view class="header">
			<view class="header-back" @click="goBack">
				<image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">{{ bookTitle }}</text>
		</view>

		<view class="reader-shell">
			<scroll-view class="reader-content" scroll-y="true" @click="hideDrawer">
				<view class="reader-inner">
					<text class="chapter-title">第一章·草部·芫花</text>
					<text class="content-text">
						这里是知识库书籍正文占位内容。后续可直接替换成接口返回的正文内容，用来展示章节详情、段落阅读与排版效果。
						这里保留较长文本段落，方便先把阅读器的页面结构和交互行为跑通。
						
						这里是知识库书籍正文占位内容。后续可直接替换成接口返回的正文内容，用来展示章节详情、段落阅读与排版效果。
						这里保留较长文本段落，方便先把阅读器的页面结构和交互行为跑通。
						
						这里是知识库书籍正文占位内容。后续可直接替换成接口返回的正文内容，用来展示章节详情、段落阅读与排版效果。
						这里保留较长文本段落，方便先把阅读器的页面结构和交互行为跑通。
						
						这里是知识库书籍正文占位内容。后续可直接替换成接口返回的正文内容，用来展示章节详情、段落阅读与排版效果。
						这里保留较长文本段落，方便先把阅读器的页面结构和交互行为跑通。
					</text>
				</view>
			</scroll-view>

			<view v-if="drawerVisible" class="drawer-mask" @click="hideDrawer"></view>
			<view v-if="drawerVisible" class="drawer-panel">
				<view class="drawer-book">
					<view class="drawer-cover"></view>
					<view class="drawer-book-info">
						<text class="drawer-book-title">{{ bookTitle }}</text>
						<text class="drawer-book-author">{{ bookAuthor }}</text>
					</view>
				</view>

				<view class="drawer-tabs">
					<view class="drawer-tab" @click="switchPanel('catalog')">
						<text class="drawer-tab-text" :class="{ 'drawer-tab-text-active': currentPanel == 'catalog' }">目录</text>
						<view v-if="currentPanel == 'catalog'" class="drawer-tab-line"></view>
					</view>
					<view class="drawer-tab" @click="switchPanel('bookmark')">
						<text class="drawer-tab-text" :class="{ 'drawer-tab-text-active': currentPanel == 'bookmark' }">书签</text>
						<view v-if="currentPanel == 'bookmark'" class="drawer-tab-line"></view>
					</view>
				</view>

				<text class="drawer-section-title">第一章·水部</text>

				<scroll-view class="drawer-list" scroll-y="true">
					<view v-if="currentPanel == 'catalog'">
						<view v-for="item in catalogItems" :key="item.id" class="drawer-row">
							<text class="drawer-row-title">{{ item.title }}</text>
						</view>
					</view>
					<view v-else>
						<view v-for="item in bookmarkItems" :key="item.id" class="drawer-row drawer-row-bookmark">
							<view class="bookmark-flag"></view>
							<text class="drawer-row-title drawer-bookmark-title">{{ item.content }}</text>
							<text class="drawer-progress">{{ item.progress }}</text>
						</view>
					</view>
				</scroll-view>
			</view>
		</view>

		<view class="reader-tabbar">
			<view class="reader-tab-item" @click="toggleDrawer('catalog')">
				<image class="reader-tab-icon-image" :src="drawerVisible && currentPanel == 'catalog' ? '/static/reader/icon_mulu_active.png' : '/static/reader/icon_mulu.png'" mode="aspectFit"></image>
				<text class="reader-tab-text" :class="{ 'reader-tab-text-active': drawerVisible && currentPanel == 'catalog' }">目录</text>
			</view>
			<view class="reader-tab-item" @click="toggleDrawer('bookmark')">
				<image class="reader-tab-icon-image" :src="drawerVisible && currentPanel == 'bookmark' ? '/static/reader/icon_shuqiandibu_active.png' : '/static/reader/icon_shuqiandibu.png'" mode="aspectFit"></image>
				<text class="reader-tab-text" :class="{ 'reader-tab-text-active': drawerVisible && currentPanel == 'bookmark' }">书签</text>
			</view>
			<view class="reader-tab-item">
				<image class="reader-tab-icon-image" src="/static/reader/icon_yuedushezhi.png" mode="aspectFit"></image>
				<text class="reader-tab-text">阅读设置</text>
			</view>
			<view class="reader-tab-item" @click="goExamPage">
				<image class="reader-tab-icon-image" src="/static/reader/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="reader-tab-text">考核</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
const currentPages = getCurrentPages()
let bookName = '本草纲目'
let authorName = '李时珍撰写 药学著作'

if (currentPages.length > 0) {
	const currentPage = currentPages[currentPages.length - 1]
	const options = currentPage.options
	if (options != null) {
		if (options['name'] != null) {
			bookName = decodeURIComponent(options['name'] as string)
		}
		if (options['author'] != null) {
			authorName = decodeURIComponent(options['author'] as string)
		}
	}
}

const bookTitle = ref(bookName)
const bookAuthor = ref(authorName)
const drawerVisible = ref(false)
const currentPanel = ref('catalog')

const catalogItems = ref([
	{ id: 'c1', title: '第 1 节：露水' },
	{ id: 'c2', title: '第 2 节：露水' },
	{ id: 'c3', title: '第 3 节：露水' },
	{ id: 'c4', title: '第 4 节：露水' },
	{ id: 'c5', title: '第 5 节：露水' },
	{ id: 'c6', title: '第 6 节：露水' },
	{ id: 'c7', title: '第 7 节：露水' },
	{ id: 'c8', title: '第 8 节：露水' },
	{ id: 'c9', title: '第 9 节：露水' },
	{ id: 'c10', title: '第 10 节：露水' }
])

const bookmarkItems = ref([
	{ id: 'b1', content: '午刻黄水从小便排出。见效占位内容一…', progress: '12%' },
	{ id: 'b2', content: '午刻黄水从小表排除。见效占位内容二…', progress: '12%' },
	{ id: 'b3', content: '午刻黄水从小表排除。见效占位内容三…', progress: '12%' },
	{ id: 'b4', content: '午刻黄水从小表排除。见效占位内容四…', progress: '12%' },
	{ id: 'b5', content: '午刻黄水从小表排除。见效占位内容五…', progress: '12%' },
	{ id: 'b6', content: '午刻黄水从小表排除。见效占位内容六…', progress: '12%' }
])

const goBack = () => {
	uni.navigateBack()
}

const hideDrawer = () => {
	drawerVisible.value = false
}

const switchPanel = (panel : string) => {
	currentPanel.value = panel
}

const toggleDrawer = (panel : string) => {
	if (drawerVisible.value && currentPanel.value == panel) {
		drawerVisible.value = false
		return
	}
	currentPanel.value = panel
	drawerVisible.value = true
}

const goExamPage = () => {
	uni.navigateTo({
		url: '/pages/exam/index?sourceType=book&sourceId=book-demo&sourceName=' + encodeURIComponent(bookTitle.value)
	})
}
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5fb;
}

.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #f5f5fb;
}

.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}

.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}

.header-title {
	font-size: 18px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}

.reader-shell {
	flex: 1;
	position: relative;
	padding-bottom: 100rpx;
}

.reader-content {
	flex: 1;
}

.reader-inner {
	padding-left: 48rpx;
	padding-right: 48rpx;
	padding-top: 40rpx;
	padding-bottom: 80rpx;
	background-color: #ffffff;
	min-height: 100%;
}

.chapter-title {
	font-size: 26px;
	line-height: 38px;
	color: #323232;
	font-weight: 600;
	text-align: center;
	margin-bottom: 36rpx;
}

.content-text {
	font-size: 18px;
	line-height: 34px;
	color: #2f2f2f;
}

.drawer-mask {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.08);
}

.drawer-panel {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 540rpx;
	background-color: #ffffff;
	box-shadow: 12rpx 0 28rpx rgba(60, 60, 60, 0.08);
}

.drawer-book {
	height: 216rpx;
	padding-left: 26rpx;
	padding-right: 26rpx;
	flex-direction: row;
	align-items: center;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #e8e8e8;
}

.drawer-cover {
	width: 128rpx;
	height: 168rpx;
	border-radius: 6rpx;
	background-color: #b8674d;
}

.drawer-book-info {
	margin-left: 24rpx;
	flex: 1;
}

.drawer-book-title {
	font-size: 28px;
	line-height: 38px;
	color: #2f2f2f;
	font-weight: 600;
}

.drawer-book-author {
	margin-top: 16rpx;
	font-size: 16px;
	line-height: 24px;
	color: #b5b5b5;
}

.drawer-tabs {
	height: 112rpx;
	flex-direction: row;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #eeeeee;
}

.drawer-tab {
	flex: 1;
	align-items: center;
	justify-content: center;
	position: relative;
}

.drawer-tab-text {
	font-size: 18px;
	line-height: 26px;
	color: #b2b2b2;
}

.drawer-tab-text-active {
	color: #2f2f2f;
	font-weight: 600;
}

.drawer-tab-line {
	position: absolute;
	bottom: 14rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}

.drawer-section-title {
	height: 92rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	font-size: 18px;
	line-height: 92rpx;
	color: #3e3e3e;
}

.drawer-list {
	flex: 1;
}

.drawer-row {
	min-height: 96rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	flex-direction: row;
	align-items: center;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #f0f0f0;
}

.drawer-row-bookmark {
	padding-left: 18rpx;
}

.bookmark-flag {
	width: 22rpx;
	height: 34rpx;
	background-color: #be6874;
	margin-right: 20rpx;
}

.drawer-row-title {
	flex: 1;
	font-size: 17px;
	line-height: 26px;
	color: #3d3d3d;
}

.drawer-bookmark-title {
	font-size: 15px;
	color: #585858;
}

.drawer-progress {
	font-size: 15px;
	line-height: 22px;
	color: #be6874;
}

.reader-tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	background-color: #ffffff;
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}

.reader-tab-item {
	align-items: center;
	justify-content: center;
}

.reader-tab-icon-image {
	width: 32rpx;
	height: 32rpx;
}

.reader-tab-text {
	margin-top: 6rpx;
	font-size: 13px;
	line-height: 18px;
	color: #4d4d4d;
}

.reader-tab-text-active {
	color: #18b775;
	font-weight: 600;
}
</style>
