<template>
	<view class="page">
		<view class="header">
			<view class="header-back" @click="goLearningPage">
				<image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">知识库</text>
		</view>

		<view class="content-shell">
			<view class="category-panel">
				<view
					v-for="item in categories"
					:key="item.id"
					class="category-item"
					:class="{ 'category-item-active': currentCategoryId === item.id }"
					@click="selectCategory(item.id)"
				>
					<view v-if="currentCategoryId === item.id" class="category-line"></view>
					<text
						class="category-text"
						:class="{ 'category-text-active': currentCategoryId === item.id }"
					>{{ item.name }}</text>
				</view>
			</view>

			<scroll-view class="book-panel" scroll-y="true">
				<view class="book-grid">
					<view
						v-for="book in currentBooks"
						:key="book.id"
						class="book-card"
						@click="goBookDetail(book)"
					>
						<view class="book-cover" :style="{ backgroundColor: book.coverColor }">
							<text class="book-cover-title">{{ book.shortTitle }}</text>
						</view>
						<text class="book-name">{{ book.name }}</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<view class="tabbar">
			<view class="tab-item" @click="goLearningPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexiweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">学习</text>
			</view>
			<view class="tab-item">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">咨询</text>
			</view>
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikudianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">知识库</text>
			</view>
			<view class="tab-item" @click="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
type CategoryItem = {
	id : string
	name : string
}

type BookItem = {
	id : string
	categoryId : string
	name : string
	shortTitle : string
	author : string
	coverColor : string
}

const categories = ref<CategoryItem[]>([
	{ id: 'theory', name: '中医基础理论' },
	{ id: 'diagnosis', name: '中医诊断学' },
	{ id: 'herbs', name: '中药学' },
	{ id: 'formula', name: '方剂学' },
	{ id: 'internal', name: '中医内科' },
	{ id: 'surgery', name: '中医外科' },
	{ id: 'classic', name: '四大经典' }
])

const books = ref<BookItem[]>([
	{ id: 'b1', categoryId: 'theory', name: '中医基础理论概论', shortTitle: '基础\n理论', author: '王某某', coverColor: '#dfead2' },
	{ id: 'b2', categoryId: 'theory', name: '中医阴阳五行导读', shortTitle: '阴阳\n五行', author: '李某某', coverColor: '#f3d88d' },
	{ id: 'b3', categoryId: 'theory', name: '脏腑经络入门', shortTitle: '脏腑\n经络', author: '周某某', coverColor: '#d5e1f2' },
	{ id: 'b4', categoryId: 'theory', name: '中医诊断学图解', shortTitle: '诊断\n图解', author: '赵某某', coverColor: '#f1ddb9' }
])

const currentCategoryId = ref('theory')
const currentBooks = ref<BookItem[]>([])

const refreshBooks = () => {
	currentBooks.value = books.value.filter((item : BookItem) : boolean => item.categoryId == currentCategoryId.value)
}

const selectCategory = (id : string) => {
	currentCategoryId.value = id
	refreshBooks()
}

const goBookDetail = (book : BookItem) => {
	uni.navigateTo({
		url: '/pages/knowledge/book-detail?id=' + book.id + '&name=' + encodeURIComponent(book.name) + '&author=' + encodeURIComponent(book.author)
	})
}

const goLearningPage = () => {
	uni.reLaunch({ url: '/pages/index/index' })
}

const goMinePage = () => {
	uni.navigateTo({ url: '/pages/mine/index' })
}

const goConsultPage = () => {
	uni.navigateTo({ url: '/pages/consult/index' })
}

refreshBooks()
</script>

