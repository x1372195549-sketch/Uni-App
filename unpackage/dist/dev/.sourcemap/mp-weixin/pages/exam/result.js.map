<template>
	<view class="page">
		<view class="header">
			<view class="header-back" @click="goBack">
				<image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">答题结果</text>
		</view>

		<view class="result-body">
			<view class="trophy-box">
				<view class="trophy-left"></view>
				<view class="trophy-cup">
					<view class="trophy-star"></view>
				</view>
				<view class="trophy-right"></view>
				<view class="trophy-stem"></view>
				<view class="trophy-base"></view>
			</view>
			<text class="result-text">共{{ totalCount }}道题，您答对了{{ correctCount }}道题</text>
			<view class="home-btn" @click="goHome">
				<text class="home-btn-text">返回首页</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
const currentPages = getCurrentPages()
let totalValue = '10'
let correctValue = '1'

if (currentPages.length > 0) {
	const currentPage = currentPages[currentPages.length - 1]
	const options = currentPage.options
	if (options != null) {
		if (options['total'] != null) {
			totalValue = options['total'] as string
		}
		if (options['correct'] != null) {
			correctValue = options['correct'] as string
		}
	}
}

const totalCount = ref(totalValue)
const correctCount = ref(correctValue)

const goHome = () => {
	uni.reLaunch({
		url: '/pages/index/index'
	})
}

const goBack = () => {
	uni.navigateBack()
}
</script>

<style>
.page {
	flex: 1;
	background-color: #ffffff;
}

.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	background-color: #ffffff;
}

.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}

.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}

.header-title {
	font-size: 16px;
	line-height: 24px;
	color: #2f2f2f;
	font-weight: 500;
}

.result-body {
	flex: 1;
	align-items: center;
	padding-top: 110rpx;
}

.trophy-box {
	width: 260rpx;
	height: 280rpx;
	position: relative;
	align-items: center;
}

.trophy-left {
	position: absolute;
	left: 18rpx;
	top: 58rpx;
	width: 54rpx;
	height: 86rpx;
	border-top-left-radius: 54rpx;
	border-bottom-left-radius: 54rpx;
	border-width: 16rpx;
	border-style: solid;
	border-right-width: 0;
	border-color: #d89f15;
}

.trophy-right {
	position: absolute;
	right: 18rpx;
	top: 58rpx;
	width: 54rpx;
	height: 86rpx;
	border-top-right-radius: 54rpx;
	border-bottom-right-radius: 54rpx;
	border-width: 16rpx;
	border-style: solid;
	border-left-width: 0;
	border-color: #d89f15;
}

.trophy-cup {
	margin-top: 20rpx;
	width: 170rpx;
	height: 132rpx;
	border-bottom-left-radius: 36rpx;
	border-bottom-right-radius: 36rpx;
	border-top-left-radius: 24rpx;
	border-top-right-radius: 24rpx;
	background-color: #e0ab22;
	align-items: center;
	justify-content: center;
}

.trophy-star {
	width: 52rpx;
	height: 52rpx;
	border-radius: 12rpx;
	background-color: rgba(255, 235, 170, 0.45);
}

.trophy-stem {
	margin-top: 8rpx;
	width: 54rpx;
	height: 64rpx;
	background-color: #d59816;
}

.trophy-base {
	margin-top: 8rpx;
	width: 148rpx;
	height: 30rpx;
	border-radius: 12rpx;
	background-color: #bf7c09;
}

.result-text {
	margin-top: 34rpx;
	font-size: 18px;
	line-height: 28px;
	color: #e04f36;
	font-weight: 600;
}

.home-btn {
	margin-top: 40rpx;
	width: 220rpx;
	height: 70rpx;
	border-radius: 8rpx;
	background-color: #12b368;
	align-items: center;
	justify-content: center;
}

.home-btn-text {
	font-size: 18px;
	line-height: 26px;
	color: #ffffff;
	font-weight: 600;
}
</style>
