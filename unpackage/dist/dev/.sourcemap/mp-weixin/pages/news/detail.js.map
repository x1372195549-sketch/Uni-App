<template>
	<view class="page">
		<view class="header">
			<view class="back-btn" @click="goBack">
				<image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">详情</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="hero">
				<view class="hero-mask"></view>
				<view class="paper-outer">
					<view class="paper-line"></view>
					<view class="paper-line"></view>
					<view class="paper-line"></view>
				</view>
			</view>

			<view class="tabs">
				<view class="tab-item" @click="activeTab = 'intro'">
					<text :class="activeTab == 'intro' ? 'tab-text tab-text-active' : 'tab-text'">简介</text>
					<view v-if="activeTab == 'intro'" class="tab-line"></view>
				</view>
				<view class="tab-item" @click="activeTab = 'catalog'">
					<text :class="activeTab == 'catalog' ? 'tab-text tab-text-active' : 'tab-text'">目录</text>
					<view v-if="activeTab == 'catalog'" class="tab-line"></view>
				</view>
			</view>

			<view v-if="activeTab == 'intro'" class="intro-panel">
				<text class="media-title">{{ topicTitle }}</text>

				<view class="stats-row">
					<text class="stats-text">浏览 {{ topicViews }}</text>
					<text class="stats-text">目录 {{ topicCatalogCount }}</text>
				</view>

				<text class="section-title">专题介绍</text>
				<text class="intro-text">{{ topicIntro }}</text>
			</view>

			<view v-else class="catalog-panel">
				<view class="catalog-row catalog-row-active" v-for="item in catalogItems" :key="item.id">
					<text class="catalog-title">{{ item.title }}</text>
					<text class="catalog-duration">{{ item.duration }}</text>
				</view>

				<view class="exam-wrap">
					<button class="exam-btn" hover-class="exam-btn-hover">进入考核</button>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { fetchTopicDetail } from '../../utils/auth.uts'

type TopicItem = {
	id : number
	topicId : number
	itemType : string
	itemId : number
	sortOrder : number
	resource : UTSJSONObject | null
}

type Topic = {
	id : number
	title : string
	summary : string
	learningRequirements : string
	coverUrl : string
	viewCount : number
	publishedAt : string
	items : TopicItem[]
}

type CatalogItem = {
	id : string
	title : string
	duration : string
}

const topicId = ref('')
const activeTab = ref('intro')
const topicTitle = ref('资讯详情')
const topicViews = ref('0')
const topicCatalogCount = ref('0')
const topicIntro = ref('这里展示专题简介、学习要求和补充说明。接口返回真实专题内容时，将优先显示后端数据。')

const catalogItems = ref<CatalogItem[]>([
	{ id: '1', title: '专题1：目录标题占位一', duration: '10\'20"' },
	{ id: '2', title: '专题2：目录标题占位二', duration: '10\'20"' },
	{ id: '3', title: '专题3：目录标题占位三', duration: '10\'20"' },
	{ id: '4', title: '专题4：目录标题占位四', duration: '10\'20"' }
])

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const applyTopicDetail = (detail : Topic) => {
	const titleText = safeText(detail.title)
	if (titleText.length > 0) {
		topicTitle.value = titleText
	}

	const introText = safeText(detail.learningRequirements).length > 0
		? safeText(detail.learningRequirements)
		: safeText(detail.summary)
	if (introText.length > 0) {
		topicIntro.value = introText
	}

	topicViews.value = String(detail.viewCount != null ? detail.viewCount : 0)
	topicCatalogCount.value = String(detail.items != null ? detail.items.length : 0)

	if (detail.items != null && detail.items.length > 0) {
		catalogItems.value = detail.items.map((item : TopicItem, index : number) : CatalogItem => {
			const itemType = safeText(item.itemType)
			return {
				id: String(item.id),
				title: '专题' + String(index + 1) + '：' + (itemType.length > 0 ? itemType : '目录项'),
				duration: '10\'20"'
			}
		})
	}
}

const goBack = () => {
	uni.navigateBack()
}

const loadParams = () => {
	const pages = getCurrentPages()
	if (pages.length > 0) {
		const current = pages[pages.length - 1]
		if (current != null && current.options != null) {
			if (current.options['id'] != null) {
				topicId.value = current.options['id'] as string
			}
			if (current.options['tab'] != null) {
				activeTab.value = current.options['tab'] as string
			}
		}
	}

	if (topicId.value.length > 0) {
		fetchTopicDetail(
			topicId.value,
			(detail) => {
				applyTopicDetail(detail)
			},
			() => {}
		)
	}
}

onMounted(() => {
	loadParams()
})
</script>

