<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

			<view class="header">
				<text class="header-title">江苏中医在线</text>
			</view>

			<view class="top-tabs">
				<view class="top-tab" @click="goLearningPage">
					<text class="top-tab-text">首页</text>
				</view>
				<view class="top-tab" @click="goAudioPage">
					<text class="top-tab-text">音频</text>
				</view>
				<view class="top-tab" @click="goLivePage">
					<text class="top-tab-text">直播</text>
				</view>
				<view class="top-tab" @click="goCoursePage">
					<text class="top-tab-text">课程</text>
				</view>
				<view class="top-tab top-tab-active">
					<text class="top-tab-text top-tab-text-active">资讯</text>
					<view class="top-tab-line"></view>
				</view>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="content-shell">
				<view class="news-card" v-for="item in newsItems" :key="item.id" @click="goNewsDetail(item.id)">
					<view class="news-cover-shell">
						<view class="news-cover">
							<text class="cover-badge">NEWS</text>
							<text class="cover-title">{{ item.coverTitle }}</text>
							<text class="cover-subtitle">{{ item.coverSubtitle }}</text>
							<view class="cover-paper">
								<view class="paper-line"></view>
								<view class="paper-line"></view>
								<view class="paper-line"></view>
							</view>
						</view>
					</view>

					<view class="news-info">
						<text class="news-title">{{ item.title }}</text>
						<view class="news-meta">
							<text class="teacher-name">{{ item.source }}</text>
							<view class="stats">
								<text class="stat-text">浏览 {{ item.views }}</text>
								<text class="stat-text">目录 {{ item.comments }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="tabbar">
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">学习</text>
			</view>
			<view class="tab-item" @click="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">咨询</text>
			</view>
			<view class="tab-item" @click="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">知识库</text>
			</view>
			<view class="tab-item" @click="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { fetchTopics } from '../../utils/auth.uts'

type TopicItem = {
	id : number
	topicId : number
	itemType : string
	itemId : number
	sortOrder : number
	resource : UTSJSONObject | null
}

type Topic = {
	id : number
	title : string
	summary : string
	learningRequirements : string
	coverUrl : string
	viewCount : number
	publishedAt : string
	items : TopicItem[]
}

type NewsItem = {
	id : string
	coverTitle : string
	coverSubtitle : string
	title : string
	source : string
	views : string
	comments : string
}

const placeholderItems : NewsItem[] = [
	{
		id: '1',
		coverTitle: '资讯封面占位',
		coverSubtitle: '第一条资讯',
		title: '资讯标题占位一，点击进入资讯详情页面',
		source: '来源占位',
		views: '3200',
		comments: '3'
	},
	{
		id: '2',
		coverTitle: '资讯封面占位',
		coverSubtitle: '第二条资讯',
		title: '资讯标题占位二，点击进入资讯详情页面',
		source: '来源占位',
		views: '3200',
		comments: '3'
	}
]

const newsItems = ref<NewsItem[]>([])

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const mapTopicToNews = (item : Topic, index : number) : NewsItem => {
	const title = safeText(item.title)
	const summary = safeText(item.summary)
	return {
		id: String(item.id),
		coverTitle: title.length > 0 ? title : '资讯封面占位',
		coverSubtitle: summary.length > 0 ? summary : '第' + String(index + 1) + '条资讯',
		title: title.length > 0 ? title : '资讯标题占位',
		source: safeText(item.publishedAt).length > 0 ? item.publishedAt : '专题来源',
		views: String(item.viewCount != null ? item.viewCount : 0),
		comments: String(item.items != null ? item.items.length : 0)
	}
}

const loadNewsItems = () => {
	fetchTopics(
		(pageData) => {
			if (pageData.records != null && pageData.records.length > 0) {
				newsItems.value = pageData.records.map((item : Topic, index : number) : NewsItem => {
					return mapTopicToNews(item, index)
				})
				return
			}
			newsItems.value = placeholderItems
		},
		() => {
			newsItems.value = placeholderItems
		}
	)
}

const goLearningPage = () => {
	uni.redirectTo({ url: '/pages/index/index' })
}

const goAudioPage = () => {
	uni.redirectTo({ url: '/pages/audio/index' })
}

const goLivePage = () => {
	uni.redirectTo({ url: '/pages/live/index' })
}

const goCoursePage = () => {
	uni.redirectTo({ url: '/pages/course/index' })
}

const goMinePage = () => {
	uni.redirectTo({ url: '/pages/mine/index' })
}

const goExamPage = () => {
	uni.redirectTo({ url: '/pages/exam/index' })
}

const goNewsDetail = (id : string) => {
	uni.navigateTo({ url: '/pages/news/detail?id=' + id })
}

const goKnowledgePage = () => {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goConsultPage = () => {
	uni.redirectTo({ url: '/pages/consult/index' })
}

loadNewsItems()
</script>

<style>
.page {
	flex: 1;
	background-color: #f7f7f2;
}

.hero-shell {
	position: relative;
	height: 236rpx;
	overflow: hidden;
}

.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 236rpx;
}

.header {
	position: relative;
	z-index: 1;
	padding-top: 34rpx;
	height: 118rpx;
	align-items: center;
	justify-content: center;
}

.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}

.top-tabs {
	position: relative;
	z-index: 1;
	height: 96rpx;
	margin-top: 18rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	background-color: rgba(251, 250, 246, 0.78);
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-around;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(229, 234, 225, 0.95);
}

.top-tab {
	min-width: 88rpx;
	height: 96rpx;
	align-items: center;
	justify-content: center;
}

.top-tab-active {
	position: relative;
}

.top-tab-text {
	font-size: 18px;
	line-height: 26px;
	color: #333333;
}

.top-tab-text-active {
	color: #b85d69;
	font-weight: 600;
}

.top-tab-line {
	position: absolute;
	bottom: 10rpx;
	width: 48rpx;
	height: 6rpx;
	border-radius: 4rpx;
	background-color: #b85d69;
}

.content {
	flex: 1;
	padding-bottom: 110rpx;
}

.content-shell {
	padding-left: 20rpx;
	padding-right: 20rpx;
	padding-top: 24rpx;
	padding-bottom: 40rpx;
}

.news-card {
	margin-bottom: 22rpx;
	border-radius: 20rpx;
	background-color: #ffffff;
	overflow: hidden;
	box-shadow: 0 12rpx 24rpx rgba(110, 100, 80, 0.05);
}

.news-cover-shell {
	padding: 0;
	background-color: #f1e3cf;
}

.news-cover {
	height: 260rpx;
	position: relative;
	padding-left: 44rpx;
	padding-top: 48rpx;
	background-color: #f4e4cf;
}

.cover-badge {
	padding-left: 12rpx;
	padding-right: 12rpx;
	height: 34rpx;
	line-height: 34rpx;
	border-radius: 18rpx;
	background-color: #bf5d68;
	color: #ffffff;
	font-size: 12px;
	font-weight: 600;
	align-self: flex-start;
	text-align: center;
}

.cover-title {
	margin-top: 16rpx;
	font-size: 28px;
	line-height: 38px;
	color: #b9702f;
	font-weight: 600;
}

.cover-subtitle {
	margin-top: 16rpx;
	font-size: 18px;
	line-height: 26px;
	color: #8d6e4d;
}

.cover-paper {
	position: absolute;
	right: 54rpx;
	top: 42rpx;
	width: 148rpx;
	height: 148rpx;
	border-radius: 18rpx;
	background-color: rgba(255, 255, 255, 0.8);
	padding-left: 22rpx;
	padding-right: 22rpx;
	padding-top: 30rpx;
}

.paper-line {
	height: 12rpx;
	border-radius: 8rpx;
	background-color: rgba(185, 112, 47, 0.25);
	margin-bottom: 18rpx;
}

.news-info {
	padding-left: 24rpx;
	padding-right: 24rpx;
	padding-top: 22rpx;
	padding-bottom: 22rpx;
}

.news-title {
	font-size: 18px;
	line-height: 28px;
	color: #252525;
	font-weight: 600;
}

.news-meta {
	margin-top: 18rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.teacher-name {
	font-size: 15px;
	line-height: 22px;
	color: #a8a8a8;
}

.stats {
	flex-direction: row;
	align-items: center;
}

.stat-text {
	font-size: 13px;
	line-height: 20px;
	color: #a0a0a0;
	margin-left: 18rpx;
}

.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}

.tab-item {
	align-items: center;
	justify-content: center;
}

.tab-item-active {
	margin-top: -2rpx;
}

.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}

.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}

.tab-label-active {
	color: #18b775;
}
</style>
