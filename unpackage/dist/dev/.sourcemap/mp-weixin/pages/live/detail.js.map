<template>
  <view class="page">
    <view class="header">
      <view class="back-btn" @click="goBack">
        <image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
      </view>
      <text class="header-title">详情</text>
    </view>

    <scroll-view class="content" scroll-y="true">
      <view class="hero">
        <view class="hero-mask"></view>
        <view class="signal-stack">
          <view class="signal-dot"></view>
          <view class="signal-ring signal-ring-one"></view>
          <view class="signal-ring signal-ring-two"></view>
        </view>
      </view>

      <view class="detail-panel">
        <view class="title-row">
          <text class="media-title">{{ liveTitle }}</text>
          <view class="favorite-title-btn" @click="toggleFavorite">
            <text class="favorite-text" :class="isFavorited ? 'favorite-text-active' : ''">{{ isFavorited ? '已收藏' : '收藏' }}</text>
          </view>
        </view>

        <view class="stats-row">
          <text class="stats-text">开始 {{ liveMetaLeft }}</text>
          <text class="stats-text">收藏 {{ liveFavoriteCount }}</text>
        </view>

        <text class="section-title">直播介绍</text>
        <text class="intro-text">{{ liveIntro }}</text>

        <view class="action-wrap">
          <button class="action-btn" hover-class="action-btn-hover">进入直播</button>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import {
  checkFavoriteStatus,
  fetchLiveSessionDetail,
  updateFavoriteStatus,
  type LiveSession
} from '../../utils/auth.uts'

const RESOURCE_TYPE = 'live'

const liveId = ref('')
const liveTitle = ref('直播详情')
const liveMetaLeft = ref('未安排')
const liveFavoriteCount = ref('0')
const liveIntro = ref('这里展示直播基础信息。')
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)

function safeText(value : string | null) : string {
  return value == null || value.length == 0 ? '' : value
}

function goBack() : void {
  uni.navigateBack()
}

function formatDateTime(value : string) : string {
  if (value.length == 0) {
    return '未安排'
  }
  if (value.length >= 16) {
    return value.slice(0, 16).replace('T', ' ')
  }
  return value.replace('T', ' ')
}

function mapLiveStatus(status : string) : string {
  if (status == '1') {
    return '直播中'
  }
  if (status == '2') {
    return '已结束'
  }
  if (status == '3') {
    return '回放'
  }
  return '未开始'
}

function loadFavoriteStatus() : void {
  if (liveId.value.length == 0) {
    return
  }

  checkFavoriteStatus(
    RESOURCE_TYPE,
    Number(liveId.value),
    (favorited) => {
      isFavorited.value = favorited
    },
    () => {
      isFavorited.value = false
    }
  )
}

function toggleFavorite() : void {
  if (liveId.value.length == 0 || isFavoriteLoading.value) {
    return
  }

  isFavoriteLoading.value = true
  updateFavoriteStatus(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(liveId.value),
      favorited: !isFavorited.value
    },
    (result) => {
      isFavorited.value = result.favorited
      liveFavoriteCount.value = String(result.favoriteCount != null ? result.favoriteCount : 0)
      isFavoriteLoading.value = false
      uni.showToast({
        title: result.favorited ? '收藏成功' : '已取消收藏',
        icon: 'success'
      })
    },
    (message) => {
      isFavoriteLoading.value = false
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

function applyLiveDetail(detail : LiveSession) : void {
  const titleText = safeText(detail.title)
  if (titleText.length > 0) {
    liveTitle.value = titleText
  }

  const anchorText = safeText(detail.anchorName)
  const timeText = safeText(detail.startAt)
  const endText = safeText(detail.endAt)
  const playbackText = safeText(detail.playbackUrl)
  const liveUrlText = safeText(detail.liveUrl)
  const statusText = safeText(detail.liveStatus)

  liveMetaLeft.value = formatDateTime(timeText)

  const introParts = new Array<string>()
  if (anchorText.length > 0) {
    introParts.push('主讲人：' + anchorText)
  }
  if (timeText.length > 0) {
    introParts.push('开始时间：' + formatDateTime(timeText))
  }
  if (endText.length > 0) {
    introParts.push('结束时间：' + formatDateTime(endText))
  }
  if (statusText.length > 0) {
    introParts.push('直播状态：' + mapLiveStatus(statusText))
  }
  if (playbackText.length > 0) {
    introParts.push('回放地址：' + playbackText)
  } else if (liveUrlText.length > 0) {
    introParts.push('直播地址：' + liveUrlText)
  }
  if (introParts.length > 0) {
    liveIntro.value = introParts.join('；')
  }
}

function loadParams() : void {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    return
  }

  const current = pages[pages.length - 1]
  if (current != null && current.options != null && current.options['id'] != null) {
    liveId.value = current.options['id'] as string
  }
}

function loadLiveDetail() : void {
  if (liveId.value.length == 0) {
    return
  }

  fetchLiveSessionDetail(
    liveId.value,
    (detail) => {
      applyLiveDetail(detail)
    },
    (message) => {
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

onMounted(() => {
  loadParams()
  loadLiveDetail()
  loadFavoriteStatus()
})

onShow(() => {
  loadFavoriteStatus()
})
</script>

