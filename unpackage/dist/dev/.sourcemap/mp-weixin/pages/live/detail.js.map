<template>
	<view class="page">
		<view class="header">
			<view class="back-btn" @click="goBack">
				<image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">详情</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="hero">
				<view class="hero-mask"></view>
				<view class="signal-stack">
					<view class="signal-dot"></view>
					<view class="signal-ring signal-ring-one"></view>
					<view class="signal-ring signal-ring-two"></view>
				</view>
			</view>

			<view class="detail-panel">
				<text class="media-title">{{ liveTitle }}</text>

				<view class="stats-row">
					<text class="stats-text">开播 {{ liveMetaLeft }}</text>
					<text class="stats-text">状态 {{ liveMetaRight }}</text>
				</view>

				<text class="section-title">直播介绍</text>
				<text class="intro-text">{{ liveIntro }}</text>

				<view class="action-wrap">
					<button class="action-btn" hover-class="action-btn-hover">进入直播</button>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { fetchLiveSessionDetail } from '../../utils/auth.uts'

type LiveSession = {
	id : number
	title : string
	coverUrl : string
	anchorName : string
	liveUrl : string
	playbackUrl : string
	startAt : string
	endAt : string
	reviewStatus : string
	liveStatus : string
}

const liveId = ref('')
const liveTitle = ref('直播详情')
const liveMetaLeft = ref('未排期')
const liveMetaRight = ref('未开始')
const liveIntro = ref('这里展示直播基础信息。接口返回直播主讲人、时间、状态或回放地址时，将直接显示后端数据。')

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const goBack = () => {
	uni.navigateBack()
}

const formatDateTime = (value : string) : string => {
	if (value.length == 0) {
		return '未排期'
	}
	if (value.length >= 16) {
		return value.slice(0, 16).replace('T', ' ')
	}
	return value.replace('T', ' ')
}

const mapLiveStatus = (status : string) : string => {
	if (status == '1') {
		return '直播中'
	}
	if (status == '2') {
		return '已结束'
	}
	if (status == '3') {
		return '回放'
	}
	return '未开始'
}

const applyLiveDetail = (detail : LiveSession) => {
	const titleText = safeText(detail.title)
	if (titleText.length > 0) {
		liveTitle.value = titleText
	}

	const anchorText = safeText(detail.anchorName)
	const timeText = safeText(detail.startAt)
	const endText = safeText(detail.endAt)
	const playbackText = safeText(detail.playbackUrl)
	const liveUrlText = safeText(detail.liveUrl)
	const statusText = safeText(detail.liveStatus)

	liveMetaLeft.value = formatDateTime(timeText)
	liveMetaRight.value = mapLiveStatus(statusText)

	const introParts = new Array<string>()
	if (anchorText.length > 0) {
		introParts.push('主讲人：' + anchorText)
	}
	if (timeText.length > 0) {
		introParts.push('开始时间：' + formatDateTime(timeText))
	}
	if (endText.length > 0) {
		introParts.push('结束时间：' + formatDateTime(endText))
	}
	if (statusText.length > 0) {
		introParts.push('直播状态：' + mapLiveStatus(statusText))
	}
	if (playbackText.length > 0) {
		introParts.push('回放地址：' + playbackText)
	} else if (liveUrlText.length > 0) {
		introParts.push('直播地址：' + liveUrlText)
	}
	if (introParts.length > 0) {
		liveIntro.value = introParts.join('；')
	}
}

const loadParams = () => {
	const pages = getCurrentPages()
	if (pages.length > 0) {
		const current = pages[pages.length - 1]
		if (current != null && current.options != null && current.options['id'] != null) {
			liveId.value = current.options['id'] as string
		}
	}

	if (liveId.value.length > 0) {
		fetchLiveSessionDetail(
			liveId.value,
			(detail) => {
				applyLiveDetail(detail)
			},
			() => {}
		)
	}
}

onMounted(() => {
	loadParams()
})
</script>

<style>
.page {
	flex: 1;
	background-color: #f7f7f2;
}

.header {
	height: 88rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: #f7f7f2;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ece9e1;
	position: relative;
}

.back-btn {
	position: absolute;
	left: 16rpx;
	top: 0;
	bottom: 0;
	width: 56rpx;
	align-items: center;
	justify-content: center;
}

.back-icon-image {
	width: 24rpx;
	height: 24rpx;
}

.header-title {
	font-size: 20px;
	line-height: 30px;
	color: #2f2f2f;
	font-weight: 600;
}

.content {
	flex: 1;
}

.hero {
	height: 420rpx;
	position: relative;
	background-color: #d8c9b5;
	align-items: center;
	justify-content: center;
}

.hero-mask {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(60, 54, 44, 0.2);
}

.signal-stack {
	width: 220rpx;
	height: 220rpx;
	align-items: center;
	justify-content: center;
	z-index: 1;
	position: relative;
}

.signal-dot {
	width: 72rpx;
	height: 72rpx;
	border-radius: 36rpx;
	background-color: rgba(185, 112, 47, 0.42);
	z-index: 3;
}

.signal-ring {
	position: absolute;
	border-width: 10rpx;
	border-style: solid;
	border-color: rgba(255, 255, 255, 0.88);
	border-radius: 999rpx;
}

.signal-ring-one {
	width: 134rpx;
	height: 134rpx;
}

.signal-ring-two {
	width: 220rpx;
	height: 220rpx;
}

.detail-panel {
	padding-left: 46rpx;
	padding-right: 46rpx;
	padding-top: 34rpx;
	padding-bottom: 60rpx;
	background-color: #ffffff;
	min-height: 860rpx;
}

.media-title {
	font-size: 18px;
	line-height: 28px;
	color: #242424;
	font-weight: 600;
	text-align: center;
}

.stats-row {
	margin-top: 34rpx;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}

.stats-text {
	font-size: 12px;
	line-height: 18px;
	color: #9e9e9e;
	margin-left: 28rpx;
}

.section-title {
	margin-top: 38rpx;
	font-size: 15px;
	line-height: 22px;
	color: #2b2b2b;
}

.intro-text {
	margin-top: 28rpx;
	font-size: 12px;
	line-height: 24px;
	color: #8f8f8f;
}

.action-wrap {
	margin-top: 140rpx;
	align-items: center;
}

.action-btn {
	width: 300rpx;
	height: 84rpx;
	line-height: 84rpx;
	border-radius: 18rpx;
	background-color: #b66572;
	color: #ffffff;
	font-size: 18px;
	font-weight: 600;
	border-width: 0;
}

.action-btn-hover {
	opacity: 0.92;
}
</style>
