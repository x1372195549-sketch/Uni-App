<template>
  <view class="page">
    <view class="hero-shell">
      <image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>
      <view class="header">
        <text class="header-title">{{ appTitleText }}</text>
      </view>

      <view class="top-tabs">
        <view class="top-tab" @tap="goLearningPage">
          <text class="top-tab-text">{{ homeTabText }}</text>
        </view>
        <view class="top-tab" @tap="goTopicsPage">
          <text class="top-tab-text">{{ topicsTabText }}</text>
        </view>
        <view class="top-tab" @tap="goAudioPage">
          <text class="top-tab-text">{{ audioTabText }}</text>
        </view>
        <view class="top-tab top-tab-active">
          <text class="top-tab-text top-tab-text-active">{{ pageTitleText }}</text>
          <view class="top-tab-line"></view>
        </view>
        <view class="top-tab" @tap="goCoursePage">
          <text class="top-tab-text">{{ courseTabText }}</text>
        </view>
        <view class="top-tab" @tap="goNewsPage">
          <text class="top-tab-text">{{ newsTabText }}</text>
        </view>
      </view>
    </view>

    <view class="search-bar">
      <input
        v-model="keyword"
        class="search-input"
        :placeholder="searchPlaceholder"
        confirm-type="search"
        @confirm="reloadList"
      />
      <view class="search-btn" @tap="reloadList">
        <text class="search-btn-text">{{ searchText }}</text>
      </view>
    </view>

    <scroll-view class="content" scroll-y="true" @scrolltolower="loadMore">
      <view class="content-shell">
        <view v-if="isLoading" class="state-wrap">
          <text class="state-text">{{ loadingText }}</text>
        </view>

        <view v-else-if="errorText.length > 0" class="state-wrap">
          <text class="state-text">{{ errorText }}</text>
          <view class="retry-btn" @tap="reloadList">
            <text class="retry-btn-text">{{ retryText }}</text>
          </view>
        </view>

        <view v-else-if="liveItems.length == 0" class="state-wrap">
          <text class="state-text">{{ emptyText }}</text>
        </view>

        <view v-else class="list-wrap">
          <view class="live-card" v-for="item in liveItems" :key="item.id" @tap="goLiveDetail(item.id)">
            <view class="live-cover-shell">
              <image v-if="item.coverUrl.length > 0" class="live-cover-image" :src="item.coverUrl" mode="aspectFill"></image>
              <view v-else class="live-cover">
                <text class="cover-badge">LIVE</text>
                <text class="cover-title">{{ item.coverTitle }}</text>
                <text class="cover-subtitle">{{ item.coverSubtitle }}</text>
                <view class="live-signal">
                  <view class="signal-dot"></view>
                  <view class="signal-ring signal-ring-one"></view>
                  <view class="signal-ring signal-ring-two"></view>
                </view>
              </view>
              <view class="status-chip">
                <text class="status-chip-text">{{ item.statusLabel }}</text>
              </view>
            </view>

            <view class="live-info">
              <text class="live-title">{{ item.title }}</text>
              <text class="teacher-name">{{ item.teacher }}</text>
              <text class="live-time">{{ item.timeText }}</text>
              <view class="tag-row" v-if="item.tags.length > 0">
                <text class="tag-text" v-for="tag in item.tags" :key="tag">{{ tag }}</text>
              </view>
              <view class="live-meta">
                <text class="stat-text">{{ viewText }} {{ item.views }}</text>
                <text class="stat-text">{{ favoriteText }} {{ item.favorites }}</text>
                <text class="stat-text">{{ item.playbackText }}</text>
              </view>
            </view>
          </view>

          <view v-if="isListLoading" class="bottom-state">
            <text class="bottom-state-text">{{ loadingMoreText }}</text>
          </view>
          <view v-else-if="!hasMore" class="bottom-state">
            <text class="bottom-state-text">{{ noMoreText }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="tabbar">
      <view class="tab-item tab-item-active">
        <image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
        <text class="tab-label tab-label-active">{{ learningTabText }}</text>
      </view>
      <view class="tab-item" @tap="goExamPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">{{ examTabText }}</text>
      </view>
      <view class="tab-item" @tap="goConsultPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
        <text class="tab-label">{{ consultTabText }}</text>
      </view>
      <view class="tab-item" @tap="goKnowledgePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">{{ knowledgeTabText }}</text>
      </view>
      <view class="tab-item" @tap="goMinePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">{{ mineTabText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { fetchLiveSessions, type LiveSession } from '../../utils/auth.uts'

type LiveCardItem = {
  id : string
  title : string
  teacher : string
  timeText : string
  statusLabel : string
  playbackText : string
  views : string
  favorites : string
  coverUrl : string
  coverTitle : string
  coverSubtitle : string
  tags : string[]
}

const PAGE_SIZE = 10

const appTitleText = '\u6c5f\u82cf\u4e2d\u533b\u5728\u7ebf'
const homeTabText = '\u9996\u9875'
const topicsTabText = '\u4e13\u9898'
const audioTabText = '\u97f3\u9891'
const pageTitleText = '\u76f4\u64ad'
const courseTabText = '\u8bfe\u7a0b'
const newsTabText = '\u8d44\u8baf'
const learningTabText = '\u5b66\u4e60'
const examTabText = '\u8003\u6838'
const consultTabText = '\u54a8\u8be2'
const knowledgeTabText = '\u77e5\u8bc6\u5e93'
const mineTabText = '\u6211\u7684'
const searchPlaceholder = '\u641c\u7d22\u6807\u9898\u3001\u8bb2\u5e08\u3001\u4e3b\u64ad'
const searchText = '\u641c\u7d22'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const emptyText = '\u6682\u65e0\u76f4\u64ad'
const loadingMoreText = '\u52a0\u8f7d\u66f4\u591a\u4e2d...'
const noMoreText = '\u6ca1\u6709\u66f4\u591a\u4e86'
const loadFailedText = '\u8bf7\u6c42\u5931\u8d25\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5'
const viewText = '\u6d4f\u89c8'
const favoriteText = '\u6536\u85cf'
const fallbackTeacherText = '\u8bb2\u5e08\u5f85\u5b9a'
const fallbackTimeText = '\u65f6\u95f4\u5f85\u5b9a'
const fallbackCoverTitle = '\u76f4\u64ad\u5c01\u9762'
const playbackReadyText = '\u53ef\u56de\u653e'
const playbackEmptyText = '\u65e0\u56de\u653e'
const liveText = '\u76f4\u64ad\u4e2d'
const endedText = '\u5df2\u7ed3\u675f'
const canceledText = '\u5df2\u53d6\u6d88'
const notStartedText = '\u672a\u5f00\u59cb'

const liveItems = ref<LiveCardItem[]>([])
const keyword = ref('')
const page = ref(1)
const hasMore = ref(true)
const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')
const hasLoadedOnce = ref(false)

function safeText(value : string | null) : string {
  return value == null || value.length == 0 ? '' : value
}

function formatDateTime(value : string) : string {
  const text = safeText(value)
  if (text.length == 0) {
    return ''
  }
  if (text.length >= 16) {
    return text.slice(0, 16).replace('T', ' ')
  }
  return text.replace('T', ' ')
}

function mapLiveStatus(status : string) : string {
  const normalized = safeText(status).toUpperCase()
  if (normalized == 'LIVE' || normalized == '1') {
    return liveText
  }
  if (normalized == 'ENDED' || normalized == '2') {
    return endedText
  }
  if (normalized == 'CANCELED' || normalized == '3') {
    return canceledText
  }
  return notStartedText
}

function formatLiveTime(item : LiveSession) : string {
  const startText = formatDateTime(item.startAt)
  const endText = formatDateTime(item.endAt)
  if (startText.length > 0 && endText.length > 0) {
    return startText + ' - ' + endText
  }
  if (startText.length > 0) {
    return startText
  }
  return fallbackTimeText
}

function formatCoverSubtitle(item : LiveSession) : string {
  const startText = formatDateTime(item.startAt)
  return startText.length > 0 ? startText : '\u76f4\u64ad\u9884\u544a'
}

function mapLiveToCard(item : LiveSession) : LiveCardItem {
  const titleText = safeText(item.title)
  const speakerText = safeText(item.speakerName)
  const anchorText = safeText(item.anchorName)
  const teacherText = speakerText.length > 0 ? speakerText : (anchorText.length > 0 ? anchorText : fallbackTeacherText)

  return {
    id: String(item.id),
    title: titleText.length > 0 ? titleText : '\u76f4\u64ad\u8be6\u60c5',
    teacher: teacherText,
    timeText: formatLiveTime(item),
    statusLabel: mapLiveStatus(item.liveStatus),
    playbackText: safeText(item.playbackUrl).length > 0 ? playbackReadyText : playbackEmptyText,
    views: String(item.browseCount),
    favorites: String(item.favoriteCount),
    coverUrl: safeText(item.coverUrl),
    coverTitle: titleText.length > 0 ? titleText : fallbackCoverTitle,
    coverSubtitle: formatCoverSubtitle(item),
    tags: item.tags != null ? item.tags : []
  }
}

function loadLiveItems(loadMoreValue : boolean) : void {
  if (!loadMoreValue) {
    page.value = 1
    hasMore.value = true
    errorText.value = ''
    isLoading.value = true
  } else {
    if (!hasMore.value || isListLoading.value) {
      return
    }
    isListLoading.value = true
  }

  fetchLiveSessions(
    page.value,
    PAGE_SIZE,
    keyword.value,
    (pageData) => {
      const records = pageData.records != null ? pageData.records : []
      const mapped = records.map((item : LiveSession) : LiveCardItem => {
        return mapLiveToCard(item)
      })
      if (loadMoreValue) {
        liveItems.value = liveItems.value.concat(mapped)
      } else {
        liveItems.value = mapped
      }
      hasMore.value = records.length >= PAGE_SIZE
      if (hasMore.value) {
        page.value += 1
      }
      isLoading.value = false
      isListLoading.value = false
    },
    (message) => {
      errorText.value = message.length > 0 ? message : loadFailedText
      isLoading.value = false
      isListLoading.value = false
    }
  )
}

function reloadList() : void {
  loadLiveItems(false)
}

function loadMore() : void {
  loadLiveItems(true)
}

function goLearningPage() : void {
  uni.redirectTo({ url: '/pages/index/index' })
}

function goTopicsPage() : void {
  uni.redirectTo({ url: '/pages/topics/list' })
}

function goAudioPage() : void {
  uni.redirectTo({ url: '/pages/audio/index' })
}

function goCoursePage() : void {
  uni.redirectTo({ url: '/pages/course/index' })
}

function goNewsPage() : void {
  uni.redirectTo({ url: '/pages/news/index' })
}

function goMinePage() : void {
  uni.redirectTo({ url: '/pages/mine/index' })
}

function goExamPage() : void {
  uni.redirectTo({ url: '/pages/exam/index' })
}

function goConsultPage() : void {
  uni.redirectTo({ url: '/pages/consult/index' })
}

function goKnowledgePage() : void {
  uni.redirectTo({ url: '/pages/knowledge/index' })
}

function goLiveDetail(id : string) : void {
  uni.navigateTo({ url: '/pages/live/detail?id=' + id })
}

onShow(() => {
  if (!hasLoadedOnce.value) {
    hasLoadedOnce.value = true
    loadLiveItems(false)
  }
})
</script>

