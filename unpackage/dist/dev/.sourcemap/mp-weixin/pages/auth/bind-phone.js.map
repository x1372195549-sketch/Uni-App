<template>
	<view class="page">
		<image class="bg" src="/static/login/bg.png" mode="scaleToFill"></image>

		<view class="nav-back" @click="handleBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">绑定手机</text>
		</view>

		<view class="form">
			<view class="field">
				<text class="label">手机号码</text>
				<input class="input" type="number" maxlength="11" v-model="phone" placeholder="请输入您的手机号" />
			</view>

			<view class="field">
				<text class="label">验证码</text>
				<view class="code-row">
					<input class="input code-input" type="number" maxlength="6" v-model="code" placeholder="请输入验证码" />
					<view class="send-code-wrap">
						<text class="send-code" @click="handleSendCode">
							{{ countdown > 0 ? countdown + 's后重发' : (isSendingCode ? '发送中...' : '获取验证码') }}
						</text>
					</view>
				</view>
			</view>

			<button class="submit-btn" hover-class="submit-btn-hover" :disabled="isSubmitting" @click="handleSubmit">
				{{ isSubmitting ? '认证中...' : '认证' }}
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
import { loginBySms, sendSmsCode, wechatBindMobile, saveLogin, clearBindToken, getBindToken } from '../../utils/auth.uts'

const phone = ref('')
const code = ref('')
const isSendingCode = ref(false)
const isSubmitting = ref(false)
const countdown = ref(0)
let timerId : number = 0
const bindToken = getBindToken()

const isValidPhone = (value : string) : boolean => {
	return /^1\d{10}$/.test(value)
}

const isValidCode = (value : string) : boolean => {
	return /^\d{4,8}$/.test(value)
}

const startCountdown = () => {
	countdown.value = 60
	timerId = setInterval(() => {
		if (countdown.value <= 1) {
			clearInterval(timerId)
			timerId = 0
			countdown.value = 0
			return
		}
		countdown.value = countdown.value - 1
	}, 1000)
}

const handleBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
		return
	}
	uni.redirectTo({ url: '/pages/login/index' })
}

const handleSendCode = () => {
	if (isSendingCode.value || countdown.value > 0) {
		return
	}

	if (!isValidPhone(phone.value)) {
		uni.showToast({
			title: '请输入正确的手机号',
			icon: 'none'
		})
		return
	}

	isSendingCode.value = true
	sendSmsCode(
		phone.value,
		() => {
			isSendingCode.value = false
			startCountdown()
			uni.showToast({
				title: '验证码已发送',
				icon: 'none'
			})
		},
		(message) => {
			isSendingCode.value = false
			uni.showToast({
				title: message,
				icon: 'none'
			})
		}
	)
}

const handleSubmit = () => {
	if (isSubmitting.value) {
		return
	}

	if (!isValidPhone(phone.value)) {
		uni.showToast({
			title: '请输入正确的手机号',
			icon: 'none'
		})
		return
	}

	if (!isValidCode(code.value)) {
		uni.showToast({
			title: '请输入正确的验证码',
			icon: 'none'
		})
		return
	}

	isSubmitting.value = true

	const onLoginSuccess = () => {
		isSubmitting.value = false
		uni.reLaunch({
			url: '/pages/index/index'
		})
	}

	const onLoginFail = (message : string) => {
		isSubmitting.value = false
		uni.showToast({
			title: message,
			icon: 'none'
		})
	}

	if (bindToken != '') {
		// WeChat binding flow: bind phone to WeChat account
		wechatBindMobile(
			bindToken,
			phone.value,
			code.value,
			(loginData) => {
				saveLogin(loginData)
				clearBindToken()
				onLoginSuccess()
			},
			(message) => {
				onLoginFail(message)
			}
		)
	} else {
		// Direct SMS login flow
		loginBySms(
			phone.value,
			code.value,
			onLoginSuccess,
			(message) => {
				onLoginFail(message)
			}
		)
	}
}
</script>

<style>
.page {
	flex: 1;
	position: relative;
	background-color: #f8f6f1;
	overflow: hidden;
}

.bg {
	position: absolute;
	top: 0;
	bottom: 0;
	width: 750rpx;
	opacity: 0.98;
}

.nav-back {
	position: absolute;
	top: 72rpx;
	left: 14rpx;
	width: 52rpx;
	height: 52rpx;
	align-items: center;
	justify-content: center;
	z-index: 2;
}

.nav-back-icon {
	width: 26rpx;
	height: 26rpx;
}

.header {
	padding-top: 78rpx;
	align-items: center;
}

.header-title {
	font-size: 17px;
	line-height: 24px;
	color: #1b1b1b;
	font-weight: 500;
}

.form {
	padding-left: 70rpx;
	padding-right: 70rpx;
	padding-top: 114rpx;
}

.field {
	margin-bottom: 52rpx;
}

.label {
	font-size: 18px;
	line-height: 28px;
	color: #1b1b1b;
	font-weight: 500;
	margin-bottom: 18rpx;
}

.input {
	height: 56rpx;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #dddddd;
	font-size: 17px;
	color: #1c1c1c;
	padding-left: 0;
	padding-right: 0;
	background-color: transparent;
}

.code-row {
	flex-direction: row;
	align-items: flex-end;
}

.code-input {
	flex: 1;
}

.send-code-wrap {
	width: 170rpx;
	height: 56rpx;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #dddddd;
	align-items: flex-end;
	justify-content: center;
}

.send-code {
	font-size: 15px;
	line-height: 22px;
	color: #12ba7b;
	font-weight: 600;
	text-align: right;
}

.submit-btn {
	margin-top: 40rpx;
	width: 320rpx;
	height: 58rpx;
	line-height: 58rpx;
	padding: 0;
	align-self: center;
	background-color: #08b16b;
	color: #ffffff;
	font-size: 18px;
	font-weight: 500;
	border-width: 0;
	border-radius: 8rpx;
}

.submit-btn-hover {
	opacity: 0.92;
}
</style>
