const currentPrimaryId = ref('internal')
const currentSecondaryId = ref('')
const currentDoctors = ref<DoctorItem[]>([])

const refreshDoctors = () => {
	currentDoctors.value = doctors.value.filter((item : DoctorItem) : boolean => {
		if (item.primaryCategoryId != currentPrimaryId.value) {
			return false
		}
		if (currentSecondaryId.value == '') {
			return true
		}
		return item.secondaryCategoryId == currentSecondaryId.value
	})
}

const selectPrimaryCategory = (id : string) => {
	currentPrimaryId.value = id
	currentSecondaryId.value = ''
	refreshDoctors()
}

const selectSecondaryCategory = (primaryId : string, childId : string) => {
	currentPrimaryId.value = primaryId
	currentSecondaryId.value = childId
	refreshDoctors()
}

const goDoctorDetail = (doctor : DoctorItem) => {
	uni.navigateTo({
		url:
			'/pages/consult/detail?id=' + doctor.id +
			'&name=' + encodeURIComponent(doctor.name) +
			'&title=' + encodeURIComponent(doctor.title) +
			'&organization=' + encodeURIComponent(doctor.organization) +
			'&specialty=' + encodeURIComponent(doctor.specialty) +
			'&tag=' + encodeURIComponent(doctor.tag)
	})
}

const goLearningPage = () => {
	uni.reLaunch({ url: '/pages/index/index' })
}

const goKnowledgePage = () => {
	uni.navigateTo({ url: '/pages/knowledge/index' })
}

const goMinePage = () => {
	uni.navigateTo({ url: '/pages/mine/index' })
}

refreshDoctors()
