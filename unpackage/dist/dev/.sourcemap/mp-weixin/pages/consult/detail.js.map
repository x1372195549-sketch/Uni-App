<template>
	<view class="page">
		<view class="header">
			<view class="header-back" @click="goBack">
				<image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
			</view>
			<text class="header-title">医生详情</text>
		</view>

		<scroll-view class="scroll" scroll-y="true">
			<view class="hero">
				<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>
				<view class="avatar-shell">
					<image v-if="avatarUrl.length > 0" class="avatar-image" :src="avatarUrl" mode="aspectFill"></image>
					<view v-else class="avatar-circle">
						<text class="avatar-text">{{ shortName }}</text>
					</view>
				</view>
			</view>

			<view class="info-card">
				<view class="name-row">
					<text class="doctor-name">{{ doctorName }}</text>
					<text class="doctor-title">{{ doctorTitle }}</text>
				</view>
				<text class="meta-text">单位：{{ organization }}</text>
				<text class="meta-text">专业方向：{{ specialty }}</text>
				<text class="meta-text">分类标签：{{ tag }}</text>
			</view>

			<view class="section">
				<view class="section-head">
					<view class="section-line"></view>
					<text class="section-title">履历介绍</text>
				</view>
				<text class="section-content">{{ introduction }}</text>
			</view>

			<view class="section">
				<view class="section-head section-head-between">
					<view class="section-head-left">
						<view class="section-line"></view>
						<text class="section-title">专家答疑</text>
					</view>
					<text class="more-text">更多</text>
				</view>

				<view class="qa-item">
					<text class="qa-title">{{ qaTitleOne }}</text>
					<view class="qa-row">
						<text class="qa-time">2020/08/08</text>
						<text class="qa-status">已回答</text>
					</view>
				</view>

				<view class="qa-item">
					<text class="qa-title">{{ qaTitleTwo }}</text>
					<view class="qa-row">
						<text class="qa-time">2020/06/22</text>
						<text class="qa-status">已回答</text>
					</view>
				</view>
			</view>

			<view class="action-wrap">
				<button class="consult-btn" hover-class="consult-btn-hover">咨询专家</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted, computed } from 'vue'
import { fetchExpertDetail } from '../../utils/auth.uts'

type ExpertExperience = {
	id : number
	expertId : number
	experienceType : string
	title : string
	description : string
	startDate : string
	endDate : string
	sortOrder : number
}

type ExpertDetail = {
	id : number
	realName : string
	avatarUrl : string
	title : string
	organization : string
	specialty : string
	introduction : string
	consultationNotice : string
	sortOrder : number
	categoryIds : number[]
	experiences : ExpertExperience[]
}

const detailId = ref('')
const doctorName = ref('医生详情')
const doctorTitle = ref('专家')
const organization = ref('暂无单位信息')
const specialty = ref('暂无专业方向')
const tag = ref('暂无标签')
const avatarUrl = ref('')
const introduction = ref('这里展示医生简介、履历和研究方向。接口返回医生介绍时，将优先使用后端数据。')

const qaTitleOne = ref('医生答疑功能占位，后续可根据后端接口补充真实问答内容。')
const qaTitleTwo = ref('当前页面已优先展示医生基础信息，问答列表等待后端接口补充。')

const shortName = computed(() : string => {
	return doctorName.value.length > 0 ? doctorName.value.substring(0, 1) : '医'
})

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const goBack = () => {
	uni.navigateBack()
}

const applyExpertDetail = (detail : ExpertDetail) => {
	const nameText = safeText(detail.realName)
	const titleText = safeText(detail.title)
	const orgText = safeText(detail.organization)
	const specialtyText = safeText(detail.specialty)
	const introText = safeText(detail.introduction)
	const noticeText = safeText(detail.consultationNotice)
	const avatarText = safeText(detail.avatarUrl)

	if (nameText.length > 0) {
		doctorName.value = nameText
	}
	if (titleText.length > 0) {
		doctorTitle.value = titleText
	}
	if (orgText.length > 0) {
		organization.value = orgText
	}
	if (specialtyText.length > 0) {
		specialty.value = specialtyText
	}
	if (avatarText.length > 0) {
		avatarUrl.value = avatarText
	}
	if (noticeText.length > 0) {
		tag.value = noticeText
	}

	if (introText.length > 0) {
		introduction.value = introText
	} else if (detail.experiences != null && detail.experiences.length > 0) {
		const experienceText = detail.experiences
			.slice(0, 3)
			.map((item : ExpertExperience) : string => {
				const titleValue = safeText(item.title)
				const descValue = safeText(item.description)
				return titleValue.length > 0 ? (titleValue + (descValue.length > 0 ? '：' + descValue : '')) : descValue
			})
			.filter((item : string) : boolean => item.length > 0)
		if (experienceText.length > 0) {
			introduction.value = experienceText.join('；')
		}
	}
}

const loadParams = () => {
	const currentPages = getCurrentPages()
	if (currentPages.length > 0) {
		const currentPage = currentPages[currentPages.length - 1]
		if (currentPage.options != null) {
			const options = currentPage.options
			if (options['id'] != null) {
				detailId.value = options['id'] as string
			}
			if (options['name'] != null) {
				doctorName.value = decodeURIComponent(options['name'])
			}
			if (options['title'] != null) {
				doctorTitle.value = decodeURIComponent(options['title'])
			}
			if (options['organization'] != null) {
				organization.value = decodeURIComponent(options['organization'])
			}
			if (options['specialty'] != null) {
				specialty.value = decodeURIComponent(options['specialty'])
			}
			if (options['tag'] != null) {
				tag.value = decodeURIComponent(options['tag'])
			}
		}
	}

	if (detailId.value.length > 0) {
		fetchExpertDetail(
			detailId.value,
			(detail) => {
				applyExpertDetail(detail)
			},
			() => {}
		)
	}
}

onMounted(() => {
	loadParams()
})
</script>

<style>
.page {
	flex: 1;
	background-color: #f5f5fb;
}

.header {
	height: 96rpx;
	padding-left: 24rpx;
	padding-right: 24rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
}

.header-back {
	position: absolute;
	left: 20rpx;
	width: 68rpx;
	height: 68rpx;
	align-items: center;
	justify-content: center;
}

.header-back-icon {
	width: 24rpx;
	height: 24rpx;
}

.header-title {
	font-size: 22px;
	line-height: 32px;
	color: #2f2f2f;
	font-weight: 600;
}

.scroll {
	flex: 1;
}

.hero {
	height: 250rpx;
	position: relative;
	overflow: hidden;
}

.hero-bg {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	width: 750rpx;
	height: 250rpx;
	opacity: 0.95;
}

.avatar-shell {
	flex: 1;
	align-items: center;
	justify-content: center;
}

.avatar-image {
	width: 160rpx;
	height: 160rpx;
	border-radius: 80rpx;
	border-width: 8rpx;
	border-style: solid;
	border-color: #3dbfe2;
	margin-top: 20rpx;
}

.avatar-circle {
	width: 160rpx;
	height: 160rpx;
	border-radius: 80rpx;
	background-color: #d9eef8;
	border-width: 8rpx;
	border-style: solid;
	border-color: #3dbfe2;
	align-items: center;
	justify-content: center;
	margin-top: 20rpx;
}

.avatar-text {
	font-size: 54px;
	font-weight: 600;
	color: #2b829f;
}

.info-card {
	margin-left: 28rpx;
	margin-right: 28rpx;
	margin-top: 16rpx;
	padding-bottom: 12rpx;
}

.name-row {
	flex-direction: row;
	align-items: center;
}

.doctor-name {
	font-size: 24px;
	line-height: 34px;
	color: #2f2f2f;
	font-weight: 600;
}

.doctor-title {
	margin-left: 18rpx;
	font-size: 16px;
	line-height: 24px;
	color: #1db56f;
	font-weight: 600;
}

.meta-text {
	margin-top: 10rpx;
	font-size: 15px;
	line-height: 22px;
	color: #8a8f98;
}

.section {
	margin-left: 28rpx;
	margin-right: 28rpx;
	margin-top: 18rpx;
	padding-top: 6rpx;
}

.section-head {
	flex-direction: row;
	align-items: center;
}

.section-head-between {
	justify-content: space-between;
}

.section-head-left {
	flex-direction: row;
	align-items: center;
}

.section-line {
	width: 8rpx;
	height: 28rpx;
	border-radius: 8rpx;
	background-color: #18b775;
	margin-right: 14rpx;
}

.section-title {
	font-size: 19px;
	line-height: 28px;
	color: #2f2f2f;
	font-weight: 600;
}

.section-content {
	margin-top: 20rpx;
	font-size: 15px;
	line-height: 28px;
	color: #6e7680;
}

.more-text {
	font-size: 15px;
	line-height: 22px;
	color: #2f2f2f;
}

.qa-item {
	padding-top: 18rpx;
	padding-bottom: 18rpx;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ececec;
}

.qa-title {
	font-size: 16px;
	line-height: 26px;
	color: #2f2f2f;
}

.qa-row {
	margin-top: 10rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.qa-time {
	font-size: 13px;
	line-height: 18px;
	color: #9aa0a8;
}

.qa-status {
	font-size: 14px;
	line-height: 20px;
	color: #18b775;
}

.action-wrap {
	padding: 34rpx 28rpx 48rpx;
}

.consult-btn {
	height: 88rpx;
	border-radius: 14rpx;
	background-color: #18b775;
	color: #ffffff;
	font-size: 18px;
	line-height: 88rpx;
}
</style>
