<template>
	<view class="page">
		<view class="page-top-bg"></view>

		<view class="nav-back" @tap="goBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">专家详情</text>
		</view>

		<scroll-view class="scroll" scroll-y="true">
			<view class="hero-spacer"></view>

			<view class="hero-card">
				<view class="hero-overlay">
					<image
						v-if="avatarUrl.length > 0 && !avatarFailed"
						class="avatar-image"
						:src="avatarUrl"
						mode="aspectFill"
						@error="handleAvatarError"
					></image>
					<view v-else class="avatar-circle">
						<text class="avatar-text">{{ shortName }}</text>
					</view>

					<view class="hero-info">
						<view class="name-row">
							<text class="doctor-name">{{ doctorName }}</text>
							<text class="doctor-title">{{ doctorTitle }}</text>
						</view>
						<view class="meta-row">
							<text class="meta-label">单位：</text>
							<text class="meta-value">{{ organization }}</text>
						</view>
						<view class="meta-row">
							<text class="meta-label">专业方向：</text>
							<text class="meta-value">{{ specialty }}</text>
						</view>
						<view v-if="consultationNotice.length > 0" class="meta-row">
							<text class="meta-label">咨询须知：</text>
							<text class="meta-value">{{ consultationNotice }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="section-card">
				<view class="section-head">
					<view class="section-line"></view>
					<text class="section-title">履历介绍</text>
				</view>
				<text class="section-content">{{ introduction }}</text>
			</view>

			<view v-if="experienceItems.length > 0" class="section-card">
				<view class="section-head">
					<view class="section-line"></view>
					<text class="section-title">专家经历</text>
				</view>

				<view v-for="item in experienceItems" :key="item.id" class="experience-item">
					<text class="experience-title">{{ item.title }}</text>
					<text v-if="item.timeText.length > 0" class="experience-time">{{ item.timeText }}</text>
					<text v-if="item.description.length > 0" class="experience-description">{{ item.description }}</text>
				</view>
			</view>

			<view class="action-section">
				<button class="consult-btn" hover-class="consult-btn-hover" @click="goCreateQuestion">立即咨询</button>
				<button class="secondary-btn" hover-class="secondary-btn-hover" @click="goMyQuestions">我的咨询</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { computed, onMounted, ref } from 'vue'
import { fetchExpertDetail, normalizeAppUrl, type ExpertDetail, type ExpertExperience } from '../../utils/auth.uts'

type ExperienceDisplayItem = {
	id : number
	title : string
	timeText : string
	description : string
}

const expertStorageKey = 'consult_current_expert'
const detailId = ref('')
const doctorName = ref('专家详情')
const doctorTitle = ref('专家')
const organization = ref('暂无单位信息')
const specialty = ref('暂无专业方向')
const consultationNotice = ref('')
const avatarUrl = ref('')
const avatarFailed = ref(false)
const introduction = ref('这里展示专家简介、履历和研究方向。')
const experienceItems = ref<ExperienceDisplayItem[]>([])

const shortName = computed(() : string => {
	return doctorName.value.length > 0 ? doctorName.value.substring(0, 1) : '医'
})

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const sanitizeAvatarUrl = (value : string) : string => {
	const avatar = normalizeAppUrl(safeText(value))
	if (avatar.length == 0) {
		return ''
	}
	if (avatar.indexOf('example.com') >= 0) {
		return ''
	}
	return avatar
}

const formatDateRange = (startDate : string, endDate : string) : string => {
	const start = safeText(startDate)
	const end = safeText(endDate)
	if (start.length == 0 && end.length == 0) {
		return ''
	}
	if (start.length > 0 && end.length > 0) {
		return start + ' - ' + end
	}
	return start.length > 0 ? start : end
}

const goBack = () => {
	uni.navigateBack()
}

const handleAvatarError = () => {
	avatarFailed.value = true
	avatarUrl.value = ''
}

const mapExperience = (item : ExpertExperience) : ExperienceDisplayItem => {
	return {
		id: item.id,
		title: safeText(item.title),
		timeText: formatDateRange(item.startDate, item.endDate),
		description: safeText(item.description)
	}
}

const saveCurrentExpert = () => {
	uni.setStorageSync(expertStorageKey, {
		expertId: detailId.value,
		expertName: doctorName.value
	})
}

const applyExpertDetail = (detail : ExpertDetail) => {
	const nameText = safeText(detail.realName)
	const titleText = safeText(detail.title)
	const orgText = safeText(detail.organization)
	const specialtyText = safeText(detail.specialty)
	const introText = safeText(detail.introduction)
	const noticeText = safeText(detail.consultationNotice)
	const avatarText = sanitizeAvatarUrl(detail.avatarUrl)

	if (nameText.length > 0) {
		doctorName.value = nameText
	}
	if (titleText.length > 0) {
		doctorTitle.value = titleText
	}
	if (orgText.length > 0) {
		organization.value = orgText
	}
	if (specialtyText.length > 0) {
		specialty.value = specialtyText
	}
	avatarUrl.value = avatarText
	avatarFailed.value = avatarText.length == 0
	consultationNotice.value = noticeText

	if (introText.length > 0) {
		introduction.value = introText
	}

	experienceItems.value = detail.experiences != null ? detail.experiences
		.map((item : ExpertExperience) : ExperienceDisplayItem => {
			return mapExperience(item)
		})
		.filter((item : ExperienceDisplayItem) : boolean => item.title.length > 0 || item.description.length > 0) : []

	saveCurrentExpert()
}

const loadParams = () => {
	const currentPages = getCurrentPages()
	if (currentPages.length == 0) {
		return
	}

	const currentPage = currentPages[currentPages.length - 1]
	if (currentPage.options == null) {
		return
	}

	const options = currentPage.options
	if (options['id'] != null) {
		detailId.value = options['id'] as string
	}
	if (options['name'] != null) {
		doctorName.value = decodeURIComponent(options['name'])
	}
	if (options['title'] != null) {
		doctorTitle.value = decodeURIComponent(options['title'])
	}
	if (options['organization'] != null) {
		organization.value = decodeURIComponent(options['organization'])
	}
	if (options['specialty'] != null) {
		specialty.value = decodeURIComponent(options['specialty'])
	}
	if (options['tag'] != null) {
		consultationNotice.value = decodeURIComponent(options['tag'])
	}

	if (detailId.value.length > 0) {
		saveCurrentExpert()
	}
}

const loadExpertDetail = () => {
	if (detailId.value.length == 0) {
		return
	}

	fetchExpertDetail(
		detailId.value,
		(detail) => {
			applyExpertDetail(detail)
		},
		(message) => {
			if (message.length > 0) {
				uni.showToast({
					title: message,
					icon: 'none'
				})
			}
		}
	)
}

const goCreateQuestion = () => {
	saveCurrentExpert()
	uni.navigateTo({
		url:
			'/pages/consult/create?expertId=' + detailId.value +
			'&expertName=' + encodeURIComponent(doctorName.value)
	})
}

const goMyQuestions = () => {
	uni.navigateTo({ url: '/pages/consult/questions' })
}

onMounted(() => {
	loadParams()
	loadExpertDetail()
})
</script>

