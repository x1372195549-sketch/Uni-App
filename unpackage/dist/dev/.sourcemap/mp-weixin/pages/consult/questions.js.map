<template>
	<view class="page">
		<image class="top-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

		<view class="nav-back" @tap="goBack">
			<image class="nav-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
		</view>

		<view class="header">
			<text class="header-title">{{ pageTitleText }}</text>
		</view>

		<scroll-view class="scroll" scroll-y="true" @scrolltolower="loadMore">
			<view v-if="isLoading" class="state-wrap">
				<text class="state-text">{{ loadingText }}</text>
			</view>

			<view v-else-if="errorText.length > 0" class="state-wrap">
				<text class="state-text">{{ errorText }}</text>
				<button class="retry-btn" hover-class="retry-btn-hover" @tap="reloadQuestions">{{ retryText }}</button>
			</view>

			<view v-else-if="questionItems.length == 0" class="state-wrap">
				<text class="state-text">{{ emptyText }}</text>
				<button class="retry-btn" hover-class="retry-btn-hover" @tap="goConsultHome">{{ goConsultText }}</button>
			</view>

			<view v-else class="list-wrap">
				<view v-for="item in questionItems" :key="item.id" class="question-card" @tap="goDetail(item.id)">
					<view class="question-head">
						<text class="question-title">{{ item.title }}</text>
						<text class="status-tag" :class="item.statusClass">{{ item.statusLabel }}</text>
					</view>
					<text class="question-id">{{ questionIdLabel }}{{ item.idText }}</text>
					<text class="question-content">{{ item.content }}</text>
					<text v-if="item.answerPreview.length > 0" class="question-answer">{{ latestReplyText }}{{ item.answerPreview }}</text>
				</view>

				<view v-if="isListLoading" class="bottom-state">
					<text class="bottom-state-text">{{ loadingMoreText }}</text>
				</view>
				<view v-else-if="!hasMore" class="bottom-state">
					<text class="bottom-state-text">{{ noMoreText }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { fetchQaQuestions, type AppQaQuestion, type AppQaAnswer } from '../../utils/auth.uts'

type QuestionDisplayItem = {
	id : number
	idText : string
	title : string
	content : string
	statusLabel : string
	statusClass : string
	answerPreview : string
}

const PAGE_SIZE = 10
const questionStorageKey = 'consult_current_question_id'

const pageTitleText = '\u6211\u7684\u54a8\u8be2'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const emptyText = '\u6682\u65e0\u54a8\u8be2\u8bb0\u5f55'
const goConsultText = '\u53bb\u54a8\u8be2'
const loadingMoreText = '\u52a0\u8f7d\u66f4\u591a\u4e2d...'
const noMoreText = '\u6ca1\u6709\u66f4\u591a\u4e86'
const failedText = '\u54a8\u8be2\u8bb0\u5f55\u52a0\u8f7d\u5931\u8d25'
const untitledText = '\u672a\u547d\u540d\u54a8\u8be2'
const emptyContentText = '\u6682\u65e0\u95ee\u9898\u63cf\u8ff0'
const questionIdLabel = '\u54a8\u8be2ID\uff1a'
const latestReplyText = '\u6700\u65b0\u56de\u590d\uff1a'

const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')
const hasMore = ref(true)
const page = ref(1)
const questionItems = ref<QuestionDisplayItem[]>([])

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const mapStatusClass = (status : string) : string => {
	if (status == 'ANSWERED') {
		return 'status-answered'
	}
	if (status == 'CLOSED') {
		return 'status-closed'
	}
	return 'status-pending'
}

const saveCurrentQuestionId = (id : number) => {
	uni.setStorageSync(questionStorageKey, String(id))
}

const mapQuestion = (item : AppQaQuestion) : QuestionDisplayItem => {
	const firstAnswer = item.answers != null && item.answers.length > 0 ? item.answers[0] as AppQaAnswer : null
	const titleValue = safeText(item.title)
	const contentValue = safeText(item.content)
	const statusLabelValue = safeText(item.statusLabel).length > 0 ? safeText(item.statusLabel) : safeText(item.status)
	return {
		id: item.id,
		idText: item.id > 0 ? String(item.id) : '--',
		title: titleValue.length > 0 ? titleValue : untitledText,
		content: contentValue.length > 0 ? contentValue : emptyContentText,
		statusLabel: statusLabelValue.length > 0 ? statusLabelValue : '--',
		statusClass: mapStatusClass(safeText(item.status)),
		answerPreview: firstAnswer != null ? safeText(firstAnswer.content) : ''
	}
}

const loadQuestions = (loadMoreValue : boolean) => {
	if (!loadMoreValue) {
		page.value = 1
		hasMore.value = true
		errorText.value = ''
		isLoading.value = true
	} else {
		if (!hasMore.value || isListLoading.value) {
			return
		}
		isListLoading.value = true
	}

	fetchQaQuestions(
		page.value,
		PAGE_SIZE,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			const mapped = records.map((item : AppQaQuestion) : QuestionDisplayItem => {
				return mapQuestion(item)
			})

			if (loadMoreValue) {
				questionItems.value = questionItems.value.concat(mapped)
			} else {
				questionItems.value = mapped
			}

			hasMore.value = records.length >= PAGE_SIZE
			if (hasMore.value) {
				page.value += 1
			}

			isLoading.value = false
			isListLoading.value = false
		},
		(message) => {
			errorText.value = message.length > 0 ? message : failedText
			isLoading.value = false
			isListLoading.value = false
		}
	)
}

const reloadQuestions = () => {
	loadQuestions(false)
}

const goBack = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack({ delta: 1 })
		return
	}
	uni.switchTab({ url: '/pages/mine/index' })
}

const goConsultHome = () => {
	uni.redirectTo({ url: '/pages/consult/index' })
}

const loadMore = () => {
	loadQuestions(true)
}

const goDetail = (id : number) => {
	if (id <= 0) {
		uni.showToast({
			title: '\u672a\u80fd\u8bfb\u53d6\u54a8\u8be2ID',
			icon: 'none'
		})
		return
	}
	saveCurrentQuestionId(id)
	uni.navigateTo({
		url: '/pages/consult/question-detail?id=' + String(id)
	})
}

loadQuestions(false)
</script>

