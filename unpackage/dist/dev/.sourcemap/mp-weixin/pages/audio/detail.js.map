<template>
  <view class="page">
    <view class="detail-header">
      <view class="header-back" @tap="goBack">
        <image class="header-back-icon" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
      </view>
      <text class="detail-title">音频详情</text>
    </view>

    <scroll-view class="detail-scroll" scroll-y="true">
      <view class="detail-cover" @tap="toggleAudioPlayback">
        <image v-if="audioCoverUrl.length > 0" class="detail-cover-image" :src="audioCoverUrl" mode="aspectFill"></image>
        <view v-else class="detail-cover-placeholder"></view>
        <view class="audio-video-mask"></view>
        <view v-if="currentAudioItemId.length > 0" class="audio-play-button">
          <view v-if="!isAudioPlaying" class="audio-play-triangle"></view>
          <view v-else class="audio-pause-bars">
            <view class="audio-pause-bar"></view>
            <view class="audio-pause-bar"></view>
          </view>
        </view>
        <text v-if="currentAudioItemId.length > 0" class="audio-video-duration">{{ currentAudioDuration }}</text>
      </view>

      <view class="detail-tabs">
        <view class="tab-item" @tap="activeTab = 'intro'">
          <text :class="activeTab == 'intro' ? 'detail-tab detail-tab-active' : 'detail-tab'">简介</text>
          <view v-if="activeTab == 'intro'" class="tab-line"></view>
        </view>
        <view class="tab-item" @tap="activeTab = 'catalog'">
          <text :class="activeTab == 'catalog' ? 'detail-tab detail-tab-active' : 'detail-tab'">目录</text>
          <view v-if="activeTab == 'catalog'" class="tab-line"></view>
        </view>
        <view class="favorite-tab-btn" @tap="toggleFavorite">
          <text class="favorite-text" :class="isFavorited ? 'favorite-text-active' : ''">{{ isFavorited ? '已收藏' : '收藏' }}</text>
        </view>
      </view>

      <view v-if="activeTab == 'intro'" class="intro-panel">
        <text class="content-title">{{ audioTitle }}</text>
        <view class="content-stats">
          <text class="content-stat">学时 {{ viewCount }}</text>
          <text class="content-stat">收藏 {{ favoriteCount }}</text>
        </view>

        <text class="section-title">音频介绍</text>
        <text class="content-text">{{ audioSummary }}</text>
      </view>

      <view v-else class="catalog-panel">
        <view
          v-for="item in catalogItems"
          :key="item.id"
          class="catalog-item"
          :class="item.id == currentAudioItemId ? 'catalog-item-active' : ''"
          @tap="selectCatalogItem(item.id)"
        >
          <text class="catalog-title" :class="item.id == currentAudioItemId ? 'catalog-title-active' : ''">{{ item.title }}</text>
          <text class="catalog-duration" :class="item.id == currentAudioItemId ? 'catalog-duration-active' : ''">{{ item.duration }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { onMounted, ref } from 'vue'
import { onHide, onShow, onUnload } from '@dcloudio/uni-app'
import {
  checkFavoriteStatus,
  fetchAudioDetail,
  normalizeAppUrl,
  reportBrowseHistory,
  updateFavoriteStatus,
  type AppPodcast,
  type AppPodcastAudio
} from '../../utils/auth.uts'

type CatalogItem = {
  id : string
  title : string
  duration : string
  audioUrl : string
}

const RESOURCE_TYPE = 'podcast'

const audioId = ref('')
const activeTab = ref('intro')
const audioTitle = ref('音频详情')
const audioSummary = ref('这里展示音频简介内容。')
const audioCoverUrl = ref('')
const viewCount = ref('0')
const favoriteCount = ref('0')
const currentAudioItemId = ref('')
const currentAudioUrl = ref('')
const currentAudioTitle = ref('')
const currentAudioDuration = ref('00:00')
const isAudioPlaying = ref(false)
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)
const catalogItems = ref<CatalogItem[]>([])
let audioContext : InnerAudioContext | null = null

function safeText(value : string | null) : string {
  return value == null || value.length == 0 ? '' : value
}

function formatDuration(seconds : number) : string {
  const total = seconds > 0 ? seconds : 0
  const minute = Math.floor(total / 60)
  const second = total % 60
  const minuteText = minute < 10 ? '0' + String(minute) : String(minute)
  const secondText = second < 10 ? '0' + String(second) : String(second)
  return minuteText + ':' + secondText
}

function updateCatalogDuration(id : string, durationText : string) : void {
  catalogItems.value = catalogItems.value.map((item : CatalogItem) : CatalogItem => {
    if (item.id == id) {
      return {
        id: item.id,
        title: item.title,
        duration: durationText,
        audioUrl: item.audioUrl
      }
    }
    return item
  })
}

function syncRealAudioDuration(context : InnerAudioContext) : void {
  const duration = Math.floor(context.duration)
  if (duration > 0) {
    const durationText = formatDuration(duration)
    if (currentAudioDuration.value != durationText) {
      currentAudioDuration.value = durationText
      updateCatalogDuration(currentAudioItemId.value, durationText)
    }
  }
}

function normalizeAudioPlayUrl(url : string) : string {
  return normalizeAppUrl(url)
}

function releaseAudioContext() : void {
  if (audioContext != null) {
    audioContext!.stop()
    audioContext!.destroy()
    audioContext = null
  }
  isAudioPlaying.value = false
}

function prepareAudioContext() : void {
  releaseAudioContext()
  if (currentAudioUrl.value.length == 0) {
    return
  }

  uni.setInnerAudioOption({
    obeyMuteSwitch: false
  })

  const context = uni.createInnerAudioContext()
  context.src = currentAudioUrl.value
  context.autoplay = false
  context.onPlay(() => {
    isAudioPlaying.value = true
  })
  context.onPause(() => {
    isAudioPlaying.value = false
  })
  context.onStop(() => {
    isAudioPlaying.value = false
  })
  context.onEnded(() => {
    isAudioPlaying.value = false
  })
  context.onCanplay(() => {
    syncRealAudioDuration(context)
  })
  context.onTimeUpdate(() => {
    syncRealAudioDuration(context)
  })
  context.onError(() => {
    isAudioPlaying.value = false
    uni.showToast({
      title: '音频播放失败，请检查音频地址',
      icon: 'none'
    })
  })
  audioContext = context
}

function toggleAudioPlayback() : void {
  if (currentAudioUrl.value.length == 0 && currentAudioItemId.value.length > 0) {
    selectCatalogItem(currentAudioItemId.value)
  }
  if (currentAudioUrl.value.length == 0) {
    uni.showToast({
      title: '暂无可播放音频',
      icon: 'none'
    })
    return
  }
  uni.setInnerAudioOption({
    obeyMuteSwitch: false
  })
  if (audioContext == null) {
    prepareAudioContext()
  }
  if (audioContext == null) {
    return
  }
  if (isAudioPlaying.value) {
    audioContext!.pause()
  } else {
    audioContext!.play()
  }
}

function applyCurrentAudio(item : CatalogItem) : void {
  releaseAudioContext()
  currentAudioItemId.value = item.id
  currentAudioTitle.value = item.title
  currentAudioUrl.value = item.audioUrl
  currentAudioDuration.value = item.duration
}

function selectCatalogItem(id : string) : void {
  for (let i = 0; i < catalogItems.value.length; i++) {
    const item = catalogItems.value[i]
    if (item.id == id) {
      applyCurrentAudio(item)
      if (item.audioUrl.length == 0) {
        uni.showToast({
          title: '暂无可播放音频',
          icon: 'none'
        })
      }
      return
    }
  }
}

function loadFavoriteStatus() : void {
  if (audioId.value.length == 0) {
    return
  }

  checkFavoriteStatus(
    RESOURCE_TYPE,
    Number(audioId.value),
    (favorited) => {
      isFavorited.value = favorited
    },
    () => {
      isFavorited.value = false
    }
  )
}

function reportBrowse() : void {
  if (audioId.value.length == 0) {
    return
  }
  reportBrowseHistory(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(audioId.value)
    },
    () => {
    },
    () => {
    }
  )
}

function toggleFavorite() : void {
  if (audioId.value.length == 0 || isFavoriteLoading.value) {
    return
  }

  isFavoriteLoading.value = true
  updateFavoriteStatus(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(audioId.value),
      favorited: !isFavorited.value
    },
    (result) => {
      isFavorited.value = result.favorited
      favoriteCount.value = String(result.favoriteCount != null ? result.favoriteCount : 0)
      isFavoriteLoading.value = false
      uni.showToast({
        title: result.favorited ? '收藏成功' : '已取消收藏',
        icon: 'success'
      })
    },
    (message) => {
      isFavoriteLoading.value = false
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

function applyAudioDetail(detail : AppPodcast) : void {
  const titleText = safeText(detail.title)
  const summaryText = safeText(detail.summary)
  audioCoverUrl.value = safeText(detail.coverUrl)

  if (titleText.length > 0) {
    audioTitle.value = titleText
  }
  if (summaryText.length > 0) {
    audioSummary.value = summaryText
  }

  viewCount.value = String(detail.studySeconds != null ? detail.studySeconds : 0)

  if (detail.audios != null && detail.audios.length > 0) {
    catalogItems.value = detail.audios.map((item : AppPodcastAudio, index : number) : CatalogItem => {
      return {
        id: String(item.id),
        title: safeText(item.title).length > 0 ? item.title : '音频 ' + String(index + 1),
        duration: '--:--',
        audioUrl: normalizeAudioPlayUrl(safeText(item.audioUrl))
      }
    })
    currentAudioItemId.value = catalogItems.value[0].id
    currentAudioTitle.value = catalogItems.value[0].title
    currentAudioDuration.value = catalogItems.value[0].duration
    currentAudioUrl.value = ''
  } else {
    catalogItems.value = []
    currentAudioItemId.value = ''
    currentAudioTitle.value = ''
    currentAudioUrl.value = ''
    currentAudioDuration.value = '00:00'
    releaseAudioContext()
  }
}

function loadParams() : void {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    return
  }

  const currentPage = pages[pages.length - 1]
  if (currentPage == null || currentPage.options == null) {
    return
  }

  const options = currentPage.options as UTSJSONObject
  const idValue = options['id']
  if (typeof idValue == 'string' && idValue.length > 0) {
    audioId.value = idValue
  }
}

function loadAudioDetail() : void {
  if (audioId.value.length == 0) {
    return
  }

  fetchAudioDetail(
    audioId.value,
    (detail) => {
      applyAudioDetail(detail)
      reportBrowse()
    },
    (message) => {
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

function goBack() : void {
  const pages = getCurrentPages()
  if (pages.length > 1) {
    uni.navigateBack()
    return
  }
  uni.redirectTo({ url: '/pages/audio/index' })
}

onMounted(() => {
  loadParams()
  loadAudioDetail()
  loadFavoriteStatus()
})

onShow(() => {
  loadFavoriteStatus()
})

onHide(() => {
  releaseAudioContext()
})

onUnload(() => {
  releaseAudioContext()
})
</script>

<style>
.page {
  flex: 1;
  background-color: #f8f6f0;
}

.detail-header {
  height: calc(96rpx + var(--status-bar-height));
  padding-top: var(--status-bar-height);
  padding-left: 24rpx;
  padding-right: 24rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #ece9e1;
  position: relative;
}

.header-back {
  position: absolute;
  left: 20rpx;
  top: var(--status-bar-height);
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.header-back-icon {
  width: 24rpx;
  height: 24rpx;
}

.detail-title {
  font-size: 18px;
  line-height: 28px;
  color: #1f1f1f;
  font-weight: 600;
}

.detail-scroll {
  flex: 1;
}

.detail-cover {
  position: relative;
  height: 420rpx;
  align-items: center;
  justify-content: center;
  background-color: #000000;
  overflow: hidden;
}

.detail-cover-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 420rpx;
}

.detail-cover-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 420rpx;
  background-color: #e7d7c6;
}

.audio-video-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.12);
}

.audio-play-button {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background-color: rgba(255, 255, 255, 0.46);
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.audio-play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top-width: 24rpx;
  border-top-style: solid;
  border-top-color: transparent;
  border-bottom-width: 24rpx;
  border-bottom-style: solid;
  border-bottom-color: transparent;
  border-left-width: 34rpx;
  border-left-style: solid;
  border-left-color: rgba(255, 255, 255, 0.94);
}

.audio-pause-bars {
  width: 38rpx;
  height: 44rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.audio-pause-bar {
  width: 12rpx;
  height: 44rpx;
  border-radius: 6rpx;
  background-color: rgba(255, 255, 255, 0.94);
}

.audio-video-duration {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 15px;
  line-height: 22px;
  color: #ffffff;
  text-align: right;
  z-index: 2;
}

.audio-disc {
  border-radius: 999px;
  background-color: #fffefc;
  align-items: center;
  justify-content: center;
}

.audio-disc-large {
  width: 120px;
  height: 120px;
}

.audio-disc-center {
  border-radius: 999px;
  background-color: #e4c09c;
}

.audio-disc-center-large {
  width: 34px;
  height: 34px;
}

.detail-tabs {
  height: 64px;
  padding: 0 24px;
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
}

.tab-item {
  margin-right: 32rpx;
  align-items: center;
  justify-content: center;
}

.detail-tab {
  font-size: 17px;
  color: #a5a5a5;
}

.detail-tab-active {
  color: #222222;
  font-weight: 700;
}

.tab-line {
  margin-top: 10rpx;
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #c46b76;
}

.favorite-tab-btn {
  margin-left: auto;
  min-width: 108rpx;
  height: 56rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
  border-radius: 28rpx;
  background-color: #f4efe7;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.favorite-text {
  font-size: 24rpx;
  color: #8f8f8f;
}

.favorite-text-active {
  color: #c46b76;
  font-weight: 600;
}

.intro-panel {
  padding: 28px 22px 32px;
  background-color: #ffffff;
}

.content-title {
  display: block;
  text-align: center;
  font-size: 18px;
  line-height: 28px;
  color: #1f1f1f;
  font-weight: 700;
}

.content-stats {
  margin-top: 18px;
  flex-direction: row;
  justify-content: flex-end;
}

.content-stat {
  margin-left: 18px;
  font-size: 14px;
  color: #a8a8a8;
}

.section-title {
  display: block;
  margin-top: 26px;
  font-size: 16px;
  color: #222222;
}

.content-text {
  display: block;
  margin-top: 18px;
  font-size: 15px;
  line-height: 30px;
  color: #8f8f8f;
}

.catalog-panel {
  padding-bottom: 24px;
  background-color: #ffffff;
}

.catalog-item {
  min-height: 72px;
  padding: 0 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #f0f0f0;
}

.catalog-item-active {
  background-color: #f7f3eb;
}

.catalog-title {
  flex: 1;
  margin-right: 12px;
  font-size: 15px;
  line-height: 24px;
  color: #303030;
}

.catalog-title-active {
  color: #c46b76;
  font-weight: 600;
}

.catalog-duration {
  font-size: 14px;
  color: #a0a0a0;
}

.catalog-duration-active {
  color: #c46b76;
}
</style>
