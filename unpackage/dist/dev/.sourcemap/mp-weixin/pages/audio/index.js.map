<template>
  <view class="page">
    <view class="hero-shell">
      <image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

      <view class="header">
        <text class="header-title">江苏中医在线</text>
      </view>

      <view class="top-tabs">
        <view class="top-tab" @click="goLearningPage">
          <text class="top-tab-text">首页</text>
        </view>
        <view class="top-tab top-tab-active">
          <text class="top-tab-text top-tab-text-active">音频</text>
          <view class="top-tab-line"></view>
        </view>
        <view class="top-tab" @click="goLivePage">
          <text class="top-tab-text">直播</text>
        </view>
        <view class="top-tab" @click="goCoursePage">
          <text class="top-tab-text">课程</text>
        </view>
        <view class="top-tab" @click="goNewsPage">
          <text class="top-tab-text">资讯</text>
        </view>
      </view>
    </view>

    <scroll-view class="content" scroll-y="true">
      <view class="content-shell">
        <view class="audio-card" v-for="item in audioItems" :key="item.id" @click="goAudioDetail(item.id)">
          <view class="audio-cover-shell">
            <view class="audio-cover">
              <text class="cover-title">{{ item.coverTitle }}</text>
              <text class="cover-subtitle">{{ item.coverSubtitle }}</text>
              <view class="audio-disc">
                <view class="audio-disc-center"></view>
              </view>
            </view>
          </view>

          <view class="audio-info">
            <text class="audio-title">{{ item.title }}</text>
            <view class="audio-meta">
              <text class="teacher-name">{{ item.teacher }}</text>
              <view class="stats">
                <text class="stat-text">浏览 {{ item.views }}</text>
                <text class="stat-text">评论 {{ item.comments }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="tabbar">
      <view class="tab-item tab-item-active">
        <image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
        <text class="tab-label tab-label-active">学习</text>
      </view>
      <view class="tab-item" @click="goExamPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">考核</text>
      </view>
      <view class="tab-item" @click="goConsultPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
        <text class="tab-label">咨询</text>
      </view>
      <view class="tab-item" @click="goKnowledgePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">知识库</text>
      </view>
      <view class="tab-item" @click="goMinePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">我的</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

type ApiResponse<T> = {
  success: boolean
  code?: string
  message?: string
  data?: T | null
}

type PageResponse<T> = {
  records?: T[]
  total?: number
  page?: number
  size?: number
}

type AppPodcastAudio = {
  id: number
  podcastId: number
  title: string
  audioUrl: string
  durationSeconds: number
  sortOrder: number
}

type AppPodcast = {
  id: number
  title: string
  summary: string
  coverUrl: string
  publishedAt: string
  progressPercent: number
  studySeconds: number
  audios: AppPodcastAudio[]
}

type AudioCardItem = {
  id: string
  coverTitle: string
  coverSubtitle: string
  title: string
  teacher: string
  views: string
  comments: string
}

const BASE_URL = 'https://api-test.arez.cc.cd'
const ACCESS_TOKEN_KEY = 'app_auth_access_token'
const TOKEN_TYPE_KEY = 'app_auth_token_type'

const placeholderItems: AudioCardItem[] = [
  {
    id: '1',
    coverTitle: '音频封面占位',
    coverSubtitle: '第一条音频',
    title: '音频标题占位一，点击进入音频详情页面',
    teacher: '讲师名称占位',
    views: '1200',
    comments: '320'
  },
  {
    id: '2',
    coverTitle: '音频封面占位',
    coverSubtitle: '第二条音频',
    title: '音频标题占位二，点击进入音频详情页面',
    teacher: '讲师名称占位',
    views: '1200',
    comments: '320'
  }
]

const audioItems = ref<AudioCardItem[]>([])

function safeText(value: string | null): string {
  return value == null || value.length == 0 ? '' : value
}

function safeNumberText(value: number | null): string {
  return value == null ? '0' : String(value)
}

function getAuthorization(): string {
  const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
  const tokenType = uni.getStorageSync(TOKEN_TYPE_KEY)
  if (typeof token === 'string' && token.length > 0) {
    if (typeof tokenType === 'string' && tokenType.length > 0) {
      return tokenType + ' ' + token
    }
    return 'Bearer ' + token
  }
  return ''
}

function mapPodcastToCard(item: AppPodcast, index: number): AudioCardItem {
  const firstAudio = item.audios != null && item.audios.length > 0 ? item.audios[0] : null
  const summary = safeText(item.summary)
  return {
    id: String(item.id),
    coverTitle: safeText(item.title).length > 0 ? safeText(item.title) : '音频封面占位',
    coverSubtitle: firstAudio != null && safeText(firstAudio.title).length > 0
      ? safeText(firstAudio.title)
      : '第' + String(index + 1) + '条音频',
    title: safeText(item.title).length > 0 ? safeText(item.title) : '音频标题占位',
    teacher: summary.length > 0 ? summary : '音频简介占位',
    views: safeNumberText(item.studySeconds),
    comments: safeNumberText(item.audios != null ? item.audios.length : 0)
  }
}

function fetchAudioItems(): void {
  const headers: UTSJSONObject = {
    'Content-Type': 'application/json'
  }
  const authorization = getAuthorization()
  if (authorization.length > 0) {
    headers['Authorization'] = authorization
  }

  uni.request({
    url: BASE_URL + '/api/v1/app/learning/podcasts?page=1&size=20',
    method: 'GET',
    header: headers,
    success: (res) => {
      const data = res.data as ApiResponse<PageResponse<AppPodcast>>
      if (
        res.statusCode == 200 &&
        data != null &&
        data.success &&
        data.data != null &&
        data.data.records != null &&
        data.data.records!.length > 0
      ) {
        audioItems.value = data.data.records!.map((item: AppPodcast, index: number): AudioCardItem => {
          return mapPodcastToCard(item, index)
        })
      } else {
        audioItems.value = placeholderItems
      }
    },
    fail: () => {
      audioItems.value = placeholderItems
    }
  })
}

function goLearningPage() {
  uni.redirectTo({ url: '/pages/index/index' })
}

function goLivePage() {
  uni.redirectTo({ url: '/pages/live/index' })
}

function goCoursePage() {
  uni.redirectTo({ url: '/pages/course/index' })
}

function goNewsPage() {
  uni.redirectTo({ url: '/pages/news/index' })
}

function goMinePage() {
	uni.redirectTo({ url: '/pages/mine/index' })
}

function goExamPage() {
	uni.redirectTo({ url: '/pages/exam/index' })
}

function goAudioDetail(id: string) {
  uni.navigateTo({ url: '/pages/audio/detail?id=' + id })
}

function goKnowledgePage() {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

function goConsultPage() {
	uni.redirectTo({ url: '/pages/consult/index' })
}

fetchAudioItems()
</script>

<style>
.page {
  flex: 1;
  background-color: #f7f7f2;
}

.hero-shell {
  position: relative;
  height: 236rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 236rpx;
}

.header {
  position: relative;
  z-index: 1;
  padding-top: 34rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 20px;
  line-height: 30px;
  color: #2f2f2f;
  font-weight: 600;
}

.top-tabs {
  position: relative;
  z-index: 1;
  height: 96rpx;
  margin-top: 18rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
  background-color: rgba(251, 250, 246, 0.78);
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: rgba(229, 234, 225, 0.95);
}

.top-tab {
  min-width: 88rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
}

.top-tab-active {
  position: relative;
}

.top-tab-text {
  font-size: 18px;
  line-height: 26px;
  color: #333333;
}

.top-tab-text-active {
  color: #b85d69;
  font-weight: 600;
}

.top-tab-line {
  position: absolute;
  bottom: 10rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background-color: #b85d69;
}

.content {
  flex: 1;
  padding-bottom: 110rpx;
}

.content-shell {
  padding-left: 20rpx;
  padding-right: 20rpx;
  padding-top: 24rpx;
  padding-bottom: 40rpx;
}

.audio-card {
  margin-bottom: 22rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  overflow: hidden;
  box-shadow: 0 12rpx 24rpx rgba(110, 100, 80, 0.05);
}

.audio-cover-shell {
  padding: 0;
  background-color: #f1e3cf;
}

.audio-cover {
  height: 260rpx;
  position: relative;
  padding-left: 44rpx;
  padding-top: 48rpx;
  background-color: #f4e4cf;
}

.cover-title {
  font-size: 28px;
  line-height: 38px;
  color: #b9702f;
  font-weight: 600;
}

.cover-subtitle {
  margin-top: 16rpx;
  font-size: 18px;
  line-height: 26px;
  color: #8d6e4d;
}

.audio-disc {
  position: absolute;
  right: 54rpx;
  top: 52rpx;
  width: 148rpx;
  height: 148rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.92);
  align-items: center;
  justify-content: center;
}

.audio-disc-center {
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background-color: rgba(185, 112, 47, 0.42);
}

.audio-info {
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.audio-title {
  font-size: 18px;
  line-height: 28px;
  color: #252525;
  font-weight: 600;
}

.audio-meta {
  margin-top: 18rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.teacher-name {
  font-size: 15px;
  line-height: 22px;
  color: #a8a8a8;
}

.stats {
  flex-direction: row;
  align-items: center;
}

.stat-text {
  font-size: 13px;
  line-height: 20px;
  color: #a0a0a0;
  margin-left: 18rpx;
}

.tabbar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 96rpx;
  padding-bottom: 8rpx;
  background-color: rgba(255, 255, 255, 0.98);
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #e9e9e4;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  align-items: center;
  justify-content: center;
}

.tab-item-active {
  margin-top: -2rpx;
}

.tab-icon-image {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 6rpx;
}

.tab-label {
  font-size: 11px;
  line-height: 16px;
  color: #b1b1b1;
}

.tab-label-active {
  color: #18b775;
}
</style>
