<template>
  <view class="page">
    <view class="hero-shell">
      <image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

      <view class="header">
        <text class="header-title">江苏中医在线</text>
      </view>

      <view class="top-tabs">
        <view class="top-tab" @click="goLearningPage">
          <text class="top-tab-text">首页</text>
        </view>
        <view class="top-tab" @click="goTopicsPage">
          <text class="top-tab-text">专题</text>
        </view>
        <view class="top-tab top-tab-active">
          <text class="top-tab-text top-tab-text-active">音频</text>
          <view class="top-tab-line"></view>
        </view>
        <view class="top-tab" @click="goLivePage">
          <text class="top-tab-text">直播</text>
        </view>
        <view class="top-tab" @click="goCoursePage">
          <text class="top-tab-text">课程</text>
        </view>
        <view class="top-tab" @click="goNewsPage">
          <text class="top-tab-text">资讯</text>
        </view>
      </view>
    </view>

    <view class="search-bar">
      <input
        v-model="keyword"
        class="search-input"
        placeholder="搜索标题、讲师、摘要"
        confirm-type="search"
        @confirm="reloadList"
      />
      <view class="search-btn" @tap="reloadList">
        <text class="search-btn-text">搜索</text>
      </view>
    </view>

    <scroll-view class="content" scroll-y="true" @scrolltolower="loadMore">
      <view class="content-shell">
        <view v-if="isLoading" class="state-wrap">
          <text class="state-text">加载中...</text>
        </view>

        <view v-else-if="errorText.length > 0" class="state-wrap">
          <text class="state-text">{{ errorText }}</text>
          <view class="search-btn retry-btn" @tap="reloadList">
            <text class="search-btn-text">重新加载</text>
          </view>
        </view>

        <view v-else-if="audioItems.length == 0" class="state-wrap">
          <text class="state-text">暂无音频</text>
        </view>

        <view v-else class="list-wrap">
        <view class="audio-card" v-for="item in audioItems" :key="item.id" @click="goAudioDetail(item.id)">
          <view class="audio-cover-shell">
            <view class="audio-cover">
              <text class="cover-title">{{ item.coverTitle }}</text>
              <text class="cover-subtitle">{{ item.coverSubtitle }}</text>
              <view class="audio-disc">
                <view class="audio-disc-center"></view>
              </view>
            </view>
          </view>

          <view class="audio-info">
            <text class="audio-title">{{ item.title }}</text>
            <view class="audio-meta">
              <text class="teacher-name">{{ item.teacher }}</text>
              <view class="stats">
                <text class="stat-text">浏览 {{ item.views }}</text>
                <text class="stat-text">评论 {{ item.comments }}</text>
              </view>
            </view>
          </view>
        </view>
        <view v-if="isListLoading" class="bottom-state">
          <text class="bottom-state-text">加载更多中...</text>
        </view>
        <view v-else-if="!hasMore" class="bottom-state">
          <text class="bottom-state-text">没有更多了</text>
        </view>
        </view>
      </view>
    </scroll-view>

    <view class="tabbar">
      <view class="tab-item tab-item-active">
        <image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
        <text class="tab-label tab-label-active">学习</text>
      </view>
      <view class="tab-item" @click="goExamPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">考核</text>
      </view>
      <view class="tab-item" @click="goConsultPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
        <text class="tab-label">咨询</text>
      </view>
      <view class="tab-item" @click="goKnowledgePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">知识库</text>
      </view>
      <view class="tab-item" @click="goMinePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">我的</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'

type ApiResponse<T> = {
  success: boolean
  code?: string
  message?: string
  data?: T | null
}

type PageResponse<T> = {
  records?: T[]
  total?: number
  page?: number
  size?: number
}

type AppPodcastAudio = {
  id: number
  podcastId: number
  title: string
  audioUrl: string
  durationSeconds: number
  sortOrder: number
}

type AppPodcast = {
  id: number
  title: string
  summary: string
  coverUrl: string
  publishedAt: string
  progressPercent: number
  studySeconds: number
  audios: AppPodcastAudio[]
}

type AudioCardItem = {
  id: string
  coverTitle: string
  coverSubtitle: string
  title: string
  teacher: string
  views: string
  comments: string
}

const BASE_URL = 'https://api-test.arez.cc.cd'
const ACCESS_TOKEN_KEY = 'app_auth_access_token'
const TOKEN_TYPE_KEY = 'app_auth_token_type'
const PAGE_SIZE = 10

const placeholderItems: AudioCardItem[] = [
  {
    id: '1',
    coverTitle: '音频封面占位',
    coverSubtitle: '第一条音频',
    title: '音频标题占位一，点击进入音频详情页面',
    teacher: '讲师名称占位',
    views: '1200',
    comments: '320'
  },
  {
    id: '2',
    coverTitle: '音频封面占位',
    coverSubtitle: '第二条音频',
    title: '音频标题占位二，点击进入音频详情页面',
    teacher: '讲师名称占位',
    views: '1200',
    comments: '320'
  }
]

const audioItems = ref<AudioCardItem[]>([])
const keyword = ref('')
const page = ref(1)
const hasMore = ref(true)
const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')

function safeText(value: string | null): string {
  return value == null || value.length == 0 ? '' : value
}

function safeNumberText(value: number | null): string {
  return value == null ? '0' : String(value)
}

function getAuthorization(): string {
  const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
  const tokenType = uni.getStorageSync(TOKEN_TYPE_KEY)
  if (typeof token === 'string' && token.length > 0) {
    if (typeof tokenType === 'string' && tokenType.length > 0) {
      return tokenType + ' ' + token
    }
    return 'Bearer ' + token
  }
  return ''
}

function mapPodcastToCard(item: AppPodcast, index: number): AudioCardItem {
  const firstAudio = item.audios != null && item.audios.length > 0 ? item.audios[0] : null
  const summary = safeText(item.summary)
  return {
    id: String(item.id),
    coverTitle: safeText(item.title).length > 0 ? safeText(item.title) : '音频封面占位',
    coverSubtitle: firstAudio != null && safeText(firstAudio.title).length > 0
      ? safeText(firstAudio.title)
      : '第' + String(index + 1) + '条音频',
    title: safeText(item.title).length > 0 ? safeText(item.title) : '音频标题占位',
    teacher: summary.length > 0 ? summary : '音频简介占位',
    views: safeNumberText(item.studySeconds),
    comments: safeNumberText(item.audios != null ? item.audios.length : 0)
  }
}

function fetchAudioItems(loadMoreValue: boolean): void {
  if (!loadMoreValue) {
    page.value = 1
    hasMore.value = true
    errorText.value = ''
    isLoading.value = true
  } else {
    if (!hasMore.value || isListLoading.value) {
      return
    }
    isListLoading.value = true
  }
  const headers: UTSJSONObject = {
    'Content-Type': 'application/json'
  }
  const authorization = getAuthorization()
  if (authorization.length > 0) {
    headers['Authorization'] = authorization
  }

  uni.request({
    url: BASE_URL + '/api/v1/app/learning/podcasts?page=' + String(page.value) + '&size=' + String(PAGE_SIZE) + (keyword.value.length > 0 ? '&keyword=' + encodeURIComponent(keyword.value) : ''),
    method: 'GET',
    header: headers,
    success: (res) => {
      const data = res.data as ApiResponse<PageResponse<AppPodcast>>
      if (
        res.statusCode == 200 &&
        data != null &&
        data.success &&
        data.data != null &&
        data.data.records != null
      ) {
        const mapped = data.data.records!.map((item: AppPodcast, index: number): AudioCardItem => {
          return mapPodcastToCard(item, index)
        })
        if (loadMoreValue) {
          audioItems.value = audioItems.value.concat(mapped)
        } else {
          audioItems.value = mapped
        }
        hasMore.value = mapped.length >= PAGE_SIZE
        if (hasMore.value) {
          page.value += 1
        }
      } else {
        if (!loadMoreValue) {
          audioItems.value = []
        }
        hasMore.value = false
        errorText.value = data != null && data.message != null && data.message!.length > 0
          ? data.message!
          : '闊抽鍔犺浇澶辫触'
      }
      isLoading.value = false
      isListLoading.value = false
    },
    fail: () => {
      errorText.value = '音频加载失败'
      isLoading.value = false
      isListLoading.value = false
    }
  })
}

function reloadList(): void {
  fetchAudioItems(false)
}

function loadMore(): void {
  fetchAudioItems(true)
}

function goLearningPage() {
  uni.redirectTo({ url: '/pages/index/index' })
}

function goTopicsPage() {
  uni.redirectTo({ url: '/pages/topics/list' })
}

function goLivePage() {
  uni.redirectTo({ url: '/pages/live/index' })
}

function goCoursePage() {
  uni.redirectTo({ url: '/pages/course/index' })
}

function goNewsPage() {
  uni.redirectTo({ url: '/pages/news/index' })
}

function goMinePage() {
	uni.redirectTo({ url: '/pages/mine/index' })
}

function goExamPage() {
	uni.redirectTo({ url: '/pages/exam/index' })
}

function goAudioDetail(id: string) {
  uni.navigateTo({ url: '/pages/audio/detail?id=' + id })
}

function goKnowledgePage() {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

function goConsultPage() {
	uni.redirectTo({ url: '/pages/consult/index' })
}

fetchAudioItems(false)
</script>

<style>
