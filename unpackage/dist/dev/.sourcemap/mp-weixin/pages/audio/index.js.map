<template>
  <view class="page">
    <view class="hero-shell">
      <image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>
      <view class="header">
        <text class="header-title">{{ appTitleText }}</text>
      </view>

      <view class="top-tabs">
        <view class="top-tab" @tap="goLearningPage">
          <text class="top-tab-text">{{ homeTabText }}</text>
        </view>
        <view class="top-tab" @tap="goTopicsPage">
          <text class="top-tab-text">{{ topicsTabText }}</text>
        </view>
        <view class="top-tab top-tab-active">
          <text class="top-tab-text top-tab-text-active">{{ pageTitleText }}</text>
          <view class="top-tab-line"></view>
        </view>
        <view class="top-tab" @tap="goLivePage">
          <text class="top-tab-text">{{ liveTabText }}</text>
        </view>
        <view class="top-tab" @tap="goCoursePage">
          <text class="top-tab-text">{{ courseTabText }}</text>
        </view>
        <view class="top-tab" @tap="goNewsPage">
          <text class="top-tab-text">{{ newsTabText }}</text>
        </view>
      </view>
    </view>

    <view class="search-bar">
      <input
        v-model="keyword"
        class="search-input"
        :placeholder="searchPlaceholder"
        confirm-type="search"
        @confirm="reloadList"
      />
      <view class="search-btn" @tap="reloadList">
        <text class="search-btn-text">{{ searchText }}</text>
      </view>
    </view>

    <scroll-view class="content" scroll-y="true" @scrolltolower="loadMore">
      <view class="content-shell">
        <view v-if="isLoading" class="state-wrap">
          <text class="state-text">{{ loadingText }}</text>
        </view>

        <view v-else-if="errorText.length > 0" class="state-wrap">
          <text class="state-text">{{ errorText }}</text>
          <view class="retry-btn" @tap="reloadList">
            <text class="retry-btn-text">{{ retryText }}</text>
          </view>
        </view>

        <view v-else-if="audioItems.length == 0" class="state-wrap">
          <text class="state-text">{{ emptyText }}</text>
        </view>

        <view v-else class="list-wrap">
          <view class="audio-card" v-for="item in audioItems" :key="item.id" @tap="goAudioDetail(item.id)">
            <view class="audio-cover-shell">
              <image v-if="item.coverUrl.length > 0" class="audio-cover-image" :src="item.coverUrl" mode="aspectFill"></image>
              <view v-else class="audio-cover">
                <text class="cover-title">{{ item.coverTitle }}</text>
                <text class="cover-subtitle">{{ item.coverSubtitle }}</text>
                <view class="audio-disc">
                  <view class="audio-disc-center"></view>
                </view>
              </view>
            </view>

            <view class="audio-info">
              <text class="audio-title">{{ item.title }}</text>
              <view class="audio-meta">
                <text class="teacher-name">{{ item.teacher }}</text>
                <view class="stats">
                  <text class="stat-text">{{ viewText }} {{ item.views }}</text>
                  <text class="stat-text">{{ commentText }} {{ item.comments }}</text>
                </view>
              </view>
            </view>
          </view>

          <view v-if="isListLoading" class="bottom-state">
            <text class="bottom-state-text">{{ loadingMoreText }}</text>
          </view>
          <view v-else-if="!hasMore" class="bottom-state">
            <text class="bottom-state-text">{{ noMoreText }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="tabbar">
      <view class="tab-item tab-item-active">
        <image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
        <text class="tab-label tab-label-active">{{ learningTabText }}</text>
      </view>
      <view class="tab-item" @tap="goExamPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">{{ examTabText }}</text>
      </view>
      <view class="tab-item" @tap="goConsultPage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
        <text class="tab-label">{{ consultTabText }}</text>
      </view>
      <view class="tab-item" @tap="goKnowledgePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">{{ knowledgeTabText }}</text>
      </view>
      <view class="tab-item" @tap="goMinePage">
        <image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
        <text class="tab-label">{{ mineTabText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { type AppPodcast } from '../../utils/auth.uts'

type AudioCardItem = {
  id : string
  coverUrl : string
  coverTitle : string
  coverSubtitle : string
  title : string
  teacher : string
  views : string
  comments : string
}

const PAGE_SIZE = 10

const appTitleText = '\u6c5f\u82cf\u4e2d\u533b\u5728\u7ebf'
const homeTabText = '\u9996\u9875'
const topicsTabText = '\u4e13\u9898'
const pageTitleText = '\u97f3\u9891'
const liveTabText = '\u76f4\u64ad'
const courseTabText = '\u8bfe\u7a0b'
const newsTabText = '\u8d44\u8baf'
const learningTabText = '\u5b66\u4e60'
const examTabText = '\u8003\u6838'
const consultTabText = '\u54a8\u8be2'
const knowledgeTabText = '\u77e5\u8bc6\u5e93'
const mineTabText = '\u6211\u7684'
const searchPlaceholder = '\u641c\u7d22\u6807\u9898\u3001\u8bb2\u5e08\u3001\u6458\u8981'
const searchText = '\u641c\u7d22'
const loadingText = '\u52a0\u8f7d\u4e2d...'
const retryText = '\u91cd\u65b0\u52a0\u8f7d'
const emptyText = '\u6682\u65e0\u97f3\u9891'
const loadingMoreText = '\u52a0\u8f7d\u66f4\u591a\u4e2d...'
const noMoreText = '\u6ca1\u6709\u66f4\u591a\u4e86'
const loadFailedText = '\u8bf7\u6c42\u5931\u8d25\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5'
const viewText = '\u6d4f\u89c8'
const commentText = '\u8bc4\u8bba'
const fallbackCoverTitle = '\u97f3\u9891\u5c01\u9762'
const fallbackTitle = '\u97f3\u9891\u6807\u9898'
const fallbackTeacher = '\u6682\u65e0\u7b80\u4ecb'

const audioItems = ref<AudioCardItem[]>([])
const keyword = ref('')
const page = ref(1)
const hasMore = ref(true)
const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')
const hasLoadedOnce = ref(false)

const safeText = (value : string | null) : string => {
  return value == null || value.length == 0 ? '' : value
}

type ApiResponse<T> = {
  success : boolean
  code ?: string
  message ?: string
  data ?: T | null
}

type PageResponse<T> = {
  records ?: T[]
  total ?: number
  page ?: number
  size ?: number
}

const BASE_URL = 'https://api-test.arez.cc.cd'
const ACCESS_TOKEN_KEY = 'app_auth_access_token'
const TOKEN_TYPE_KEY = 'app_auth_token_type'

const getAuthorization = () : string => {
  const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
  const tokenType = uni.getStorageSync(TOKEN_TYPE_KEY)
  if (typeof token === 'string' && token.length > 0) {
    if (typeof tokenType === 'string' && tokenType.length > 0) {
      return tokenType + ' ' + token
    }
    return 'Bearer ' + token
  }
  return ''
}

const mapAudioItem = (item : AppPodcast, index : number) : AudioCardItem => {
  const title = safeText(item.title)
  const summary = safeText(item.summary)
  const firstAudio = item.audios != null && item.audios.length > 0 ? item.audios[0] : null
  return {
    id: String(item.id),
    coverUrl: safeText(item.coverUrl),
    coverTitle: title.length > 0 ? title : fallbackCoverTitle,
    coverSubtitle: firstAudio != null && safeText(firstAudio.title).length > 0
      ? safeText(firstAudio.title)
      : '\u7b2c' + String(index + 1) + '\u6761\u97f3\u9891',
    title: title.length > 0 ? title : fallbackTitle,
    teacher: summary.length > 0 ? summary : fallbackTeacher,
    views: String(item.studySeconds),
    comments: String(item.audios != null ? item.audios.length : 0)
  }
}

const loadAudioItems = (loadMoreValue : boolean) => {
  if (!loadMoreValue) {
    page.value = 1
    hasMore.value = true
    errorText.value = ''
    isLoading.value = true
  } else {
    if (!hasMore.value || isListLoading.value) {
      return
    }
    isListLoading.value = true
  }

  const headers : UTSJSONObject = {
    'Content-Type': 'application/json'
  }
  const authorization = getAuthorization()
  if (authorization.length > 0) {
    headers['Authorization'] = authorization
  }

  uni.request({
    url: BASE_URL + '/api/v1/app/learning/podcasts?page=' + String(page.value) + '&size=' + String(PAGE_SIZE) + (keyword.value.length > 0 ? '&keyword=' + encodeURIComponent(keyword.value) : ''),
    method: 'GET',
    header: headers,
    success: (res) => {
      const data = res.data as ApiResponse<PageResponse<AppPodcast>>
      if (
        res.statusCode == 200 &&
        data != null &&
        data.success &&
        data.data != null &&
        data.data.records != null
      ) {
        const records = data.data.records != null ? data.data.records! : []
        const mapped = records.map((item : AppPodcast, index : number) : AudioCardItem => {
          return mapAudioItem(item, loadMoreValue ? audioItems.value.length + index : index)
        })
        if (loadMoreValue) {
          audioItems.value = audioItems.value.concat(mapped)
        } else {
          audioItems.value = mapped
        }
        hasMore.value = records.length >= PAGE_SIZE
        if (hasMore.value) {
          page.value += 1
        }
      } else {
        if (!loadMoreValue) {
          audioItems.value = []
        }
        hasMore.value = false
        errorText.value = data != null && data.message != null && data.message!.length > 0
          ? data.message!
          : loadFailedText
      }
      isLoading.value = false
      isListLoading.value = false
    },
    fail: () => {
      errorText.value = loadFailedText
      isLoading.value = false
      isListLoading.value = false
    }
  })
}

const reloadList = () => {
  loadAudioItems(false)
}

const loadMore = () => {
  loadAudioItems(true)
}

const goLearningPage = () => {
  uni.redirectTo({ url: '/pages/index/index' })
}

const goTopicsPage = () => {
  uni.redirectTo({ url: '/pages/topics/list' })
}

const goLivePage = () => {
  uni.redirectTo({ url: '/pages/live/index' })
}

const goCoursePage = () => {
  uni.redirectTo({ url: '/pages/course/index' })
}

const goNewsPage = () => {
  uni.redirectTo({ url: '/pages/news/index' })
}

const goMinePage = () => {
  uni.redirectTo({ url: '/pages/mine/index' })
}

const goExamPage = () => {
  uni.redirectTo({ url: '/pages/exam/index' })
}

const goKnowledgePage = () => {
  uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goConsultPage = () => {
  uni.redirectTo({ url: '/pages/consult/index' })
}

const goAudioDetail = (id : string) => {
  uni.navigateTo({ url: '/pages/audio/detail?id=' + id })
}

onShow(() => {
  if (!hasLoadedOnce.value) {
    hasLoadedOnce.value = true
    loadAudioItems(false)
  }
})
</script>

