<template>
  <view class="page">
    <view class="header">
      <view class="back-btn" @click="goBack">
        <image class="back-icon-image" src="/static/reader/icon_fanhui.png" mode="aspectFit"></image>
      </view>
      <text class="header-title">详情</text>
    </view>

    <scroll-view class="content" scroll-y="true">
      <view class="hero">
        <view class="hero-mask"></view>
        <view class="board-outer">
          <text class="board-label">课程</text>
        </view>
      </view>

      <view class="tabs">
        <view class="tab-item" @click="activeTab = 'intro'">
          <text :class="activeTab == 'intro' ? 'tab-text tab-text-active' : 'tab-text'">简介</text>
          <view v-if="activeTab == 'intro'" class="tab-line"></view>
        </view>
        <view class="tab-item" @click="activeTab = 'catalog'">
          <text :class="activeTab == 'catalog' ? 'tab-text tab-text-active' : 'tab-text'">目录</text>
          <view v-if="activeTab == 'catalog'" class="tab-line"></view>
        </view>
        <view class="favorite-tab-btn" @click="toggleFavorite">
          <text class="favorite-text" :class="isFavorited ? 'favorite-text-active' : ''">{{ isFavorited ? '已收藏' : '收藏' }}</text>
        </view>
      </view>

      <view v-if="activeTab == 'intro'" class="intro-panel">
        <text class="media-title">{{ courseTitle }}</text>

        <view class="stats-row">
          <text class="stats-text">学时 {{ courseViews }}</text>
          <text class="stats-text">收藏 {{ courseFavorites }}</text>
        </view>

        <text class="section-title">课程介绍</text>
        <text class="intro-text">{{ courseIntro }}</text>
      </view>

      <view v-else class="catalog-panel">
        <view v-for="item in catalogItems" :key="item.id" class="catalog-row catalog-row-active">
          <text class="catalog-title">{{ item.title }}</text>
          <text class="catalog-duration">{{ item.duration }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import {
  checkFavoriteStatus,
  fetchCourseDetail,
  updateFavoriteStatus,
  type Course,
  type CourseVideo
} from '../../utils/auth.uts'

type CatalogItem = {
  id : string
  title : string
  duration : string
}

const RESOURCE_TYPE = 'COURSE'

const courseId = ref('')
const activeTab = ref('intro')
const courseTitle = ref('课程详情')
const courseViews = ref('0')
const courseFavorites = ref('0')
const courseIntro = ref('这里展示课程基础信息。')
const isFavorited = ref(false)
const isFavoriteLoading = ref(false)
const catalogItems = ref<CatalogItem[]>([])

function safeText(value : string | null) : string {
  return value == null || value.length == 0 ? '' : value
}

function formatDuration(seconds : number) : string {
  const total = seconds > 0 ? seconds : 0
  const minute = Math.floor(total / 60)
  const second = total % 60
  const secondText = second < 10 ? '0' + String(second) : String(second)
  return String(minute) + "'" + secondText + '"'
}

function loadFavoriteStatus() : void {
  if (courseId.value.length == 0) {
    return
  }

  checkFavoriteStatus(
    RESOURCE_TYPE,
    Number(courseId.value),
    (favorited) => {
      isFavorited.value = favorited
    },
    () => {
      isFavorited.value = false
    }
  )
}

function toggleFavorite() : void {
  if (courseId.value.length == 0 || isFavoriteLoading.value) {
    return
  }

  isFavoriteLoading.value = true
  updateFavoriteStatus(
    {
      resourceType: RESOURCE_TYPE,
      resourceId: Number(courseId.value),
      favorited: !isFavorited.value
    },
    (result) => {
      isFavorited.value = result.favorited
      courseFavorites.value = String(result.favoriteCount != null ? result.favoriteCount : 0)
      isFavoriteLoading.value = false
      uni.showToast({
        title: result.favorited ? '收藏成功' : '已取消收藏',
        icon: 'success'
      })
    },
    (message) => {
      isFavoriteLoading.value = false
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

function applyCourseDetail(detail : Course) : void {
  const titleText = safeText(detail.courseName)
  if (titleText.length > 0) {
    courseTitle.value = titleText
  }

  const introText = safeText(detail.introduction)
  if (introText.length > 0) {
    courseIntro.value = introText
  } else {
    const introParts = new Array<string>()
    const subtitleText = safeText(detail.subtitle)
    const lecturerText = safeText(detail.lecturerName)
    const publishedText = safeText(detail.publishedAt)
    if (subtitleText.length > 0) {
      introParts.push('课程副标题：' + subtitleText)
    }
    if (lecturerText.length > 0) {
      introParts.push('讲师：' + lecturerText)
    }
    if (publishedText.length > 0) {
      introParts.push('发布时间：' + publishedText.replace('T', ' '))
    }
    if (introParts.length > 0) {
      courseIntro.value = introParts.join('；')
    }
  }

  courseViews.value = String(detail.studySeconds != null ? detail.studySeconds : 0)

  if (detail.videos != null && detail.videos.length > 0) {
    catalogItems.value = detail.videos.map((item : CourseVideo, index : number) : CatalogItem => {
      return {
        id: String(item.id),
        title: safeText(item.title).length > 0 ? item.title : '课程 ' + String(index + 1),
        duration: formatDuration(item.durationSeconds)
      }
    })
  } else {
    catalogItems.value = []
  }
}

function goBack() : void {
  uni.navigateBack()
}

function loadParams() : void {
  const pages = getCurrentPages()
  if (pages.length == 0) {
    return
  }

  const current = pages[pages.length - 1]
  if (current == null || current.options == null) {
    return
  }

  const options = current.options as UTSJSONObject
  const idValue = options['id']
  const tabValue = options['tab']
  if (typeof idValue == 'string' && idValue.length > 0) {
    courseId.value = idValue
  }
  if (typeof tabValue == 'string' && tabValue.length > 0) {
    activeTab.value = tabValue
  }
}

function loadCourseDetail() : void {
  if (courseId.value.length == 0) {
    return
  }

  fetchCourseDetail(
    courseId.value,
    (detail) => {
      applyCourseDetail(detail)
    },
    (message) => {
      uni.showToast({
        title: message,
        icon: 'none'
      })
    }
  )
}

onMounted(() => {
  loadParams()
  loadCourseDetail()
  loadFavoriteStatus()
})

onShow(() => {
  loadFavoriteStatus()
})
</script>

