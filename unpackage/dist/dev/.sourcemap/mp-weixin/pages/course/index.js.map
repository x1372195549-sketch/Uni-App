<template>
	<view class="page">
		<view class="hero-shell">
			<image class="hero-bg" src="/static/home/icon_expert.png" mode="scaleToFill"></image>

			<view class="header">
				<text class="header-title">江苏中医在线</text>
			</view>

			<view class="top-tabs">
				<view class="top-tab" @click="goLearningPage">
					<text class="top-tab-text">首页</text>
				</view>
				<view class="top-tab" @click="goTopicsPage">
					<text class="top-tab-text">专题</text>
				</view>
				<view class="top-tab" @click="goAudioPage">
					<text class="top-tab-text">音频</text>
				</view>
				<view class="top-tab" @click="goLivePage">
					<text class="top-tab-text">直播</text>
				</view>
				<view class="top-tab top-tab-active">
					<text class="top-tab-text top-tab-text-active">课程</text>
					<view class="top-tab-line"></view>
				</view>
				<view class="top-tab" @click="goNewsPage">
					<text class="top-tab-text">资讯</text>
				</view>
			</view>
		</view>

		<view class="search-bar">
			<input
				v-model="keyword"
				class="search-input"
				placeholder="搜索标题、讲师、课程"
				confirm-type="search"
				@confirm="reloadList"
			/>
			<view class="search-btn" @tap="reloadList">
				<text class="search-btn-text">搜索</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" @scrolltolower="loadMore">
			<view class="content-shell">
				<view v-if="isLoading" class="state-wrap">
					<text class="state-text">加载中...</text>
				</view>

				<view v-else-if="errorText.length > 0" class="state-wrap">
					<text class="state-text">{{ errorText }}</text>
					<view class="search-btn retry-btn" @tap="reloadList">
						<text class="search-btn-text">重新加载</text>
					</view>
				</view>

				<view v-else-if="courseItems.length == 0" class="state-wrap">
					<text class="state-text">暂无课程</text>
				</view>

				<view v-else class="list-wrap">
				<view class="course-card" v-for="item in courseItems" :key="item.id" @click="goCourseDetail(item.id)">
					<view class="course-cover-shell">
						<view class="course-cover">
							<text class="cover-badge">COURSE</text>
							<text class="cover-title">{{ item.coverTitle }}</text>
							<text class="cover-subtitle">{{ item.coverSubtitle }}</text>
							<view class="cover-board">
								<text class="board-text">课程</text>
							</view>
						</view>
					</view>

					<view class="course-info">
						<text class="course-title">{{ item.title }}</text>
						<view class="course-meta">
							<text class="teacher-name">{{ item.teacher }}</text>
							<view class="stats">
								<text class="stat-text">浏览 {{ item.views }}</text>
								<text class="stat-text">评论 {{ item.comments }}</text>
							</view>
						</view>
					</view>
				</view>
				<view v-if="isListLoading" class="bottom-state">
					<text class="bottom-state-text">加载更多中...</text>
				</view>
				<view v-else-if="!hasMore" class="bottom-state">
					<text class="bottom-state-text">没有更多了</text>
				</view>
				</view>
			</view>
		</scroll-view>

		<view class="tabbar">
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexidianji.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">学习</text>
			</view>
			<view class="tab-item" @click="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">咨询</text>
			</view>
			<view class="tab-item" @click="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">知识库</text>
			</view>
			<view class="tab-item" @click="goMinePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_wodeweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { fetchCourses } from '../../utils/auth.uts'

type CourseItem = {
	id : string
	coverTitle : string
	coverSubtitle : string
	title : string
	teacher : string
	views : string
	comments : string
}

type CourseVideo = {
	id : number
	courseId : number
	title : string
	videoUrl : string
	durationSeconds : number
	sortOrder : number
}

type Course = {
	id : number
	courseName : string
	subtitle : string
	coverUrl : string
	lecturerName : string
	introduction : string
	paperId : number
	publishedAt : string
	progressPercent : number
	studySeconds : number
	videos : CourseVideo[]
}

const placeholderItems = [
	{
		id: '1',
		coverTitle: '课程封面占位',
		coverSubtitle: '第一门课程',
		title: '课程标题占位一，点击进入课程详情页面',
		teacher: '讲师名称占位',
		views: '2600',
		comments: '420'
	},
	{
		id: '2',
		coverTitle: '课程封面占位',
		coverSubtitle: '第二门课程',
		title: '课程标题占位二，点击进入课程详情页面',
		teacher: '讲师名称占位',
		views: '2600',
		comments: '420'
	}
]

const PAGE_SIZE = 10

const courseItems = ref<CourseItem[]>([])
const keyword = ref('')
const page = ref(1)
const hasMore = ref(true)
const isLoading = ref(true)
const isListLoading = ref(false)
const errorText = ref('')

const safeText = (value : string | null) : string => {
	return value == null || value.length == 0 ? '' : value
}

const mapCourseToCard = (item : Course, index : number) : CourseItem => {
	const courseName = safeText(item.courseName)
	const subtitle = safeText(item.subtitle)
	const lecturer = safeText(item.lecturerName)
	return {
		id: String(item.id),
		coverTitle: courseName.length > 0 ? courseName : '课程封面占位',
		coverSubtitle: subtitle.length > 0 ? subtitle : '第' + String(index + 1) + '门课程',
		title: courseName.length > 0 ? courseName : '课程标题占位',
		teacher: lecturer.length > 0 ? lecturer : '讲师名称占位',
		views: String(item.studySeconds != null ? item.studySeconds : 0),
		comments: String(item.videos != null ? item.videos.length : 0)
	}
}

const loadCourseItems = (loadMoreValue : boolean) => {
	if (!loadMoreValue) {
		page.value = 1
		hasMore.value = true
		errorText.value = ''
		isLoading.value = true
	} else {
		if (!hasMore.value || isListLoading.value) {
			return
		}
		isListLoading.value = true
	}

	fetchCourses(
		page.value,
		PAGE_SIZE,
		keyword.value,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			const mapped = records.map((item : Course, index : number) : CourseItem => {
				return mapCourseToCard(item, index)
			})
			if (loadMoreValue) {
				courseItems.value = courseItems.value.concat(mapped)
			} else {
				courseItems.value = mapped
			}
			hasMore.value = mapped.length >= PAGE_SIZE
			if (hasMore.value) {
				page.value += 1
			}
			isLoading.value = false
			isListLoading.value = false
		},
		(message) => {
			errorText.value = message.length > 0 ? message : '课程加载失败'
			isLoading.value = false
			isListLoading.value = false
		}
	)
}

const reloadList = () => {
	loadCourseItems(false)
}

const loadMore = () => {
	loadCourseItems(true)
}

const goLearningPage = () => {
	uni.redirectTo({ url: '/pages/index/index' })
}

const goTopicsPage = () => {
	uni.redirectTo({ url: '/pages/topics/list' })
}

const goAudioPage = () => {
	uni.redirectTo({ url: '/pages/audio/index' })
}

const goLivePage = () => {
	uni.redirectTo({ url: '/pages/live/index' })
}

const goNewsPage = () => {
	uni.redirectTo({ url: '/pages/news/index' })
}

const goMinePage = () => {
	uni.redirectTo({ url: '/pages/mine/index' })
}

const goExamPage = () => {
	uni.redirectTo({ url: '/pages/exam/index' })
}

const goCourseDetail = (id : string) => {
	uni.navigateTo({ url: '/pages/course/detail?id=' + id })
}

const goKnowledgePage = () => {
	uni.redirectTo({ url: '/pages/knowledge/index' })
}

const goConsultPage = () => {
	uni.redirectTo({ url: '/pages/consult/index' })
}

loadCourseItems(false)
</script>

