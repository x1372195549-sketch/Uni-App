<template>
	<view class="page">
		<image class="hero-bg" src="/static/mine/hero-bg.png" mode="scaleToFill"></image>

		<view class="content">
			<view class="profile-shell">
				<view class="profile-head">
					<image class="avatar" :src="avatarUrl || '/static/mine/avatar.png'" mode="aspectFill"></image>
					<view class="profile-main">
						<view class="name-row">
							<text class="nickname">{{ nickname || '微信用户' }}</text>
							<text class="user-type">{{ userTypeText }}</text>
						</view>
						<view class="sub-row">
							<text class="student-no">{{ studentNo }}</text>
							<text v-if="isCertified" class="cert-tag cert-tag-on">学员认证</text>
							<text v-else class="cert-tag cert-tag-off">学员未认证</text>
						</view>
					</view>
				</view>

				<view class="menu">
					<view class="menu-item" v-for="item in menuItems" :key="item.label" @click="handleMenuClick(item.label)">
						<view class="menu-left">
							<image class="menu-icon" :src="item.icon" mode="aspectFit"></image>
							<text class="menu-label">{{ item.label }}</text>
						</view>
						<image class="menu-arrow" src="/static/mine/arrow.png" mode="aspectFit"></image>
					</view>
				</view>
			</view>

			<view class="footer">
				<text class="footer-line">版权所有</text>
				<text class="footer-line">江苏凤凰科学技术出版社有限公司</text>
			</view>
		</view>

		<view class="tabbar">
			<view class="tab-item" @click="goLearningHome">
				<image class="tab-icon-image" src="/static/tabbar/icon_xuexiweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">学习</text>
			</view>
			<view class="tab-item" @click="goExamPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_kaoheweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">考核</text>
			</view>
			<view class="tab-item" @click="goConsultPage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhuanjia.png" mode="aspectFit"></image>
				<text class="tab-label">咨询</text>
			</view>
			<view class="tab-item" @click="goKnowledgePage">
				<image class="tab-icon-image" src="/static/tabbar/icon_zhishikuweidianji.png" mode="aspectFit"></image>
				<text class="tab-label">知识库</text>
			</view>
			<view class="tab-item tab-item-active">
				<image class="tab-icon-image" src="/static/tabbar/icon_wode.png" mode="aspectFit"></image>
				<text class="tab-label tab-label-active">我的</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import {
	hasToken,
	fetchProfile,
	getCurrentUserFromStorage,
	logout
} from '../../utils/auth.uts'
import { onShow } from '@dcloudio/uni-app'

type MineMenuItem = {
	label : string
	icon : string
}

const nickname = ref('')
const avatarUrl = ref('')
const userTypeText = ref('')
const studentNo = ref('')
const isCertified = ref(false)
const isLoggedIn = ref(hasToken())

const menuItems = ref<MineMenuItem[]>([
	{ label: '个人资料', icon: '/static/mine/icon_about.png' },
	{ label: '学员认证', icon: '/static/mine/icon_about.png' },
	{ label: '我的收藏', icon: '/static/mine/icon_favorite.png' },
	{ label: '学习历史', icon: '/static/mine/icon_history.png' },
	{ label: '意见反馈', icon: '/static/mine/icon_about.png' },
	{ label: '退出登录', icon: '/static/mine/icon_about.png' },
	{ label: '使用手册', icon: '/static/mine/icon_manual.png' }
])

const loadUserData = () => {
	if (!isLoggedIn.value) {
		uni.reLaunch({
			url: '/pages/login/index'
		})
		return
	}

	const cached = getCurrentUserFromStorage()
	if (cached != null) {
		nickname.value = cached.nickname
		avatarUrl.value = cached.avatarUrl
		isCertified.value = cached.certificationStatus == '2'
	}

	fetchProfile(
		(profile) => {
			nickname.value = profile.nickname
			avatarUrl.value = profile.avatarUrl || avatarUrl.value
			studentNo.value = profile.studentId != 0 ? '学员' : ''
			isCertified.value = profile.certificationStatus == '2'
			userTypeText.value = profile.profileCompleted ? '（已认证）' : '（普通用户）'
		},
		() => {}
	)
}

const handleMenuClick = (label : string) => {
	if (label == '个人资料') {
		uni.navigateTo({
			url: '/pages/profile/edit'
		})
		return
	}
	if (label == '学员认证') {
		uni.navigateTo({
			url: '/pages/profile/certification'
		})
		return
	}
	if (label == '我的收藏') {
		uni.navigateTo({
			url: '/pages/profile/favorites'
		})
		return
	}
	if (label == '学习历史') {
		uni.navigateTo({
			url: '/pages/profile/history'
		})
		return
	}
	if (label == '退出登录') {
		logout(
			() => {
				uni.reLaunch({
					url: '/pages/login/index'
				})
			},
			(message) => {
				uni.showToast({
					title: message,
					icon: 'none'
				})
			}
		)
	}
}

const goLearningHome = () => {
	uni.redirectTo({
		url: '/pages/index/index'
	})
}

const goExamPage = () => {
	uni.redirectTo({
		url: '/pages/exam/index'
	})
}

const goConsultPage = () => {
	uni.redirectTo({
		url: '/pages/consult/index'
	})
}

const goKnowledgePage = () => {
	uni.redirectTo({
		url: '/pages/knowledge/index'
	})
}

loadUserData()
onShow(() => {
	loadUserData()
})
</script>

<style>
.page {
	flex: 1;
	position: relative;
	background-color: #f7f7f2;
	overflow: hidden;
}

.hero-bg {
	position: absolute;
	top: 0;
	left: 0;
	width: 750rpx;
	height: 284rpx;
}

.content {
	flex: 1;
	padding-top: 304rpx;
	padding-bottom: 128rpx;
}

.profile-shell {
	margin-left: 12rpx;
	margin-right: 12rpx;
	background-color: rgba(255, 255, 255, 0.97);
	border-radius: 18rpx;
	box-shadow: 0 12rpx 22rpx rgba(90, 90, 60, 0.05);
	overflow: hidden;
}

.profile-head {
	padding-left: 14rpx;
	padding-right: 20rpx;
	padding-top: 18rpx;
	padding-bottom: 12rpx;
	flex-direction: row;
	align-items: center;
}

.avatar {
	width: 76rpx;
	height: 76rpx;
	border-radius: 38rpx;
	margin-right: 14rpx;
}

.profile-main {
	flex: 1;
}

.name-row {
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
	margin-bottom: 8rpx;
}

.nickname {
	font-size: 18px;
	line-height: 26px;
	color: #1f1f1f;
	font-weight: 600;
}

.user-type {
	font-size: 13px;
	line-height: 20px;
	color: #9d9d9d;
	margin-left: 8rpx;
}

.sub-row {
	flex-direction: row;
	align-items: center;
}

.student-no {
	font-size: 13px;
	line-height: 20px;
	color: #9d9d9d;
	margin-right: 10rpx;
}

.cert-tag {
	padding-left: 14rpx;
	padding-right: 14rpx;
	height: 32rpx;
	line-height: 32rpx;
	border-radius: 7rpx;
	font-size: 12px;
	font-weight: 500;
	color: #ffffff;
}

.cert-tag-on {
	background-color: #10b66d;
}

.cert-tag-off {
	background-color: #b9b9b9;
}

.menu {
	padding-left: 18rpx;
	padding-right: 18rpx;
	padding-top: 4rpx;
	padding-bottom: 8rpx;
}

.menu-item {
	height: 80rpx;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #f1f1ec;
}

.menu-item:last-child {
	border-bottom-width: 0;
}

.menu-left {
	flex-direction: row;
	align-items: center;
}

.menu-icon {
	width: 28rpx;
	height: 28rpx;
	margin-right: 16rpx;
}

.menu-label {
	font-size: 16px;
	line-height: 24px;
	color: #1b1b1b;
}

.menu-arrow {
	width: 14rpx;
	height: 22rpx;
	opacity: 0.72;
}

.footer {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 98rpx;
	align-items: center;
}

.footer-line {
	font-size: 11px;
	line-height: 16px;
	color: #b8b8b8;
}

.tabbar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 96rpx;
	padding-bottom: 8rpx;
	background-color: rgba(255, 255, 255, 0.98);
	border-top-width: 1px;
	border-top-style: solid;
	border-top-color: #e9e9e4;
	flex-direction: row;
	align-items: center;
	justify-content: space-around;
}

.tab-item {
	align-items: center;
	justify-content: center;
}

.tab-item-active {
	margin-top: -2rpx;
}

.tab-icon-image {
	width: 42rpx;
	height: 42rpx;
	margin-bottom: 6rpx;
}

.tab-label {
	font-size: 11px;
	line-height: 16px;
	color: #b1b1b1;
}

.tab-label-active {
	color: #18b775;
}
</style>
