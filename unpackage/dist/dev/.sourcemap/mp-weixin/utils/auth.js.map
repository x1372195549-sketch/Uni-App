const ACCESS_TOKEN_KEY = 'app_auth_access_token'
const TOKEN_TYPE_KEY = 'app_auth_token_type'
const LOGIN_USER_KEY = 'app_auth_login_user'
const CURRENT_USER_KEY = 'app_auth_current_user'
const BIND_TOKEN_KEY = 'app_auth_bind_token'

function getTokenType() : string {
	const tokenType = uni.getStorageSync(TOKEN_TYPE_KEY)
	return typeof tokenType == 'string' ? tokenType : ''
}

function getAccessToken() : string {
	const accessToken = uni.getStorageSync(ACCESS_TOKEN_KEY)
	return typeof accessToken == 'string' ? accessToken : ''
}

function buildAuthorization() : string {
	const tokenType = getTokenType()
	const accessToken = getAccessToken()
	if (accessToken == '') {
		return ''
	}
	if (tokenType != '') {
		return tokenType + ' ' + accessToken
	}
	return 'Bearer ' + accessToken
}

function getBaseOrigin() : string {
	const matches = BASE_URL.match(/^https?:\/\/[^/]+/)
	if (matches != null && matches.length > 0) {
		return matches[0]
	}
	return BASE_URL
}

function normalizeExternalUrl(rawUrl : string) : string {
	if (rawUrl == null || rawUrl == '') {
		return ''
	}

	const baseOrigin = getBaseOrigin()

	if (/^https?:\/\/minio(?::\d+)?($|\/|\?)/.test(rawUrl)) {
		return rawUrl.replace(/^https?:\/\/minio(?::\d+)?/i, baseOrigin)
	}

	if (/^https?:\/\/[^/]*minio[^/]*($|\/|\?)/.test(rawUrl)) {
		return rawUrl.replace(/^https?:\/\/[^/]*minio[^/]*/i, baseOrigin)
	}

	if (/^https?:\/\/minio(?::\d+)?\//.test(rawUrl)) {
		return rawUrl.replace(/^https?:\/\/minio(?::\d+)?/, baseOrigin)
	}

	if (/^https?:\/\/[^/]+\/minio\//.test(rawUrl) && rawUrl.indexOf(baseOrigin) == 0) {
		return rawUrl
	}

	if (rawUrl.startsWith('/')) {
		return baseOrigin + rawUrl
	}

	return rawUrl
}

function normalizeUploadUrlResponse(data : UTSJSONObject) : AvatarUploadUrlResponse {
	const rawUploadUrl =
		(data['uploadUrl'] as string) ||
		(data['signedUrl'] as string) ||
		(data['presignedUrl'] as string) ||
		(data['url'] as string) ||
		''
	const uploadUrl = normalizeExternalUrl(rawUploadUrl)
	const objectKey =
		(data['objectKey'] as string) ||
		(data['fileKey'] as string) ||
		(data['key'] as string) ||
		''
	const method =
		(data['method'] as string) ||
		'PUT'
	const headers = data['headers'] as UTSJSONObject | null
	const formData = data['formData'] as UTSJSONObject | null
	const rawPublicUrl =
		(data['publicUrl'] as string) ||
		(data['avatarUrl'] as string) ||
		(data['fileUrl'] as string) ||
		''
	const publicUrl = normalizeExternalUrl(rawPublicUrl)

	return {
		uploadUrl,
		objectKey,
		method,
		headers,
		formData,
		publicUrl
	} as AvatarUploadUrlResponse
}

export function saveLogin(data : LoginResponseData) {
	uni.setStorageSync(ACCESS_TOKEN_KEY, data.accessToken)
	uni.setStorageSync(TOKEN_TYPE_KEY, data.tokenType)
	if (data.user != null) {
		uni.setStorageSync(LOGIN_USER_KEY, data.user)
	}
}

function saveCurrentUser(user : CurrentUser) {
	uni.setStorageSync(CURRENT_USER_KEY, user)
}

function normalizeCurrentUserData(raw : UTSJSONObject | null) : CurrentUser | null {
	if (raw == null) {
		return null
	}

	return {
		id: typeof raw['id'] == 'number' ? (raw['id'] as number) : 0,
		username: typeof raw['username'] == 'string' ? (raw['username'] as string) : '',
		nickname: typeof raw['nickname'] == 'string' ? (raw['nickname'] as string) : '',
		avatarUrl: typeof raw['avatarUrl'] == 'string' ? (raw['avatarUrl'] as string) : '',
		mobile: typeof raw['mobile'] == 'string' ? (raw['mobile'] as string) : '',
		email: typeof raw['email'] == 'string' ? (raw['email'] as string) : '',
		profileCompleted: typeof raw['profileCompleted'] == 'boolean' ? (raw['profileCompleted'] as boolean) : false,
		studentId: typeof raw['studentId'] == 'number' ? (raw['studentId'] as number) : 0,
		certificationStatus: typeof raw['certificationStatus'] == 'string' ? (raw['certificationStatus'] as string) : ''
	} as CurrentUser
}

export function patchCurrentUser(partial : CurrentUserPatch) {
	const cached = getCurrentUserFromStorage()
	if (cached == null) {
		return
	}

	const nextUser : CurrentUser = {
		id: cached.id,
		username: cached.username,
		nickname: partial.nickname != null && partial.nickname != '' ? partial.nickname! : cached.nickname,
		avatarUrl: partial.avatarUrl != null && partial.avatarUrl != '' ? partial.avatarUrl! : cached.avatarUrl,
		mobile: partial.mobile != null && partial.mobile != '' ? partial.mobile! : cached.mobile,
		email: partial.email != null && partial.email != '' ? partial.email! : cached.email,
		profileCompleted: partial.profileCompleted != null ? partial.profileCompleted! : cached.profileCompleted,
		studentId: partial.studentId != null ? partial.studentId! : cached.studentId,
		certificationStatus: partial.certificationStatus != null && partial.certificationStatus != '' ? partial.certificationStatus! : cached.certificationStatus
	}

	saveCurrentUser(nextUser)
}

export function mergeProfileIntoCurrentUser(profile : AppProfile) {
	const cached = getCurrentUserFromStorage()
	const nextUser : CurrentUser = {
		id: cached != null ? cached.id : (profile.id || 0),
		username: cached != null ? cached.username : (profile.username || ''),
		nickname: profile.nickname || (cached != null ? cached.nickname : ''),
		avatarUrl: profile.avatarUrl || (cached != null ? cached.avatarUrl : ''),
		mobile: profile.mobile || (cached != null ? cached.mobile : ''),
		email: profile.email || (cached != null ? cached.email : ''),
		profileCompleted: profile.profileCompleted || (cached != null ? cached.profileCompleted : false),
		studentId: profile.studentId || (cached != null ? cached.studentId : 0),
		certificationStatus: profile.certificationStatus || (cached != null ? cached.certificationStatus : '')
	}
	saveCurrentUser(nextUser)
}

