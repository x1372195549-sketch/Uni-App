export function fetchLiveSessions(
	page : number,
	size : number,
	keyword : string,
	success : (pageData : PageResponse<LiveSession>) => void,
	fail : (message : string) => void
) {
	let path = '/api/v1/app/live-sessions?page=' + String(page) + '&size=' + String(size)
	if (keyword != null && keyword.length > 0) {
		path += '&keyword=' + encodeURIComponent(keyword)
	}
	request<PageResponse<LiveSession>>(
		path,
		'GET',
		null,
		true,
		false,
		(pageData) => {
			const records = pageData.records != null ? pageData.records : []
			success({
				records: records.map((item : UTSJSONObject) : LiveSession => {
					return normalizeLiveSession(item)
				}),
				total: pageData.total,
				page: pageData.page,
				size: pageData.size
			} as PageResponse<LiveSession>)
		},
		(message) => {
			fail(message)
		}
	)
}

export function fetchLiveSessionDetail(
	id : string,
