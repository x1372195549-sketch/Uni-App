export function uploadAvatarFile(
	filePath : string,
	config : AvatarUploadUrlResponse,
	success : () => void,
	fail : (message : string) => void
) {
	if (config.method.toUpperCase() == 'PUT') {
		uni.uploadFile({
			url: config.uploadUrl,
			filePath,
			name: 'file',
			header: (() : UTSJSONObject => {
				const putHeaders : UTSJSONObject = {
					'Content-Type': 'application/octet-stream'
				}
				if (config.headers != null) {
					const keys = Object.keys(config.headers)
					for (let i = 0; i < keys.length; i++) {
						const key = keys[i]
						const value = config.headers[key]
						if (typeof value == 'string') {
							putHeaders[key] = value
						}
					}
				}
				return putHeaders
			})(),
			success: (res) => {
				if (res.statusCode >= 200 && res.statusCode < 300) {
					success()
					return
				}
				fail('头像文件上传失败')
			},
			fail: (err) => {
				fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '头像文件上传失败')
			}
		})
		return
	}

	const uploadHeader : UTSJSONObject = {}
	if (config.headers != null) {
		const keys = Object.keys(config.headers)
		for (let i = 0; i < keys.length; i++) {
			const key = keys[i]
			const value = config.headers[key]
			if (typeof value == 'string') {
				uploadHeader[key] = value
			}
		}
	}

	const uploadFormData : UTSJSONObject = {}
	if (config.formData != null) {
		const keys = Object.keys(config.formData)
		for (let i = 0; i < keys.length; i++) {
			const key = keys[i]
			const value = config.formData[key]
			if (typeof value == 'string') {
				uploadFormData[key] = value
			}
		}
	}

	uni.uploadFile({
		url: config.uploadUrl,
		filePath,
		name: 'file',
		formData: uploadFormData,
		header: uploadHeader,
		success: (res) => {
			if (res.statusCode >= 200 && res.statusCode < 300) {
				success()
				return
			}
			fail('头像文件上传失败')
		},
		fail: (err) => {
			fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '头像文件上传失败')
		}
	})
}

export function uploadAvatarBinaryFile(
	filePath : string,
	config : AvatarUploadUrlResponse,
	binaryConfig : AvatarBinaryUploadConfig,
	success : () => void,
	fail : (message : string) => void
) {
	if (config.method.toUpperCase() == 'PUT') {
		uni.getFileSystemManager().readFile({
			filePath,
			success: (readRes) => {
				const putHeaders : UTSJSONObject = {
					'Content-Type': binaryConfig.contentType
				}
				if (config.headers != null) {
					const keys = Object.keys(config.headers)
					for (let i = 0; i < keys.length; i++) {
						const key = keys[i]
						const value = config.headers[key]
						if (typeof value == 'string') {
							putHeaders[key] = value
						}
					}
				}
				uni.request({
					url: config.uploadUrl,
					method: 'PUT',
					data: readRes.data,
					header: putHeaders,
					success: (res) => {
						if (res.statusCode >= 200 && res.statusCode < 300) {
							success()
							return
						}
						fail('头像文件上传失败')
					},
					fail: (err) => {
						fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '头像文件上传失败')
					}
				})
			},
			fail: (err) => {
				fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '读取头像文件失败')
			}
		})
		return
	}

	const uploadHeader : UTSJSONObject = {}
	if (config.headers != null) {
		const keys = Object.keys(config.headers)
		for (let i = 0; i < keys.length; i++) {
			const key = keys[i]
			const value = config.headers[key]
			if (typeof value == 'string') {
				uploadHeader[key] = value
			}
		}
	}

	const uploadFormData : UTSJSONObject = {}
	if (config.formData != null) {
		const keys = Object.keys(config.formData)
		for (let i = 0; i < keys.length; i++) {
			const key = keys[i]
			const value = config.formData[key]
			if (typeof value == 'string') {
				uploadFormData[key] = value
			}
		}
	}

	uni.uploadFile({
		url: config.uploadUrl,
		filePath,
		name: 'file',
		formData: uploadFormData,
		header: uploadHeader,
		success: (res) => {
			if (res.statusCode >= 200 && res.statusCode < 300) {
				success()
				return
			}
			fail('头像文件上传失败')
		},
		fail: (err) => {
			fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '头像文件上传失败')
		}
	})
}

export function clearAuthStorage() {
	uni.removeStorageSync(ACCESS_TOKEN_KEY)
	uni.removeStorageSync(TOKEN_TYPE_KEY)
	uni.removeStorageSync(LOGIN_USER_KEY)
	uni.removeStorageSync(CURRENT_USER_KEY)
	uni.removeStorageSync(BIND_TOKEN_KEY)
}

export function getCurrentUserFromStorage() : CurrentUser | null {
	const user = uni.getStorageSync(CURRENT_USER_KEY)
	if (user == null || user == '') {
		return null
	}
	return normalizeCurrentUserData(user as UTSJSONObject)
}

export function hasToken() : boolean {
	return getAccessToken() != ''
}

export function hasBoundMobile(user : CurrentUser | null) : boolean {
	if (user == null) {
		return false
	}
	return user.mobile != null && user.mobile != ''
}

function saveBindToken(token : string) {
	uni.setStorageSync(BIND_TOKEN_KEY, token)
}

export function getBindToken() : string {
	const token = uni.getStorageSync(BIND_TOKEN_KEY)
	return typeof token == 'string' ? token : ''
}

export function clearBindToken() {
	uni.removeStorageSync(BIND_TOKEN_KEY)
}

function request<T>(
	path : string,
	method : string,
	data : UTSJSONObject | null,
	needAuth : boolean,
	allowEmptyData : boolean,
	success : (data : T) => void,
	fail : (message : string) => void
) {
	const header : UTSJSONObject = {
		'Content-Type': 'application/json'
	}
	if (needAuth) {
		const authorization = buildAuthorization()
		if (authorization == '') {
			fail('登录状态已失效，请重新登录')
			return
		}
		header['Authorization'] = authorization
	}

	uni.request({
		url: BASE_URL + path,
		method,
		data,
		header,
		success: (res) => {
			const statusCode = res.statusCode
			const body = res.data as ApiResponse<T>
			if (statusCode >= 200 && statusCode < 300 && body != null && body.success == true) {
				if (body.data != null) {
					success(body.data)
					return
				}
				if (allowEmptyData) {
					success(null as T)
					return
				}
			}

			if (body != null && body.message != null && body.message != '') {
				fail(body.message)
				return
			}

			fail('请求失败，请稍后重试')
		},
		fail: (err) => {
			fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '网络请求失败')
		}
	})
}

export function fetchCurrentUser(
	success : (user : CurrentUser) => void,
	fail : (message : string) => void
) {
	request<CurrentUser>(
		'/api/v1/app/auth/me',
		'GET',
		null,
		true,
		false,
		(user) => {
			saveCurrentUser(user)
			success(user)
		},
		(message) => {
			fail(message)
		}
	)
}

export function loginByWechat(
	nickname : string,
	avatarUrl : string,
	success : (user : CurrentUser | null) => void,
	fail : (message : string) => void
) {
	// #ifdef MP-WEIXIN
	uni.login({
		success: (loginRes) => {
			const requestBody : UTSJSONObject = {
				code: loginRes.code,
				nickname,
				avatarUrl
			}
			request<WechatLoginData>(
				'/api/v1/app/auth/wechat-login',
				'POST',
				requestBody,
				false,
				false,
				(loginData) => {
					if (loginData.needBindMobile) {
						saveBindToken(loginData.bindToken)
						success(null)
						return
					}
					const saveData : LoginResponseData = {
						tokenType: loginData.tokenType,
						accessToken: loginData.accessToken,
						expiresIn: loginData.expiresIn,
						user: loginData.user
					}
					saveLogin(saveData)
					fetchCurrentUser(
						(user) => {
							success(user)
						},
						(message) => {
							fail(message)
						}
					)
				},
				(message) => {
					fail(message)
				}
			)
		},
		fail: (err) => {
			fail(err.errMsg != null && err.errMsg != '' ? err.errMsg : '微信登录失败')
		}
	})
	// #endif

	// #ifndef MP-WEIXIN
	fail('请在微信小程序环境中使用微信授权登录')
	// #endif
}

export function wechatBindMobile(
	bindToken : string,
	mobile : string,
	code : string,
	success : (data : LoginResponseData) => void,
	fail : (message : string) => void
) {
	const requestBody : UTSJSONObject = {
		bindToken,
		mobile,
		code
	}
	request<LoginResponseData>(
		'/api/v1/app/auth/wechat-bind-mobile',
		'POST',
		requestBody,
		false,
		false,
		(loginData) => {
			success(loginData)
		},
		(message) => {
			fail(message)
		}
	)
}

