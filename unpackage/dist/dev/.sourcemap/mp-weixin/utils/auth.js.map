export type AvatarUploadUrlResponse = {
	uploadUrl : string
	objectKey : string
	method : string
	headers : UTSJSONObject | null
	formData : UTSJSONObject | null
	publicUrl : string
}

export type AvatarUploadUrlRequest = {
	originalName : string
	contentType : string
	fileSize : number
}

export type AvatarConfirmRequest = {
	objectKey : string
	originalName? : string
}

export type AvatarBinaryUploadConfig = {
	contentType : string
